Cell["\<\
On a two-spin system, both 4-step phase cycles match \
CoherenceOrderFiltration[{-2, 2}] to machine precision (~10^-16). Notice an \
important practical distinction for larger spin networks: a 4-step phase \
cycle selects p = +/-2 mod 4 (which includes +/-6-quantum coherences in >= \
6-spin systems unless extended to more steps), whereas \
CoherenceOrderFiltration[{-2, 2}] selects strictly p in {-2, +2} in a single \
evaluation \[AHat]\.80\.94 making CoherenceOrderFiltration ideal for fast \
exploratory simulations, and PhaseCycle ideal when testing real spectrometer \
phase tables or finite/imperfect pulses.\
\>", "Text",ExpressionUUID->"ef6ea053-4438-ba40-aa2c-10626f7a404c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Quadrature Modes and Diagnostics for DQF-COSY", "Section",ExpressionUUID->"422b989f-f3f6-2e49-9985-a22abadf6b7d"],

Cell["\<\
Just like COSY-90, DQF-COSY works seamlessly with Signal2D's phase-sensitive \
indirect quadrature modes (\"States\", \"StatesTPPI\", \"EchoAntiEcho\", \
\"OversampledStates\"). Here we verify that \"StatesTPPI\" and \"EchoAntiEcho\
\" yield the exact same pure-absorption DQF-COSY spectrum when processed \
identically, and inspect QuadratureDiagnostics[sigDQF] to verify balanced \
quadrature channels with no diagnostic warnings.\
\>", "Text",ExpressionUUID->"12f0f8e7-cf31-034a-9dea-98eaeb1c2f59"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigDQFST", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", "rho0"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", "dqfMix"}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hax"}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<StatesTPPI\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "16."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigDQFEA", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", "rho0"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", "dqfMix"}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hax"}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<EchoAntiEcho\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "16."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specDQFST", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQFST", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specDQFEA", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQFEA", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Max |StatesTPPI - States| (RR)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"specDQFST", "[", "\"\<RR\>\"", "]"}], "-", 
       RowBox[{"specDQF", "[", "\"\<RR\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |EchoAntiEcho - States| (RR)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"specDQFEA", "[", "\"\<RR\>\"", "]"}], "-", 
       RowBox[{"specDQF", "[", "\"\<RR\>\"", "]"}]}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"60c986bc-f2f5-014d-80e7-48be925490f8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Max |StatesTPPI - States| (RR)\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"Max |EchoAntiEcho - States| (RR)\"\>", "\[Rule]", 
    "6.938893903907228`*^-18"}]}], "}"}]], "Output",
