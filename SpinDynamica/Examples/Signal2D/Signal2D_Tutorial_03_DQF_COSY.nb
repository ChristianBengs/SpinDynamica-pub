Cell[CellGroupData[{
Cell["\<\
SpinDynamica 2D NMR Tutorial 03: Double-Quantum Filtered COSY (DQF-COSY)\
\>", "Title",ExpressionUUID->"c433da0e-4558-4d4a-bfea-6291035453df"],

Cell["\<\
Simultaneous Pure-Absorption Diagonal and Cross Peaks, Coherence-Order \
Filtration, Phase Cycling, Singlet Suppression, and Active vs. Passive \
Couplings\
\>", "Subtitle",ExpressionUUID->"bfae1ba5-a5f9-3149-bf18-334947d335a4"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"b79e0725-5b1b-bf4b-9d65-11dc08d9a140"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that the public 2D simulation, \
processing, and coherence-order filtration functions are loaded.\
\>", "Text",ExpressionUUID->"2c0a89ad-6441-ef41-beba-6cbf4faa7f26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"f3cecdf9-000a-eb40-b2b7-79ef327c8402"],

