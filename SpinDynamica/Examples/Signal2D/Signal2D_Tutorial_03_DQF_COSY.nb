Cell["\<\
Look closely at the zoomed A-M cross peak on the right: along F1 (spin A, \
which has only J_AM = 36 Hz) there are two components of opposite sign \
separated by 36 Hz; along F2 (spin M, coupled to both A and X) the active \
J_AM = 36 Hz flips sign between left and right halves, while within each half \
the passive J_MX = 16 Hz splits into a SAME-SIGN (in-phase) pair separated by \
16 Hz!\
\>", "Text",ExpressionUUID->"4771016f-6c11-8f4e-a9aa-46ef713348f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Linewidth and Apodization on Anti-Phase Multiplets", "Section",ExpressionUUID->"b09cfb69-88f1-d24e-a665-887e640204df"],

Cell["\<\
Because every peak in a DQF-COSY spectrum is anti-phase, line broadening that \
approaches or exceeds the active scalar coupling J causes adjacent positive \
and negative lobes to cancel destructively, collapsing peak intensity. \
Conversely, matched resolution-enhancing window functions such as a shifted \
sine-bell (Apodization -> {\"SineBell\", Pi/4}) preserve crisp anti-phase \
structure and reduce truncation ringing.

To demonstrate this cleanly without repeating the spin-dynamics simulation, \
we simulate one lightly damped AX DQF-COSY signal (LineBroadening -> 4 Hz) \
and re-process it with FT under three different apodization settings.\
\>", "Text",ExpressionUUID->"f05daaa5-9f05-e24d-aeb3-6a3820220fd8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigDQFSharp", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", "dqfMix"}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hax"}], ",", 
     RowBox[{"LineBroadening", "->", "4."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specApodSharp", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQFSharp", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"Apodization", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Lorentzian\>\"", ",", "6."}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specApodBroad", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQFSharp", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"Apodization", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Lorentzian\>\"", ",", "32."}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specApodSine", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQFSharp", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"Apodization", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<SineBell\>\"", ",", 
        RowBox[{"Pi", "/", "4"}]}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Max |RR| (Lorentzian 6 Hz)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"specApodSharp", "[", "\"\<RR\>\"", "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |RR| (Lorentzian 32 Hz)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"specApodBroad", "[", "\"\<RR\>\"", "]"}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |RR| (SineBell Pi/4)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"specApodSine", "[", "\"\<RR\>\"", "]"}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"cdeb756f-6d7e-ea45-90ab-da92f2e442e4"],

