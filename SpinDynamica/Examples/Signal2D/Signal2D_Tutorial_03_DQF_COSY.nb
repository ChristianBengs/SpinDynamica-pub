       ",", 
       RowBox[{"AspectRatio", "->", "0.55"}], ",", 
       RowBox[{"ImageSize", "->", "350"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directive", "[", 
           RowBox[{"Gray", ",", "Dashed", ",", 
            RowBox[{"Thickness", "[", "0.004", "]"}]}], "]"}], ",", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.10", ",", "0.35", ",", "0.75"}], "]"}], ",", 
            RowBox[{"Thickness", "[", "0.005", "]"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<COSY-90 (dispersive)\>\"", 
            ",", "\"\<DQF-COSY (absorptive)\>\""}], "}"}], ",", "Above"}], 
         "]"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "Automatic"}], "}"}], ",", 
          RowBox[{"{", 
