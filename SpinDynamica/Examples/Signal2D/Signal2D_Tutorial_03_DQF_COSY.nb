Cell[CellGroupData[{

Cell["1. Why Double-Quantum Filtering? The COSY-90 Phase Trade-Off", "Section",ExpressionUUID->"624cee02-cba1-614d-901b-09fb59483532"],

Cell["\<\
In Tutorial 01 we simulated a simple 90-t1-90 COSY-90 experiment on a weakly \
coupled two-spin-1/2 AX system (chemical shifts -120 Hz and +180 Hz, scalar \
coupling J = 24 Hz). That simple sequence reveals a fundamental constraint of \
two-pulse COSY:
  - The cross-peak coherence pathways originate as anti-phase magnetization \
(~ sin(Pi J t1) sin(Pi J t2)).
  - The diagonal-peak coherence pathways remain in-phase (~ cos(Pi J t1) \
cos(Pi J t2)).

Because sine and cosine J-modulations differ by 90 degrees in both t1 and t2, \
no single phase correction can make both the cross peaks and the diagonal \
peaks purely absorptive at the same time.\
\>", "Text",ExpressionUUID->"4202e800-b087-cb43-b4fe-1234b16ee2c8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nu1", "=", 
   RowBox[{"-", "120."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nu2", "=", "180."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"j12", "=", "24."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hax", "=", 
   RowBox[{"2.", "*", "Pi", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"nu1", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"nu2", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"j12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigCosy", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", "rho0"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hax"}], ",", 
     RowBox[{"LineBroadening", "->", "16."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specCosyCross", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigCosy", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specCosyDiag", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{"specCosyCross", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", 
       RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specCosyCross", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<COSY-90, Phase {0, 0}:\\nAbsorptive Cross Peaks, \
Dispersive Diagonal\>\""}], ",", 
       RowBox[{"ImageSize", "->", "320"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specCosyDiag", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<COSY-90, Phase {Pi/2, Pi/2}:\\nAbsorptive Diagonal, \
Dispersive Cross Peaks\>\""}], ",", 
       RowBox[{"ImageSize", "->", "320"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "700"}], ",", 
   RowBox[{"Spacings", "->", "16"}]}], "]"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"bf5da425-1260-2f44-8f76-66f89b4cf840"],

