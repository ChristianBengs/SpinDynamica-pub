        RowBox[{"{", 
         RowBox[{"\"\<F2 (Hz)\>\"", ",", "\"\<Intensity\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Diagonal Slice (F1 = -108 Hz)\>\""}]}],
       "]"}], ",", 
