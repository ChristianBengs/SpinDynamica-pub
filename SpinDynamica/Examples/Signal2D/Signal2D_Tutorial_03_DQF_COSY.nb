Cell["\<\
Why PhaseCorrection -> {Pi/2, Pi/2}? With all three pulses along x and \
QuadratureMethod -> \"States\", the extra 90-degree pulse through the p = \
+/-2 pathway introduces a Pi/2 phase shift in both dimensions relative to \
COSY-90. Applying PhaseCorrection -> {Pi/2, Pi/2} puts BOTH the diagonal \
peaks and the cross peaks into pure 2D anti-phase absorption in the \"RR\" \
component, completely removing the dispersive diagonal tails.

We can confirm this lineshape improvement directly by taking 1D F2 slices via \
ExtractSlice through one multiplet row of the diagonal peak (F1 = -108 Hz) \
and one row of the cross peak (F1 = +192 Hz).\
\>", "Text",ExpressionUUID->"739a7f80-4d0d-ad4d-acfb-e434770b1ecd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sliceDiagCosy", "=", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"specCosyCross", ",", "\"\<F2\>\"", ",", 
     RowBox[{"-", "108."}], ",", 
     RowBox[{"Component", "->", "\"\<RR\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sliceDiagDQF", "=", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"specDQF", ",", "\"\<F2\>\"", ",", 
     RowBox[{"-", "108."}], ",", 
     RowBox[{"Component", "->", "\"\<RR\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sliceCrossCosy", "=", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"specCosyCross", ",", "\"\<F2\>\"", ",", "192.", ",", 
     RowBox[{"Component", "->", "\"\<RR\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sliceCrossDQF", "=", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"specDQF", ",", "\"\<F2\>\"", ",", "192.", ",", 
     RowBox[{"Component", "->", "\"\<RR\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sliceDiagCosy", ",", "sliceDiagDQF"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
