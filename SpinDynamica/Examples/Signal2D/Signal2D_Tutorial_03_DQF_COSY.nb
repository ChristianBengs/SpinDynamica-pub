Cell[CellGroupData[{

Cell["6. Active vs. Passive Couplings in a 3-Spin AMX System", "Section",ExpressionUUID->"558c6299-8209-5849-9765-f7b6fa5bfc2c"],

Cell["\<\
Because DQF-COSY yields clean pure-absorption multiplets everywhere, it is \
the classic tool for measuring scalar coupling constants directly from \
cross-peak fine structure in multi-spin systems. Consider a linear three-spin \
AMX chain on the current three-spin-1/2 system:
  - nu_A = -200 Hz, nu_M = +20 Hz, nu_X = +210 Hz
  - J_AM = 36 Hz, J_MX = 16 Hz, J_AX = 0 Hz

In a cross peak between spins A and M:
  - J_AM is the ACTIVE coupling (responsible for coherence transfer between A \
and M): it produces an ANTI-PHASE splitting (opposite signs across the 36 Hz \
doublet in both F1 and F2).
  - J_MX is a PASSIVE coupling to the spectator spin X on M: it does not \
transfer coherence here, so along F2 (the M spin dimension) each anti-phase \
component is split IN-PHASE (same sign) by 16 Hz.\
\>", "Text",ExpressionUUID->"3d045d12-e7ea-6e47-a395-6ecc31e9317f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hamx", "=", 
   RowBox[{"2.", "*", "Pi", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "200."}], "*", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"20.", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"210.", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"36.", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], ")"}]}], "+", 
      RowBox[{"16.", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sigAMX", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "900."}], ",", "96"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "900."}], ",", "192"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", "dqfMix"}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hamx"}], ",", 
     RowBox[{"LineBroadening", "->", "10."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specAMX", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigAMX", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "2"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specAMX", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "300"}], ",", "300"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "300"}], ",", "300"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"BaseContourLevel", "->", "0.05"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<3-Spin AMX DQF-COSY (Full)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "320"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specAMX", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "40"}], ",", "80"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "260"}], ",", 
            RowBox[{"-", "140"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"BaseContourLevel", "->", "0.06"}], ",", 
       RowBox[{
       "PlotLabel", 
        "->", "\"\<Zoom: A-M Cross Peak (F2 = +20, F1 = -200)\\nActive J_AM = \
36 Hz (anti-phase)\\nPassive J_MX = 16 Hz along F2 (in-phase)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "320"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "700"}], ",", 
   RowBox[{"Spacings", "->", "16"}]}], "]"}]}], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"29e78348-5ce4-1d4a-927b-bc60193fe453"],

