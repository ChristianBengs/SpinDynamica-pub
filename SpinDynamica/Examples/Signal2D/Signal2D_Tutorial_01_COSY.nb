Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sliceF2", "=", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"specCosy", ",", "\"\<F2\>\"", ",", 
     RowBox[{"-", "120."}], ",", 
     RowBox[{"PositionType", "->", "\"\<Frequency\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"projF1", "=", 
   RowBox[{"ProjectSpectrum2D", "[", 
    RowBox[{"specCosy", ",", "\"\<F1\>\"", ",", 
     RowBox[{"Method", "->", "\"\<Skyline\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"sliceF2", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", "All"}], "}"}]}], 
       ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<F2 (Hz)\>\"", ",", "\"\<Intensity\>\""}], "}"}]}], ",", 
       
       RowBox[{"PlotLabel", "->", "\"\<F2 Slice at F1 = -120 Hz\>\""}], ",", 
       RowBox[{"ImageSize", "->", "340"}]}], "]"}], ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"projF1", ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", "All"}], "}"}]}], 
       ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<F1 (Hz)\>\"", ",", "\"\<Intensity\>\""}], "}"}]}], ",", 
       
       RowBox[{"PlotLabel", "->", "\"\<F1 Skyline Projection\>\""}], ",", 
       RowBox[{"ImageSize", "->", "340"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", "15"}]}], "]"}]}], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"6b5af1fb-4189-e940-af0d-46081f574917"],

