Cell["\<\
What to observe: \"PhaseModulated\" defaults to plotting \"Magnitude\" \
(positive contours only) because its real part has phase-twist lineshapes, \
whereas all five phase-sensitive methods display crisp signed absorption \
cross peaks. \"States\", \"StatesTPPI\", \"EchoAntiEcho\", \"TPPI\" (in \
default \"RetainedHalf\" mode), and \"OversampledStates\" (in default \
\"Logical\" bandwidth mode) agree closely here; differences between \
\"PhaseModulated\" and the others reflect phase-twist acquisition, while \
differences in TPPI come from its real-only F1 projection as explored further \
in Section 9.\
\>", "Text",ExpressionUUID->"9848b35a-f97b-5e41-b8c2-e874644e278f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Fourier Transformation and Processing (FT)", "Section",ExpressionUUID->"bd655fd9-664d-e945-b6a6-c192d97ad64b"],

Cell["\<\
It is important to distinguish acquisition parameters (N1, N2, spectral \
widths, QuadratureMethod, pulse sequences) from processing parameters \
(zero-filling, apodization, first-point scaling, phase correction). By \
generating one unbroadened time-domain signal once, you can rapidly explore \
many processing choices without repeating the spin-dynamics calculation.

Pair-valued processing options in SpinDynamica follow {direct, indirect} = \
{F2, F1} ordering, matching Signals`Signal`.\
\>", "Text",ExpressionUUID->"7171197d-ad6d-0a47-b548-b7898751971c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sigRaw", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hcosy"}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"df4a0387-bab3-7043-a4db-54314ab6fb4c"],

Cell[CellGroupData[{

Cell["5.1 Zero-Filling in F2 and F1", "Subsection",ExpressionUUID->"07fe628b-92ac-5f4b-95e4-1a9caca38a8a"],

Cell["\<\
ZeroFill -> {zf2, zf1} pads the direct and indirect time axes before FFT, \
interpolating the frequency grid without adding simulation cost.\
\>", "Text",ExpressionUUID->"6610dfd7-182f-824f-bd03-2098a29a3f21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spZF11", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spZF22", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spZF24", "=", 
