Cell[CellGroupData[{

Cell["7. Spectrum Manipulation and Plotting", "Section",ExpressionUUID->"ea7facff-0990-0b4c-b75b-a6bbf7c48782"],

Cell["\<\
It is helpful to separate display-only operations (which change only how \
PlotSpectrum2D renders the figure) from data-modifying operations (which \
return a new Spectrum2D with altered spectral arrays).\
\>", "Text",ExpressionUUID->"12832571-1a61-ed42-b497-e3585f6f3235"],

Cell[CellGroupData[{

Cell["7.1 Display-Only Plotting, Slices, and Projections", "Subsection",ExpressionUUID->"2b5f7a5d-8192-0e4c-bb94-c9172a910aaa"],

Cell["\<\
PlotSpectrum2D supports styling and viewing options such as Component, \
Contours, BaseContourLevel, ContourFactor, PositiveColor, NegativeColor, \
PlotRange, ReverseAxes -> {revF2, revF1} (standard NMR convention is \
high-to-low ppm/Hz), AxisUnits -> \"Hz\" | \"rad/s\", and ShowProjections -> \
True (note: ShowProjections aligns the top/side skyline projections to the \
full frequency span, so use PlotRange -> All when enabling ShowProjections). \
ExtractSlice and ProjectSpectrum2D pull 1D cross-sections and projections \
directly from Spectrum2D.\
\>", "Text",ExpressionUUID->"c41bab87-b2fa-ca49-92ea-8a82fd8c97c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotSpectrum2D", "[", 
  RowBox[{"spZF11", ",", 
   RowBox[{"ReverseAxes", "->", 
    RowBox[{"{", 
     RowBox[{"True", ",", "True"}], "}"}]}], ",", 
   RowBox[{"AxisUnits", "->", "\"\<rad/s\>\""}], ",", 
   RowBox[{"Contours", "->", "6"}], ",", 
   RowBox[{"BaseContourLevel", "->", "0.08"}], ",", 
   RowBox[{"ContourFactor", "->", "1.35"}], ",", 
   RowBox[{"PositiveColor", "->", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.05", ",", "0.45", ",", "0.25"}], "]"}]}], ",", 
   RowBox[{"NegativeColor", "->", 
    RowBox[{"RGBColor", "[", 
     RowBox[{"0.75", ",", "0.25", ",", "0.05"}], "]"}]}], ",", 
   RowBox[{"ShowProjections", "->", "True"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"de3d246e-e42a-7745-8c8d-e96a6ab0df41"],

