    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
