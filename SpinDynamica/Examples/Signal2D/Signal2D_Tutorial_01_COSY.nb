Cell[CellGroupData[{

Cell["8. Full vs Compact Spectral Storage (StorageMode)", "Section",ExpressionUUID->"47443534-a84c-7b4e-9b22-5905b7735f77"],

Cell["\<\
By default, FT uses StorageMode -> \"Hypercomplex\" (or Automatic), retaining \
both U and V so all four components (RR, IR, RI, II) remain accessible and F2 \
phase correction can still be adjusted interactively. Passing StorageMode -> \
\"Compact\" drops V immediately after the F2 Fourier transform (keeping only \
U = S_RR + i1 S_IR in Representation -> \"ReducedComplex\").\
\>", "Text",ExpressionUUID->"0c9f7649-28bd-c74e-8068-cb6baaa48355"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specFull", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigCosy", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"StorageMode", "->", "\"\<Hypercomplex\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"specCompact", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigCosy", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"StorageMode", "->", "\"\<Compact\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Full Representation & Components\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"specFull", "[", "\"\<Representation\>\"", "]"}], ",", 
      RowBox[{"Keys", "[", 
       RowBox[{"specFull", "[", "\"\<Components\>\"", "]"}], "]"}]}], "}"}]}],
    ",", 
   RowBox[{"\"\<Compact Representation & Components\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"specCompact", "[", "\"\<Representation\>\"", "]"}], ",", 
      RowBox[{"Keys", "[", 
       RowBox[{"specCompact", "[", "\"\<Components\>\"", "]"}], "]"}]}], 
     "}"}]}], ",", 
   RowBox[{"\"\<Compact HasDirectImaginary\>\"", "->", 
    RowBox[{
     RowBox[{"specCompact", "[", "\"\<QuadratureCapabilities\>\"", "]"}], 
     "[", "\"\<HasDirectImaginary\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Compact F2 Phase Capability\>\"", "->", 
    RowBox[{
     RowBox[{"specCompact", "[", "\"\<QuadratureCapabilities\>\"", "]"}], 
     "[", "\"\<SupportsIndependentF2Phase\>\"", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"2f9363a0-a524-4d4c-8990-73e2e1e2fca7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Full Representation & Components\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Hypercomplex\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"\<\"RR\"\>", ",", "\<\"IR\"\>", ",", "\<\"RI\"\>", 
        ",", "\<\"II\"\>"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Compact Representation & Components\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"ReducedComplex\"\>", ",", 
      RowBox[{"{", 
       RowBox[{"\<\"RR\"\>", ",", "\<\"IR\"\>"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Compact HasDirectImaginary\"\>", "\[Rule]", "False"}], ",", 
   RowBox[{"\<\"Compact F2 Phase Capability\"\>", "\[Rule]", "False"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[23]=",ExpressionUUID->"7a3c3b72-c78c-6f49-9ae0-f1f45835d464"]
}, Open  ]],

Cell["\<\
In \"Compact\" storage, F1 phase adjustment still succeeds because U retains \
the F1 imaginary part S_IR, whereas attempting post-FT F2 phasing or F2 \
conjugation emits an informative diagnostic message (Spectrum2D::nof2phase / \
Spectrum2D::nocomp) and returns $Failed. Therefore, select StorageMode -> \
\"Compact\" only after finalizing any direct-dimension phase correction \
inside FT.\
\>", "Text",ExpressionUUID->"f4e5fe73-223d-cc4b-bb71-5ff359f06c1f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specCompactF1OK", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{"specCompact", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.4", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<F1 phase in Compact succeeded?\>\"", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Head", "[", "specCompactF1OK", "]"}], "===", "Spectrum2D"}], 
     ")"}]}], ",", 
   RowBox[{"\"\<F2 phase in Compact (expected $Failed + nof2phase)\>\"", "->", 
    RowBox[{"PhaseSpectrum2D", "[", 
     RowBox[{"specCompact", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.4", ",", "0."}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<F2 conjugation in Compact (expected $Failed + nocomp)\>\"", "->", 
    RowBox[{"ConjugateSpectrum2D", "[", 
     RowBox[{"specCompact", ",", "\"\<F2\>\""}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"86c55e3a-3f20-8047-af80-c77b0488a7da"],

Cell["\<\
Spectrum2D::nof2phase : Cannot apply direct-dimension (F2) phase correction \
to a Spectrum2D with Representation -> ReducedComplex because \
direct-dimension imaginary components (RI, II) are not stored. Use default \
hypercomplex storage or apply F2 phasing inside FT.\
\>", "Message", "MSG",ExpressionUUID->"d5404191-b37b-dc40-8ed1-1e351b10a608"],

Cell["\<\
Spectrum2D::nocomp : Component V is unavailable for Spectrum2D with \
Representation -> ReducedComplex.\
\>", "Message", "MSG",ExpressionUUID->"4e3641e9-a939-fe46-8f0d-f1a83d3ef9b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"F1 phase in Compact succeeded?\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"F2 phase in Compact (expected $Failed + nof2phase)\"\>", "\[Rule]",
     "$Failed"}], ",", 
   RowBox[{"\<\"F2 conjugation in Compact (expected $Failed + nocomp)\"\>", "\[Rule]",
     "$Failed"}]}], "}"}]], "Output",
 CellLabel->"Out[24]=",ExpressionUUID->"647337ce-fa67-ab43-b219-1fd9e95e03c3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. OversampledStates and TPPI", "Section",ExpressionUUID->"3f211a1e-62a7-1a40-88b1-771a7227d17e"],

Cell["\<\
Notice the close connection between OversampledStates and native TPPI:
  - \"OversampledStates\" acquires both \"Cos\" and \"Sin\" channels at 2*N1 \
increments with half the dwell time (dt1/2), giving a doubled F1 spectral \
width of 2*SW1.
  - Processing with IndirectBandwidth -> \"Logical\" (default) crops the \
central (-SW1/2, +SW1/2] window matching standard N1-point spectra, whereas \
IndirectBandwidth -> \"Full\" retains the entire 2*N1 mirror-free bandwidth.
  - Applying ProjectToTPPI[sigOS] computes the algebraic projection P_n = C_n \
Cos[n Pi/2] - S_n Sin[n Pi/2], turning an OversampledStates dataset into a \
real-modulated TPPI SignalData2D dataset without re-running the spin-dynamics \
simulation!\
\>", "Text",ExpressionUUID->"35503ed0-b1fe-654a-a84f-b62a94145652"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigOS", "=", 
   RowBox[{"sigsQ", "[", "\"\<OversampledStates\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigTPPI", "=", 
   RowBox[{"sigsQ", "[", "\"\<TPPI\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specOSLog", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigOS", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"IndirectBandwidth", "->", "\"\<Logical\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"specOSFull", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigOS", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"IndirectBandwidth", "->", "\"\<Full\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigProjTPPI", "=", 
   RowBox[{"ProjectToTPPI", "[", "sigOS", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specProjTPPI", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigProjTPPI", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"TPPIProcessing", "->", "\"\<RetainedHalf\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<OS Logical N1 & SW1 (Hz)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"specOSLog", "[", "\"\<N1\>\"", "]"}], ",", 
      RowBox[{"specOSLog", "[", "\"\<SpectralWidth1Hz\>\"", "]"}]}], "}"}]}], 
   ",", 
   RowBox[{"\"\<OS Full N1 & SW1 (Hz)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"specOSFull", "[", "\"\<N1\>\"", "]"}], ",", 
      RowBox[{"specOSFull", "[", "\"\<SpectralWidth1Hz\>\"", "]"}]}], "}"}]}],
    ",", 
   RowBox[{"\"\<PreservesFullHypercomplex? (Logical vs Full)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"specOSLog", "[", "\"\<QuadratureCapabilities\>\"", "]"}], 
       "[", "\"\<PreservesFullHypercomplexSpectrum\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"specOSFull", "[", "\"\<QuadratureCapabilities\>\"", "]"}], 
       "[", "\"\<PreservesFullHypercomplexSpectrum\>\"", "]"}]}], "}"}]}], ",", 
   RowBox[{"\"\<Max |ProjectToTPPI - native TPPI| (time domain)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigProjTPPI", "[", "\"\<Data\>\"", "]"}], "-", 
       RowBox[{"sigTPPI", "[", "\"\<Data\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |ProjectToTPPI - native TPPI| (RR spectrum)\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"specProjTPPI", "[", "\"\<RR\>\"", "]"}], "-", 
       RowBox[{
        RowBox[{"specsQ", "[", "\"\<TPPI\>\"", "]"}], "[", "\"\<RR\>\"", 
        "]"}]}], "]"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"e87e4ed4-bfe1-8d41-aaad-2dcbeed14f9e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"OS Logical N1 & SW1 (Hz)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"128", ",", "800.`"}], "}"}]}], ",", 
   RowBox[{"\<\"OS Full N1 & SW1 (Hz)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"256", ",", "1600.`"}], "}"}]}], ",", 
   RowBox[{"\<\"PreservesFullHypercomplex? (Logical vs Full)\"\>", "\[Rule]", 
    
    RowBox[{"{", 
     RowBox[{"False", ",", "True"}], "}"}]}], ",", 
   RowBox[{"\<\"Max |ProjectToTPPI - native TPPI| (time domain)\"\>", "\[Rule]",
     "8.66125958484052`*^-15"}], ",", 
   RowBox[{"\<\"Max |ProjectToTPPI - native TPPI| (RR spectrum)\"\>", "\[Rule]",
     "1.2836953722228372`*^-16"}]}], "}"}]], "Output",
 CellLabel->"Out[25]=",ExpressionUUID->"a806d664-9d62-e847-b281-b4f5a0eb1373"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specOSFull", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "450"}], ",", "450"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<OversampledStates (2x SW1)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specProjTPPI", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<ProjectToTPPI\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{
       RowBox[{"specsQ", "[", "\"\<TPPI\>\"", "]"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Native TPPI\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", "10"}]}], "]"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"aa73c54a-40e6-2442-a2b8-a27185ef57d0"],

