Cell["\<\
You can also inspect the phase-independent \"HypercomplexMagnitude\" \
Sqrt[Abs[U]^2 + Abs[V]^2], and apply PhaseSpectrum2D to correct an arbitrary \
F2 + F1 zero- and first-order phase error back to the exact unperturbed \
spectrum.\
\>", "Text",ExpressionUUID->"43c5b07c-c1f8-3844-a79e-494644d58461"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specFixed", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{"spPhaseErr", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.55"}], ",", "0.30"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.45", ",", 
         RowBox[{"-", "0.25"}]}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"\"\<Max |RR_fixed - RR_ref|\>\"", "->", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"specFixed", "[", "\"\<RR\>\"", "]"}], "-", 
      RowBox[{"spZF22", "[", "\"\<RR\>\"", "]"}]}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"18380a2b-3150-5c44-aa26-9ce9e8ab51b7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Max |RR_fixed - RR_ref|\"\>", "\[Rule]", 
   "6.938893903907228`*^-18"}], "}"}]], "Output",
 CellLabel->"Out[18]=",ExpressionUUID->"c236040d-18a3-9b4d-bbc5-63c1f6847870"]
}, Open  ]],

