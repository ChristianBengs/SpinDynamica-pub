Cell[CellGroupData[{

Cell["5.3 First-Point Multiplication and Phase Correction", "Subsection",ExpressionUUID->"3339ad0a-3557-c04d-838f-5622549a29ae"],

Cell["\<\
FirstPointMultiplicationFactor -> {f2, f1} (default 0.5 on both axes from \
Options[FT]) scales the t = 0 point to suppress constant DC baseline offsets \
arising from causal discrete integration. Setting {1.0, 1.0} disables this \
halving and leaves a tiny constant offset. PhaseCorrection accepts phi0, \
{phi0Dir, phi0Ind}, or {{phi0Dir, phi1Dir}, {phi0Ind, phi1Ind}} in radians \
(again {F2, F1} ordering).\
\>", "Text",ExpressionUUID->"51a3cf1c-79f2-564a-b81d-40778888ee11"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spFpmf10", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"FirstPointMultiplicationFactor", "->", 
      RowBox[{"{", 
       RowBox[{"1.0", ",", "1.0"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spFpmf05", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"FirstPointMultiplicationFactor", "->", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", "0.5"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spPhaseErr", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"LineBroadening", "->", "22."}], ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"PhaseCorrection", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.55", ",", 
          RowBox[{"-", "0.30"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.45"}], ",", "0.25"}], "}"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Baseline Offset (FPMF 1.0 vs 0.5)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Mean", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"spFpmf10", "[", "\"\<RR\>\"", "]"}], "]"}], "]"}], ",", 
      RowBox[{"Mean", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"spFpmf05", "[", "\"\<RR\>\"", "]"}], "]"}], "]"}]}], "}"}]}],
    ",", 
   RowBox[{"\"\<F1 Axis Range (Hz)\>\"", "->", 
    RowBox[{"MinMax", "[", 
     RowBox[{"spFpmf05", "[", "\"\<Frequency1\>\"", "]"}], "]"}]}], ",", 
   RowBox[{"\"\<F2 Axis Range (rad/s)\>\"", "->", 
    RowBox[{"MinMax", "[", 
     RowBox[{"spFpmf05", "[", "\"\<AngularFrequency2\>\"", "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"27449986-5db2-134a-9709-30dbbd9356ee"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Baseline Offset (FPMF 1.0 vs 0.5)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "7.040961374051372`*^-21"}], ",", 
      RowBox[{"-", "8.046812998915853`*^-21"}]}], "}"}]}], ",", 
   RowBox[{"\<\"F1 Axis Range (Hz)\"\>", "\[Rule]", 
