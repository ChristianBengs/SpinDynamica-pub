Cell[CellGroupData[{

Cell["5.2 Apodization and Time-Domain Line Broadening", "Subsection",ExpressionUUID->"8bae0727-1cba-9741-8715-bb6ca0dd4d60"],

Cell["\<\
Apodization shapes the FID before FFT to balance resolution and truncation \
artifacts. Supported windows include numeric exponential Lorentzian \
broadening, {\"Lorentzian\", lb}, {\"Gaussian\", fwhh}, {\"Gaussian\", lb, \
gb}, \"SineBell\", {\"SineBell\", shift}, \"SquaredSineBell\", and \
{\"SquaredSineBell\", shift}. You can pass Apodization or LineBroadening \
directly to FT, or pre-apply them to SignalData2D using ApplyApodization and \
ApplyLineBroadening.\
\>", "Text",ExpressionUUID->"fcda14a1-3777-9242-b0bd-6c89f300264d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigSinApo", "=", 
   RowBox[{"ApplyApodization", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"Apodization", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SineBell\>\"", ",", 
          RowBox[{"Pi", "/", "4"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<SineBell\>\"", ",", 
          RowBox[{"Pi", "/", "4"}]}], "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spNone", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spLorentz", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"LineBroadening", "->", 
      RowBox[{"{", 
       RowBox[{"22.", ",", "22."}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spGauss", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigRaw", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}], ",", 
     RowBox[{"Apodization", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<Gaussian\>\"", ",", "22."}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Gaussian\>\"", ",", "22."}], "}"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spSine", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigSinApo", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"spNone", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"120", ",", "240"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "180"}], ",", 
            RowBox[{"-", "60"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<No window (truncated)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "220"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"spLorentz", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"120", ",", "240"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "180"}], ",", 
            RowBox[{"-", "60"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Lorentzian 22 Hz\>\""}], ",", 
       RowBox[{"ImageSize", "->", "220"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"spGauss", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"120", ",", "240"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "180"}], ",", 
            RowBox[{"-", "60"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Gaussian 22 Hz\>\""}], ",", 
       RowBox[{"ImageSize", "->", "220"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"spSine", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"120", ",", "240"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "180"}], ",", 
            RowBox[{"-", "60"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<SineBell (Pi/4)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "220"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", "8"}]}], "]"}]}], "Input",
