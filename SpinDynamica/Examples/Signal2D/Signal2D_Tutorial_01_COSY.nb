      RowBox[{"-", "393.75`"}], ",", "400.`"}], "}"}]}], ",", 
   RowBox[{"\<\"F2 Axis Range (rad/s)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "2493.639168786898`"}], ",", "2513.2741228718346`"}], 
     "}"}]}]}], "}"}]], "Output",
