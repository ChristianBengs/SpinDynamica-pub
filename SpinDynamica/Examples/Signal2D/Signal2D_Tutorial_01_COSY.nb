  PlotRange->{{0, 360.}, {0, 348.75}}]], "Input",
 CellChangeTimes->{{4.004637979809332*^9, 
  4.0046379798152084`*^9}},ExpressionUUID->"02fcf61b-e926-5744-aa74-\
b1538b0423e5"],

Cell["\<\
What to observe: Two anti-phase 2x2 cross-peak multiplets appear at (F2 = \
+180 Hz, F1 = -120 Hz) and (F2 = -120 Hz, F1 = +180 Hz) in blue (positive) \
and red (negative), split by J = 24 Hz along both axes. The diagonal peaks \
sit at (-120 Hz, -120 Hz) and (+180 Hz, +180 Hz) with dispersive star-like \
tails, characteristic of a COSY-90 spectrum.\
\>", "Text",ExpressionUUID->"a38d3fcb-cafe-3742-bf71-ca8378f4b2df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Making Important Options Explicit", "Subsection",ExpressionUUID->"e47dfc1c-ee3a-6e42-9f8f-d29fcf02b518"],

Cell["\<\
In real workflows you will often customize individual stages. Below is the \
exact same COSY simulation with every major argument spelled out explicitly: \
initial state, background Hamiltonian, separate Evolution1/Evolution2 \
placeholders (None means use BackgroundGenerator directly), observable, \
NormalizationFactor, and explicit {tmin, tmax, dt} timing vectors. Two \
additional acquisition options worth knowing are Chronology (\"LeftToRight\" \
by default) and ForceEvenNumberOfPoints (False by default; set True to \
truncate odd increment counts cleanly for FFT).\
\>", "Text",ExpressionUUID->"6f9eb139-bb98-ab44-a4e7-4f5ac1dc7f03"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dt", "=", 
   RowBox[{"1.", "/", "800."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigExplicit", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       RowBox[{"63.", "*", "dt"}], ",", "dt"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.", ",", 
       RowBox[{"127.", "*", "dt"}], ",", "dt"}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", "rho0"}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hcosy"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Evolution1", "->", "None"}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
     RowBox[{"Evolution2", "->", "None"}], ",", 
     RowBox[{"Observable", "->", "All"}], ",", 
     RowBox[{"NormalizationFactor", "->", "1"}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"ForceEvenNumberOfPoints", "->", "False"}], ",", 
     RowBox[{"LineBroadening", "->", "22."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"sigExplicit", "[", "\"\<Cos\>\"", "]"}], "-", 
    RowBox[{"sigCosy", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"9bdb9b91-97d4-fe4f-abe1-5a051852093d"],

Cell[BoxData["0.`"], "Output",
 CellChangeTimes->{4.0046191400356445`*^9},
 CellLabel->"Out[16]=",ExpressionUUID->"ab576e15-143d-6d46-95d7-42e92871ceb6"]
}, Open  ]],

Cell["\<\
The maximum numerical difference between the shorthand call and the explicit \
call is zero, confirming the defaults documented above.\
\>", "Text",ExpressionUUID->"ad07807f-4d29-a94f-a8a3-96e8337c7183"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Inspecting the Time-Domain SignalData2D Object", "Section",ExpressionUUID->"577c638e-e66a-6b4f-ae8c-d3be3e227839"],

Cell["\<\
Signal2D returns a SignalData2D object that bundles the acquired quadrature \
channel matrices together with exact time axes and acquisition metadata. \
Using string property lookups avoids printing large numerical arrays.\
\>", "Text",ExpressionUUID->"9562bdd5-39c4-de46-91fb-c6dea3e83f02"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<Keys\>\"", "->", 
     RowBox[{"sigCosy", "[", "\"\<Keys\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Dimensions\>\"", "->", 
     RowBox[{"sigCosy", "[", "\"\<Dimensions\>\"", "]"}]}], ",", 
    RowBox[{"\"\<QuadratureMethod\>\"", "->", 
     RowBox[{"sigCosy", "[", "\"\<QuadratureMethod\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Timing1\>\"", "->", 
     RowBox[{"sigCosy", "[", "\"\<Timing1\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Timing2\>\"", "->", 
     RowBox[{"sigCosy", "[", "\"\<Timing2\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Channels\>\"", "->", 
     RowBox[{"Keys", "[", 
      RowBox[{"sigCosy", "[", "\"\<Data\>\"", "]"}], "]"}]}], ",", 
    RowBox[{"\"\<Method\>\"", "->", 
     RowBox[{
      RowBox[{"sigCosy", "[", "\"\<Metadata\>\"", "]"}], "[", "\"\<Method\>\"",
       "]"}]}], ",", 
    RowBox[{"\"\<Space\>\"", "->", 
     RowBox[{
      RowBox[{"sigCosy", "[", "\"\<Metadata\>\"", "]"}], "[", "\"\<Space\>\"",
       "]"}]}]}], "}"}], "//", "Dataset"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"168b36a9-8c43-3443-8ebb-5bcdf2a23be2"],

