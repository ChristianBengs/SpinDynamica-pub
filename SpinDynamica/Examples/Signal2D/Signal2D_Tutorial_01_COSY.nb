Cell[CellGroupData[{

Cell["1. Defining a Simple Two-Spin System", "Section",ExpressionUUID->"c32758c2-6aa5-5944-9b10-af260e75d77c"],

Cell["\<\
Every 2D NMR simulation in SpinDynamica begins with the spin system, its \
static Hamiltonian (the generator of free evolution), and an initial density \
operator. Here we define a weakly coupled homonuclear two-spin-1/2 AX system \
with two distinct, opposite-sign chemical shifts (-120 Hz and +180 Hz) and a \
scalar coupling J = 24 Hz so that F1 frequency discrimination, diagonal \
peaks, and anti-phase COSY cross peaks are immediately clear.\
\>", "Text",ExpressionUUID->"c4d555c5-fc8d-3647-b9d3-289ace10cb26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nu1", "=", 
   RowBox[{"-", "120."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nu2", "=", "180."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"j12", "=", "24."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hcosy", "=", 
   RowBox[{"2.", "*", "Pi", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"nu1", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"nu2", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"j12", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"e1f7b34e-f203-f44e-ba92-d1107cc415b3"],

Cell[BoxData[
 TemplateBox[{
  "SetSpinSystem", "set", 
   "\"the spin system has been set to \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"1\\\", \\\",\\\", \
FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", RowBox[{\\\"2\\\", \\\",\\\", FractionBox[\\\"1\\\", \\\"2\
\\\"]}], \\\"}\\\"}]}], \\\"}\\\"}]\\)\"", 2, 4, 4, 33229236743001292538, 
   "Local", "QM`Hilbert`SetSpinSystem"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.004619063775795*^9, 4.004637197145769*^9},
 CellLabel->
  "During evaluation of \
In[4]:=",ExpressionUUID->"e734c710-df26-8a41-8e0e-fc112d7a3c04"],

Cell[BoxData[
 TemplateBox[{
  "SetBasis", "set", 
   "\"the state basis has been set to \\!\\(\\*RowBox[{\\\"ZeemanBasis\\\", \
\\\"[\\\", RowBox[{RowBox[{\\\"{\\\", RowBox[{RowBox[{\\\"{\\\", \
RowBox[{\\\"1\\\", \\\",\\\", FractionBox[\\\"1\\\", \\\"2\\\"]}], \
\\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{\\\"2\\\", \\\",\\\", \
FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"BasisLabels\\\", \\\"\[Rule]\\\", \\\"Automatic\\\"}]}], \
\\\"]\\\"}]\\).\"", 2, 4, 5, 33229236743001292538, "Local", 
   "QM`Hilbert`SetBasis"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.004619063775795*^9, 4.0046371971512775`*^9},
 CellLabel->
  "During evaluation of \
In[4]:=",ExpressionUUID->"7ff106be-61b3-3f42-94c4-fc6fb996ae07"]
}, Open  ]],

Cell["\<\
Notice that all frequencies in Hcosy are expressed in rad s^-1 (2 Pi times \
Hz), matching SpinDynamica's standard angular-frequency convention. \
Throughout this notebook we retain this same AX spin system and Hamiltonian \
so each section isolates only the new options being introduced.\
\>", "Text",ExpressionUUID->"83e20025-ab47-0740-a6af-7b135b36fa28"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Your First Signal2D Simulation (COSY)", "Section",ExpressionUUID->"d0afd0eb-c5e7-9d41-879c-e19dd68c8798"],

Cell["\<\
A conventional 2D experiment has four sequential stages: (1) Preparation, (2) \
Indirect evolution during t1, (3) Mixing, and (4) Direct evolution and \
detection during t2. In Signal2D, these map directly onto the Preparation, \
Evolution1, Mixing, and Evolution2 (or shared BackgroundGenerator) options, \
while the two positional arguments specify the t1 and t2 timing grids.\
\>", "Text",ExpressionUUID->"5dfb7c0b-cae5-034f-9faa-8a8cb18116e8"],

Cell[CellGroupData[{

Cell["2.1 Shortest Meaningful Call and First 2D Spectrum", "Subsection",ExpressionUUID->"b3cd437c-a37a-d14f-81f2-56aab5b007c2"],

Cell["\<\
We start with the shortest practical COSY call, relying on defaults wherever \
appropriate: QuadratureMethod -> \"States\", InitialDensityOperator -> \
opI[\"z\"], Observable -> All, Chronology -> \"LeftToRight\", and \
BackgroundGenerator shared across all four stages. The compact timing \
shorthand {{{swRad, nPoints}}} specifies an 800 Hz spectral width in both \
dimensions (64 indirect t1 increments by 128 direct t2 points).\
\>", "Text",ExpressionUUID->"5b32408f-8f39-c44d-a374-c1adda1766be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sigCosy", "=", 
  RowBox[{"Signal2D", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "Pi", "800."}], ",", "64"}], "}"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "Pi", "800."}], ",", "128"}], "}"}], "}"}]}], "}"}], ",", 
    RowBox[{"Preparation", "->", 
     RowBox[{"Pulse", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
    RowBox[{"Mixing", "->", 
     RowBox[{"Pulse", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], ",", 
    RowBox[{"BackgroundGenerator", "->", "Hcosy"}], ",", 
    RowBox[{"LineBroadening", "->", "22."}]}], "]"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"f08d15e2-d308-a442-a146-5ad0ef3ab585"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"SignalData2D", "["}], "\<\"64 x 128\"\>", 
   RowBox[{",", " ", 
    RowBox[{"Quadrature", " ", "->", " "}]}], "\<\"States\"\>", 
   RowBox[{",", " ", 
    RowBox[{"Method", " ", "->", " "}]}], 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[LeftAssociation]", 
      RowBox[{
       RowBox[{"\<\"Space\"\>", "\[Rule]", "\<\"Hilbert\"\>"}], ",", 
       RowBox[{"\<\"Method\"\>", "\[Rule]", "\<\"DoubleDiagonalization\"\>"}],
        ",", 
       RowBox[{"\<\"SignalCalculationMethod\"\>", 
        "\[Rule]", "\<\"DoubleDiagonalization\"\>"}], ",", 
       RowBox[{"\<\"Chronology\"\>", "\[Rule]", "\<\"LeftToRight\"\>"}], ",", 
       RowBox[{"\<\"QuadratureOrder\"\>", "\[Rule]", "1"}], ",", 
       RowBox[{"\<\"QuadratureSpins\"\>", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\<\"NormalizationFactor\"\>", "\[Rule]", "1.`"}], ",", 
       RowBox[{"\<\"InitialTimePoint\"\>", "\[Rule]", "0.`"}], ",", 
       RowBox[{"\<\"Period\"\>", "\[Rule]", "None"}], ",", 
       RowBox[{"\<\"CarouselAverage\"\>", "\[Rule]", "False"}], ",", 
       RowBox[{"\<\"OversamplingFactor1\"\>", "\[Rule]", "1"}], ",", 
       RowBox[{"\<\"AutomaticQuadratureEncoding\"\>", "\[Rule]", "True"}], ",", 
       RowBox[{"\<\"ChannelDependentPreparation\"\>", "\[Rule]", "False"}], ",", 
       RowBox[{"\<\"ChannelDependentMixing\"\>", "\[Rule]", "False"}], ",", 
       RowBox[{"\<\"HeteronuclearDetected\"\>", "\[Rule]", "False"}], ",", 
       RowBox[{"\<\"ChannelNorms\"\>", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{
          RowBox[{"\<\"Cos\"\>", "\[Rule]", "11.607760875150472`"}], ",", 
          RowBox[{"\<\"Sin\"\>", "\[Rule]", "11.76782962999933`"}]}], 
         "\[RightAssociation]"}]}], ",", 
       RowBox[{"\<\"PreparationPhaseShifts\"\>", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{
          RowBox[{"\<\"Cos\"\>", "\[Rule]", 
           RowBox[{"{", "0.`", "}"}]}], ",", 
          RowBox[{"\<\"Sin\"\>", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"-", "1.5707963267948966`"}], "}"}]}]}], 
         "\[RightAssociation]"}]}], ",", 
       RowBox[{"\<\"ReceiverPhaseShifts\"\>", "\[Rule]", 
        RowBox[{"\[LeftAssociation]", 
         RowBox[{
          RowBox[{"\<\"Cos\"\>", "\[Rule]", 
           RowBox[{"{", "0.`", "}"}]}], ",", 
          RowBox[{"\<\"Sin\"\>", "\[Rule]", 
           RowBox[{"{", "0.`", "}"}]}]}], "\[RightAssociation]"}]}], ",", 
       RowBox[{"\<\"DiagnosticWarnings\"\>", "\[Rule]", 
        RowBox[{"{", "}"}]}]}], "\[RightAssociation]"}], 
     ",", "\<\"DoubleDiagonalization\"\>"}], "}"}], "]"}],
  DisplayForm]], "Output",
 CellChangeTimes->{4.0046190683132896`*^9, 4.0046372019284744`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"348d882f-21ed-d943-9927-32924f5ffef0"]
}, Open  ]],

Cell["\<\
Let us immediately Fourier-transform sigCosy with FT and plot its real \
absorptive component using PlotSpectrum2D.\
\>", "Text",ExpressionUUID->"fe24b9b2-fe69-c548-aea4-a18064969dea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"specCosy", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigCosy", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"PlotSpectrum2D", "[", 
  RowBox[{"specCosy", ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "360"}]}], "]"}]}], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"7fdd73aa-5823-3742-af48-623f27af2746"],

