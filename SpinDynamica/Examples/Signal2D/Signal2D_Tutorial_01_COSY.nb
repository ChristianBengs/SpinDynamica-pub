Notebook[{

Cell[CellGroupData[{
Cell["\<\
SpinDynamica Tutorial 01: Introduction to 2D NMR Simulation Using COSY\
\>", "Title",ExpressionUUID->"e177b58b-4d54-7948-ae50-af70e276232b"],

Cell["\<\
Simulating, inspecting, processing, phasing, and visualizing homonuclear \
liquid-state 2D NMR spectra with Signal2D and Spectrum2D.\
\>", "Subtitle",ExpressionUUID->"bd1c4db5-fc4d-254f-a933-5f9c396627a3"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"1e8a9395-55f3-8846-8f86-583774183cde"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that the public 2D simulation and \
processing packages are available.\
\>", "Text",ExpressionUUID->"52091de9-0543-274f-b05b-d0ee16bff1b7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"3dab8fe9-1ba2-9d40-886e-bbb7f222155f"],

