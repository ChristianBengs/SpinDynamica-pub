Cell["\<\
Each channel matrix (here \"Cos\" and \"Sin\") has dimensions {N1, N2} = {64, \
128}: row index k1 runs over the indirect t1 increments (sigCosy[\"Time1\"]) \
and column index k2 runs over direct acquisition time t2 \
(sigCosy[\"Time2\"]). Below we extract and plot a direct FID (row 5, t1 = 5 \
ms, since at t1 = 0 the two 90-degree x pulses cancel to zero) and an \
indirect interferogram trace (column 5, t2 = 5 ms, where J-evolution has \
built up strong observable coherence).\
\>", "Text",ExpressionUUID->"afdbb7e1-1b31-984c-96b1-df60d0d7d6db"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"t1", "=", 
   RowBox[{"sigCosy", "[", "\"\<Time1\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2", "=", 
   RowBox[{"sigCosy", "[", "\"\<Time2\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fidDirect", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"sigCosy", "[", "\"\<Cos\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"5", ",", "All"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"traceIndCos", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"sigCosy", "[", "\"\<Cos\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"traceIndSin", "=", 
   RowBox[{"Re", "[", 
    RowBox[{
     RowBox[{"sigCosy", "[", "\"\<Sin\>\"", "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "5"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"t2", ",", "fidDirect"}], "}"}], "]"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t2 (s)\>\"", ",", "\"\<Re[s_Cos(t1, t2)]\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Direct FID (row 5, t1 = 5 ms)\>\""}]}],
       "]"}], ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"t1", ",", "traceIndCos"}], "}"}], "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"t1", ",", "traceIndSin"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t1 (s)\>\"", ",", "\"\<Re[s(t1, t2)]\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Cos\>\"", ",", "\"\<Sin\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0.85", ",", "0.85"}], "}"}]}], "]"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Indirect Trace (col 5, t2 = 5 ms)\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "20"}]}], "]"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"fc4cf6e9-01cc-eb47-91ef-79e2885e2c80"],

