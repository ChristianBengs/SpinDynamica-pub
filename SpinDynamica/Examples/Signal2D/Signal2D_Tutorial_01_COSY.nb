Cell[CellGroupData[{

Cell["\<\
7.2 Data-Modifying Operations: Reflection, Conjugation, and Combination\
\>", "Subsection",ExpressionUUID->"5d752182-3ffb-3c45-a3a7-201002024b3c"],

Cell["\<\
ReflectSpectrum[spec, Axis -> \"F1\" | \"F2\"] reverses the spectral grid \
along F1 or F2, ConjugateSpectrum2D[spec, \"F1\" | \"F2\"] conjugates along \
i1 (U -> U*, V -> V*) or i2 (V -> -V), and spectra can be scaled by numbers \
or combined via CombineData (for complementary P/N-type spectra acquired \
separately, CombineComplementarySpectra automates reflection and \
recombination).\
\>", "Text",ExpressionUUID->"df34981b-9a1c-bd47-bb9c-9f9fec22db87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specRefF1", "=", 
   RowBox[{"ReflectSpectrum", "[", 
    RowBox[{"specCosy", ",", 
     RowBox[{"Axis", "->", "\"\<F1\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specConjF1", "=", 
   RowBox[{"ConjugateSpectrum2D", "[", 
    RowBox[{"specCosy", ",", "\"\<F1\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specConjF2", "=", 
   RowBox[{"ConjugateSpectrum2D", "[", 
    RowBox[{"specCosy", ",", "\"\<F2\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specSym", "=", 
   RowBox[{"CombineData", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"0.5", "*", "specCosy"}], ",", 
      RowBox[{"0.5", "*", "specRefF1"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specRefF1", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<ReflectSpectrum[Axis -> F1]\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specConjF1", ",", 
       RowBox[{"Component", "->", "\"\<IR\>\""}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<ConjugateSpectrum2D[F1] (IR)\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}], ",", 
     RowBox[{"PlotSpectrum2D", "[", 
      RowBox[{"specSym", ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "280"}], ",", "280"}], "}"}]}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Combined Original + F1-Reflected\>\""}], ",", 
       RowBox[{"ImageSize", "->", "240"}]}], "]"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", "10"}]}], "]"}]}], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"15ee17ce-1572-354e-b42d-a34534e44f63"],

