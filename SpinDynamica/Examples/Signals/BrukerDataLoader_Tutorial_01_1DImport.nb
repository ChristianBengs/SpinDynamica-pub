Cell[CellGroupData[{

Cell["\<\
2. Inspecting BrukerSpectrum Properties and JCAMP-DX Parameters\
\>", "Section",ExpressionUUID->"4699c0e2-f779-8347-a23a-417a6902e612"],

Cell["\<\
BrukerSpectrum behaves like an Association for scalar properties, calibrated \
axes, spectral arrays, and parsed TopSpin parameter files. Querying \
\"Properties\" lists every supported key, and \"Metadata\" returns all \
metadata without dumping large 1D arrays.\
\>", "Text",ExpressionUUID->"7dd2bb86-7980-df4f-8878-89fc28a83ddc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<PropertyCount\>\"", "->", 
    RowBox[{"Length", "[", 
     RowBox[{"spec", "[", "\"\<Properties\>\"", "]"}], "]"}]}], ",", 
   RowBox[{"\"\<SampleProperties\>\"", "->", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"spec", "[", "\"\<Properties\>\"", "]"}], ",", "14"}], 
     "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"0d1c89cb-6f7a-964b-951e-4c2a7935831e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"PropertyCount\"\>", "\[Rule]", "41"}], ",", 
   RowBox[{"\<\"SampleProperties\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"AcquisitionParameters\"\>", ",", "\<\"AngularFrequency\"\>",
       ",", "\<\"AppliedScaleFactor\"\>", ",", "\<\"BrukerScaleFactor\"\>", 
      ",", "\<\"ByteOrder\"\>", ",", "\<\"BYTORDP\"\>", 
      ",", "\<\"ChemicalShift\"\>", ",", "\<\"Complex\"\>", 
      ",", "\<\"DataType\"\>", ",", "\<\"DTYPP\"\>", 
      ",", "\<\"ExperimentDirectory\"\>", ",", "\<\"Frequency\"\>", 
      ",", "\<\"HasImaginary\"\>", ",", "\<\"Hz\"\>"}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"5274ac04-ab53-b54c-a537-5d9624990e15"]
}, Open  ]],

