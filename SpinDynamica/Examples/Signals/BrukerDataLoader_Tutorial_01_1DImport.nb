Notebook[{

Cell[CellGroupData[{
Cell["\<\
SpinDynamica Bruker Data Loader Tutorial 01: Importing and Working with 1D \
Spectra\
\>", "Title",ExpressionUUID->"58957faf-8476-b140-a4c1-2c8a0dc966d2"],

Cell["\<\
Loading TopSpin 1D datasets (1r/1i, procs/acqus), intensity scaling, NMR \
plotting conventions, phasing and combining spectra, and converting to \
time-domain Signal objects.\
\>", "Subtitle",ExpressionUUID->"c19b1974-e126-474b-8fbd-517686563253"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"a55b7930-f232-0049-a693-cd8aaafc4e04"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that Signals`Bruker` loaded cleanly \
and sets sampleDir to the bundled TopSpin 1D dataset.\
\>", "Text",ExpressionUUID->"3b78aaa9-7500-aa41-9f58-57c34e9f92d4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"a7e5e51b-2ec4-ea4d-8691-a321f1c775b6"],

Cell["\<\
SetUserLevel::ini : The user level is being initialized to 2. The user level \
may be set to an integer between 1 and 3 by using SetUserLevel[level]. Low \
user levels provide strong syntax trapping at the expense of slow execution \
for some routines. High user levels relax the syntax trapping in order to \
provide better execution speeds.\
\>", "Message", "MSG",ExpressionUUID->"24ef0d62-dbda-c140-829e-784416d29872"],

Cell["SetUserLevel::ul : The user level has been set to 2.", "Message", "MSG",ExpressionUUID->"05bda574-1897-fb4f-81cc-7339c458acfc"],

Cell["\<\
SetUserLevel::modsymbs : Additional definitions have been given to the \
following symbols: {Commutator, Duration, Exp, Expand, Plus, Power, Simplify, \
SolidAngle, Times, WignerD}\
\>", "Message", "MSG",ExpressionUUID->"041ad4a4-825a-f848-8ac8-373a5b6fe225"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sampleDir", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{"nbRepoRoot", ",", "\"\<sample_data\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MemberQ", "[", 
    RowBox[{"$Packages", ",", "\"\<Signals`Bruker`\>\""}], "]"}], ",", 
   RowBox[{"Context", "[", "ImportBrukerSpectrum", "]"}], ",", 
   RowBox[{"DirectoryQ", "[", "sampleDir", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"6d8916e0-1716-6d44-a159-28441454487b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "\<\"Signals`Bruker`\"\>", ",", "True"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]=",ExpressionUUID->"83a78b2f-6f86-8e47-9fea-73ef2763a58a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Your First Bruker Import and Spectrum Plot", "Section",ExpressionUUID->"8cd92942-91fa-4549-b701-aa85d63df876"],

Cell["\<\
ImportBrukerSpectrum reads processed TopSpin 1D datasets automatically from \
an experiment root directory, a pdata directory, a processed directory (such \
as pdata/1), or directly from a 1r binary file. You can also select a \
specific processing number with ProcessingNumber -> n.\
\>", "Text",ExpressionUUID->"3cfea198-8297-744a-90f1-ff879565b480"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"spec", "=", 
  RowBox[{"ImportBrukerSpectrum", "[", "sampleDir", "]"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"028a2f4e-3d05-994e-a189-61aaff6602f1"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"BrukerSpectrum", "["}], "\<\"1H, \"\>", "131072", 
   RowBox[{" ", 
    RowBox[{"pts", ",", " ", 
     RowBox[{"SF", "="}]}]}], 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"299.83\"\>",
      ShowStringCharacters->False],
     299.832697169922,
     AutoDelete->True],
    NumberForm[#, {6, 2}]& ], 
   RowBox[{" ", 
    RowBox[{"MHz", ",", " "}]}], 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"8.338\"\>",
      ShowStringCharacters->False],
     8.337983,
     AutoDelete->True],
    NumberForm[#, 4]& ], "..", 
   TagBox[
    InterpretationBox[
     StyleBox["\<\"-8.338\"\>",
      ShowStringCharacters->False],
     -8.337983454607135,
     AutoDelete->True],
    NumberForm[#, 4]& ], 
   RowBox[{" ", "ppm"}], 
   RowBox[{",", " ", "complex"}], "]"}],
  DisplayForm]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"1e0b2945-0f83-0747-b513-91ea7204a90e"]
}, Open  ]],

Cell["All four path styles yield identical spectral data:", "Text",ExpressionUUID->"b21a2887-13d2-e947-bc85-c450f127bac0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specPdata", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"sampleDir", ",", "\"\<pdata\>\""}], "}"}], "]"}], ",", 
     RowBox[{"ProcessingNumber", "->", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spec1r", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "sampleDir", ",", "\"\<pdata\>\"", ",", "\"\<1\>\"", 
       ",", "\"\<1r\>\""}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Max |expDir - pdata|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], "-", 
       RowBox[{"specPdata", "[", "\"\<Real\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |expDir - 1r|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], "-", 
       RowBox[{"spec1r", "[", "\"\<Real\>\"", "]"}]}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"cdb6afd1-495c-4c41-a7e0-92e26da38a35"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Max |expDir - pdata|\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"Max |expDir - 1r|\"\>", "\[Rule]", "0.`"}]}], "}"}]], "Output",\

 CellLabel->"Out[4]=",ExpressionUUID->"5346e18c-62c6-2942-83b0-2d7db414c80a"]
}, Open  ]],

Cell["\<\
Let us immediately inspect the full 1H spectrum and a zoom around the \
dominant peak near -1.99 ppm using PlotBrukerSpectrum (passing MaxPlotPoints \
-> 4000 so the 131,072-point full trace plots cleanly and interactively).\
\>", "Text",ExpressionUUID->"71ad4ba0-af6d-3c40-8989-0331b927f7c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotBrukerSpectrum", "[", 
      RowBox[{"spec", ",", 
       RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Full 1H Bruker Spectrum (ppm)\>\""}]}],
       "]"}], ",", 
     RowBox[{"PlotBrukerSpectrum", "[", 
      RowBox[{"spec", ",", 
       RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3.2"}], ",", 
            RowBox[{"-", "0.8"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<Peak Region (-3.2 to -0.8 ppm)\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "25"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"ab898d29-4459-0a45-8404-a5fe2e1c61d0"],

