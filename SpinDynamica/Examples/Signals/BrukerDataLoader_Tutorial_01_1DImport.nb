Cell[CellGroupData[{

Cell["7. Built-in Validation and Diagnostic Messages", "Section",ExpressionUUID->"dad15426-c7f1-a946-adc0-66a0b60cc1a0"],

Cell["\<\
ImportBrukerSpectrum, BrukerSpectrum, and ToSignal validate processing \
directories, property names, and optional imaginary components cleanly. Below \
we intentionally trigger three diagnostic checks: an absent ProcessingNumber \
(ImportBrukerSpectrum::badprocno), an unknown property key \
(BrukerSpectrum::badprop), accessing Im[...] on a real-only import \
(BrukerSpectrum::noimag), and calling ToSignal on a real-only spectrum \
(ToSignal::noimag, which warns and falls back to zero imaginary data).\
\>", "Text",ExpressionUUID->"2e8a7403-d9fc-a84b-b4af-f9005a7a1b9f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Absent ProcessingNumber -> 99\>\"", "->", 
    RowBox[{"ImportBrukerSpectrum", "[", 
     RowBox[{"sampleDir", ",", 
      RowBox[{"ProcessingNumber", "->", "99"}]}], "]"}]}], ",", 
   RowBox[{"\"\<Unknown Property\>\"", "->", 
    RowBox[{"spec", "[", "\"\<NonExistentKey\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Im[specRealOnly]\>\"", "->", 
    RowBox[{"Im", "[", "specRealOnly", "]"}]}], ",", 
   RowBox[{"\"\<Head[ToSignal[specRealOnly]]\>\"", "->", 
    RowBox[{"Head", "[", 
     RowBox[{"ToSignal", "[", "specRealOnly", "]"}], "]"}]}]}], 
  "}"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"107e712a-8a18-8b4f-ac5a-2175b03639b3"],

Cell["\<\
ImportBrukerSpectrum::badprocno : Invalid ProcessingNumber 99; expected \
Automatic, a positive integer, or a directory-name string.\
\>", "Message", "MSG",ExpressionUUID->"c22b931f-9d6a-d846-a9ea-f4e5afc3caef"],

Cell["\<\
BrukerSpectrum::badprop : Unknown BrukerSpectrum property NonExistentKey. Use \
spec[\"Properties\"] to list available keys.\
\>", "Message", "MSG",ExpressionUUID->"0dde1ab0-9a09-c544-9ee1-f79d53a8d49b"],

Cell["\<\
BrukerSpectrum::noimag : This BrukerSpectrum does not contain an imaginary \
component (HasImaginary -> False).\
\>", "Message", "MSG",ExpressionUUID->"00a2cddd-7845-7744-aabe-cae0707fd8ad"],

Cell["\<\
ToSignal::noimag : Converting a BrukerSpectrum to a time-domain Signal uses \
complex data if available; imaginary part is absent, assuming zero imaginary \
spectrum.\
\>", "Message", "MSG",ExpressionUUID->"b9f2b85d-557d-6046-8ca9-ed479c740f7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Absent ProcessingNumber -> 99\"\>", "\[Rule]", "$Failed"}], ",", 
   RowBox[{"\<\"Unknown Property\"\>", "\[Rule]", "$Failed"}], ",", 
   RowBox[{"\<\"Im[specRealOnly]\"\>", "\[Rule]", "$Failed"}], ",", 
   RowBox[{"\<\"Head[ToSignal[specRealOnly]]\"\>", "\[Rule]", "Signal"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[16]=",ExpressionUUID->"53ac97a4-48cd-034f-95d7-f18649c55f06"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Summary and Quick Reference", "Section",ExpressionUUID->"c781d727-91d3-944e-9049-229f4f2e4908"],

Cell["\<\
A typical experimental Bruker 1D workflow in SpinDynamica:
  1. Load the processed dataset directly via ImportBrukerSpectrum[expDir] \
with automatic 2^NC_proc scaling and axis calibration.
  2. Inspect acquisition/processing metadata via spec[\"Metadata\"], \
spec[\"ProcessingParameters\"], or ReadBrukerParameters.
  3. Plot with PlotBrukerSpectrum (or ListPlot) in ppm, Hz, or rad/s, and \
adjust zero-order phase (Exp[I*phi]*spec) or average spectra with \
CombineData.
  4. Convert to a SpinDynamica time-domain Signal using ToSignal[spec] \
whenever further apodization or custom FT processing is desired.\
\>", "Text",ExpressionUUID->"dc8d1675-b6ad-3d42-8f4e-3db3c261efc8"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Symbol / Option\"\>", "\<\"Purpose\"\>", "\<\"Key Notes\"\>"},
    {"\<\"ImportBrukerSpectrum[path, opts]\"\>", "\<\"Load 1D Bruker spectrum\
\"\>", "\<\"Accepts expDir, pdata, pdata/n, or 1r; returns \
BrukerSpectrum\"\>"},
    {"\<\"ProcessingNumber\"\>", "\<\"Select pdata subdirectory\"\>", \
"\<\"Automatic picks 1 or smallest integer; or integer/string\"\>"},
    {"\<\"IntensityScaling\"\>", "\<\"Scale stored integer intensities\"\>", \
"\<\"\\\"Bruker\\\" (2^NC_proc), \\\"Raw\\\", \\\"Normalized\\\", or \
numeric\"\>"},
    {"\<\"ReadImaginary / IncludeRawData\"\>", "\<\"Control 1i & unscaled \
array loading\"\>", "\<\"ReadImaginary -> Automatic | True | False; \
IncludeRawData -> True | False\"\>"},
    {"\<\"ReadAcquisitionParameters\"\>", "\<\"Parse acqus metadata\"\>", "\<\
\"True (default) or False\"\>"},
    {"\<\"ReturnFormat / AxisOrder\"\>", "\<\"Output format & pair ordering\"\
\>", "\<\"\\\"BrukerSpectrum\\\", \\\"Association\\\", \\\"Pairs\\\"; \
Automatic, \\\"Ascending\\\", \\\"Descending\\\"\"\>"},
    {"\<\"ReadBrukerParameters[file]\"\>", "\<\"Standalone JCAMP-DX \
reader\"\>", "\<\"Parses procs / acqus / proc / acqu into Association\"\>"},
    {"\<\"BrukerSpectrum[...]\"\>", "\<\"Imported 1D spectrum container\"\>", \
"\<\"Supports \\\"Properties\\\", \\\"Metadata\\\", \\\"PPM\\\", \\\"Hz\\\", \
\\\"Real\\\", \\\"Complex\\\"\"\>"},
    {"\<\"PlotBrukerSpectrum / ListPlot\"\>", "\<\"NMR-oriented 1D plotting\"\
\>", "\<\"AxisUnits (\\\"ppm\\\", \\\"Hz\\\", \\\"rad/s\\\"), Component, \
ReverseAxis\"\>"},
    {"\<\"Expand / Re / Im / Abs / Times / CombineData\"\>", "\<\"Extract, \
phase, scale & combine\"\>", "\<\"Exp[I*phi]*spec shifts zero-order phase; \
CombineData averages compatible spectra\"\>"},
    {"\<\"ToSignal[spec]\"\>", "\<\"Inverse-FFT to SpinDynamica Signal\"\>", \
"\<\"Produces time-domain Signal ready for ApplyLineBroadening and FT\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85], {
        GrayLevel[1], 
        RGBColor[0.97, 0.98, 1.]}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"723fa18f-6413-3c44-b514-449f14cda0ec"]
}, Open  ]]
}, Open  ]]
},
