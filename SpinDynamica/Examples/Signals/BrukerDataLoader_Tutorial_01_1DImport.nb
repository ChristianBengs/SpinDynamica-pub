Cell[CellGroupData[{

Cell["3. Intensity Scaling, Imaginary Data, and Return Formats", "Section",ExpressionUUID->"f5bb3743-e30c-054c-bab3-7621cc255cfe"],

Cell["\<\
TopSpin stores 1r/1i integers scaled by an exponent NC_proc (here NC_proc = \
-10, corresponding to a multiplier of 2^-10). IntensityScaling controls how \
loaded intensities are scaled:
  - \"Bruker\" (default): multiplies stored integers by 2^NC_proc.
  - \"Raw\": keeps raw stored integers unscaled.
  - \"Normalized\": applies 2^NC_proc and scales peak magnitude to 1.
  - Positive number (e.g. 10^-6): multiplies 2^NC_proc by your custom factor.
Additional options: IncludeRawData -> False omits RawReal/RawImaginary arrays \
to save memory; ReadImaginary -> False skips 1i; ReturnFormat returns \
\"BrukerSpectrum\" (default), \"Association\", or coordinate pairs \"Pairs\" \
(supporting AxisOrder -> Automatic | \"Ascending\" | \"Descending\").\
\>", "Text",ExpressionUUID->"0fb6a87b-3e5b-784e-ab7d-7523a8c98fc8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"specRaw", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"IntensityScaling", "->", "\"\<Raw\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specNorm", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"IntensityScaling", "->", "\"\<Normalized\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"specCustom", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"IntensityScaling", "->", "1.*^-6"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specRealOnly", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"ReadImaginary", "->", "False"}], ",", 
     RowBox[{"IncludeRawData", "->", "False"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pairsHzAsc", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"ReturnFormat", "->", "\"\<Pairs\>\""}], ",", 
     RowBox[{"AxisUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AxisOrder", "->", "\"\<Ascending\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Bruker (default, 2^NC_proc)\>\"", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
       RowBox[{"spec", "[", "\"\<AppliedScaleFactor\>\"", "]"}], ",", 
       RowBox[{"spec", "[", "\"\<HasImaginary\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Raw\>\"", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"specRaw", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
       RowBox[{"specRaw", "[", "\"\<AppliedScaleFactor\>\"", "]"}], ",", 
       RowBox[{"specRaw", "[", "\"\<HasImaginary\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Normalized\>\"", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"specNorm", "[", "\"\<Complex\>\"", "]"}], "]"}], "]"}], ",", 
       RowBox[{"specNorm", "[", "\"\<AppliedScaleFactor\>\"", "]"}], ",", 
       RowBox[{"specNorm", "[", "\"\<HasImaginary\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Custom (10^-6)\>\"", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"specCustom", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
       RowBox[{"specCustom", "[", "\"\<AppliedScaleFactor\>\"", "]"}], ",", 
       RowBox[{"specCustom", "[", "\"\<HasImaginary\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<ReadImaginary -> False\>\"", ",", 
       RowBox[{"Max", "[", 
        RowBox[{"specRealOnly", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
       RowBox[{"specRealOnly", "[", "\"\<RawReal\>\"", "]"}], ",", 
       RowBox[{"specRealOnly", "[", "\"\<HasImaginary\>\"", "]"}]}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Mode\>\"", ",", "\"\<Max Amplitude\>\"", 
        ",", "\"\<ScaleFactor / RawReal\>\"", ",", "\"\<HasImaginary\>\""}], 
       "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"c263b89e-f0be-2746-ab13-fe3f766d71bc"],

