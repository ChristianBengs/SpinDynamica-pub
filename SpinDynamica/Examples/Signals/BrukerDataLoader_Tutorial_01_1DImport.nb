Cell[CellGroupData[{

Cell["\<\
5. Extracting Pairs, Peak Finding, Phasing, and Combining Spectra\
\>", "Section",ExpressionUUID->"856a9099-1cb6-1149-9960-df47bb1ab780"],

Cell["\<\
BrukerSpectrum supports SpinDynamica data UpValues directly: Length[spec], \
Expand[spec, AxisUnits -> ..., Component -> ..., AxisOrder -> ...] \
(equivalently spec[\"Pairs\", units, comp, order]), Re[spec], Im[spec], \
Abs[spec], numeric/complex scalar multiplication (such as Exp[I * phi] * spec \
for zero-order phase adjustment), and linear combination via CombineData.\
\>", "Text",ExpressionUUID->"ad94f418-0ee1-5047-b1e3-d7d7e3d1d58a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"peakIdx", "=", 
   RowBox[{"First", "[", 
    RowBox[{"Ordering", "[", 
     RowBox[{
      RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specPhased", "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", 
      RowBox[{"(", 
       RowBox[{"35.", "*", "Degree"}], ")"}]}], "]"}], "*", "spec"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"specAvg", "=", 
   RowBox[{"CombineData", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"spec", ",", "specPhased"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Length[spec]\>\"", "->", 
    RowBox[{"Length", "[", "spec", "]"}]}], ",", 
   RowBox[{"\"\<Peak Position (ppm, Hz)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"spec", "[", "\"\<PPM\>\"", "]"}], "[", 
       RowBox[{"[", "peakIdx", "]"}], "]"}], ",", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Hz\>\"", "]"}], "[", 
       RowBox[{"[", "peakIdx", "]"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"\"\<Max |Expand[spec] - Re[spec]|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Expand", "[", "spec", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", 
       RowBox[{
        RowBox[{"Re", "[", "spec", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Peak Amp (Original, +35 deg, Combined)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"specPhased", "[", "\"\<Real\>\"", "]"}], "]"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"specAvg", "[", "\"\<Real\>\"", "]"}], "]"}]}], "}"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"7ef7d0a7-0440-9645-86b7-15a530d1eec8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Length[spec]\"\>", "\[Rule]", "131072"}], ",", 
   RowBox[{"\<\"Peak Position (ppm, Hz)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.9933527189116056`"}], ",", 
      RowBox[{"-", "597.6723221222642`"}]}], "}"}]}], ",", 
   RowBox[{"\<\"Max |Expand[spec] - Re[spec]|\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"Peak Amp (Original, +35 deg, Combined)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "378796.01953125`", ",", "378439.36859427235`", ",", 
      "372729.7195430653`"}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"5de6c450-b448-bb40-bf71-ae9d7f2a61cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotBrukerSpectrum", "[", 
  RowBox[{"specPhased", ",", 
   RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3.2"}], ",", 
        RowBox[{"-", "0.8"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Zero-Order Phased (+35 deg via Exp[I*phi]*spec)\>\""}], ",", 
   RowBox[{"ImageSize", "->", "440"}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"72a2e28b-4291-234f-bd08-423bc899f179"],

