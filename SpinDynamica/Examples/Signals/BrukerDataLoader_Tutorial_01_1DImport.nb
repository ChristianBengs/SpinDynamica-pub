   "\"Zero-Order Phased (+35 deg via Exp[I*phi]*spec)\"", TraditionalForm],
  PlotRange->{{3.2, 0.8}, All},
  PlotRangeClipping->True,
  PlotRangePadding->{{None, None}, {
     Scaled[0.05], 
     Scaled[0.05]}},
  Ticks->{
    Charting`ScaledTicks[
    "Reverse", {-#& , -#& }, "Nice", WorkingPrecision -> 15.954589770191003`, 
     RotateLabel -> 0], Automatic}]], "Output",
 CellLabel->"Out[13]=",ExpressionUUID->"34803ac1-d09f-7744-8711-4c8225f6d080"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
6. Converting to a SpinDynamica Signal (ToSignal) and FT Processing\
\>", "Section",ExpressionUUID->"aded0678-cff5-3a4f-9a9a-edaeaa5e665f"],

Cell["\<\
ToSignal[spec] transforms an imported 1D BrukerSpectrum back into a \
SpinDynamica time-domain Signal object via inverse FFT on SpinDynamica's \
frequency convention. You can verify the exact round-trip with FT[sigExp, \
ZeroFill -> 1, FirstPointMultiplicationFactor -> 1] (error ~ 3e-16), and \
apply SpinDynamica processing such as ApplyLineBroadening. Because \
sample_data was acquired with a spin-echo (gp_echozg) sequence over 26.2 s, \
half of the inverse-FFT echo signal sits near t = 0 and the anti-causal echo \
wing wraps to t -> 26.2 s; therefore a gentle LineBroadening -> 0.05 rad/s \
cleanly reduces and broadens the peak without suppressing the wrapped echo \
wing.\
\>", "Text",ExpressionUUID->"cf6f642c-461c-2248-8c74-076ff6fc85c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigExp", "=", 
   RowBox[{"ToSignal", "[", "spec", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ftRoundTrip", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigExp", ",", 
     RowBox[{"ZeroFill", "->", "1"}], ",", 
     RowBox[{"FirstPointMultiplicationFactor", "->", "1"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"roundTripErr", "=", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Reverse", "[", 
        RowBox[{"ftRoundTrip", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "-", 
       RowBox[{"spec", "[", "\"\<Complex\>\"", "]"}]}], "]"}], "]"}], "/", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"spec", "[", "\"\<Complex\>\"", "]"}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sigBroad", "=", 
   RowBox[{"ApplyLineBroadening", "[", 
    RowBox[{"sigExp", ",", 
     RowBox[{"LineBroadening", "->", "0.05"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ftBroad", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigBroad", ",", 
     RowBox[{"ZeroFill", "->", "1"}], ",", 
     RowBox[{"FirstPointMultiplicationFactor", "->", "1"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Signal Sampling {tmin, tmax, dt}\>\"", "->", 
    RowBox[{"First", "[", "sigExp", "]"}]}], ",", 
   RowBox[{"\"\<FT Round-Trip Relative Error\>\"", "->", "roundTripErr"}], ",", 
   RowBox[{"\"\<Peak Ratio after 0.05 rad/s Broadening\>\"", "->", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"Re", "[", 
       RowBox[{"ftBroad", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}], "/", 
     RowBox[{"Max", "[", 
      RowBox[{"spec", "[", "\"\<Real\>\"", "]"}], "]"}]}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"cdd33e48-4ca8-744b-a6e9-dbff608b3993"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Signal Sampling {tmin, tmax, dt}\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "26.2142`", ",", "0.0002`"}], "}"}]}], ",", 
   RowBox[{"\<\"FT Round-Trip Relative Error\"\>", "\[Rule]", 
    "3.3303278400366557`*^-16"}], ",", 
   RowBox[{"\<\"Peak Ratio after 0.05 rad/s Broadening\"\>", "\[Rule]", 
    "0.5220717350715632`"}]}], "}"}]], "Output",
 CellLabel->"Out[14]=",ExpressionUUID->"b75bf3f2-77a3-9b4b-b6ef-9803cd716798"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"tGrid", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "sigExp", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"First", "[", "sigExp", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"First", "[", "sigExp", "]"}], "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tGrid", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "800"}], "]"}], "]"}], ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"sigExp", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", 
              RowBox[{"1", ";;", "800"}]}], "]"}], "]"}], "]"}]}], "}"}], 
        "]"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Time (s)\>\"", ",", "\"\<|FID|\>\""}], "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", "\"\<|FID| (first 0.16 s)\>\"", "}"}], ",", "Above"}], 
         "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Imported Echo FID Envelope\>\""}]}], 
      "]"}], ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"spec", "[", "\"\<PPM\>\"", "]"}], ",", 
              RowBox[{"spec", "[", "\"\<Real\>\"", "]"}]}], "}"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2.6"}], "<=", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", 
             RowBox[{"-", "1.4"}]}], "&"}]}], "]"}], ",", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"ftBroad", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "/", 
               RowBox[{"spec", "[", "\"\<ReferenceFrequencyMHz\>\"", "]"}]}], 
              ",", 
              RowBox[{"Re", "[", 
               RowBox[{"ftBroad", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], 
            "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "2.6"}], "<=", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", 
             RowBox[{"-", "1.4"}]}], "&"}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"ScalingFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Reverse\>\"", ",", "None"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Chemical Shift (ppm)\>\"", ",", "\"\<Intensity\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Original\>\"", ",", "\"\<+0.05 rad/s LB\>\""}], "}"}],
           ",", "Above"}], "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Effect of LineBroadening\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "25"}]}], "]"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"5469e635-1ed3-474c-9be5-64d91bf3172e"],

