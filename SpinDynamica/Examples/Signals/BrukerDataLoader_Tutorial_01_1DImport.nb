Cell[CellGroupData[{

Cell["4. Plotting Conventions and Spectral Components", "Section",ExpressionUUID->"292b9009-04e5-3348-b864-7985a65ba9f4"],

Cell["\<\
PlotBrukerSpectrum (also aliased via ListPlot[spec, ...]) adapts to AxisUnits \
-> \"ppm\" | \"Hz\" | \"rad/s\", ReverseAxis -> Automatic | True | False \
(ReverseAxis -> Automatic reverses chemical shift ppm left-to-right per NMR \
convention while keeping Hz and rad/s ascending), and Component -> \"Real\" | \
\"Imaginary\" | \"Both\" | \"Complex\" | \"Magnitude\".\
\>", "Text",ExpressionUUID->"78a3521e-f3e4-6747-b3d9-3d62963eb63d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotBrukerSpectrum", "[", 
        RowBox[{"spec", ",", 
         RowBox[{"AxisUnits", "->", "\"\<ppm\>\""}], ",", 
         RowBox[{"Component", "->", "\"\<Real\>\""}], ",", 
         RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3.2"}], ",", 
              RowBox[{"-", "0.8"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<ppm (Reversed by Default)\>\""}]}], 
        "]"}], ",", 
       RowBox[{"PlotBrukerSpectrum", "[", 
        RowBox[{"spec", ",", 
         RowBox[{"AxisUnits", "->", "\"\<Hz\>\""}], ",", 
         RowBox[{"Component", "->", "\"\<Real\>\""}], ",", 
         RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "960"}], ",", 
              RowBox[{"-", "240"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", "\"\<Hz (Ascending by Default)\>\""}]}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PlotBrukerSpectrum", "[", 
        RowBox[{"spec", ",", 
         RowBox[{"AxisUnits", "->", "\"\<ppm\>\""}], ",", 
         RowBox[{"Component", "->", "\"\<Both\>\""}], ",", 
         RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "3.2"}], ",", 
              RowBox[{"-", "0.8"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{"PlotLegends", "->", "None"}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Real (blue) & Imaginary (orange)\>\""}]}], 
        "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"spec", ",", 
         RowBox[{"AxisUnits", "->", "\"\<rad/s\>\""}], ",", 
         RowBox[{"Component", "->", "\"\<Magnitude\>\""}], ",", 
         RowBox[{"MaxPlotPoints", "->", "4000"}], ",", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "6000"}], ",", 
              RowBox[{"-", "1500"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<ListPlot Alias (rad/s Magnitude)\>\""}]}], 
        "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"20", ",", "15"}], "}"}]}]}], "]"}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"4c004d02-44e2-af4e-923d-1be0a39f8852"],

