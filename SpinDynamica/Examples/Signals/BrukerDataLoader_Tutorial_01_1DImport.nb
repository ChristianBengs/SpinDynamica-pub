Cell["\<\
Full JCAMP-DX dictionaries from procs and acqus are stored under \
\"ProcessingParameters\" and \"AcquisitionParameters\", and you can also \
parse any parameter file standalone using ReadBrukerParameters. Passing \
ReadAcquisitionParameters -> False skips reading acqus when only processed \
metadata is needed.\
\>", "Text",ExpressionUUID->"fda11eb5-da3a-8f4d-af99-166e6e7c2ee0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"procs", "=", 
   RowBox[{"ReadBrukerParameters", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
      "sampleDir", ",", "\"\<pdata\>\"", ",", "\"\<1\>\"", 
       ",", "\"\<procs\>\""}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"acqus", "=", 
   RowBox[{"spec", "[", "\"\<AcquisitionParameters\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specNoAcq", "=", 
   RowBox[{"ImportBrukerSpectrum", "[", 
    RowBox[{"sampleDir", ",", 
     RowBox[{"ReadAcquisitionParameters", "->", "False"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<procs (SI, SF, SW_p, OFFSET, NC_proc, LB, PHC0)\>\"", "->", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"procs", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<SI\>\"", ",", "\"\<SF\>\"", ",", "\"\<SW_p\>\"", 
        ",", "\"\<OFFSET\>\"", ",", "\"\<NC_proc\>\"", ",", "\"\<LB\>\"", 
        ",", "\"\<PHC0\>\""}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<acqus (PULPROG, TD, NS, RG)\>\"", "->", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"acqus", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<PULPROG\>\"", ",", "\"\<TD\>\"", ",", "\"\<NS\>\"", 
        ",", "\"\<RG\>\""}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<ReadAcquisitionParameters -> False\>\"", "->", 
    RowBox[{"specNoAcq", "[", "\"\<AcquisitionParameters\>\"", "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"a49bc942-d899-564e-8f3a-f89bf7f6d6d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"procs (SI, SF, SW_p, OFFSET, NC_proc, LB, PHC0)\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"SI\"\>", "\[Rule]", "131072"}], ",", 
      RowBox[{"\<\"SF\"\>", "\[Rule]", "299.832697169922`"}], ",", 
      RowBox[{"\<\"SW_p\"\>", "\[Rule]", "5000"}], ",", 
      RowBox[{"\<\"OFFSET\"\>", "\[Rule]", "8.337983`"}], ",", 
      RowBox[{"\<\"NC_proc\"\>", "\[Rule]", 
       RowBox[{"-", "10"}]}], ",", 
      RowBox[{"\<\"LB\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"PHC0\"\>", "\[Rule]", "113.2`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"acqus (PULPROG, TD, NS, RG)\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"PULPROG\"\>", "\[Rule]", "\<\"gp_echozg\"\>"}], ",", 
