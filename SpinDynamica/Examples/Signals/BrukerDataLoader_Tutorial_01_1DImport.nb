      RowBox[{"\<\"NS\"\>", "\[Rule]", "1"}], ",", 
      RowBox[{"\<\"RG\"\>", "\[Rule]", "64"}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"ReadAcquisitionParameters -> False\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", "\[RightAssociation]"}]}]}], 
