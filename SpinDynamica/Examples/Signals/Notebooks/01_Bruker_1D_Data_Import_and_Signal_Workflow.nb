Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"c0cf3ad6-80dd-41bf-ac0f-1bc2c47b7f61"],

Cell["\<\
Lab S1A lets you inspect sample_data instantaneously across AxisUnits, \
Component, zero-order phase rotation, and zoom half-width. Lab S1B (queued \
button) writes an isolated synthetic Bruker dataset with configurable binary \
encoding (DTYPP/BYTORDP/NC_proc/STSI/REVERSE), re-imports it with \
ImportBrukerSpectrum, and verifies exact numerical reconstruction.\
\>", "Text",ExpressionUUID->"d5acd5e4-166a-449f-ab84-86f0fc43bfdc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLabS1A", "[", 
     RowBox[{
     "specObj_BrukerSpectrum", ",", " ", "unit_String", ",", " ", 
      "comp_String", ",", " ", 
      RowBox[{"phc0Deg_", "?", "NumericQ"}], ",", " ", "halfSpan_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "phSpec", ",", " ", "pIdx", ",", " ", "centerVal", ",", " ", "rng", ",",
         " ", "lbl"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"phSpec", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "phc0Deg", "]"}], " ", "<", " ", "1.*^-12"}], ",",
           " ", "specObj", ",", " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", "*", " ", 
             RowBox[{"(", 
              RowBox[{"phc0Deg", " ", "*", " ", "Degree"}], ")"}]}], "]"}], 
           " ", "*", " ", "specObj"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"pIdx", " ", "=", " ", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"specObj", "[", "\"\<Complex\>\"", "]"}], "]"}], ",", " ", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"centerVal", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"unit", ",", "\n", "    ", "\"\<ppm\>\"", ",", " ", 
          RowBox[{
           RowBox[{"specObj", "[", "\"\<ChemicalShift\>\"", "]"}], "[", 
           RowBox[{"[", "pIdx", "]"}], "]"}], ",", "\n", "    ", "\"\<Hz\>\"",
           ",", " ", 
          RowBox[{
           RowBox[{"specObj", "[", "\"\<Frequency\>\"", "]"}], "[", 
           RowBox[{"[", "pIdx", "]"}], "]"}], ",", "\n", "    ", "_", ",", 
          " ", 
          RowBox[{
           RowBox[{"specObj", "[", "\"\<AngularFrequency\>\"", "]"}], "[", 
           RowBox[{"[", "pIdx", "]"}], "]"}]}], "\n", "  ", "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"rng", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"halfSpan", " ", "===", " ", "All"}], ",", " ", "All", ",", 
          "\n", "    ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sc", " ", "=", " ", 
              RowBox[{"Switch", "[", 
               RowBox[{
               "unit", ",", " ", "\"\<ppm\>\"", ",", " ", "1.", ",", 
                " ", "\"\<Hz\>\"", ",", " ", 
                RowBox[{
                "specObj", "[", "\"\<ReferenceFrequencyMHz\>\"", "]"}], ",", 
                " ", "_", ",", " ", 
                RowBox[{"2.", " ", "Pi", " ", "*", " ", 
                 RowBox[{
                 "specObj", "[", "\"\<ReferenceFrequencyMHz\>\"", "]"}]}]}], 
               "]"}]}], "}"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sort", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"centerVal", " ", "-", " ", 
                  RowBox[{"halfSpan", " ", "*", " ", "sc"}]}], ",", " ", 
                 RowBox[{"centerVal", " ", "+", " ", 
                  RowBox[{"halfSpan", " ", "*", " ", "sc"}]}]}], "}"}], "]"}],
               ",", " ", "All"}], "}"}]}], "\n", "    ", "]"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"lbl", " ", "=", " ", 
        RowBox[{"StringForm", "[", 
         RowBox[{"\"\<sample_data (`1`, `2`, phc0=`3` deg)\>\"", ",", " ", 
          "unit", ",", " ", "comp", ",", " ", 
          RowBox[{"NumberForm", "[", 
           RowBox[{"phc0Deg", ",", " ", 
            RowBox[{"{", 
             RowBox[{"4", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"PlotBrukerSpectrum", "[", 
        RowBox[{"phSpec", ",", " ", 
         RowBox[{"AxisUnits", " ", "->", " ", "unit"}], ",", " ", 
         RowBox[{"Component", " ", "->", " ", "comp"}], ",", " ", 
         RowBox[{"PlotRange", " ", "->", " ", "rng"}], ",", " ", 
         RowBox[{"PlotLabel", " ", "->", " ", "lbl"}], ",", " ", 
         RowBox[{"ImageSize", " ", "->", " ", "580"}]}], "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabS1B", "[", 
     RowBox[{
     "dtypp_Integer", ",", " ", "bytordp_Integer", ",", " ", "ncProc_Integer",
       ",", " ", "stripLen_Integer", ",", " ", "revQ_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tmpDir", ",", " ", "pdir", ",", " ", 
        RowBox[{"nSI", " ", "=", " ", "64"}], ",", " ", "ppm0", ",", " ", 
        "delta", ",", " ", "lor", ",", " ", "rAll", ",", " ", "iAll", ",", 
        " ", "nUse", ",", " ", "bo", ",", " ", "fmt", ",", " ", "pLines", ",",
         " ", "st", ",", "\n", "   ", "imported", ",", " ", "expectR", ",", 
        " ", "expectI", ",", " ", "scaleF", ",", " ", "errR", ",", " ", 
        "errI", ",", " ", "plt"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"tmpDir", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"$TemporaryDirectory", ",", " ", 
           RowBox[{"\"\<sd_nb_bruker_\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "$ProcessID", "]"}], " ", "<>", 
            " ", "\"\<_\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"10000", ",", " ", "99999"}], "}"}], "]"}], "]"}]}]}], 
          "}"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"pdir", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "tmpDir", ",", " ", "\"\<pdata\>\"", ",", " ", "\"\<1\>\""}], "}"}],
          "]"}]}], ";", "\n", "  ", 
       RowBox[{"CreateDirectory", "[", 
        RowBox[{"pdir", ",", " ", 
         RowBox[{"CreateIntermediateDirectories", " ", "->", " ", "True"}]}], 
        "]"}], ";", "\n", "  ", 
       RowBox[{"ppm0", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{"8.0", ",", " ", "0.0", ",", " ", 
          RowBox[{"nSI", " ", "-", " ", "1"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"delta", " ", "=", " ", 
        RowBox[{"ppm0", " ", "-", " ", "3.2"}]}], ";", "\n", "  ", 
       RowBox[{"lor", " ", "=", " ", 
        RowBox[{
         RowBox[{"1.", " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"1.", " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"delta", " ", "/", " ", "0.28"}], ")"}], "^", "2"}]}], 
           ")"}]}], " ", "+", " ", 
         RowBox[{"I", " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", " ", 
             RowBox[{"(", 
              RowBox[{"delta", " ", "/", " ", "0.28"}], ")"}]}], " ", "/", 
            " ", 
            RowBox[{"(", 
             RowBox[{"1.", " ", "+", " ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"delta", " ", "/", " ", "0.28"}], ")"}], "^", "2"}]}],
              ")"}]}], ")"}]}]}]}], ";", "\n", "  ", 
       RowBox[{"rAll", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dtypp", " ", "===", " ", "0"}], ",", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"40000.", " ", "*", " ", 
            RowBox[{"Re", "[", "lor", "]"}]}], "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"400.", " ", "*", " ", 
            RowBox[{"Re", "[", "lor", "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"iAll", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dtypp", " ", "===", " ", "0"}], ",", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"40000.", " ", "*", " ", 
            RowBox[{"Im", "[", "lor", "]"}]}], "]"}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"400.", " ", "*", " ", 
            RowBox[{"Im", "[", "lor", "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"nUse", " ", "=", " ", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"16", ",", " ", "stripLen"}], "]"}], ",", " ", "nSI"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"rAll", " ", "=", " ", 
        RowBox[{"rAll", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "nUse"}], "]"}], "]"}]}], ";", " ", 
       RowBox[{"iAll", " ", "=", " ", 
        RowBox[{"iAll", "[", 
         RowBox[{"[", 
          RowBox[{"1", " ", ";;", " ", "nUse"}], "]"}], "]"}]}], ";", "\n", 
       "\n", "  ", 
       RowBox[{"bo", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"bytordp", " ", "===", " ", "0"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"fmt", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"dtypp", " ", "===", " ", "0"}], ",", 
          " ", "\"\<Integer32\>\"", ",", " ", "\"\<Real64\>\""}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"pLines", " ", "=", " ", 
        RowBox[{
         RowBox[{"{", "\n", "    ", 
          
          RowBox[{"\"\<##TITLE= Synthetic Notebook Bruker Fixture\>\"", ",", 
           "\n", "    ", "\"\<##JCAMPDX= 5.0\>\"", ",", "\n", "    ", 
           RowBox[{"\"\<##$SI= \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "nSI", "]"}]}], ",", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nUse", " ", "<", " ", "nSI"}], ",", " ", 
             RowBox[{"\"\<##$STSI= \>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", "nUse", "]"}]}], ",", " ", "Nothing"}],
             "]"}], ",", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"nUse", " ", "<", " ", "nSI"}], ",", 
             " ", "\"\<##$STSR= 1\>\"", ",", " ", "Nothing"}], "]"}], ",", 
           "\n", "    ", "\"\<##$SF= 400.0\>\"", ",", "\n", 
           "    ", "\"\<##$SW_p= 3200.0\>\"", ",", "\n", 
           "    ", "\"\<##$OFFSET= 8.0\>\"", ",", "\n", "    ", 
           RowBox[{"\"\<##$BYTORDP= \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "bytordp", "]"}]}], ",", "\n", "    ", 
           RowBox[{"\"\<##$DTYPP= \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "dtypp", "]"}]}], ",", "\n", "    ", 
           RowBox[{"\"\<##$NC_proc= \>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "ncProc", "]"}]}], ",", "\n", "    ", 
           RowBox[{"\"\<##$REVERSE= \>\"", " ", "<>", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", "revQ", "]"}], ",", " ", "\"\<yes\>\"", ",",
               " ", "\"\<no\>\""}], "]"}]}], ",", "\n", 
           "    ", "\"\<##$AXNUC= <1H>\>\"", ",", "\n", 
           "    ", "\"\<##END=\>\""}], "\n", "  ", "}"}], " ", "/.", " ", 
         RowBox[{"Nothing", " ", "->", " ", 
          RowBox[{"Sequence", "[", "]"}]}]}]}], ";", "\n", "  ", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"pdir", ",", " ", "\"\<procs\>\""}], "}"}], "]"}], ",", 
         " ", "pLines", ",", " ", "\"\<Lines\>\""}], "]"}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{"OpenWrite", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"pdir", ",", " ", "\"\<1r\>\""}], "}"}], "]"}], ",", " ", 
          RowBox[{"BinaryFormat", " ", "->", " ", "True"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"BinaryWrite", "[", 
        RowBox[{"st", ",", " ", "rAll", ",", " ", "fmt", ",", " ", 
         RowBox[{"ByteOrdering", " ", "->", " ", "bo"}]}], "]"}], ";", " ", 
       RowBox[{"Close", "[", "st", "]"}], ";", "\n", "  ", 
       RowBox[{"st", " ", "=", " ", 
        RowBox[{"OpenWrite", "[", 
         RowBox[{
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"pdir", ",", " ", "\"\<1i\>\""}], "}"}], "]"}], ",", " ", 
          RowBox[{"BinaryFormat", " ", "->", " ", "True"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"BinaryWrite", "[", 
        RowBox[{"st", ",", " ", "iAll", ",", " ", "fmt", ",", " ", 
         RowBox[{"ByteOrdering", " ", "->", " ", "bo"}]}], "]"}], ";", " ", 
       RowBox[{"Close", "[", "st", "]"}], ";", "\n", "\n", "  ", 
       RowBox[{"imported", " ", "=", " ", 
        RowBox[{"ImportBrukerSpectrum", "[", "tmpDir", "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"DeleteDirectory", "[", 
         RowBox[{"tmpDir", ",", " ", 
          RowBox[{"DeleteContents", " ", "->", " ", "True"}]}], "]"}], "]"}], 
       ";", "\n", "  ", 
       RowBox[{"scaleF", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"2.", "^", "ncProc"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"expectR", " ", "=", " ", 
        RowBox[{
         RowBox[{"N", "[", "rAll", "]"}], " ", "*", " ", "scaleF"}]}], ";", 
       "\n", "  ", 
       RowBox[{"expectI", " ", "=", " ", 
        RowBox[{
         RowBox[{"N", "[", "iAll", "]"}], " ", "*", " ", "scaleF"}]}], ";", 
       "\n", "  ", 
       RowBox[{"errR", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"imported", "[", "\"\<Real\>\"", "]"}], " ", "-", " ", 
           "expectR"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"errI", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"imported", "[", "\"\<Imaginary\>\"", "]"}], " ", "-", " ",
            "expectI"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"plt", " ", "=", " ", 
        RowBox[{"PlotBrukerSpectrum", "[", 
         RowBox[{"imported", ",", " ", 
          RowBox[{"Component", " ", "->", " ", "\"\<Both\>\""}], ",", "\n", 
          "    ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"StringForm", "[", 
            
            RowBox[{"\"\<Synthetic 1D (`1`, `2`, NC_proc=`3`, pts=`4`)\>\"", ",",
              "\n", "      ", 
             RowBox[{"imported", "[", "\"\<DataType\>\"", "]"}], ",", " ", 
             RowBox[{"imported", "[", "\"\<ByteOrder\>\"", "]"}], ",", " ", 
