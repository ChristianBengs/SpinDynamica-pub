Notebook[{

Cell[CellGroupData[{
Cell["Bruker 1D Data Import and SpinDynamica Signal Workflow", "Title",ExpressionUUID->"690141f8-c168-4cb8-9595-67cc8eacb505"],

Cell["\<\
Importing processed TopSpin 1D NMR spectra (1r/1i, procs/acqus), intensity \
scaling, chemical-shift calibration, visualization, inverse-FFT Signal \
conversion, and interactive binary synthesis labs.\
\>", "Subtitle",ExpressionUUID->"30876d18-da29-448a-935b-daa64b892ba2"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"61be8ae0-9e7f-4d56-b54e-98deee1321df"],

Cell["\<\
Evaluate the two setup cells below. Cell 1 locates the repository checkout \
root upward from NotebookDirectory[] and loads SpinDynamica` before \
referencing any package symbol. Cell 2 verifies that Signals`Bruker` loaded \
cleanly.\
\>", "Text",ExpressionUUID->"0108c6b6-0906-4aa2-922c-a69d1e51c58d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dir", " ", "=", " ", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"FileExistsQ", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
               " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"found", " ", "=", " ", "dir"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"dir", " ", "=", " ", 
          RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"{", "6", "}"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
              ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
         "\n", "    ", 
        RowBox[{"found", " ", "=", " ", 
         RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
      "found"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], ",", "\n", "  ", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", " ", "\"\<SpinDynamica\>\"", ",", 
         " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "\n", "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"94f36726-eb21-43e1-9421-f09c427d7ddb"],

