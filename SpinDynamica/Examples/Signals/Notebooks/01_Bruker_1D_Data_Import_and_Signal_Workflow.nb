          RowBox[{"ImageSize", " ", "->", " ", "540"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<DataType\>\"", " ", "->", " ", 
          RowBox[{"imported", "[", "\"\<DataType\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<ByteOrder\>\"", " ", "->", " ", 
          RowBox[{"imported", "[", "\"\<ByteOrder\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<NumPoints\>\"", " ", "->", " ", 
