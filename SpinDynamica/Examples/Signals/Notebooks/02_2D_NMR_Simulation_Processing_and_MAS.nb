 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"nuR", " ", "=", " ", "10000."}], ",", " ", 
     RowBox[{"nG", " ", "=", " ", "4"}], ",", " ", 
     RowBox[{"res", " ", "=", " ", "labS2BDefault"}]}], "}"}], ",", "\n", 
