Notebook[{

Cell[CellGroupData[{
Cell["\<\
02. 2D NMR Simulation, Hypercomplex Processing, and MAS COMPUTE2D\
\>", "Title",ExpressionUUID->"0b298aa3-9383-b14c-85e5-d21a588c3e33"],

Cell["\<\
High-performance 2D NMR time-domain simulation (Signal2D), hypercomplex \
processing (States, StatesTPPI, EchoAntiEcho, TPPI), Liouville NOESY/EXSY, \
compiled powder ensembles, and rotor-phase-locked MAS COMPUTE2D.\
\>", "Subtitle",ExpressionUUID->"99eb09cb-50e7-6c42-ba23-782435577299"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"701d5b7a-f38b-cd44-bba3-83f734a3ca3b"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 resolves the repository root from \
NotebookDirectory[] using System symbols only and loads SpinDynamica`; Cell 2 \
verifies that Signals`Signal2D` and Simulations`Signal2D` loaded cleanly.\
\>", "Text",ExpressionUUID->"522958ca-208b-ff47-933f-9b56fa7c949f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", " ", "=", " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], " ", "&&", " ", 
     RowBox[{"nbRepoRoot", " ", "=!=", " ", "\"\<\>\""}], " ", "&&", " ", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", " ", "\"\<SpinDynamica\>\"", ",", 
          " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", "\n",
     "  ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", " ", "=", " ", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", " ", "===", " ", "nbRepoRoot"}], ",", " ", 
        RowBox[{
         RowBox[{"nbRepoRoot", " ", "=", " ", 
          RowBox[{"Directory", "[", "]"}]}], ";", " ", 
         RowBox[{"Break", "[", "]"}]}], ",", " ", 
        RowBox[{"nbRepoRoot", " ", "=", " ", "parent"}]}], "]"}]}], "\n", 
     "  ", "]"}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", 
