Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"3123f6fa-030d-e140-8602-08b4e3a1c12b"],

Cell["\<\
SpinDynamica's 2D subsystem separates fast low-level numerical linear algebra \
(SpinDynamica/Simulations/Signal2DKernels.m), 2D experiment orchestration \
(SpinDynamica/Simulations/Signal2D.m), and 2D hypercomplex Fourier processing \
and plotting (SpinDynamica/Signals/Signal2D.m).\
\>", "Text",ExpressionUUID->"d49136d5-77dd-ec45-ac6c-1ada47096f2f"],

Cell["\<\
Matrix shape convention: every 2D time-domain SignalData2D and \
frequency-domain Spectrum2D matrix has shape {N1, N2} where rows index t1 / \
F1 (indirect) and columns index t2 / F2 (direct), matching Signal2D[{timing1, \
timing2}, ...].\
\>", "Item",ExpressionUUID->"942181c8-b46c-4543-8125-b7e991ab176e"],

Cell["\<\
Processing option pair convention: ZeroFill, FirstPointMultiplicationFactor, \
LineBroadening, Apodization, and PhaseCorrection accept {direct, indirect} \
pairs ({F2, F1}), consistent with 1D FT conventions.\
\>", "Item",ExpressionUUID->"0deb1a34-12f3-aa47-9177-1c60c94ec4c5"],

Cell["\<\
Three propagation tiers: DoubleDiagonalization (static & split-echo t1/t2 \
with secular block diagonalization and O(d^2) Hilbert coherence masks), \
SteppedPropagator (stepped indirect pulses), and COMPUTE2D (CF4 \
Gauss-Legendre Magnus + Floquet factorization + rotor-phase-locked \
CarouselAverage for periodic MAS).\
\>", "Item",ExpressionUUID->"1bcd8e3d-f585-324a-a7cb-82b4b74f4bf1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"b68e4946-4829-3041-a264-2e7c4264c1de"],

Cell["\<\
In Hilbert or Liouville space, a 2D experiment propagates Preparation -> \
Evolution1(t1) -> Mixing -> Evolution2(t2) under BackgroundGenerator (either \
one shared generator or {bgPrep, bgEv1, bgMix, bgEv2}). For time-independent \
generators, DoubleDiagonalization factors H = V Diag(lambda) V^dagger once \
and evaluates the full (t1, t2) grid via batched BLAS-3 matrix products. For \
States / StatesTPPI quadrature, two datasets (Cos, Sin) differing by pi/(2 p) \
on QuadratureSpins yield pure-absorptive 2D spectra via complex F2 FFT \
followed by real hypercomplex F1 FFT; for EchoAntiEcho, anti-echo rows are \
conjugated along F2 and linearly recombined before F1 FFT.\
\>", "Text",ExpressionUUID->"c1b1a2cb-75f7-554d-aa47-45005cefd968"],

Cell["\<\
Under Magic Angle Spinning (MAS) with rotor period tau_r = 2 Pi / omega_r, \
SignalCalculationMethod -> \"COMPUTE2D\" constructs sub-interval propagators \
across one rotor period with 4th-order Gauss-Legendre Magnus integration \
(MagnusSubsteps), diagonalizes the full-period Floquet operator U(tau_r) = V \
Lambda V^(-1), and reuses micro-interpolated propagators at arbitrary \
asynchronous (t1, t2) points. Setting CarouselAverage -> n_gamma coherently \
locks a global initial rotor phase gamma_k = InitialTimePoint + k tau_r / \
n_gamma across all four stages (Preparation -> t1 -> Mixing -> t2).\
\>", "Text",ExpressionUUID->"6c7d7eba-93f0-7a4e-b594-55a45e7cf85f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"88fe5770-ebbe-6e43-bb76-881056c9bf09"],

Cell["\<\
1. Solution-state 2-spin COSY: compare States and EchoAntiEcho hypercomplex \
quadrature, process with FT (ZeroFill -> {2, 2}, LineBroadening -> 10.), \
extract a 1D slice and projection, and check spectral parity (< 1e-12).\
\>", "Text",ExpressionUUID->"60311f02-5632-5242-8017-83e9cd26286f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Hcosy", " ", "=", " ", 
    RowBox[{"2.", " ", "*", " ", "Pi", " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"100.", " ", "*", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
       RowBox[{"250.", " ", "*", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
       RowBox[{"20.", " ", "*", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ")"}]}]}], ";"}],
   "\n"}], "\n", 
 RowBox[{
  RowBox[{"sCosyStates", " ", "=", " ", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "32"}], "}"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "64"}], "}"}], 
        "}"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Preparation", " ", "->", " ", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], "]"}]}], ",",
      "\n", "  ", 
     RowBox[{"Mixing", " ", "->", " ", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], "]"}]}], ",",
      "\n", "  ", 
     RowBox[{"BackgroundGenerator", " ", "->", " ", "Hcosy"}], ",", "\n", 
     "  ", 
     RowBox[{"QuadratureMethod", " ", "->", " ", "\"\<States\>\""}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sCosyEA", " ", "=", " ", 
    RowBox[{"Signal2D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "32"}], "}"}], 
         "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "64"}], "}"}], 
         "}"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"Preparation", " ", "->", " ", 
       RowBox[{"Pulse", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], "]"}]}], ",",
       "\n", "  ", 
      RowBox[{"Mixing", " ", "->", " ", 
       RowBox[{"Pulse", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], "]"}]}], ",",
       "\n", "  ", 
      RowBox[{"BackgroundGenerator", " ", "->", " ", "Hcosy"}], ",", "\n", 
      "  ", 
      RowBox[{"QuadratureMethod", " ", "->", " ", "\"\<EchoAntiEcho\>\""}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"spStates", " ", "=", " ", 
   RowBox[{"FT", "[", 
    RowBox[{"sCosyStates", ",", " ", 
     RowBox[{"ZeroFill", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"LineBroadening", " ", "->", " ", "10."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spEA", " ", "=", " ", 
   RowBox[{"FT", "[", 
    RowBox[{"sCosyEA", ",", " ", 
     RowBox[{"ZeroFill", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"2", ",", " ", "2"}], "}"}]}], ",", " ", 
     RowBox[{"LineBroadening", " ", "->", " ", "10."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eaParityErr", " ", "=", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"spStates", "[", "\"\<Data\>\"", "]"}], "]"}], " ", "-", " ", 
       
       RowBox[{"Re", "[", 
        RowBox[{"spEA", "[", "\"\<Data\>\"", "]"}], "]"}]}], "]"}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"slF2", " ", "=", " ", 
   RowBox[{"ExtractSlice", "[", 
    RowBox[{"spStates", ",", " ", "\"\<F2\>\"", ",", " ", "250.", ",", " ", 
     RowBox[{"Units", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], ";"}], "\n", 

 RowBox[{
  RowBox[{
   RowBox[{"projF2", " ", "=", " ", 
    RowBox[{"ProjectSpectrum2D", "[", 
     RowBox[{"spStates", ",", " ", "\"\<F2\>\"", ",", " ", 
      RowBox[{"Mode", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"PlotSpectrum2D", "[", 
     RowBox[{"spStates", ",", " ", 
      RowBox[{"Component", " ", "->", " ", "\"\<Magnitude\>\""}], ",", " ", 
      RowBox[{"ShowProjections", " ", "->", " ", "True"}], ",", "\n", "    ", 
      
      RowBox[{
      "PlotLabel", " ", "->", 
       " ", "\"\<2-Spin COSY (States, Magnitude, F2/F1 in Hz)\>\""}], ",", 
      " ", 
