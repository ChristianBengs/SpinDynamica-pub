                 RowBox[{"20000.", " ", "->", " ", "\"\<20 kHz\>\""}]}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<CarouselAverage (gamma):\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "nG", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", " ", "->", " ", "\"\<False (1)\>\""}], ",", " ", 
                 RowBox[{"4", " ", "->", " ", "\"\<4\>\""}], ",", " ", 
                 RowBox[{"8", " ", "->", " ", "\"\<8\>\""}]}], "}"}]}], 
              "]"}]}], "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
