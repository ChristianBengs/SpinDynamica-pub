Cell["\<\
2. Liouville NOESY/EXSY, compiled static CSA+dipolar powder (\"ZCW50\"), and \
2D MAS COMPUTE2D with finite mixing and rotor-phase-locked CarouselAverage -> \
4.\
\>", "Text",ExpressionUUID->"85cfa960-9c86-1f43-a9ec-9945ff120d2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lnoesy", " ", "=", " ", 
   RowBox[{
    RowBox[{"CommutationSuperoperator", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "*", " ", "Hcosy"}], "]"}], " ", "+", " ", 
    RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
     RowBox[{"2.", ",", " ", "0.25"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sNoesy", " ", "=", " ", 
