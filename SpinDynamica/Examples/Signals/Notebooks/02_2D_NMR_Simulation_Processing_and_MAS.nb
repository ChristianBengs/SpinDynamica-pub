Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"qm", " ", "=", " ", "\"\<States\>\""}], ",", " ", 
     RowBox[{"lb", " ", "=", " ", "10."}], ",", " ", 
