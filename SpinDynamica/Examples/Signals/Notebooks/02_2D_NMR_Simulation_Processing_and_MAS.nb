         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<QuadratureMethod:\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "qm", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<States\>\"", ",", " ", "\"\<StatesTPPI\>\"", ",",
                  " ", "\"\<EchoAntiEcho\>\""}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Component:\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "comp", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Magnitude\>\"", ",", " ", "\"\<Real\>\""}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<LineBroadening (Hz):\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "lb", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"2.", ",", " ", "30.", ",", " ", "2."}], "}"}]}], 
                 "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "lb", "]"}]}], "}"}], "]"}]}], "}"}], 
           ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<ZeroFill:\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "zf", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"1", ",", " ", "2", ",", " ", "4"}], "}"}]}], "]"}]}],
             "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<F2 Phase (deg):\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "ph", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "90."}], ",", " ", "90.", ",", " ", "5."}], 
                   "}"}]}], "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "ph", "]"}]}], "}"}], "]"}]}], 
            "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<Simulate & Process 2D COSY\>\"", ",", " ", 
         RowBox[{"res", " ", "=", " ", 
