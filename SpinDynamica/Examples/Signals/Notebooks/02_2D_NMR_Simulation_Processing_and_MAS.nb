Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"6d69fa68-2bef-fb4a-b7a3-d75038492e1c"],

Cell["\<\
Lab S2A explores solution-state 2D COSY quadrature methods (States, \
StatesTPPI, EchoAntiEcho), line broadening, zero-filling, and F2 phase \
correction. Lab S2B explores 2D MAS COMPUTE2D spinning frequency and \
rotor-phase-locked CarouselAverage (1 vs 4 vs 8 gamma angles). Both buttons \
use Method -> \"Queued\".\
\>", "Text",ExpressionUUID->"21a114f6-45c7-b94b-869b-2597f7d35125"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabS2A", "[", 
     RowBox[{"qm_String", ",", " ", 
      RowBox[{"lbHz_", "?", "NumericQ"}], ",", " ", "zf_Integer", ",", " ", 
      RowBox[{"phDeg_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sig", ",", " ", "sp0", ",", " ", "sp"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"sig", " ", "=", " ", 
        RowBox[{"Signal2D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "24"}], "}"}],
              "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2", " ", "Pi", " ", "800."}], ",", " ", "48"}], "}"}],
              "}"}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"Preparation", " ", "->", " ", 
           RowBox[{"Pulse", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"Mixing", " ", "->", " ", 
           RowBox[{"Pulse", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", "Hcosy"}], ",", "\n",
           "    ", 
          RowBox[{"QuadratureMethod", " ", "->", " ", "qm"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"sp0", " ", "=", " ", 
        RowBox[{"FT", "[", 
         RowBox[{"sig", ",", " ", 
          RowBox[{"ZeroFill", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"zf", ",", " ", "zf"}], "}"}]}], ",", " ", 
          RowBox[{"LineBroadening", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"lbHz", ",", " ", "lbHz"}], "}"}]}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"sp", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", "phDeg", "]"}], " ", "<", " ", "1.*^-12"}], ",",
           " ", "sp0", ",", " ", 
          RowBox[{"PhaseSpectrum2D", "[", 
           RowBox[{"sp0", ",", " ", 
            RowBox[{"PhaseCorrection", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"phDeg", " ", "*", " ", "Degree"}], ",", " ", "0."}], 
              "}"}]}]}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<Quadrature\>\"", " ", "->", " ", "qm"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<Method\>\"", " ", "->", " ", 
          RowBox[{"sig", "[", "\"\<Method\>\"", "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<Shape\>\"", " ", "->", " ", 
          RowBox[{"Dimensions", "[", 
           RowBox[{"sp", "[", "\"\<Data\>\"", "]"}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<LineBroadening\>\"", " ", "->", " ", "lbHz"}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<ZeroFill\>\"", " ", "->", " ", "zf"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<PhaseDeg\>\"", " ", "->", " ", "phDeg"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<MaxReal\>\"", " ", "->", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"sp", "[", "\"\<Data\>\"", "]"}], "]"}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<Spectrum\>\"", " ", "->", " ", "sp"}]}], "\n", "  ", 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLabS2A", "[", 
     RowBox[{"d_Association", ",", " ", "comp_String"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Quadrature / Engine:\>\"", ",", " ", 
             RowBox[{
              RowBox[{"d", "[", "\"\<Quadrature\>\"", "]"}], " ", "<>", 
              " ", "\"\< / \>\"", " ", "<>", " ", 
              RowBox[{"d", "[", "\"\<Method\>\"", "]"}]}], ",", 
             " ", "\"\<Spectrum Shape:\>\"", ",", " ", 
             RowBox[{"d", "[", "\"\<Shape\>\"", "]"}]}], "}"}], ",", "\n", 
           "    ", 
           RowBox[{"{", 
            RowBox[{"\"\<LineBroadening / ZeroFill:\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"d", "[", "\"\<LineBroadening\>\"", "]"}], ",", 
                " ", "\"\< Hz / \>\"", ",", " ", 
                RowBox[{"d", "[", "\"\<ZeroFill\>\"", "]"}], ",", 
                " ", "\"\<x\>\""}], "}"}], "]"}], ",", 
             " ", "\"\<Max Real:\>\"", ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"d", "[", "\"\<MaxReal\>\"", "]"}], ",", " ", "5"}], 
              "]"}]}], "}"}]}], "\n", "  ", "}"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "  ", 
       RowBox[{"PlotSpectrum2D", "[", 
        RowBox[{
         RowBox[{"d", "[", "\"\<Spectrum\>\"", "]"}], ",", " ", 
         RowBox[{"Component", " ", "->", " ", "comp"}], ",", " ", 
         RowBox[{"ShowProjections", " ", "->", " ", "True"}], ",", "\n", 
         "    ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"StringForm", "[", 
           
           RowBox[{"\"\<Lab S2A (`1`, `2`, LB=`3` Hz, ph0=`4` deg)\>\"", ",", 
            " ", 
            RowBox[{"d", "[", "\"\<Quadrature\>\"", "]"}], ",", " ", "comp", ",",
             " ", 
            RowBox[{"d", "[", "\"\<LineBroadening\>\"", "]"}], ",", " ", 
            RowBox[{"d", "[", "\"\<PhaseDeg\>\"", "]"}]}], "]"}]}], ",", "\n",
          "    ", 
         RowBox[{"ImageSize", " ", "->", " ", "500"}]}], "]"}]}], "\n", "}"}],
      "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabS2B", "[", 
     RowBox[{
      RowBox[{"nuRHz_", "?", "NumericQ"}], ",", " ", "nGamma_Integer"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tR", ",", " ", "wR", ",", " ", "Hmas", ",", " ", "sig", ",", " ", 
        "sp", ",", " ", "carVal"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"tR", " ", "=", " ", 
        RowBox[{"1.", " ", "/", " ", 
         RowBox[{"N", "[", "nuRHz", "]"}]}]}], ";", " ", 
       RowBox[{"wR", " ", "=", " ", 
        RowBox[{"2.", " ", "*", " ", "Pi", " ", "*", " ", 
         RowBox[{"N", "[", "nuRHz", "]"}]}]}], ";", "\n", "  ", 
       RowBox[{"Hmas", " ", "=", " ", 
        RowBox[{"PeriodicFunction", "[", 
         RowBox[{"t", ",", " ", "tR", ",", " ", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"2.", " ", "*", " ", "Pi", " ", "*", " ", 
            RowBox[{"(", "\n", "    ", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"250.", " ", "+", " ", 
                 RowBox[{"900.", " ", "*", " ", 
                  RowBox[{"Cos", "[", 
                   RowBox[{"wR", " ", "*", " ", "t"}], "]"}]}], " ", "+", " ", 
                 RowBox[{"450.", " ", "*", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"2.", " ", "*", " ", "wR", " ", "*", " ", "t"}], 
                   "]"}]}]}], ")"}], " ", "*", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n",
               "    ", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "350."}], " ", "+", " ", 
                 RowBox[{"700.", " ", "*", " ", 
                  RowBox[{"Sin", "[", 
                   RowBox[{"wR", " ", "*", " ", "t"}], "]"}]}]}], ")"}], " ", 
               "*", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n",
               "    ", 
              RowBox[{"950.", " ", "*", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"2.", " ", "*", " ", "wR", " ", "*", " ", "t"}], 
                "]"}], " ", "*", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2.", " ", "*", " ", 
                  RowBox[{
                   RowBox[{"opI", "[", 
                    RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", 
                   " ", 
                   RowBox[{"opI", "[", 
                    RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], " ", "-",
                  " ", 
                 RowBox[{
                  RowBox[{"opI", "[", 
                   RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", ".", " ", 
                  RowBox[{"opI", "[", 
                   RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "-", 
                 " ", 
                 RowBox[{
                  RowBox[{"opI", "[", 
                   RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
                  RowBox[{"opI", "[", 
                   RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}]}],
              "\n", "  ", ")"}]}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"carVal", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nGamma", " ", "<=", " ", "1"}], ",", " ", "False", ",", 
          " ", "nGamma"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"sig", " ", "=", " ", 
        RowBox[{"Signal2D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", 
            RowBox[{"1.", " ", "*", " ", "tR"}], ",", " ", 
            RowBox[{"tR", " ", "/", " ", "4."}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", 
            RowBox[{"2.", " ", "*", " ", "tR"}], ",", " ", 
            RowBox[{"tR", " ", "/", " ", "8."}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"Preparation", " ", "->", " ", 
           RowBox[{"Pulse", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"Mixing", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Pulse", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}], 
              "]"}], ",", " ", 
             RowBox[{"Delay", "[", 
              RowBox[{"0.31", " ", "*", " ", "tR"}], "]"}], ",", " ", 
             RowBox[{"Pulse", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<y\>\""}], "}"}], 
              "]"}]}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", "Hmas"}], ",", "\n", 
          "    ", 
          RowBox[{"CarouselAverage", " ", "->", " ", "carVal"}], ",", "\n", 
          "    ", 
          RowBox[{"QuadratureMethod", " ", "->", " ", "\"\<States\>\""}]}], 
         "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"sp", " ", "=", " ", 
        RowBox[{"FT", "[", 
         RowBox[{"sig", ",", " ", 
          RowBox[{"ZeroFill", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "2"}], "}"}]}], ",", " ", 
          RowBox[{"LineBroadening", " ", "->", " ", "250."}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<NuR_Hz\>\"", " ", "->", " ", 
          RowBox[{"N", "[", "nuRHz", "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<TauR_us\>\"", " ", "->", " ", 
          RowBox[{"1.*^6", " ", "*", " ", "tR"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<Method\>\"", " ", "->", " ", 
          RowBox[{"sig", "[", "\"\<Method\>\"", "]"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<CarouselAverage\>\"", " ", "->", " ", "carVal"}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<SignalShape\>\"", " ", "->", " ", 
          RowBox[{"Dimensions", "[", 
           RowBox[{"sig", "[", "\"\<Cos\>\"", "]"}], "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<MaxMag\>\"", " ", "->", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"sig", "[", "\"\<Cos\>\"", "]"}], " ", "+", " ", 
             RowBox[{"I", " ", "*", " ", 
              RowBox[{"sig", "[", "\"\<Sin\>\"", "]"}]}]}], "]"}], "]"}]}], ",",
          "\n", "    ", 
         RowBox[{"\"\<Spectrum\>\"", " ", "->", " ", "sp"}]}], "\n", "  ", 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLabS2B", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "  ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Spin Rate / Rotor Period:\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"d", "[", "\"\<NuR_Hz\>\"", "]"}], ",", 
                " ", "\"\< Hz / \>\"", ",", " ", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"d", "[", "\"\<TauR_us\>\"", "]"}], ",", " ", "4"}],
                  "]"}], ",", " ", "\"\< us\>\""}], "}"}], "]"}], ",", 
             " ", "\"\<Engine:\>\"", ",", " ", 
             RowBox[{"d", "[", "\"\<Method\>\"", "]"}]}], "}"}], ",", "\n", 
           "    ", 
           RowBox[{"{", 
            RowBox[{"\"\<CarouselAverage:\>\"", ",", " ", 
             RowBox[{"d", "[", "\"\<CarouselAverage\>\"", "]"}], ",", 
             " ", "\"\<Time Grid:\>\"", ",", " ", 
             RowBox[{"d", "[", "\"\<SignalShape\>\"", "]"}]}], "}"}]}], "\n", 
          "  ", "}"}], ",", " ", 
         RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "  ", 
       RowBox[{"PlotSpectrum2D", "[", 
        RowBox[{
         RowBox[{"d", "[", "\"\<Spectrum\>\"", "]"}], ",", " ", 
         RowBox[{"Component", " ", "->", " ", "\"\<Magnitude\>\""}], ",", " ", 
         RowBox[{"ShowProjections", " ", "->", " ", "True"}], ",", "\n", 
         "    ", 
         RowBox[{"PlotLabel", " ", "->", " ", 
          RowBox[{"StringForm", "[", 
           
           RowBox[{"\"\<Lab S2B MAS (`1` Hz, CarouselAverage -> `2`)\>\"", ",",
             " ", 
            RowBox[{"d", "[", "\"\<NuR_Hz\>\"", "]"}], ",", " ", 
            RowBox[{"d", "[", "\"\<CarouselAverage\>\"", "]"}]}], "]"}]}], ",",
          "\n", "    ", 
         RowBox[{"ImageSize", " ", "->", " ", "500"}]}], "]"}]}], "\n", "}"}],
      "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"labS2ADefault", " ", "=", " ", 
