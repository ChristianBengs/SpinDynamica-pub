         RowBox[{"res", " ", "=", " ", 
          RowBox[{"runLabS2B", "[", 
           RowBox[{"nuR", ",", " ", "nG"}], "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"renderLabS2B", "[", "res", "]"}], "]"}]}], "\n", "  ", "}"}],
