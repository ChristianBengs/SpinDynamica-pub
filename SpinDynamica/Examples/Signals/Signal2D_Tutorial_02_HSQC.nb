Notebook[{

Cell[CellGroupData[{
Cell["\<\
SpinDynamica Tutorial 02: Configuring Flexible 2D Experiments Using HSQC\
\>", "Title",ExpressionUUID->"8e4f96b6-5bfd-9e4c-bd56-c2046b800023"],

Cell["\<\
Heteronuclear spin selection, coherence pathways, propagation engines, echo \
and constant-time evolution, channel-dependent sequences, relaxation, and \
quadrature diagnostics.\
\>", "Subtitle",ExpressionUUID->"1181b587-38ac-be4e-90cf-c0f73086113e"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"ec2fea76-ff34-5f4d-b2b5-4463de761d7a"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that Signal2D and Spectrum2D loaded \
cleanly.\
\>", "Text",ExpressionUUID->"25b036d6-2ae6-af4c-9d04-fb9acbd2cf50"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"8b19cc8e-acd2-644c-ab6c-fdf682653430"],

