Cell[CellGroupData[{

Cell["5. Channel-Dependent Preparation", "Section",ExpressionUUID->"1bce7e75-7ca9-9147-b2fb-c1008d347f27"],

Cell["\<\
For standard \"States\" quadrature, Signal2D automatically rotates the final \
preparation operator on QuadratureSpins by -Pi/2 around z to build the \
\"Sin\" channel from the \"Cos\" preparation sequence. Alternatively, you can \
pass an explicit channel Association to Preparation -> <|\"Cos\" -> ..., \
\"Sin\" -> ...|>.

This gives you direct control over individual quadrature channels \[AHat]\.80\
\.94 essential when preparation uses shaped or selective pulses whose phases \
are programmed per channel rather than rotated abstractly. Changing the final \
15N 90-degree pulse phase from \"x\" to \"-y\" produces the exact same -Pi/2 \
z-rotation as automatic \"States\" encoding.\
\>", "Text",ExpressionUUID->"77014003-3f05-794a-b9cb-a116d0075739"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"prepPhase", "[", "pN_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "pN"}], "}"}]}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sigPrepChan", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Cos\>\"", "->", 
         RowBox[{"prepPhase", "[", "\"\<x\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Sin\>\"", "->", 
         RowBox[{"prepPhase", "[", "\"\<-y\>\"", "]"}]}]}], "|>"}]}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Max |Explicit Cos - Auto Cos|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigPrepChan", "[", "\"\<Cos\>\"", "]"}], "-", 
       RowBox[{"sigHSQC", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |Explicit Sin - Auto Sin|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigPrepChan", "[", "\"\<Sin\>\"", "]"}], "-", 
       RowBox[{"sigHSQC", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"52192630-e2c5-1441-a573-0d182a9385a5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Max |Explicit Cos - Auto Cos|\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"Max |Explicit Sin - Auto Sin|\"\>", "\[Rule]", 
    "2.306595211858756`*^-16"}]}], "}"}]], "Output",
 CellLabel->"Out[11]=",ExpressionUUID->"514f2946-f764-8a4a-9d7b-001590e24cdb"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Channel-Dependent Mixing", "Section",ExpressionUUID->"ac5e1123-e545-e148-87c5-1619283f1a9b"],

Cell["\<\
Just like Preparation, Mixing also accepts a channel-dependent Association: \
<|\"Cos\" -> ..., \"Sin\" -> ...|> for States/StatesTPPI/OversampledStates, \
or <|\"Echo\" -> ..., \"AntiEcho\" -> ...|> for EchoAntiEcho. Thus \
preparation, indirect evolution, and mixing do not have to be identical \
across quadrature channels.

First, an elementary States association on Mixing (using \
AutomaticQuadratureEncoding -> True so automatic preparation-side phase \
shifting remains active):\
\>", "Text",ExpressionUUID->"96d6f2b9-d0b2-0e48-9833-e66f8f1d28e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigMixStates", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Cos\>\"", "->", "mixConv"}], ",", 
        RowBox[{"\"\<Sin\>\"", "->", "mixConv"}]}], "|>"}]}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"AutomaticQuadratureEncoding", "->", "True"}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"sigMixStates", "[", "\"\<Sin\>\"", "]"}], "-", 
    RowBox[{"sigHSQC", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}], "Input",
