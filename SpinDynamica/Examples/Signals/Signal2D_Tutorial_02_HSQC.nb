Cell["\<\
What to observe: When Mixing is a channel Association with \
AutomaticQuadratureEncoding -> Automatic (row 2), automatic preparation phase \
shifts turn off so Cos and Sin become identical unless you either supply \
Preparation as an Association too or set AutomaticQuadratureEncoding -> True \
(row 3).\
\>", "Text",ExpressionUUID->"e8099371-cb57-c342-9161-4b139f44e02e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Relaxation and Liouville-Space Simulation", "Section",ExpressionUUID->"6f3b8db8-c0c1-4e41-a752-9737bc6bfd12"],

Cell["\<\
For purely unitary Hamiltonian dynamics, Signal2D propagates density matrices \
in Hilbert space by default (UseHilbertSpaceWhenPossible -> True), which \
scales with Hilbert-space dimension d rather than Liouville-space dimension \
d^2. General non-unitary dynamics such as T1/T2 relaxation cannot be \
represented by a single Hilbert-space unitary operator, so Liouville-space \
propagation becomes necessary.

To enable Liouville space, specify Basis and OperatorBasis (e.g. \
ZeemanBasis[] and ZeemanKetBraOperatorBasis[]) and either pass a \
superoperator generator (such as CommutationSuperoperator[-I H] + \
PhenomenologicalRelaxationSuperoperator[T1, T2]) or force Liouville space on \
a unitary problem with UseHilbertSpaceWhenPossible -> False.\
\>", "Text",ExpressionUUID->"8692000a-5232-e540-8a44-90acffc3c277"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zb", "=", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ob", "=", 
   RowBox[{"ZeemanKetBraOperatorBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigHilb", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigLiouvUnit", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"UseHilbertSpaceWhenPossible", "->", "False"}], ",", 
     RowBox[{"Basis", "->", "zb"}], ",", 
     RowBox[{"OperatorBasis", "->", "ob"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Lrelax", "=", 
   RowBox[{
    RowBox[{"CommutationSuperoperator", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "Hhn"}], "]"}], "+", 
    RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
     RowBox[{"1.5", ",", "0.04"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigRelax", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"CommutationSuperoperator", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "Hhn"}], "]"}], ",", "Lrelax", ",", 
        RowBox[{"CommutationSuperoperator", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "Hhn"}], "]"}], ",", "Lrelax"}], "}"}]}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"Basis", "->", "zb"}], ",", 
     RowBox[{"OperatorBasis", "->", "ob"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Spaces Used (Hilb, LiouvUnit, Relax)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"sigHilb", "[", "\"\<Metadata\>\"", "]"}], "[", "\"\<Space\>\"",
        "]"}], ",", 
      RowBox[{
       RowBox[{"sigLiouvUnit", "[", "\"\<Metadata\>\"", "]"}], 
       "[", "\"\<Space\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"sigRelax", "[", "\"\<Metadata\>\"", "]"}], 
       "[", "\"\<Space\>\"", "]"}]}], "}"}]}], ",", 
   RowBox[{"\"\<Max |Hilbert - Forced Liouville (unitary)|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigHilb", "[", "\"\<Cos\>\"", "]"}], "-", 
       RowBox[{"sigLiouvUnit", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"23f25a72-3567-f94d-b2cc-1a64094d58ec"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Spaces Used (Hilb, LiouvUnit, Relax)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"Hilbert\"\>", ",", "\<\"Liouville\"\>", 
      ",", "\<\"Liouville\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"Max |Hilbert - Forced Liouville (unitary)|\"\>", "\[Rule]", 
    "4.613190423717512`*^-15"}]}], "}"}]], "Output",
 CellLabel->"Out[15]=",ExpressionUUID->"c7e59f57-7d99-7240-9fbd-05403c589214"]
}, Open  ]],

Cell["\<\
Let us compare the direct FIDs and F2 cross-section slices without relaxation \
(plus minimal 4 Hz windowing for finite grid display) and with physical T1 = \
1.5 s, T2 = 0.04 s relaxation.\
\>", "Text",ExpressionUUID->"d9c3248e-f19b-304f-953c-e577371495e0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"spNoRelax", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{
     RowBox[{"FT", "[", 
      RowBox[{"sigHilb", ",", 
       RowBox[{"ZeroFill", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}], ",", 
       RowBox[{"LineBroadening", "->", "4."}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}], ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spRelax", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{
     RowBox[{"FT", "[", 
      RowBox[{"sigRelax", ",", 
       RowBox[{"ZeroFill", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}], ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t2", "=", 
   RowBox[{"sigHilb", "[", "\"\<Time2\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"t2", ",", 
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{"sigHilb", "[", "\"\<Cos\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "All"}], "]"}], "]"}], "]"}]}], "}"}], "]"}],
          ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"t2", ",", 
            RowBox[{"Re", "[", 
             RowBox[{
              RowBox[{"sigRelax", "[", "\"\<Cos\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "All"}], "]"}], "]"}], "]"}]}], "}"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<t2 (s)\>\"", ",", "\"\<Re[s_Cos(0, t2)]\>\""}], "}"}]}],
        ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<No relaxation\>\"", 
            ",", "\"\<T1 = 1.5 s, T2 = 0.04 s\>\""}], "}"}], ",", "Above"}], 
         "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<FID Decay\>\""}]}], "]"}], ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ExtractSlice", "[", 
          RowBox[{"spNoRelax", ",", "\"\<F2\>\"", ",", 
           RowBox[{"-", "210."}]}], "]"}], ",", 
         RowBox[{"ExtractSlice", "[", 
          RowBox[{"spRelax", ",", "\"\<F2\>\"", ",", 
           RowBox[{"-", "210."}]}], "]"}]}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "350"}], "}"}], ",", "All"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<F2 (Hz)\>\"", ",", "\"\<Intensity\>\""}], "}"}]}], ",", 
       
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<No relaxation\>\"", 
            ",", "\"\<T1 = 1.5 s, T2 = 0.04 s\>\""}], "}"}], ",", "Above"}], 
         "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<F2 Spectral Linewidth\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "25"}]}], "]"}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"b33aabf0-3937-ab48-bb95-8f8bde586949"],

