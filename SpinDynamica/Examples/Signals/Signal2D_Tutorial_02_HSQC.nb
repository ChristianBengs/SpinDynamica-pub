Cell["\<\
Comparing F1 slices at F2 = 134 Hz makes the J_HN splitting under free \
evolution vs clean decoupling under both Echo and ConstantTime immediately \
obvious.\
\>", "Text",ExpressionUUID->"8cbb6c8f-2844-3e44-95e7-06488292af8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ExtractSlice", "[", 
      RowBox[{"spFree", ",", "\"\<F1\>\"", ",", "134."}], "]"}], ",", 
     RowBox[{"ExtractSlice", "[", 
      RowBox[{"specHSQC", ",", "\"\<F1\>\"", ",", "134."}], "]"}], ",", 
     RowBox[{"ExtractSlice", "[", 
      RowBox[{"spCT", ",", "\"\<F1\>\"", ",", "134."}], "]"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "350"}], ",", 
        RowBox[{"-", "50"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<F1 (Hz)\>\"", ",", "\"\<Intensity\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Free\>\"", ",", "\"\<Echo\>\"", 
      ",", "\"\<ConstantTime\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<F1 Slices at F2 = 134 Hz\>\""}], ",", 
   RowBox[{"ImageSize", "->", "440"}]}], "]"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"bc12ec2b-6260-dc4b-8091-a5442395f218"],

