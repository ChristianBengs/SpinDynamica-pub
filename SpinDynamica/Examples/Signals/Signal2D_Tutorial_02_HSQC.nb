Cell["\<\
To see diagnostics catch a real setup mistake, suppose we choose \
QuadratureMethod -> \"EchoAntiEcho\" (which requires both p1 = -1 and p1 = +1 \
pathways) while accidentally passing CoherencePathway -> {-1}. Signal2D \
immediately emits Signal2D::quadconflict and Signal2D::zerochan, flagging \
\"AntiEcho\" in ZeroChannels and \"Status\" -> \"Warning\".\
\>", "Text",ExpressionUUID->"10c33204-9390-cf4a-97b6-c829e78d9632"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigBad", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<EchoAntiEcho\>\""}], ",", 
     RowBox[{"CoherencePathway", "->", 
      RowBox[{"{", 
       RowBox[{"-", "1"}], "}"}]}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
