Cell["\<\
A classic NMR application of channel-dependent mixing is sensitivity-enhanced \
(PEP / Rance-Kay) HSQC under EchoAntiEcho. Whereas conventional reverse-INEPT \
mixing (mixConv) converts only one of the two orthogonal transverse 15N \
components after t1, the double-INEPT PEP mixing block (mixPEP) converts both \
into observable 1H magnetization when paired with opposite 15N pulse phases (\
\"-x\" vs \"x\") for the \"Echo\" and \"AntiEcho\" channels, doubling the \
coherent signal amplitude in a noiseless simulation (corresponding to a \
Sqrt[2] experimental SNR gain). Note we set AutomaticQuadratureEncoding -> \
True so automatic Echo/AntiEcho pathway filtering (-1 / +1) stays enabled \
alongside the channel-dependent Mixing.\
\>", "Text",ExpressionUUID->"d0b96d31-32e3-aa4b-aaad-793dabd56c42"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mixPEP", "[", "pN_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "pN"}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigConvEA", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<EchoAntiEcho\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigPepEA", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Echo\>\"", "->", 
         RowBox[{"mixPEP", "[", "\"\<x\>\"", "]"}]}], ",", 
        RowBox[{"\"\<AntiEcho\>\"", "->", 
         RowBox[{"mixPEP", "[", "\"\<-x\>\"", "]"}]}]}], "|>"}]}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<EchoAntiEcho\>\""}], ",", 
     RowBox[{"AutomaticQuadratureEncoding", "->", "True"}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spConvEA", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{
     RowBox[{"FT", "[", 
      RowBox[{"sigConvEA", ",", 
       RowBox[{"ZeroFill", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}], ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"spPepEA", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{
     RowBox[{"FT", "[", 
      RowBox[{"sigPepEA", ",", 
       RowBox[{"ZeroFill", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "4"}], ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "4"}], ",", "0."}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Conv Norms\>\"", "->", 
    RowBox[{
     RowBox[{"QuadratureDiagnostics", "[", "sigConvEA", "]"}], 
     "[", "\"\<ChannelNorms\>\"", "]"}]}], ",", 
   RowBox[{"\"\<PEP Norms\>\"", "->", 
    RowBox[{
     RowBox[{"QuadratureDiagnostics", "[", "sigPepEA", "]"}], 
     "[", "\"\<ChannelNorms\>\"", "]"}]}], ",", 
   RowBox[{"\"\<PEP / Conv HypercomplexMagnitude Ratio\>\"", "->", 
    RowBox[{
     RowBox[{"Max", "[", 
      RowBox[{"spPepEA", "[", "\"\<HypercomplexMagnitude\>\"", "]"}], "]"}], "/", 
     RowBox[{"Max", "[", 
      RowBox[{"spConvEA", "[", "\"\<HypercomplexMagnitude\>\"", "]"}], 
      "]"}]}]}]}], "}"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"983fba29-7291-db4f-9162-a15bd031e0e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Conv Norms\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Echo\"\>", "\[Rule]", "9.960981613773772`"}], ",", 
      RowBox[{"\<\"AntiEcho\"\>", "\[Rule]", "9.960981613773772`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"PEP Norms\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Echo\"\>", "\[Rule]", "1.0697747004767297`*^-30"}], ",", 
      RowBox[{"\<\"AntiEcho\"\>", "\[Rule]", "1.0697747004767297`*^-30"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"PEP / Conv HypercomplexMagnitude Ratio\"\>", "\[Rule]", 
    "1.0743480153153901`*^-31"}]}], "}"}]], "Output",
 CellLabel->"Out[13]=",ExpressionUUID->"c0eefbf9-90e7-ee43-a11c-32853f393feb"]
}, Open  ]]
