Cell["\<\
Fixing the pathway filter to {{-1, 1}} (or Automatic) restores both channels \
cleanly. Note also that unequal channel norms (ChannelRatio > 1) are NOT \
automatically errors \[AHat]\.80\.94 an on-resonance peak, asymmetric \
relaxation, or intentional selective mixing can legitimately produce \
asymmetric channel norms even when the simulation is completely valid.\
\>", "Text",ExpressionUUID->"15bdb852-8d88-2044-a1ee-47c4d24f7a67"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigFixed", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<EchoAntiEcho\>\""}], ",", 
     RowBox[{"CoherencePathway", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "1"}], "}"}], "}"}]}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"KeyTake", "[", 
  RowBox[{
   RowBox[{"QuadratureDiagnostics", "[", "sigFixed", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Status\>\"", ",", "\"\<ChannelNorms\>\"", 
     ",", "\"\<ChannelRatio\>\"", ",", "\"\<ZeroChannels\>\"", 
     ",", "\"\<Warnings\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"2d351e6e-4cc1-5548-91b4-9d3c033f097a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Status\"\>", "\[Rule]", "\<\"OK\"\>"}], ",", 
   RowBox[{"\<\"ChannelNorms\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Echo\"\>", "\[Rule]", "9.960981613773772`"}], ",", 
      RowBox[{"\<\"AntiEcho\"\>", "\[Rule]", "9.960981613773772`"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"ChannelRatio\"\>", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\<\"ZeroChannels\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Warnings\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[20]=",ExpressionUUID->"46d8b1fd-053f-0046-b5ec-5c5e9b46f4de"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Summary and Quick Reference", "Section",ExpressionUUID->"876d30b7-6e7f-474b-a085-c629d1774783"],

Cell["\<\
When moving beyond simple homonuclear experiments:
  1. Specify Observable and QuadratureSpins explicitly for heteronuclear \
sequences, and use CoherencePathway or QuadratureOrder whenever selecting \
higher-order or specific pathways.
  2. Use Evolution1 -> \"Echo\" or \"ConstantTime\" to decouple scalar \
splittings in F1 without changing the preparation/mixing blocks.
  3. Supply channel-dependent Associations in Preparation or Mixing when \
channels differ (e.g. PEP-HSQC), remembering that AutomaticQuadratureEncoding \
-> Automatic turns off automatic preparation shifts when any channel \
Association is present unless set to True.
  4. Include relaxation via superoperators (CommutationSuperoperator + \
PhenomenologicalRelaxationSuperoperator) with Basis and OperatorBasis, and \
verify any quadrature configuration cleanly with QuadratureDiagnostics.\
\>", "Text",ExpressionUUID->"3823dabf-e1d4-8b42-963f-06140c4d88a4"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Symbol / Option\"\>", "\<\"Purpose\"\>", "\<\"Key Notes\"\>"},
    {"\<\"Observable -> {\\\"1H\\\"}\"\>", "\<\"Select detected spins\"\>", "\
\<\"Defaults to All; restricts direct detection to chosen isotope\"\>"},
    {"\<\"QuadratureSpins -> {\\\"15N\\\"}\"\>", "\<\"Select indirectly \
encoded spins\"\>", "\<\"Isolates quadrature encoding to evolving indirect \
spins\"\>"},
    {"\<\"QuadratureOrder -> q\"\>", "\<\"Coherence order for \
phase/filter\"\>", "\<\"Phase step -Pi/(2q); Echo/AntiEcho filters +/- q\"\>"},
    {"\<\"CoherencePathway\"\>", "\<\"Explicit coherence selection\"\>", \
"\<\"{p1, pMix} or {{p1List}, pMix} (distinct from PhaseCycle)\"\>"},
    {"\<\"SignalCalculationMethod\"\>", "\<\"Propagation backend\"\>", \
"\<\"\\\"DoubleDiagonalization\\\" (static default), \
\\\"SteppedPropagator\\\", \\\"Direct\\\", \\\"COMPUTE2D\\\" (MAS)\"\>"},
    {"\<\"ReportSignalCalculationMethod\"\>", "\<\"Print backend & space \
summary\"\>", "\<\"True / False; emits Signal2D::reportscm\"\>"},
    {"\<\"Evolution1 -> {\\\"Echo\\\", ...}\"\>", "\<\"Refocused indirect \
evolution\"\>", "\<\"Splits t1 around refocusing events (e.g. heteronuclear \
180-deg pulse)\"\>"},
    {"\<\"Evolution1 -> {\\\"ConstantTime\\\", tCT, ...}\"\>", \
"\<\"Constant-time t1 block\"\>", "\<\"Requires tCT >= t1_max; fixes \
J-evolution duration\"\>"},
    {"\<\"Preparation / Mixing -> <|...|>\"\>", "\<\"Channel-dependent \
sequences\"\>", "\<\"<|\\\"Cos\\\" -> ..., \\\"Sin\\\" -> ...|> or <|\\\"Echo\
\\\" -> ..., \\\"AntiEcho\\\" -> ...|>\"\>"},
    {"\<\"AutomaticQuadratureEncoding\"\>", "\<\"Control auto prep encoding\"\
\>", "\<\"Automatic (off if either stage is Assoc), True (keep prep auto), \
False (manual)\"\>"},
    {"\<\"UseHilbertSpaceWhenPossible\"\>", "\<\"Choose Hilbert vs \
Liouville\"\>", "\<\"True (default for unitary); superoperators require \
Liouville + Basis/OperatorBasis\"\>"},
    {"\<\"QuadratureDiagnostics[obj]\"\>", "\<\"Structured quadrature & \
capability check\"\>", "\<\"Reports Status, ChannelNorms, Warnings, and \
Spectrum2D QuadratureCapabilities\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85], {
        GrayLevel[1], 
        RGBColor[0.97, 0.98, 1.]}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"dc4288d0-ef0f-b140-8682-d7264fc57195"]
}, Open  ]]
}, Open  ]]
