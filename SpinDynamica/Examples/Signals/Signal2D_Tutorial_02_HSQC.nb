Cell[CellGroupData[{

Cell["1. Constructing a Heteronuclear HSQC Experiment", "Section",ExpressionUUID->"c95e3988-8976-0642-a732-45c027874121"],

Cell["\<\
Tutorial 01 used a homonuclear two-spin system where both preparation and \
detection acted identically on all spins. In heteronuclear 2D experiments \
such as HSQC, different isotopes experience spin-selective RF pulses, evolve \
under different chemical shifts in t1 and t2, transfer magnetization across a \
heteronuclear scalar coupling J_HN, and are detected selectively on one spin.

Below we set up a simple two-spin-1/2 {1H, 15N} system with 1H shift +180 Hz, \
15N shift -210 Hz, and J_HN = 92 Hz (INEPT delay tau = 1/(4 J_HN)).\
\>", "Text",ExpressionUUID->"bd8f2b1c-3e64-ea4e-acf6-3c28920a524f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuH", "=", "180."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuN", "=", 
   RowBox[{"-", "210."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jHN", "=", "92."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tauHN", "=", 
   RowBox[{"1.", "/", 
    RowBox[{"(", 
     RowBox[{"4.", "*", "jHN"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hhn", "=", 
   RowBox[{"2.", "*", "Pi", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"nuH", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"nuN", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"jHN", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], ")"}]}]}], 
     ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"239fa2de-445a-2040-ad2a-e1e1f0c170e0"],

Cell["\<\
                                                           1         1
SetSpinSystem::set : the spin system has been set to {{1H, -}, {15N, -}}
                                                           2         2\
\>", "Message", "MSG",ExpressionUUID->"88e28b03-495d-dc4d-9462-5f8ec5ab1388"],

Cell["\<\
                                                                  1         1
SetBasis::set : the state basis has been set to ZeemanBasis[{{1H, -}, {15N, \
-}}, BasisLabels -> Automatic].
                                                                  2         2\
\
\>", "Message", "MSG",ExpressionUUID->"17b93429-e196-5640-9360-34f74d1c3f12"]
}, Open  ]],

Cell["\<\
We start from proton polarization (InitialDensityOperator -> opI[\"1H\", \
\"z\"]), transfer coherence from 1H to 15N with an INEPT Preparation block, \
refocus 1H-15N coupling in the indirect dimension with Evolution1 -> \
{\"Echo\", Pulse[\"1H\", {Pi, \"x\"}]}, transfer back via a reverse-INEPT \
Mixing block, and detect only 1H (Observable -> {\"1H\"}) while encoding \
quadrature specifically on 15N (QuadratureSpins -> {\"15N\"}). Notice the \
spin-selective pulses Pulse[\"1H\", ...], Pulse[\"15N\", ...], and \
simultaneous Pulse[{\"1H\", \"15N\"}, ...].\
\>", "Text",ExpressionUUID->"29e5ef68-d048-5b4f-b5c1-593a0d2da157"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prepHN", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ev1Echo", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<Echo\>\"", ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mixConv", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Pi", ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", "tauHN", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigHSQC", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specHSQC", "=", 
   RowBox[{"PhaseSpectrum2D", "[", 
    RowBox[{
     RowBox[{"FT", "[", 
      RowBox[{"sigHSQC", ",", 
       RowBox[{"ZeroFill", "->", 
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "Pi"}], "/", "2"}], ",", "0."}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"PlotSpectrum2D", "[", 
  RowBox[{"specHSQC", ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "350"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "350"}], ",", 
        RowBox[{"-", "50"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "360"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"42fadd95-6295-1e4b-bc2d-fb30fdb7fa12"],

