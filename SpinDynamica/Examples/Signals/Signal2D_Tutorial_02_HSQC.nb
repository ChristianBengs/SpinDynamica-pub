Cell[CellGroupData[{

Cell["7. AutomaticQuadratureEncoding (Automatic | True | False)", "Section",ExpressionUUID->"e1919404-8b75-ab49-a277-a0738b0266ea"],

Cell["\<\
The final implemented semantics of AutomaticQuadratureEncoding are simple and \
explicit:
  - Automatic (default): enables automatic preparation-side phase shifts \
(-Pi/(2q)) and Echo/AntiEcho filters whenever BOTH Preparation and Mixing are \
channel-independent, and automatically DISABLES them whenever either \
Preparation or Mixing is a channel Association.
  - True: forces automatic preparation encoding ON even when Mixing is \
supplied as a channel Association (used in Section 6 above).
  - False: disables all automatic preparation encoding, giving the user full \
manual control over every channel.

Let us verify all four combinations directly from the resulting Metadata and \
time-domain channels.\
\>", "Text",ExpressionUUID->"39275a07-2377-c342-bc10-654415793dcf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigAEDefault", "=", "sigHSQC"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigAEAutoMix", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Cos\>\"", "->", "mixConv"}], ",", 
        RowBox[{"\"\<Sin\>\"", "->", "mixConv"}]}], "|>"}]}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"AutomaticQuadratureEncoding", "->", "Automatic"}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigAETrueMix", "=", "sigMixStates"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigAEFalse", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"AutomaticQuadratureEncoding", "->", "False"}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Standard (no Assoc, Automatic)\>\"", ",", 
       RowBox[{
        RowBox[{"sigAEDefault", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<AutomaticQuadratureEncoding\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"sigAEDefault", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<PreparationPhaseShifts\>\"", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"sigAEDefault", "[", "\"\<Cos\>\"", "]"}], "-", 
          RowBox[{"sigAEDefault", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Mix Assoc + Automatic\>\"", ",", 
       RowBox[{
        RowBox[{"sigAEAutoMix", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<AutomaticQuadratureEncoding\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"sigAEAutoMix", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<PreparationPhaseShifts\>\"", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"sigAEAutoMix", "[", "\"\<Cos\>\"", "]"}], "-", 
          RowBox[{"sigAEAutoMix", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Mix Assoc + True\>\"", ",", 
       RowBox[{
        RowBox[{"sigAETrueMix", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<AutomaticQuadratureEncoding\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"sigAETrueMix", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<PreparationPhaseShifts\>\"", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"sigAETrueMix", "[", "\"\<Cos\>\"", "]"}], "-", 
          RowBox[{"sigAETrueMix", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}],
       "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Standard + False\>\"", ",", 
       RowBox[{
        RowBox[{"sigAEFalse", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<AutomaticQuadratureEncoding\>\"", "]"}], ",", 
       RowBox[{
        RowBox[{"sigAEFalse", "[", "\"\<Metadata\>\"", "]"}], 
        "[", "\"\<PreparationPhaseShifts\>\"", "]"}], ",", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"sigAEFalse", "[", "\"\<Cos\>\"", "]"}], "-", 
          RowBox[{"sigAEFalse", "[", "\"\<Sin\>\"", "]"}]}], "]"}], "]"}]}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Configuration\>\"", ",", "\"\<AutoQuad Active?\>\"", 
        ",", "\"\<PreparationPhaseShifts\>\"", 
        ",", "\"\<Max |Cos - Sin|\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",\

