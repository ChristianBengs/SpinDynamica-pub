Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MemberQ", "[", 
    RowBox[{"$Packages", ",", "\"\<Signals`Signal2D`\>\""}], "]"}], ",", 
   RowBox[{"MemberQ", "[", 
    RowBox[{"$Packages", ",", "\"\<Simulations`Signal2D`\>\""}], "]"}], ",", 
