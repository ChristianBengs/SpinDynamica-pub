Cell[CellGroupData[{

Cell["9. QuadratureDiagnostics", "Section",ExpressionUUID->"6321c537-3dc9-304b-b481-0797c2abcfef"],

Cell["\<\
QuadratureDiagnostics[sig] and QuadratureDiagnostics[spec] return a \
structured report summarizing quadrature encoding, channel norms, phase \
shifts, diagnostic warnings, and (for Spectrum2D) supported processing \
capabilities. You can also control automatic runtime warnings inside Signal2D \
via the QuadratureDiagnostics option (Automatic, True, \"Verbose\", False, \
None).\
\>", "Text",ExpressionUUID->"1a0bd0d5-feae-634d-8b14-20028f4b3583"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagSig", "=", 
   RowBox[{"QuadratureDiagnostics", "[", "sigHSQC", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diagSpec", "=", 
   RowBox[{"QuadratureDiagnostics", "[", "specHSQC", "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"KeyTake", "[", 
   RowBox[{"diagSig", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<ObjectType\>\"", ",", "\"\<Status\>\"", 
      ",", "\"\<QuadratureMethod\>\"", ",", "\"\<QuadratureOrder\>\"", 
      ",", "\"\<QuadratureSpins\>\"", ",", "\"\<HeteronuclearDetected\>\"", 
      ",", "\"\<AutomaticQuadratureEncoding\>\"", ",", "\"\<ChannelNorms\>\"",
       ",", "\"\<ChannelRatio\>\"", ",", "\"\<ZeroChannels\>\"", 
      ",", "\"\<PreparationPhaseShifts\>\"", ",", "\"\<Warnings\>\""}], 
     "}"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"f9caa19f-6293-d946-98a8-8e04d9fc52b9"],

