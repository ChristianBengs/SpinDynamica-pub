Cell["\<\
What to observe: Because Evolution1 refocuses J_HN during t1 while direct \
acquisition evolves freely, a pure absorptive doublet appears along F2 at nuH \
+/- J_HN/2 = 134 Hz and 226 Hz, centered at the 15N frequency F1 = -210 Hz.\
\>", "Text",ExpressionUUID->"5b2a4834-e7b9-e14a-9c72-f24358f9de59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. QuadratureSpins, QuadratureOrder, and CoherencePathway", "Section",ExpressionUUID->"5cd4f9b2-299d-7940-9e65-a2c772d75cc1"],

Cell["\<\
In multi-spin systems it is essential to distinguish three related options:
  - QuadratureSpins: specifies WHICH spins receive the indirect quadrature \
phase shift or coherence filter ({\"15N\"} in HSQC, rather than All).
  - QuadratureOrder: specifies the positive integer coherence order q scaling \
the preparation phase step (-Pi/(2q)) and Echo/AntiEcho filters (+/- q).
  - CoherencePathway: applies explicit coherence-order filtration \
before/after mixing (independent of quadrature encoding, unlike explicit \
multi-scan PhaseCycle averaging).\
\>", "Text",ExpressionUUID->"1eda202d-d3cc-de4f-b601-aff2c87ccf77"],

Cell["\<\
In our HSQC, 15N evolves as single-quantum coherence (p1 in {-1, +1}) during \
t1 and 1H is detected at p2 = -1 after mixing. Adding CoherencePathway -> \
{{-1, 1}, -1} explicitly enforces this pathway and agrees with the unfiltered \
HSQC to machine precision.\
\>", "Text",ExpressionUUID->"fd07da0d-dbe5-ff42-acc6-562caab31fa0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigHSQCPath", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"CoherencePathway", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Max", "[", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"sigHSQCPath", "[", "\"\<Cos\>\"", "]"}], "-", 
    RowBox[{"sigHSQC", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"36f327e4-9060-8642-b960-013a7fe11927"],

Cell[BoxData["2.3714374201337736`*^-16"], "Output",
 CellLabel->"Out[5]=",ExpressionUUID->"6e90c21e-59e6-f64b-ad3b-f6836a4dff98"]
}, Open  ]],

Cell["\<\
As a brief isolated example of higher coherence order on this same two-spin \
pair, a two-spin double-quantum (q = 2) preparation creates +/-2 coherence \
spanning BOTH spins (QuadratureSpins -> {\"1H\", \"15N\"}). Setting \
QuadratureOrder -> 2 adjusts the preparation States phase step to -Pi/4, and \
CoherencePathway -> {{-2, 2}} filters out zero-quantum terms so the indirect \
peak appears cleanly at the sum frequency nuH + nuN = 180 - 210 = -30 Hz.\
\>", "Text",ExpressionUUID->"542e1551-34eb-1b45-bee3-df87b94abbc5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"prepDQ", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
     RowBox[{"Delay", "[", 
      RowBox[{"2.", "*", "tauHN"}], "]"}], ",", 
     RowBox[{"Pulse", "[", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mixDQ", "=", 
   RowBox[{"Pulse", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pi", "/", "2"}], ",", "\"\<x\>\""}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sigDQ", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepDQ"}], ",", 
     RowBox[{"Mixing", "->", "mixDQ"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<15N\>\""}], "}"}]}], ",", 
     RowBox[{"QuadratureOrder", "->", "2"}], ",", 
     RowBox[{"CoherencePathway", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "2"}], "}"}], "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specDQ", "=", 
   RowBox[{"FT", "[", 
    RowBox[{"sigDQ", ",", 
     RowBox[{"ZeroFill", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<DQ PreparationPhaseShifts\>\"", "->", 
    RowBox[{
     RowBox[{"sigDQ", "[", "\"\<Metadata\>\"", "]"}], 
     "[", "\"\<PreparationPhaseShifts\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Peak F1 (Hz) vs nuH + nuN\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"specDQ", "[", "\"\<Frequency1\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"First", "[", 
         RowBox[{"Ordering", "[", 
          RowBox[{
           RowBox[{"Max", "/@", 
            RowBox[{"specDQ", "[", "\"\<HypercomplexMagnitude\>\"", "]"}]}], ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"nuH", "+", "nuN"}]}], "}"}]}]}], "}"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"52765243-111a-ef4b-aa19-cbcc9d2fb7df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"DQ PreparationPhaseShifts\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"Cos\"\>", "\[Rule]", 
