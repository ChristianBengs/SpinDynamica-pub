Cell[CellGroupData[{

Cell["3. Alternative Propagation Methods (SignalCalculationMethod)", "Section",ExpressionUUID->"eee66dc2-8887-5f48-9422-6fd859aa29ce"],

Cell["\<\
Signal2D provides multiple numerical propagation backends via \
SignalCalculationMethod:
  - \"DoubleDiagonalization\" (Automatic default for static liquid-state \
problems): diagonalizes the indirect and direct generators once and evaluates \
all (t1, t2) points analytically in the eigenbasis. Usually fastest for \
ordinary static Hamiltonians and Liouvillians.
  - \"SteppedPropagator\": precomputes single-step propagators Exp[-I H dt] \
(and direct eigendecomposition when static) and steps sequentially; handles \
arbitrary stepped sequences during evolution.
  - \"Direct\": propagates step-by-step via general SpinDynamica trajectory \
evaluation; serves as the reference implementation for arbitrary \
time-dependent problems.
(For periodic time-dependent Hamiltonians such as MAS, Signal2D automatically \
selects \"COMPUTE2D\", which is covered in specialized solid-state tutorials.)

Setting ReportSignalCalculationMethod -> True prints which engine and state \
space (Hilbert vs Liouville) were selected. Here we verify that all three \
liquid-state engines agree to machine precision.\
\>", "Text",ExpressionUUID->"204ec8c7-03c1-464d-851b-9da1acc2e6a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigDD", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{
     "SignalCalculationMethod", "->", "\"\<DoubleDiagonalization\>\""}], ",", 
     
     RowBox[{"ReportSignalCalculationMethod", "->", "True"}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigStep", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"SignalCalculationMethod", "->", "\"\<SteppedPropagator\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigDir", "=", 
   RowBox[{"Signal2D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "48"}], "}"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "Pi", "800."}], ",", "96"}], "}"}], "}"}]}], "}"}], ",", 
     RowBox[{"InitialDensityOperator", "->", 
      RowBox[{"opI", "[", 
       RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], ",", 
     RowBox[{"BackgroundGenerator", "->", "Hhn"}], ",", 
     RowBox[{"Preparation", "->", "prepHN"}], ",", 
     RowBox[{"Evolution1", "->", "ev1Echo"}], ",", 
     RowBox[{"Mixing", "->", "mixConv"}], ",", 
     RowBox[{"Observable", "->", 
      RowBox[{"{", "\"\<1H\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureSpins", "->", 
      RowBox[{"{", "\"\<15N\>\"", "}"}]}], ",", 
     RowBox[{"QuadratureMethod", "->", "\"\<States\>\""}], ",", 
     RowBox[{"SignalCalculationMethod", "->", "\"\<Direct\>\""}], ",", 
     RowBox[{"LineBroadening", "->", "25."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Max |DD - SteppedPropagator|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigDD", "[", "\"\<Cos\>\"", "]"}], "-", 
       RowBox[{"sigStep", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   RowBox[{"\"\<Max |DD - Direct|\>\"", "->", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"sigDD", "[", "\"\<Cos\>\"", "]"}], "-", 
       RowBox[{"sigDir", "[", "\"\<Cos\>\"", "]"}]}], "]"}], "]"}]}]}], 
  "}"}]}], "Input",
