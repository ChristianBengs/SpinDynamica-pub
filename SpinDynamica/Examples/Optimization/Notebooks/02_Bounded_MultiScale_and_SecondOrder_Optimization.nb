    "\n", "  ", 
   RowBox[{"\"\<CacheMisses\>\"", " ", "->", " ", 
    RowBox[{"rCache", "[", 
     RowBox[{"\"\<CacheStats\>\"", ",", " ", "\"\<CacheMisses\>\""}], "]"}]}],
    ",", "\n", "  ", 
   RowBox[{"\"\<FinalAmplitude\>\"", " ", "->", " ", 
    RowBox[{"rCache", "[", "\"\<Value\>\"", "]"}]}]}], "\n", "|>"}]}], "Input",\
ExpressionUUID->"abcfcdf2-cd0f-4953-b7fc-89a525c9be99"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"e1b015e5-5fb2-49c3-b011-344d8b455f94"],

Cell["\<\
Lab G2A compares bounded optimization methods on 2-spin INEPT transfer across \
J-couplings and BoundTransform choices. Lab G2B benchmarks static event \
fusion compression as static chain length grows.\
\>", "Text",ExpressionUUID->"14fd34ca-ff5b-4057-89ec-48239b4b2b43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabG2A", "[", 
     RowBox[{
      RowBox[{"jHz_", "?", "NumericQ"}], ",", " ", "solv_String", ",", " ", 
      "btMode_String"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "pr", ",", " ", "useDeriv", ",", " ", "useBt", ",", " ", "r", ",", " ",
         "hist", ",", " ", "infTrace", ",", " ", "tExact"}], "}"}], ",", "\n",
       "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"pr", " ", "=", " ", 
        RowBox[{"TransformationOptimizationProblem", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"2", " ", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}]}]}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Pulse", "[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<x\>\""}], "}"}]}], 
             "]"}], ",", " ", 
            RowBox[{"Delay", "[", "tau1", "]"}], ",", " ", 
            RowBox[{"Pulse", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"Pi", ",", " ", "\"\<x\>\""}], "}"}]}], "]"}], ",", 
            " ", 
            RowBox[{"Delay", "[", "tau2", "]"}], ",", " ", 
            RowBox[{"Pulse", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Pi", "/", "2"}], ",", " ", "\"\<y\>\""}], "}"}]}], 
             "]"}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tau1", ",", " ", "0.0008", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0.0002", ",", " ", "0.02"}], "}"}]}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"tau2", ",", " ", "0.0010", ",", " ", 
              RowBox[{"{", 
               RowBox[{"0.0002", ",", " ", "0.02"}], "}"}]}], "}"}]}], "}"}], 
          ",", "\n", "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", 
           RowBox[{"2.", " ", "Pi", " ", "*", " ", "jHz", " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], ")"}]}]}]}], 
         "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"useDeriv", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"solv", " ", "===", " ", "\"\<Powell\>\""}], ",", 
          " ", "\"\<None\>\"", ",", " ", "Automatic"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"useBt", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<HybridLBFGSNewtonCG\>\"", ",", 
               " ", "\"\<TrustRegionNewtonCG\>\"", ",", 
               " ", "\"\<NewtonRFO\>\""}], "}"}], ",", " ", "solv"}], "]"}], 
           " ", "&&", " ", 
           RowBox[{"btMode", " ", "===", " ", "\"\<None\>\""}]}], ",", 
          " ", "\"\<Sigmoid\>\"", ",", " ", "btMode"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"OptimizeTransformationAmplitude", "[", 
         RowBox[{"pr", ",", "\n", "    ", 
          RowBox[{"Optimizer", " ", "->", " ", "solv"}], ",", "\n", "    ", 
          RowBox[{"DerivativeMethod", " ", "->", " ", "useDeriv"}], ",", "\n",
           "    ", 
          RowBox[{"BoundTransform", " ", "->", " ", "useBt"}], ",", "\n", 
          "    ", 
          RowBox[{"RecordHistory", " ", "->", " ", "True"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"hist", " ", "=", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<Association\>\"", "]"}], ",", 
          " ", "\"\<ObjectiveHistory\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", "[", "\"\<Value\>\"", "]"}], "}"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"infTrace", " ", "=", " ", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}], ",", 
             " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.*^-16", ",", " ", 
               RowBox[{"1.", " ", "-", " ", 
                RowBox[{"N", "[", 
                 RowBox[{"Re", "[", "#1", "]"}], "]"}]}]}], "]"}]}], "}"}], 
           " ", "&"}], ",", " ", "hist"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"tExact", " ", "=", " ", 
        RowBox[{"1.", " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"2.", " ", "*", " ", "jHz"}], ")"}]}]}], ";", "\n", "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "r"}], ",", "\n", "    ", 
         RowBox[{"\"\<Solver\>\"", " ", "->", " ", "solv"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<EffectiveBT\>\"", " ", "->", " ", "useBt"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<JHz\>\"", " ", "->", " ", "jHz"}], ",", "\n", "    ", 
         RowBox[{"\"\<SumDelays\>\"", " ", "->", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"r", "[", "\"\<ParametersVec\>\"", "]"}], "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<AnalyticalSum\>\"", " ", "->", " ", "tExact"}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<Trace\>\"", " ", "->", " ", "infTrace"}]}], "\n", "  ", 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLabG2A", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
