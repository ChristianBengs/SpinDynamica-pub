Notebook[{
Cell["02. Bounded, Multi-Scale, and Second-Order Optimisation", "Title",ExpressionUUID->"dbed943b-3adf-4a5c-a674-d18b8fdb672e"],

Cell["\<\
ConstrainPositive and box bounds, automatic coordinate scaling across \
10^-3..10^3, O(K) exact HVP verification, BoundTransform -> \"Sigmoid\" / \
\"Log\", and static event fusion + dependency caching.\
\>", "Subtitle",ExpressionUUID->"f0f74ed1-dc23-4d74-a42c-4c78ac097f9f"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"a86d17ac-20d0-4bc0-b890-820df501372b"],

Cell["\<\
Evaluate Cell 1 then Cell 2 to load SpinDynamica and verify second-order and \
verification symbols.\
\>", "Text",ExpressionUUID->"52365ef7-b326-427e-90bb-3fd81d98bca7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dir", " ", "=", " ", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"FileExistsQ", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
               " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"found", " ", "=", " ", "dir"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"dir", " ", "=", " ", 
          RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"{", "6", "}"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
              ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
         "\n", "    ", 
        RowBox[{"found", " ", "=", " ", 
         RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
      "found"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], ",", "\n", "  ", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", " ", "\"\<SpinDynamica\>\"", ",", 
         " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "\n", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"f7f95f45-36ed-4a76-a89f-7658e53aa874"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetUserLevel", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   "\n", "  ", 
