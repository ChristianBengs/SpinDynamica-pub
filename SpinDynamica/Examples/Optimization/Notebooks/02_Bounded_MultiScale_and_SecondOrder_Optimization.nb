 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabG2B", "[", "nStatic_Integer", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "bg", ",", " ", "half", ",", " ", "rest", ",", " ", "evs", ",", " ", 
        "pr", ",", " ", "cR", ",", " ", "cF", ",", " ", "oR", ",", " ", "oF", 
        ",", " ", "x0", ",", " ", "tR", ",", " ", "tF"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"bg", " ", "=", " ", 
        RowBox[{"2.", " ", "Pi", " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"80.", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
           RowBox[{"140.", " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], ")"}]}]}], 
          ")"}]}]}], ";", "\n", "  ", 
       RowBox[{"half", " ", "=", " ", 
        RowBox[{"Floor", "[", 
         RowBox[{"nStatic", " ", "/", " ", "2"}], "]"}]}], ";", " ", 
       RowBox[{"rest", " ", "=", " ", 
        RowBox[{"nStatic", " ", "-", " ", "half"}]}], ";", "\n", "  ", 
       RowBox[{"evs", " ", "=", " ", 
        RowBox[{"Join", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "i", "]"}], ",", " ", 
              RowBox[{"Pulse", "[", 
               RowBox[{"1", ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Pi", "/", "30"}], ",", " ", "\"\<x\>\""}], "}"}]}],
                "]"}], ",", " ", 
              RowBox[{"Delay", "[", "0.0001", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "half"}], "}"}]}], "]"}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"Pulse", "[", 
            RowBox[{"1", ",", " ", 
             RowBox[{"{", 
              RowBox[{"bF1", ",", " ", "\"\<y\>\""}], "}"}]}], "]"}], "}"}], ",",
           "\n", "    ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"OddQ", "[", "i", "]"}], ",", " ", 
              RowBox[{"Pulse", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Pi", "/", "25"}], ",", " ", "\"\<y\>\""}], "}"}]}],
                "]"}], ",", " ", 
              RowBox[{"Delay", "[", "0.0001", "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"i", ",", " ", "rest"}], "}"}]}], "]"}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"Pulse", "[", 
            RowBox[{"2", ",", " ", 
             RowBox[{"{", 
              RowBox[{"bF2", ",", " ", "\"\<x\>\""}], "}"}]}], "]"}], "}"}]}],
          "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"pr", " ", "=", " ", 
        RowBox[{"TransformationOptimizationProblem", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"2", " ", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}]}]}], ",", " ", 
          "evs", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"bF1", ",", " ", "1.1"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"bF2", ",", " ", "1.2"}], "}"}]}], "}"}], ",", " ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", "bg"}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"cR", " ", "=", " ", 
        RowBox[{"CompileTransformationOptimization", "[", 
         RowBox[{"pr", ",", " ", 
          RowBox[{"FuseStaticEvents", " ", "->", " ", "False"}], ",", " ", 
          RowBox[{"EnableCaching", " ", "->", " ", "False"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"cF", " ", "=", " ", 
        RowBox[{"CompileTransformationOptimization", "[", 
         RowBox[{"pr", ",", " ", 
          RowBox[{"FuseStaticEvents", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"EnableCaching", " ", "->", " ", "True"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"oR", " ", "=", " ", 
        RowBox[{"EvaluateTransformationOptimization", "[", 
         RowBox[{"cR", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.1", ",", " ", "1.2"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"oF", " ", "=", " ", 
        RowBox[{"EvaluateTransformationOptimization", "[", 
         RowBox[{"cF", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.1", ",", " ", "1.2"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"x0", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"1.1", ",", " ", "1.2"}], "}"}]}], ";", "\n", "  ", 
       RowBox[{"tR", " ", "=", " ", 
        RowBox[{"1000.", " ", "*", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"EvaluateTransformationOptimization", "[", 
               RowBox[{"cR", ",", " ", "x0"}], "]"}], ",", " ", 
              RowBox[{"{", "20", "}"}]}], "]"}], "]"}], "]"}], " ", "/", " ", 
          "20."}]}]}], ";", "\n", "  ", 
       RowBox[{"tF", " ", "=", " ", 
        RowBox[{"1000.", " ", "*", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"EvaluateTransformationOptimization", "[", 
               RowBox[{"cF", ",", " ", "x0"}], "]"}], ",", " ", 
              RowBox[{"{", "20", "}"}]}], "]"}], "]"}], "]"}], " ", "/", " ", 
          "20."}]}]}], ";", "\n", "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<TotalEvents\>\"", " ", "->", " ", 
          RowBox[{"nStatic", " ", "+", " ", "2"}]}], ",", "\n", "    ", 
         RowBox[{"\"\<RawStages\>\"", " ", "->", " ", 
          RowBox[{"cR", "[", "\"\<NumStagesTotal\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<FusedStages\>\"", " ", "->", " ", 
          RowBox[{"cF", "[", "\"\<NumStagesTotal\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<UnfusedGradMs\>\"", " ", "->", " ", "tR"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<FusedGradMs\>\"", " ", "->", " ", "tF"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<Speedup\>\"", " ", "->", " ", 
          RowBox[{"tR", " ", "/", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"tF", ",", " ", "1.*^-6"}], "]"}]}]}], ",", "\n", "    ", 
         
         RowBox[{"\"\<GradDiff\>\"", " ", "->", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"oR", "[", "\"\<Gradient\>\"", "]"}], " ", "-", " ", 
             RowBox[{"oF", "[", "\"\<Gradient\>\"", "]"}]}], "]"}], "]"}]}]}],
         "\n", "  ", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
