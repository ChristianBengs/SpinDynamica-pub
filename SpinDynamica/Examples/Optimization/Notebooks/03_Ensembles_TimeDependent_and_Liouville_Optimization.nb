Cell[CellGroupData[{
Cell["\<\
03. Ensembles, Time-Dependent Hamiltonians, and Liouville Optimisation\
\>", "Title",ExpressionUUID->"195c65ce-8585-482f-9564-3b0ece4c01fa"],

Cell["\<\
Robust EnsembleAverage design, CF4 time-dependent generators, dissipative \
Liouville relaxation rates, coherence-order filtration, and non-smooth \
fallback.\
\>", "Subtitle",ExpressionUUID->"3c314229-69ca-449d-b851-b6494c449d03"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"6f4e2929-874e-40c7-b32b-caeaeba015d0"],

Cell["\<\
Evaluate Cell 1 then Cell 2 to initialize SpinDynamica from the local \
repository checkout.\
\>", "Text",ExpressionUUID->"9fc913f8-e906-4121-88f4-bf24347e0cb4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dir", " ", "=", " ", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"FileExistsQ", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
               " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"found", " ", "=", " ", "dir"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"dir", " ", "=", " ", 
          RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"{", "6", "}"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
              ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
         "\n", "    ", 
        RowBox[{"found", " ", "=", " ", 
         RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
      "found"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], ",", "\n", "  ", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", " ", "\"\<SpinDynamica\>\"", ",", 
         " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "\n", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"8824be11-d56b-48ed-8ed1-b2bbb0679689"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetUserLevel", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CF4Option\>\"", " ", "->", " ", "Substeps"}], ",", "\n", "  ", 
   RowBox[{"\"\<SpacesSupported\>\"", " ", "->", " ", 
