 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabG3B", "[", 
     RowBox[{
      RowBox[{"t2Sec_", "?", "NumericQ"}], ",", " ", "nSub_Integer"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rL", ",", " ", "prT", ",", " ", "vgT"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", "\n", "  ", 
       RowBox[{"rL", " ", "=", " ", 
        RowBox[{"OptimizeTransformationAmplitude", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "    ", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"wRFl", " ", "*", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Cos", "[", "phiL", "]"}], " ", 
                  RowBox[{"opI", "[", 
                   RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", 
                 " ", 
                 RowBox[{
                  RowBox[{"Sin", "[", "phiL", "]"}], " ", 
                  RowBox[{"opI", "[", 
                   RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",",
               " ", "0.004"}], "}"}], ",", " ", 
            RowBox[{"Delay", "[", "0.002", "]"}]}], "}"}], ",", "\n", "    ", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"wRFl", ",", " ", "300."}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"phiL", ",", " ", "0.4"}], "}"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"CommutationSuperoperator", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "*", " ", "2.", " ", "Pi", " ", "*", 
               " ", "60.", " ", "*", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], " ", "+",
              "\n", "      ", 
             RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
              RowBox[{"0.5", ",", " ", "t2Sec"}], "]"}]}], ")"}]}], ",", "\n",
           "    ", 
          RowBox[{"Optimizer", " ", "->", " ", "\"\<LBFGS\>\""}], ",", " ", 
          RowBox[{"LineSearch", " ", "->", " ", "\"\<HagerZhang\>\""}]}], 
         "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"prT", " ", "=", " ", 
        RowBox[{"TransformationOptimizationProblem", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "    ", 
          
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Delay", "[", "tPre", "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"TimeDependentGeneratorFunction", "[", 
               RowBox[{"t", ",", " ", 
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{"s", ",", " ", "0"}], "}"}], "}"}], ",", " ", "1", ",",
                 "\n", "      ", 
                RowBox[{"aMax", " ", "*", " ", 
                 RowBox[{"(", 
                  RowBox[{"1.", " ", "-", " ", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"2.", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"s", " ", "-", " ", 
                    RowBox[{"0.5", " ", "tDur"}]}], ")"}], " ", "/", " ", 
                    "tDur"}]}], ")"}], "^", "2"}]}], ")"}], " ", "*", " ", 
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], "]"}], ",",
               " ", "tDur"}], "}"}]}], "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"tPre", ",", " ", "0.001"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"aMax", ",", " ", "1100."}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"tDur", ",", " ", "0.002"}], "}"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", 
           RowBox[{"180.", " ", "*", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"vgT", " ", "=", " ", 
