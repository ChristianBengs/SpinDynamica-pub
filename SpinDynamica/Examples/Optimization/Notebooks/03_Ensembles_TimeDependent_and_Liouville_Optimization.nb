         RowBox[{"\"\<Substeps\>\"", " ", "->", " ", "nSub"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<CF4GradRelErr\>\"", " ", "->", " ", 
          RowBox[{"vgT", "[", "\"\<RelativeError\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<CF4GradPassed\>\"", " ", "->", " ", 
          RowBox[{"vgT", "[", "\"\<Passed\>\"", "]"}]}]}], "\n", "  ", 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
