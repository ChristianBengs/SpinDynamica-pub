          RowBox[{"\"\<Grad RelErr vs Central FD: \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"ScientificForm", "[", 
             RowBox[{
              RowBox[{"d", "[", "\"\<CF4GradRelErr\>\"", "]"}], ",", " ", 
              "3"}], "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<Space: \>\"", " ", "<>", " ", 
           RowBox[{"d", "[", "\"\<LiouvilleSpace\>\"", "]"}]}], ",", " ", 
          RowBox[{"\"\<Gradient Check Passed: \>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", 
            RowBox[{"d", "[", "\"\<CF4GradPassed\>\"", "]"}], "]"}]}]}], 
         "}"}]}], "\n", "}"}], ",", " ", 
      RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
      RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"labG3ADefault", " ", "=", " ", 
   RowBox[{"runLabG3A", "[", 
    RowBox[{"300.", ",", " ", "0.1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"labG3BDefault", " ", "=", " ", 
   RowBox[{"runLabG3B", "[", 
    RowBox[{"0.08", ",", " ", "16"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
