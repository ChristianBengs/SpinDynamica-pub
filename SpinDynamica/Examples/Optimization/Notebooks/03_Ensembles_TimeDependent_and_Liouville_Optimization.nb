           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", "p1", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "p1", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",", 
          " ", "0.0005"}], "}"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rf", " ", "*", " ", 
           RowBox[{"(", 
            RowBox[{"b2", " ", "/", " ", "0.0005"}], ")"}], " ", "*", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", "p2", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", " ", 
