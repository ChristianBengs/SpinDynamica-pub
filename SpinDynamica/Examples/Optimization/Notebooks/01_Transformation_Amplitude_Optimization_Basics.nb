                    RowBox[{
                    RowBox[{"r", "[", "\"\<ElapsedTime\>\"", "]"}], " ", "-", 
                    " ", 
                    RowBox[{"r", "[", "\"\<CompileTime\>\"", "]"}]}], ")"}]}],
                   ",", " ", "0.01"}], "]"}]}], "}"}], ",", "\n", "      ", 
              RowBox[{"{", 
               RowBox[{"\"\<Iterations / Obj / Grad Evals\>\"", ",", " ", 
                RowBox[{"Row", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}], ",", 
