            RowBox[{"{", "\n", "      ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<Final Amplitude\>\"", ",", " ", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"r", "[", "\"\<Value\>\"", "]"}], ",", " ", "10"}], 
                 "]"}], ",", " ", "\"\<Status\>\"", ",", " ", 
                RowBox[{"r", "[", "\"\<Status\>\"", "]"}]}], "}"}], ",", "\n",
               "      ", 
              RowBox[{"{", 
               RowBox[{"\"\<Optimal Rules\>\"", ",", " ", 
                RowBox[{"r", "[", "\"\<Rules\>\"", "]"}], ",", 
