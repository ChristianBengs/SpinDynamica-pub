Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"off", " ", "=", " ", "150."}], ",", " ", 
     RowBox[{"wInit", " ", "=", " ", "1200."}], ",", " ", 
     RowBox[{"solv", " ", "=", " ", "\"\<LBFGS\>\""}], ",", " ", 
     RowBox[{"ls", " ", "=", " ", "\"\<StrongWolfe\>\""}], ",", " ", 
     RowBox[{"data", " ", "=", " ", "labG1Default"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Panel", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Offset (Hz):\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "off", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0.", ",", " ", "400.", ",", " ", "25."}], "}"}]}],
                  "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "off", "]"}]}], "}"}], "]"}]}], "}"}],
            ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Initial wRF (rad/s):\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "wInit", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"400.", ",", " ", "2400.", ",", " ", "100."}], 
                   "}"}]}], "]"}], ",", " ", "\"\< \>\"", ",", " ", 
