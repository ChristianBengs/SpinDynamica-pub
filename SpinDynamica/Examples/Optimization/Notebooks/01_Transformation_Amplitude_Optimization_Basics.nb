        RowBox[{"wRF", " ", "*", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", "phi", "]"}], " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "phi", "]"}], " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",", 
        " ", "0.002"}], "}"}], "}"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"wRF", ",", " ", "1200."}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"phi", ",", " ", "0.5"}], "}"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"BackgroundGenerator", " ", "->", " ", 
      RowBox[{"2.", " ", "Pi", " ", "*", " ", "150.", " ", "*", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"compB2", " ", "=", " ", 
    RowBox[{"CompileTransformationOptimization", "[", "probB2", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solverConfigs", " ", "=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<LBFGS (StrongWolfe)\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Optimizer", " ", "->", " ", "\"\<LBFGS\>\""}], ",", " ", 
          RowBox[{"LineSearch", " ", "->", " ", "\"\<StrongWolfe\>\""}]}], 
         "}"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<BFGS (Adjoint)\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Optimizer", " ", "->", " ", "\"\<BFGS\>\""}], "}"}]}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<FindMinimum (Adjoint)\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{"Optimizer", " ", "->", " ", "\"\<FindMinimum\>\""}], 
         "}"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<FindMinimum (No Grad)\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Optimizer", " ", "->", " ", "\"\<FindMinimum\>\""}], ",", 
          " ", 
          RowBox[{"DerivativeMethod", " ", "->", " ", "\"\<None\>\""}]}], 
         "}"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<NelderMead\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Optimizer", " ", "->", " ", "\"\<NelderMead\>\""}], ",", 
          " ", 
          RowBox[{"DerivativeMethod", " ", "->", " ", "\"\<None\>\""}]}], 
         "}"}]}], "}"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<Powell\>\"", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Optimizer", " ", "->", " ", "\"\<Powell\>\""}], ",", " ", 
          RowBox[{"DerivativeMethod", " ", "->", " ", "\"\<None\>\""}]}], 
         "}"}]}], "}"}]}], "\n", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"rows", " ", "=", " ", 
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"OptimizeTransformationAmplitude", "[", 
          RowBox[{"probB2", ",", " ", 
           RowBox[{"Sequence", " ", "@@", " ", 
            RowBox[{"cfg", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cfg", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
         RowBox[{"r", "[", "\"\<DerivativeMethod\>\"", "]"}], ",", " ", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"r", "[", "\"\<Value\>\"", "]"}], ",", " ", "8"}], "]"}], ",",
          "\n", "     ", 
         RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}], ",", " ", 
         RowBox[{"r", "[", "\"\<Evaluations\>\"", "]"}], ",", "\n", "     ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"1000.", " ", "*", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", "[", "\"\<ElapsedTime\>\"", "]"}], " ", "-", " ", 
              RowBox[{"r", "[", "\"\<CompileTime\>\"", "]"}]}], ")"}]}], ",", 
           " ", "0.01"}], "]"}], ",", " ", 
         RowBox[{"r", "[", "\"\<Status\>\"", "]"}]}], "}"}]}], "\n", "  ", 
      "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"cfg", ",", " ", "solverConfigs"}], "}"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{"rows", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Solver\>\"", ",", " ", "\"\<Deriv\>\"", ",", 
       " ", "\"\<Final Amp\>\"", ",", " ", "\"\<Iters\>\"", ",", 
       " ", "\"\<Obj Evals\>\"", ",", " ", "\"\<Solve (ms)\>\"", ",", 
       " ", "\"\<Status\>\""}], "}"}]}], "]"}], ",", "\n", "  ", 
   RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", 
   RowBox[{"Background", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"LightGray", ",", " ", 
        RowBox[{"{", "White", "}"}]}], "}"}]}], "}"}]}]}], "]"}]}], "Input",Ex\
pressionUUID->"8f245bbe-072f-4cee-93fe-1af0c7383fb1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"3eecdc8e-6677-4513-bd29-77e8d888eed9"],

Cell["\<\
Explore how offset frequency, initial RF amplitude, solver choice, and line \
search affect convergence trajectories and solve times.\
\>", "Text",ExpressionUUID->"fdaa39d7-6fe0-44e3-ae0d-2229d809e67f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLabG1", "[", 
     RowBox[{
      RowBox[{"offsetHz_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"w0_", "?", "NumericQ"}], ",", " ", "solverName_String", ",", 
      " ", "lineSearch_String"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pr", ",", " ", "r", ",", " ", "hist", ",", " ", "infHist"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", "\n", "  ", 
       RowBox[{"pr", " ", "=", " ", 
        RowBox[{"TransformationOptimizationProblem", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "    ", 
          
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"wRF", " ", "*", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Cos", "[", "phi", "]"}], " ", 
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", 
                " ", 
                RowBox[{
                 RowBox[{"Sin", "[", "phi", "]"}], " ", 
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",",
              " ", "0.002"}], "}"}], "}"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"wRF", ",", " ", "w0"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"phi", ",", " ", "0.5"}], "}"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"BackgroundGenerator", " ", "->", " ", 
           RowBox[{
           "2.", " ", "Pi", " ", "*", " ", "offsetHz", " ", "*", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"r", " ", "=", " ", 
        RowBox[{"OptimizeTransformationAmplitude", "[", 
         RowBox[{"pr", ",", "\n", "    ", 
          RowBox[{"Optimizer", " ", "->", " ", "solverName"}], ",", "\n", 
          "    ", 
          RowBox[{"LineSearch", " ", "->", " ", "lineSearch"}], ",", "\n", 
          "    ", 
          RowBox[{"DerivativeMethod", " ", "->", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<NelderMead\>\"", ",", " ", "\"\<Powell\>\""}], 
                "}"}], ",", " ", "solverName"}], "]"}], ",", 
             " ", "\"\<None\>\"", ",", " ", "Automatic"}], "]"}]}], ",", "\n",
           "    ", 
          RowBox[{"RecordHistory", " ", "->", " ", "True"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"hist", " ", "=", " ", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"r", "[", "\"\<Association\>\"", "]"}], ",", 
