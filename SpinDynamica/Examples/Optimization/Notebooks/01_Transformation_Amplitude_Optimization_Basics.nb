              RowBox[{
               RowBox[{"r", "[", "\"\<Value\>\"", "]"}], ",", " ", "7"}], 
              "]"}], ",", " ", 
             RowBox[{"r", "[", "\"\<Evaluations\>\"", "]"}]}], "]"}]}], ",", 
          "\n", "    ", 
          RowBox[{"ImageSize", " ", "->", " ", "560"}]}], "\n", "  ", "]"}]}],
        ";", "\n", "  ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{
