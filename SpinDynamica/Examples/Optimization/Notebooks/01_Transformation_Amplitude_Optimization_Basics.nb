     RowBox[{"bDemo", " ", "===", " ", "999."}], ")"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<HoldAllOptAmplitude\>\"", " ", "->", " ", 
    RowBox[{"resIso", "[", "\"\<Value\>\"", "]"}]}]}], "\n", "|>"}]}], "Input",\
ExpressionUUID->"b0cabba0-61da-4d95-b432-61dd9651b523"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "bDemo", "]"}], ";"}], "\n", 
 RowBox[{
