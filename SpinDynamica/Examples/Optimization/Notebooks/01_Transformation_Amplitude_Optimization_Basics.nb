          RowBox[{"d", "[", "\"\<InfidelityTrace\>\"", "]"}], ",", "\n", 
          "    ", 
          RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
          RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", "\n", 
          "    ", 
          RowBox[{"PlotRange", " ", "->", " ", 
           RowBox[{"{", 
