          RowBox[{"{", 
           RowBox[{"r", "[", "\"\<Value\>\"", "]"}], "}"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"infHist", " ", "=", " ", 
        RowBox[{"MapIndexed", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#2", "]"}], " ", "-", " ", "1"}], ",", 
             " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.*^-16", ",", " ", 
               RowBox[{"1.", " ", "-", " ", 
                RowBox[{"N", "[", 
                 RowBox[{"Re", "[", "#1", "]"}], "]"}]}]}], "]"}]}], "}"}], 
           " ", "&"}], ",", " ", "hist"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"<|", "\n", "    ", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "r"}], ",", "\n", "    ", 
         RowBox[{"\"\<Solver\>\"", " ", "->", " ", "solverName"}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<LineSearch\>\"", " ", "->", " ", "lineSearch"}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<InfidelityTrace\>\"", " ", "->", " ", "infHist"}]}], 
        "\n", "  ", "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLabG1", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
