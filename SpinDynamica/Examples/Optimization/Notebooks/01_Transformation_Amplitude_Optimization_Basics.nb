Notebook[{
Cell["01. Transformation Amplitude Optimisation Basics", "Title",ExpressionUUID->"2cf8bd68-ed74-4641-b1c9-ff5f83398b02"],

Cell["\<\
Seamless acceleration via MaximizeTransformationAmplitude (Engine -> \
Automatic | \"Compiled\" | \"Legacy\"), HoldAll symbol safety, explicit \
problem compilation, and solver benchmarking.\
\>", "Subtitle",ExpressionUUID->"b939fc94-ae83-4261-97fc-a9f35e0be958"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"859385cd-9bac-422d-a36a-eaef539419d8"],

Cell["\<\
Evaluate both cells below to load SpinDynamica from the repository checkout.\
\>", "Text",ExpressionUUID->"3ade0660-7c87-4d9f-b1cb-39ac2036c425"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dir", " ", "=", " ", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
           RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
       RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"FileExistsQ", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{
              "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
               " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"found", " ", "=", " ", "dir"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"dir", " ", "=", " ", 
          RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", "\n", "    ", 
        RowBox[{"{", "6", "}"}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
         RowBox[{"FileExistsQ", "[", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
              ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
         "\n", "    ", 
        RowBox[{"found", " ", "=", " ", 
         RowBox[{"Directory", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
      "found"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], ",", "\n", "  ", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", " ", "\"\<SpinDynamica\>\"", ",", 
         " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", "\n", 
    "  ", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "\n", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"18fa64f8-6471-4919-92dc-eff23c949b52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetUserLevel", "[", "2", "]"}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<EngineOptions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "Automatic", ",", " ", "\"\<Compiled\>\"", ",", " ", "\"\<Legacy\>\""}], 
     "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<MTAAttributes\>\"", " ", "->", " ", 
    RowBox[{"Attributes", "[", "MaximizeTransformationAmplitude", "]"}]}]}], 
  "\n", "|>"}]}], "Input",ExpressionUUID->"85f12f63-2167-4c52-b259-\
a83e9ac66d5c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"e67d8456-e01c-4f19-badc-90ae5aa85953"],

Cell["\<\
SpinDynamica's upgraded MaximizeTransformationAmplitude preserves its classic \
{maxval, rules} signature while delegating by default (Engine -> Automatic) \
to the compiled engine in SpinDynamica/Optimization/.\
\>", "Text",ExpressionUUID->"17aebe89-77dd-4183-8a5a-ba170bf32a9c"],

Cell["\<\
Preserve backwards compatibility via Engine -> \"Legacy\" (with all six WP 3 \
defects fixed) or request Engine -> \"Compiled\" strictly.\
\>", "Item",ExpressionUUID->"c2ff2616-2b53-46b8-832c-c00eeebebe67"],

Cell["\<\
Inspect rich solver telemetry with ReturnResultObject -> True \
(TransformationOptimizationResult).\
\>", "Item",ExpressionUUID->"64ffe7d4-2436-476c-a4a2-2de23f818e94"],

Cell["\<\
Compare quasi-Newton (LBFGS, BFGS, CG), Wolfram FindMinimum (with analytical \
gradients), and derivative-free (NelderMead, Powell) backends on an \
off-resonance finite pulse.\
\>", "Item",ExpressionUUID->"e7846e0a-4291-464b-967a-764418133714"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"63faa2c3-b359-49a2-ba39-5ba96730f9de"],

Cell["\<\
Given initial density operator rho_ini, observable O, and parameterized \
events E(theta), SpinDynamica maximizes the real normalized transformation \
amplitude A(theta) = Re[Tr(O^dagger rho_K(theta)) / (norm * ||O||^2)]. \
Whereas Legacy FindMinimum reconstructs symbolic operator representations and \
approximates gradients via O(p) finite differences (~12-49 ms per \
evaluation), the compiled engine decomposes SpinDynamica generators once into \
packed numerical operator atoms H(theta) = Sum_r c_r(theta) M_r and evaluates \
both A(theta) and nabla A(theta) in a single O(1) reverse-mode spectral \
adjoint sweep.\
\>", "Text",ExpressionUUID->"60746280-0595-4691-86da-1872b4e502c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"04ff4b6e-71d2-4d89-b31c-7066aada614e"],

Cell["\<\
Optimize an off-resonance finite pulse (RF amplitude wRF and phase phi at 150 \
Hz offset) using Legacy, Compiled, HoldAll global-variable isolation, and \
five solver configurations.\
\>", "Text",ExpressionUUID->"eff164c0-199d-4480-893b-8d424bb5760d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"tLeg", ",", " ", "resLeg"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
    RowBox[{"Quiet", "[", 
     RowBox[{"MaximizeTransformationAmplitude", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"wRF", " ", "*", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", "phi", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "phi", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",", 
          " ", "0.002"}], "}"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"wRF", ",", " ", "1200."}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"phi", ",", " ", "0.5"}], "}"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"BackgroundGenerator", " ", "->", " ", 
        RowBox[{"2.", " ", "Pi", " ", "*", " ", "150.", " ", "*", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{"Engine", " ", "->", " ", "\"\<Legacy\>\""}]}], "\n", "  ", 
      "]"}], "]"}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tComp", ",", " ", "resComp"}], "}"}], " ", "=", " ", 
    RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
     RowBox[{"MaximizeTransformationAmplitude", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"wRF", " ", "*", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", "phi", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "+", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "phi", "]"}], " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}], ",", 
          " ", "0.002"}], "}"}], "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"wRF", ",", " ", "1200."}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"phi", ",", " ", "0.5"}], "}"}]}], "}"}], ",", "\n", "    ", 
       RowBox[{"BackgroundGenerator", " ", "->", " ", 
        RowBox[{"2.", " ", "Pi", " ", "*", " ", "150.", " ", "*", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", "\n", "    ", 
       
       RowBox[{"Engine", " ", "->", " ", "\"\<Compiled\>\""}], ",", "\n", 
       "    ", 
       RowBox[{"ReturnResultObject", " ", "->", " ", "True"}]}], "\n", "  ", 
      "]"}], "\n", "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Verify", " ", "HoldAll", " ", "prevents", " ", "global", " ", "OwnValue", 
    " ", "collisions"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"bDemo", " ", "=", " ", "999."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resIso", " ", "=", " ", 
    RowBox[{"OptimizeTransformationAmplitude", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"Pulse", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"{", 
          RowBox[{"bDemo", ",", " ", "\"\<y\>\""}], "}"}]}], "]"}], "}"}], ",",
       "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"bDemo", ",", " ", "0.4"}], "}"}], "}"}], ",", "\n", "  ", 
      RowBox[{"Optimizer", " ", "->", " ", "\"\<LBFGS\>\""}]}], "\n", "]"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<LegacyAmplitude\>\"", " ", "->", " ", 
    RowBox[{"resLeg", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<LegacyWall_ms\>\"", " ", "->", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"1000.", " ", "*", " ", "tLeg"}], ",", " ", "0.01"}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<CompiledAmplitude\>\"", " ", "->", " ", 
    RowBox[{"resComp", "[", "\"\<Value\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<CompiledSolve_ms\>\"", " ", "->", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"1000.", " ", "*", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"resComp", "[", "\"\<ElapsedTime\>\"", "]"}], " ", "-", " ", 
         
         RowBox[{"resComp", "[", "\"\<CompileTime\>\"", "]"}]}], ")"}]}], ",",
       " ", "0.01"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<CompiledTotalWall_ms\>\"", " ", "->", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"1000.", " ", "*", " ", "tComp"}], ",", " ", "0.01"}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"\"\<HoldAllPreservedGlobal\>\"", " ", "->", " ", 
