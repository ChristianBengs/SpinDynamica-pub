  "Hyperlink"],
 " or continue to 02_Bounded_MultiScale_and_SecondOrder_Optimization.nb."
}], "Item",ExpressionUUID->"5c6ec8f4-80df-4aa6-a2c9-b8e2aa881c6e"]
}, Open  ]]
