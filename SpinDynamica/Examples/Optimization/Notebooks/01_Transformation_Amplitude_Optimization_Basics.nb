              RowBox[{"1.*^-16", ",", " ", "2."}], "}"}]}], "}"}]}], ",", 
          "\n", "    ", 
          RowBox[{"FrameLabel", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<Iteration\>\"", ",", " ", "\"\<1 - Amplitude\>\""}], 
            "}"}]}], ",", "\n", "    ", 
          RowBox[{"PlotLabel", " ", "->", " ", 
           RowBox[{"StringForm", "[", 
            
            RowBox[{"\"\<`1` (`2`): amp=`3`, evals=`4`\>\"", ",", "\n", 
