            "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Optimizer:\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "solv", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<LBFGS\>\"", ",", " ", "\"\<BFGS\>\"", ",", 
                 " ", "\"\<CG\>\"", ",", " ", "\"\<NelderMead\>\"", ",", 
                 " ", "\"\<Powell\>\"", ",", " ", "\"\<FindMinimum\>\""}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<LineSearch:\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "ls", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<StrongWolfe\>\"", ",", " ", "\"\<HagerZhang\>\"",
                  ",", " ", "\"\<ZhangHagerNonmonotone\>\""}], "}"}]}], 
              "]"}]}], "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<Run Optimisation\>\"", ",", " ", 
         RowBox[{"data", " ", "=", " ", 
          RowBox[{"runLabG1", "[", 
           RowBox[{
           "off", ",", " ", "wInit", ",", " ", "solv", ",", " ", "ls"}], 
           "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"renderLabG1", "[", "data", "]"}], "]"}]}], "\n", "  ", "}"}],
      "]"}], "]"}]}], "\n", "]"}]], "Input",ExpressionUUID->"9e1db65b-23f2-\
4903-9903-433e618590ea"]
