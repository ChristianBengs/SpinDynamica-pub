Notebook[{

Cell[CellGroupData[{
Cell["\<\
SpinDynamica Optimal Control Tutorial 02: Two-Spin Transfers, Ensembles, \
Relaxation, and Time-Optimal Control\
\>", "Title",ExpressionUUID->"f6692ad9-8888-9645-bb92-371cce986f11"],

Cell["\<\
Heteronuclear transfers, cooperative and trajectory-penalized objectives, \
robust broadband/B1 ensembles, Liouville relaxation, quantum speed limit \
searches, and Pontryagin diagnostics.\
\>", "Subtitle",ExpressionUUID->"ff7978d6-ecf7-c14b-8dc6-499cfe470903"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"deb14544-3567-8740-a5be-ff8b7c0a412c"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that all OptimalControl` packages \
(including Ensemble, TimeOptimal, and Visualization) loaded cleanly.\
\>", "Text",ExpressionUUID->"62d3a740-712c-fe4b-8330-9e3af4d65b1a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"9c4142ae-c724-e64d-a8a6-125cad1ea508"],

Cell["\<\
SetUserLevel::ini : The user level is being initialized to 2. The user level \
may be set to an integer between 1 and 3 by using SetUserLevel[level]. Low \
user levels provide strong syntax trapping at the expense of slow execution \
for some routines. High user levels relax the syntax trapping in order to \
provide better execution speeds.\
\>", "Message", "MSG",ExpressionUUID->"ebd8f3dc-669a-a84a-a902-8acbfffd930d"],

Cell["SetUserLevel::ul : The user level has been set to 2.", "Message", "MSG",ExpressionUUID->"12a5fe39-9f93-0d42-8190-9dca91bde5e0"],

Cell["\<\
SetUserLevel::modsymbs : Additional definitions have been given to the \
