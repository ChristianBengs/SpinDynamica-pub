Cell[CellGroupData[{

Cell["4. Mean vs Worst-Case (SoftMin) Ensemble Aggregation", "Section",ExpressionUUID->"2b89a00c-69b8-b348-a9ee-4d1e1d4fa0cf"],

Cell["\<\
Optimizing the average fidelity (EnsembleAggregation -> \"Mean\") can leave \
corner members of a 2D (offset x B1) grid significantly lower than the \
center. Setting EnsembleAggregation -> {\"SoftMin\", beta} smoothly \
emphasizes the worst-performing members, and SoftMinSchedule -> {0., 5., 15.} \
continues smoothly from Mean (beta = 0) into progressively stronger \
worst-case optimization.\
\>", "Text",ExpressionUUID->"c4e40a88-b8c9-3147-8728-5ac6f728fc23"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ens2D", "=", 
   RowBox[{"OptimalControlEnsemble", "[", 
    RowBox[{"Hens", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"EnsembleParameters", "->", 
      RowBox[{"{", 
       RowBox[{"delta", "->", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "1200."}], ",", "1200.", ",", "4"}], "]"}]}], "}"}]}], 
     ",", 
     RowBox[{"RFInhomogeneity", "->", 
      RowBox[{"{", 
       RowBox[{"0.75", ",", "1.0", ",", "1.25"}], "}"}]}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "800."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resEnsMean", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ens2D", ",", 
     RowBox[{"EnsembleAggregation", "->", "\"\<Mean\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"MaxIterations", "->", "80"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resEnsSoftMin", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ens2D", ",", 
     RowBox[{"EnsembleAggregation", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<SoftMin\>\"", ",", "15."}], "}"}]}], ",", 
     RowBox[{"SoftMinSchedule", "->", 
      RowBox[{"{", 
       RowBox[{"0.", ",", "10."}], "}"}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"MaxIterations", "->", "80"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Mean-Aggregated (Mean, Min)\>\"", "->", 
    RowBox[{"Values", "[", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"EvaluateEnsembleFidelity", "[", "resEnsMean", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<MeanFidelity\>\"", ",", "\"\<MinFidelity\>\""}], "}"}]}],
       "]"}], "]"}]}], ",", 
   RowBox[{"\"\<SoftMin-Aggregated (Mean, Min)\>\"", "->", 
    RowBox[{"Values", "[", 
     RowBox[{"KeyTake", "[", 
      RowBox[{
       RowBox[{"EvaluateEnsembleFidelity", "[", "resEnsSoftMin", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<MeanFidelity\>\"", ",", "\"\<MinFidelity\>\""}], "}"}]}],
       "]"}], "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"1befa1e0-d804-2146-a8a3-35ef317864e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Mean-Aggregated (Mean, Min)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.939184237946215`", ",", "0.6649537257947215`"}], "}"}]}], ",", 
   RowBox[{"\<\"SoftMin-Aggregated (Mean, Min)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.9236472914648728`", ",", "0.7859068505885973`"}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[8]=",ExpressionUUID->"ad28b134-3440-7648-8b39-ae120018ef52"]
}, Open  ]],

