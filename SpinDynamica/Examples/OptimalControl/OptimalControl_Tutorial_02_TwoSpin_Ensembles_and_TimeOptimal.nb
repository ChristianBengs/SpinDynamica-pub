Cell[CellGroupData[{

Cell["1. Two-Spin Polarization and Coherence Transfer", "Section",ExpressionUUID->"22d0d0b0-0bb7-d84d-b7dd-c6a8abb3529b"],

Cell["\<\
In a coupled heteronuclear {1H, 15N} two-spin-1/2 liquid-state system (nuH = \
+120 Hz, nuN = -160 Hz, J_HN = 92 Hz), we provide four RF control channels: \
{1H x, 1H y, 15N x, 15N y} bounded on each RF channel pair by \
AmplitudeNormBound -> {{1, 2} -> 1000., {3, 4} -> 1000.} Hz.

Notice the physics of ObservableTarget vs CoherenceTarget:
  - ObservableTarget[Iz^H -> Iz^N] transfers longitudinal magnetization via \
J-coupling (requires duration ~ 1.2/J_HN for full transfer).
  - CoherenceTarget[I-^H -> I-^N] handles non-Hermitian raising/lowering spin \
coherences, with PhaseInsensitive -> False (exact phase) or True (arbitrary \
receiver phase).\
\>", "Text",ExpressionUUID->"4a39f71e-f688-2747-8ba7-24968666c6b3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<1H\>\"", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<15N\>\"", ",", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuH", "=", "120."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuN", "=", 
   RowBox[{"-", "160."}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"jHN", "=", "92."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hhn", "=", 
   RowBox[{"2.", "*", "Pi", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"nuH", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"nuN", "*", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "+", 
      RowBox[{"jHN", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], ".", 
         RowBox[{"opI", "[", 
          RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], ")"}]}]}], 
     ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ctrlsHN", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"\"\<1H\>\"", ",", "\"\<x\>\""}], "]"}], ",", 
     RowBox[{"opI", "[", 
      RowBox[{"\"\<1H\>\"", ",", "\"\<y\>\""}], "]"}], ",", 
     RowBox[{"opI", "[", 
      RowBox[{"\"\<15N\>\"", ",", "\"\<x\>\""}], "]"}], ",", 
     RowBox[{"opI", "[", 
      RowBox[{"\"\<15N\>\"", ",", "\"\<y\>\""}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rfLimits", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "->", "1000."}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "4"}], "}"}], "->", "1000."}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resPol", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hhn", ",", "ctrlsHN", ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.2", "/", "jHN"}], ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "rfLimits"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resCohPS", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hhn", ",", "ctrlsHN", ",", 
     RowBox[{"CoherenceTarget", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"\"\<1H\>\"", ",", "\"\<-\>\""}], "]"}], "->", 
        RowBox[{"opI", "[", 
         RowBox[{"\"\<15N\>\"", ",", "\"\<-\>\""}], "]"}]}], ",", 
       RowBox[{"PhaseInsensitive", "->", "False"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.6", "/", "jHN"}], ",", "48"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "rfLimits"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resCohPI", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hhn", ",", "ctrlsHN", ",", 
     RowBox[{"CoherenceTarget", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"\"\<1H\>\"", ",", "\"\<-\>\""}], "]"}], "->", 
        RowBox[{"opI", "[", 
         RowBox[{"\"\<15N\>\"", ",", "\"\<-\>\""}], "]"}]}], ",", 
       RowBox[{"PhaseInsensitive", "->", "True"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.6", "/", "jHN"}], ",", "48"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "rfLimits"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Iz^H -> Iz^N Fidelity\>\"", "->", 
    RowBox[{"resPol", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<I-^H -> I-^N (PhaseSensitive)\>\"", "->", 
    RowBox[{"resCohPS", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<I-^H -> I-^N (PhaseInsensitive)\>\"", "->", 
    RowBox[{"resCohPI", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Native SpinDynamica Check\>\"", "->", 
    RowBox[{
     RowBox[{"VerifyOptimalControlSimulation", "[", "resPol", "]"}], 
     "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], "}"}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"41b6800c-628e-a44d-952a-ea26399a5dd2"],

