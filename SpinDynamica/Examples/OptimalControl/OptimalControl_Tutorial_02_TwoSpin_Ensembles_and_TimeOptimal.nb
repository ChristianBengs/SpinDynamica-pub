       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"PropagateSpace", "->", "\"\<Liouville\>\""}], ",", 
     RowBox[{"Basis", "->", "zb"}], ",", 
     RowBox[{"OperatorBasis", "->", "ob"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "800."}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
