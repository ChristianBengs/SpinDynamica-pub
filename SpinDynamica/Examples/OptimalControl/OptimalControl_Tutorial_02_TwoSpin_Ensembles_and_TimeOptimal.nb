Cell[CellGroupData[{

Cell["\<\
7. Pontryagin Stationarity Diagnostics (VerifyOptimalControlStationarity)\
\>", "Section",ExpressionUUID->"fad3e667-4edf-5046-a0c2-74836484d2e4"],

Cell["\<\
After polishing the time-optimal pulse down to tight gradient tolerance, \
VerifyOptimalControlStationarity evaluates continuous-time Pontryagin Maximum \
Principle (PMP) switching functions s_k(t) on sub-slice grids and measures \
discrete and integrated stationarity residuals. Note carefully: small \
switching residuals confirm local first-order constrained stationarity \
(necessary, not sufficient, for global or time optimality). \
PlotSwitchingFunctions displays the control amplitudes alongside s_k(t) and \
pointwise residuals.\
\>", "Text",ExpressionUUID->"4781353c-ff0c-544d-8042-91930f60f3e4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resTOPolished", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hrel", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"toRes", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}], ",", 
       "24"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}], ",", 
     RowBox[{"InitialControls", "->", 
      RowBox[{"toRes", "[", "\"\<BestResult\>\"", "]"}]}], ",", 
     RowBox[{"TargetFidelity", "->", "None"}], ",", 
     RowBox[{"GradientTolerance", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "7"}]}]}], ",", 
     RowBox[{"MaxIterations", "->", "200"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statRes", "=", 
   RowBox[{"VerifyOptimalControlStationarity", "[", 
    RowBox[{"resTOPolished", ",", 
     RowBox[{"StationaritySubdivisions", "->", "8"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"KeyTake", "[", 
  RowBox[{"statRes", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<ApplicableQ\>\"", ",", "\"\<ConstraintType\>\"", 
     ",", "\"\<RelativeDiscreteResidual\>\"", 
     ",", "\"\<RelativeIntegratedResidual\>\"", 
     ",", "\"\<StationaritySatisfiedQ\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ff8ca640-cc14-da44-b673-402e4042b169"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"ApplicableQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"ConstraintType\"\>", "\[Rule]", "\<\"Disk\"\>"}], ",", 
   RowBox[{"\<\"RelativeDiscreteResidual\"\>", "\[Rule]", 
    "9.771677761902835`*^-9"}], ",", 
   RowBox[{"\<\"RelativeIntegratedResidual\"\>", "\[Rule]", 
    "0.00006214346865815257`"}], ",", 
   RowBox[{"\<\"StationaritySatisfiedQ\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[14]=",ExpressionUUID->"b06afa0f-174a-2148-9e05-4a7f4947bf17"]
}, Open  ]],

Cell["\<\
Notice also two clean diagnostic nuances: PlotSwitchingFunctions renders \
three stacked panels (controls, switching functions, and pointwise residual; \
in the current GraphicsColumn layout, the top two Legended panels may \
visually crop frame edges on export, while the underlying TimeGrid, \
ControlTimeSeries, and SwitchingFunctions arrays remain directly accessible \
in statRes).\
\>", "Text",ExpressionUUID->"c4291fa6-aa08-e445-ab70-f95ecbb4f8b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotSwitchingFunctions", "[", 
  RowBox[{"statRes", ",", 
   RowBox[{"ImageSize", "->", "520"}]}], "]"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"1b9704ef-2d71-9b47-86d0-8b9e6c51eeb2"],

