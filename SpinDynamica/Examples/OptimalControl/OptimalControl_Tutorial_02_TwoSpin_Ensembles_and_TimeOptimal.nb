       RowBox[{"PlotLabel", "->", "\"\<2D Fidelity Map (Mean)\>\""}]}], "]"}],
      ",", 
     RowBox[{"PlotEnsembleFidelity", "[", 
      RowBox[{"resEnsSoftMin", ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<2D Fidelity Map (SoftMin Schedule)\>\""}]}], 
