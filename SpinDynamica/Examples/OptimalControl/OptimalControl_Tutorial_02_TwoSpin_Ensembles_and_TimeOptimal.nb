Cell[CellGroupData[{

Cell["5. Relaxation and Liouville-Space Optimal Control", "Section",ExpressionUUID->"4151efbc-c313-2840-9499-241360b72353"],

Cell["\<\
For unitary Hamiltonians, GRAPEOptimize defaults to Hilbert space. When \
relaxation or non-unitary damping is present, pass a Liouvillian \
superoperator (here CommutationSuperoperator[-I H0] + \
PhenomenologicalRelaxationSuperoperator[T1, T2]), specify Basis and \
OperatorBasis, and set PropagateSpace -> \"Liouville\". Below we compare \
unitary inversion against a dissipative system with rapid relaxation (T1 = 15 \
ms, T2 = 3 ms over a 2 ms pulse).\
\>", "Text",ExpressionUUID->"82c6364c-d064-d94d-ae21-69f8b2392c87"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"zb", "=", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ob", "=", 
   RowBox[{"ZeemanKetBraOperatorBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hrel", "=", 
   RowBox[{"2.", "*", "Pi", "*", "150.", "*", 
    RowBox[{"opI", "[", 
     RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Lrel", "=", 
   RowBox[{
    RowBox[{"CommutationSuperoperator", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "Hrel"}], "]"}], "+", 
    RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
     RowBox[{"0.015", ",", "0.003"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resUnitary", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hrel", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "800."}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resLiouvRelax", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Lrel", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
