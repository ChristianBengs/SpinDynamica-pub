   RowBox[{"\<\"MeanFidelity\"\>", "\[Rule]", "0.998392233759366`"}], ",", 
   RowBox[{"\<\"MinFidelity\"\>", "\[Rule]", "0.9969893444806953`"}], ",", 
   RowBox[{"\<\"MaxFidelity\"\>", "\[Rule]", "0.9997849068470462`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[6]=",ExpressionUUID->"13535eb2-0912-044c-be4d-30645d4d0e8d"]
}, Open  ]],

