Cell[CellGroupData[{

Cell["8. Summary and Quick Reference", "Section",ExpressionUUID->"93677752-8aed-0446-8af8-8b6a43759472"],

Cell["\<\
Moving to multi-spin and realistic experimental pulse design:
  1. Use CoherenceTarget or CooperativeObjective for coupled heteronuclear \
transfers and multi-task pulses, optionally shaping intermediate states with \
RunningCost -> StatePenalty[...].
  2. Build robust pulses over offset and B1 spreads with \
OptimalControlEnsemble, using SoftMinSchedule when edge fidelity matters.
  3. Switch to PropagateSpace -> \"Liouville\" with a relaxation \
superoperator to quantify and compensate T1/T2 losses.
  4. Probe quantum speed limits with TimeOptimalControlOptimize / \
TimeOptimalPulseCurve and inspect first-order PMP optimality with \
VerifyOptimalControlStationarity.\
\>", "Text",ExpressionUUID->"abce4188-7957-de42-b8f0-d3dcd0ba5f98"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Symbol / Option\"\>", "\<\"Purpose\"\>", "\<\"Key Notes\"\>"},
    {"\<\"ObservableTarget / CoherenceTarget\"\>", "\<\"Multi-spin & \
coherence transfers\"\>", "\<\"Supports non-Hermitian operators & \
PhaseInsensitive -> True/False\"\>"},
    {"\<\"CooperativeObjective\"\>", "\<\"Weighted multi-objective sum\"\>", \
"\<\"NormalizeWeights -> True / False\"\>"},
    {"\<\"RunningCost / StatePenalty\"\>", "\<\"Intermediate-time trajectory \
cost\"\>", "\<\"TargetMode, TimeWeighting, Sign; SubspaceUnitaryTarget \
noted\"\>"},
    {"\<\"OptimalControlEnsemble\"\>", "\<\"Broadband / B1-robust \
ensemble\"\>", "\<\"EnsembleParameters & RFInhomogeneity grids\"\>"},
    {"\<\"EnsembleAggregation / SoftMinSchedule\"\>", "\<\"Mean vs worst-case \
robustness\"\>", "\<\"\\\"Mean\\\" or {\\\"SoftMin\\\", beta}; continuation \
schedule\"\>"},
    {"\<\"EvaluateEnsembleFidelity / PlotEnsembleFidelity\"\>", "\<\"Member \
fidelity stats & maps\"\>", "\<\"Reports Mean, Min, Max; plots 1D slices or \
2D maps\"\>"},
    {"\<\"PropagateSpace -> \\\"Liouville\\\"\"\>", "\<\"Open-system / \
relaxation GRAPE\"\>", "\<\"Requires superoperator generator, Basis, \
OperatorBasis\"\>"},
    {"\<\"TimeOptimalControlOptimize\"\>", "\<\"Shortest feasible pulse \
duration\"\>", "\<\"\\\"Progressive\\\", \\\"Joint\\\", \\\"Hybrid\\\"; \
FidelityCriterion, ValidationEnsemble\"\>"},
    {"\<\"TimeOptimalPulseCurve / PlotTimeOptimalPulseCurve\"\>", \
"\<\"Duration sweep trade-off curve\"\>", "\<\"DiscretizationStrategy, \
WaveformRescaling, AttemptsPerDuration\"\>"},
    {"\<\"OptimizeDurations / DurationBounds / Penalty\"\>", "\<\"Joint \
duration optimization\"\>", "\<\"Available directly in OptimalControlProblem \
/ GRAPEOptimize\"\>"},
    {"\<\"VerifyOptimalControlStationarity / PlotSwitchingFunctions\"\>", "\<\
\"Continuous-time PMP stationarity check\"\>", "\<\"Sub-slice s_k(t) & \
residuals (StationaritySubdivisions)\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85], {
        GrayLevel[1], 
        RGBColor[0.97, 0.98, 1.]}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"6f87ddd1-e23a-e249-9028-c6821c6ee10c"]
