Cell["\<\
What to observe: The trajectory plot reveals how the optimized pulse \
automatically passes through two-spin longitudinal order 2 Iz^H Iz^N near \
mid-pulse before arriving at pure Iz^N at the end.\
\>", "Text",ExpressionUUID->"11f566d2-2d51-2b48-8729-60ffeb795126"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. Cooperative Objectives and Intermediate Trajectory Penalties\
\>", "Section",ExpressionUUID->"f8d4e311-3a55-7c44-a46a-0ce6ee3c6ac2"],

Cell["\<\
CooperativeObjective combines multiple simultaneous spin transformations into \
one pulse \[AHat]\.80\.94 for example, swapping 1H -> 15N and 15N -> 1H \
simultaneously (NormalizeWeights -> True). RunningCost with StatePenalty \
penalizes (or rewards) intermediate spin states along the pulse trajectory; \
for example, penalizing transverse 15N coherence along the Iz^H -> Iz^N \
transfer. (For unitary gates confined to an embedded manifold, \
SubspaceUnitaryTarget with LeakageWeight plays a complementary role.)\
\>", "Text",ExpressionUUID->"bbef3ac6-6c77-f843-8bd0-e09f8a511592"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resSwap", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hhn", ",", "ctrlsHN", ",", 
     RowBox[{"CooperativeObjective", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ObservableTarget", "[", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], "->", 
           RowBox[{"opI", "[", 
            RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "]"}], ",", 
         RowBox[{"ObservableTarget", "[", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}], "->", 
           RowBox[{"opI", "[", 
            RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}]}], "]"}]}], "}"}],
        ",", 
       RowBox[{"NormalizeWeights", "->", "True"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.5", "/", "jHN"}], ",", "48"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "rfLimits"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resWithPenalty", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"Hhn", ",", "ctrlsHN", ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1.2", "/", "jHN"}], ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "rfLimits"}], ",", 
     RowBox[{"RunningCost", "->", 
      RowBox[{"StatePenalty", "[", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"\"\<15N\>\"", ",", "\"\<x\>\""}], "]"}], ",", "0.3", ",", 
        RowBox[{"TargetMode", "->", "\"\<Magnitude\>\""}], ",", 
        RowBox[{"TimeWeighting", "->", "\"\<Uniform\>\""}]}], "]"}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Cooperative Swap Fidelity\>\"", "->", 
    RowBox[{"resSwap", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Unpenalized Iz^H -> Iz^N Fidelity\>\"", "->", 
    RowBox[{"resPol", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Penalized Iz^H -> Iz^N (Fidelity, RunningCost)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resWithPenalty", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
      RowBox[{"resWithPenalty", "[", "\"\<RunningCost\>\"", "]"}]}], 
     "}"}]}]}], "}"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"ee0c0b61-0e59-564b-9a37-e0f81b2e341b"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Cooperative Swap Fidelity\"\>", "\[Rule]", 
    "0.9993379996342409`"}], ",", 
   RowBox[{"\<\"Unpenalized Iz^H -> Iz^N Fidelity\"\>", "\[Rule]", 
    "0.9999710281376324`"}], ",", 
   RowBox[{"\<\"Penalized Iz^H -> Iz^N (Fidelity, RunningCost)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.9999167461059181`", ",", 
      RowBox[{"-", "0.0019995365371409586`"}]}], "}"}]}]}], "}"}]], "Output",
 CellLabel->"Out[5]=",ExpressionUUID->"6c6923a6-2175-e644-aea2-9401937bf09e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Robust Broadband and RF-Inhomogeneity Ensembles", "Section",ExpressionUUID->"60c36323-44a8-1646-a2e0-42276fb3e75d"],

Cell["\<\
Real NMR samples experience chemical-shift offsets and spatial RF (B1) \
inhomogeneity. OptimalControlEnsemble optimizes a single waveform across a \
parameter grid specified by EnsembleParameters (symbolic Hamiltonian \
parameters) and RFInhomogeneity (multiplicative scaling applied to all \
control channels). Here we switch back to a fast single spin-1/2 so the 1D \
and 2D ensemble optimizations run in under a second.\
\>", "Text",ExpressionUUID->"f54b4f91-4e19-a843-938f-539014160e3e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"1", "/", "2"}]}], "}"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "delta", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hens", "=", 
   RowBox[{"2.", "*", "Pi", "*", "delta", "*", 
    RowBox[{"opI", "[", 
     RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ens1D", "=", 
   RowBox[{"OptimalControlEnsemble", "[", 
    RowBox[{"Hens", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"EnsembleParameters", "->", 
      RowBox[{"{", 
       RowBox[{"delta", "->", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "800."}], ",", "800.", ",", "8"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "1200."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resEns1D", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ens1D", ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"MaxIterations", "->", "120"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ev1D", "=", 
   RowBox[{"EvaluateEnsembleFidelity", "[", "resEns1D", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"KeyTake", "[", 
  RowBox[{"ev1D", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<MeanFidelity\>\"", ",", "\"\<MinFidelity\>\"", 
     ",", "\"\<MaxFidelity\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"59996f67-5a9a-354f-87bb-4f3567e9083f"],

Cell["\<\
                                                          1
SetSpinSystem::set : the spin system has been set to {{1, -}}
                                                          2\
\>", "Message", "MSG",ExpressionUUID->"8524e2b2-4c66-994e-b171-718451fb4eed"],

Cell["\<\
                                                                 1
SetBasis::set : the state basis has been set to ZeemanBasis[{{1, -}}, \
BasisLabels -> Automatic].
                                                                 2\
\>", "Message", "MSG",ExpressionUUID->"4ca0393e-1dc6-a34b-8723-72024f4b29cc"],

