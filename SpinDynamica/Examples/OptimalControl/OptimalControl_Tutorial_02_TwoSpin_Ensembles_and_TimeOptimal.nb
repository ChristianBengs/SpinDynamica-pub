Cell["\<\
What to observe: Under relaxation, the optimizer cannot reach 100% inversion \
over 2 ms and shapes a shorter/faster-acting amplitude profile to outrun \
transverse T2 decay.\
\>", "Text",ExpressionUUID->"f0bf66e1-4d18-fd4c-af61-b12c71b11b54"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Time-Optimal Control and Quantum Speed Limits", "Section",ExpressionUUID->"a872b3b3-a1d7-424c-8450-606584fcba04"],

Cell["\<\
Under a fixed RF ceiling (AmplitudeNormBound -> 500 Hz, whose on-resonance \
pi-pulse duration is 1/(2 * 500 Hz) = 1.0 ms), what is the shortest duration \
at which a pulse still reaches TargetFidelity -> 0.999?

SpinDynamica provides two complementary tools:
  - TimeOptimalControlOptimize: brackets and refines ShortestFeasibleDuration \
(Method -> \"Progressive\", \"Joint\", or \"Hybrid\"; FidelityCriterion; \
DiscretizationStrategy; WaveformRescaling; AttemptsPerDuration; optional \
ValidationEnsemble).
  - TimeOptimalPulseCurve + PlotTimeOptimalPulseCurve: sweeps a grid of \
durations to map the trade-off curve.
In addition, GRAPEOptimize itself accepts OptimizeDurations -> \"Total\" with \
DurationBounds and DurationPenalty to shrink pulse duration directly in one \
solve.\
\>", "Text",ExpressionUUID->"605cd8af-fe64-c64c-a220-99ebd90da1e3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"probTO", "=", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{"Hrel", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.0016", ",", "24"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"toRes", "=", 
   RowBox[{"TimeOptimalControlOptimize", "[", 
    RowBox[{"probTO", ",", 
     RowBox[{"Method", "->", "\"\<Progressive\>\""}], ",", 
     RowBox[{"TargetFidelity", "->", "0.999"}], ",", 
     RowBox[{"InitialDuration", "->", "0.0016"}], ",", 
     RowBox[{"MinimumDuration", "->", "0.0005"}], ",", 
     RowBox[{"DurationReductionFactor", "->", "0.75"}], ",", 
     RowBox[{"AttemptsPerDuration", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"curveRes", "=", 
   RowBox[{"TimeOptimalPulseCurve", "[", 
    RowBox[{"probTO", ",", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0.0007", ",", "0.0015", ",", "4"}], "]"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.999"}], ",", 
     RowBox[{"AttemptsPerDuration", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resJointDur", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probTO", ",", 
     RowBox[{"OptimizeDurations", "->", "\"\<Total\>\""}], ",", 
     RowBox[{"DurationBounds", "->", 
      RowBox[{"{", 
       RowBox[{"0.0006", ",", "0.0025"}], "}"}]}], ",", 
     RowBox[{"DurationPenalty", "->", "0.05"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<TimeOptimal ShortestFeasibleDuration (ms)\>\"", "->", 
    RowBox[{"1000.", "*", 
     RowBox[{"toRes", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}]}]}], ",", 
   RowBox[{"\"\<TimeOptimal AchievedFidelity\>\"", "->", 
    RowBox[{"toRes", "[", "\"\<AchievedFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<Joint Duration Opt (ms, Fidelity)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1000.", "*", 
       RowBox[{"resJointDur", "[", "\"\<TotalDuration\>\"", "]"}]}], ",", 
      RowBox[{"resJointDur", "[", "\"\<FinalFidelity\>\"", "]"}]}], "}"}]}]}],
   "}"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"ae034b2e-dda4-a94c-a9d3-40bfc3e9b864"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"TimeOptimal ShortestFeasibleDuration (ms)\"\>", "\[Rule]", 
    "0.9890624999999977`"}], ",", 
   RowBox[{"\<\"TimeOptimal AchievedFidelity\"\>", "\[Rule]", 
    "0.9990037232288134`"}], ",", 
   RowBox[{"\<\"Joint Duration Opt (ms, Fidelity)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.9968971061113913`", ",", "0.9999505153418389`"}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"b9745c32-3702-714b-bca8-2529cec56cb2"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotTimeOptimalPulseCurve", "[", 
      RowBox[{"curveRes", ",", 
       RowBox[{"Method", "->", "\"\<Fidelity\>\""}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<TOP Curve (Fidelity vs T)\>\""}]}], 
      "]"}], ",", 
     RowBox[{"PlotTimeOptimalPulseCurve", "[", 
      RowBox[{"curveRes", ",", 
       RowBox[{"Method", "->", "\"\<Infidelity\>\""}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<TOP Curve (Log Infidelity vs T)\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "20"}]}], "]"}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"26041d2e-c81f-9a4c-b53b-e654eba2f665"],

