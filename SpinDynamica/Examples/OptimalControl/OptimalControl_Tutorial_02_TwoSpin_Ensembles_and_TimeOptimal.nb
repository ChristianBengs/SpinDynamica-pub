Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotOptimalControlWaveform", "[", 
      RowBox[{"resPol", ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<1Hx\>\"", ",", "\"\<1Hy\>\"", ",", "\"\<15Nx\>\"", 
            ",", "\"\<15Ny\>\""}], "}"}], ",", "Above"}], "]"}]}], ",", 
       RowBox[{
       "PlotLabel", "->", "\"\<1H -> 15N Transfer Controls (4 ch)\>\""}]}], 
      "]"}], ",", 
     RowBox[{"PlotOptimalControlTrajectory", "[", 
      RowBox[{"resPol", ",", 
       RowBox[{"opI", "[", 
        RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], ",", 
         RowBox[{"2.", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"\"\<1H\>\"", ",", "\"\<z\>\""}], "]"}], ".", 
            RowBox[{"opI", "[", 
             RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], ")"}]}], ",", 
         RowBox[{"opI", "[", 
          RowBox[{"\"\<15N\>\"", ",", "\"\<z\>\""}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<<Iz^H>\>\"", ",", "\"\<<2 Iz^H Iz^N>\>\"", 
            ",", "\"\<<Iz^N>\>\""}], "}"}], ",", "Above"}], "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<INEPT-like State Trajectory\>\""}]}], 
      "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "25"}]}], "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"87f89ad9-96e7-334b-9741-8f17734f28d0"],

