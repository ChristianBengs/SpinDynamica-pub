Cell[CellGroupData[{

Cell["\<\
8.2 Sparse & Piecewise-Constant Pulses via FISTA (L1Penalty, TVPenalty) & \
Q-Space ADMM\
\>", "Subsection",ExpressionUUID->"b868b06e-7b8c-d541-ae87-2df18024d0ee"],

Cell["\<\
Adding L1Penalty or TVPenalty (using Condat's exact O(N_t) total-variation \
proximal operator) or combining waveform constraints with parameterized bases \
(Fourier / B-spline via thin-SVD orthonormal Q-space reduction) automatically \
engages monotone-safeguarded adaptive-restart FISTA.\
\>", "Text",ExpressionUUID->"1050fb03-46aa-8749-b3d7-eab7a38f2cc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resUnreg", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"20.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "90."}], ",", " ", 
     RowBox[{"Optimizer", " ", "->", " ", "\"\<FISTA\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "140"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "31"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resL1TV", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"20.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "90."}], ",", " ", 
     RowBox[{"L1Penalty", " ", "->", " ", "1.*^-4"}], ",", " ", 
     RowBox[{"TVPenalty", " ", "->", " ", "2.*^-4"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "180"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "31"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resHannBSplineSlew", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"50.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "32"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlParameterization", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<BSpline\>\"", ",", " ", "12"}], "}"}]}], ",", " ", 
     RowBox[{"ControlWindow", " ", "->", " ", "\"\<Hann\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "120."}], ",", " ", 
     RowBox[{"SlewRateBound", " ", "->", " ", "40000."}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "22"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Unreg_F\>\"", " ", "->", " ", 
    RowBox[{"resUnreg", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Unreg_TV\>\"", " ", "->", " ", 
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Differences", "[", 
        RowBox[{"resUnreg", "[", "\"\<Controls\>\"", "]"}], "]"}], "]"}], 
      "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<L1TV_F\>\"", " ", "->", " ", 
    RowBox[{"resL1TV", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<L1TV_TV\>\"", " ", "->", " ", 
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Differences", "[", 
        RowBox[{"resL1TV", "[", "\"\<Controls\>\"", "]"}], "]"}], "]"}], 
      "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<L1TV_Optimizer\>\"", " ", "->", " ", 
    RowBox[{"resL1TV", "[", "\"\<Optimizer\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<BSplineSlew_F\>\"", " ", "->", " ", 
    RowBox[{"resHannBSplineSlew", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<BSplineSlew_Viol\>\"", " ", "->", " ", 
    RowBox[{
    "resHannBSplineSlew", "[", "\"\<MaxConstraintViolation\>\"", "]"}]}]}], 
  "\n", "|>"}]}], "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"ddee5581-b68e-6d4b-ab1f-7e0090eb508a"],

