Cell[CellGroupData[{

Cell["\<\
2. Parameterizations, Regularization, Bounds, Optimizers & Warm Restarts\
\>", "Section",ExpressionUUID->"f8c57b50-1520-884a-b275-9322f253f62c"],

Cell[CellGroupData[{

Cell["\<\
2.1 Smooth Basis Parameterizations, Window Envelopes, Penalties & Box Bounds\
\>", "Subsection",ExpressionUUID->"29b7a36d-be6f-244a-b3fc-5a091fd8183b"],

Cell["\<\
Reduce the parameter count and ensure smooth hardware-friendly waveforms \
using ControlParameterization (\"BSpline\", \"Fourier\", \"Chebyshev\"), \
ControlWindow -> \"Hann\", SmoothnessPenalty, PowerPenalty, or asymmetric \
per-channel ControlBounds.\
\>", "Text",ExpressionUUID->"62d3e31b-cadb-9142-a39e-934e40524c7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resBSpline", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"50.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"ControlParameterization", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<BSpline\>\"", ",", " ", "12"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"ControlWindow", " ", "->", " ", "\"\<Hann\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"PowerPenalty", " ", "->", " ", "1.*^-11"}], ",", " ", 
     RowBox[{"SmoothnessPenalty", " ", "->", " ", "1.*^-10"}], ",", "\n", 
     "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "2"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resFourier", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"50.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"ControlParameterization", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Fourier\>\"", ",", " ", "6"}], "}"}]}], ",", " ", 
     RowBox[{"ControlWindow", " ", "->", " ", "\"\<Hann\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "3"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resBounds", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"10.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "20"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"ControlBounds", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "40."}], ",", " ", "40."}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "25."}], ",", " ", "35."}], "}"}]}], "}"}]}], ",", 
     "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "60"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "41"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<BSpline\>\"", " ", "->", " ", 
