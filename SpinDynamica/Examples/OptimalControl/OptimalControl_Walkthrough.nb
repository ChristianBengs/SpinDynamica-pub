Cell[CellGroupData[{

Cell["3.2 Coupled Two-Spin CNOT Gate (4 Control Channels)", "Subsection",ExpressionUUID->"a19ac756-c2f9-204c-bf50-5b7f6661a963"],

Cell["\<\
Optimize a two-qubit controlled-NOT (CNOT) unitary gate on a J-coupled \
spin-1/2 pair with independent x/y RF controls on both spins, then verify and \
plot the multi-channel pulse.\
\>", "Text",ExpressionUUID->"883d81fa-03ea-734a-9f34-df1b9563deb7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b2", " ", "=", " ", 
