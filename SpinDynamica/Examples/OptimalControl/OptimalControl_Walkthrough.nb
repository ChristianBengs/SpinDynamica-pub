Cell[CellGroupData[{

Cell["\<\
4. NMR Observable Transfer, Non-Hermitian Coherence & Cooperative Pulses\
\>", "Section",ExpressionUUID->"d2371d62-6a48-4347-b3f7-857d125b6161"],

Cell[CellGroupData[{

Cell["\<\
4.1 Heteronuclear INEPT Polarization Transfer (ObservableTarget)\
\>", "Subsection",ExpressionUUID->"85027034-5415-694a-93d9-908225153ae5"],

Cell["\<\
Use ObservableTarget to drive selective operator-to-operator transfer I1z -> \
I2z across a 140 Hz J-coupling. Track the full transfer pathway (I1z -> \
anti-phase 2 I1z I2z -> I2z) with PlotOptimalControlTrajectory.\
\>", "Text",ExpressionUUID->"ecfdbd77-129d-1643-8a44-c82ee303afa5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resInept", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"30.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"45.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"140.", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.015", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simInept", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resInept", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<INEPT_Fidelity\>\"", " ", "->", " ", 
    RowBox[{"resInept", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simInept", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], 
  "|>"}]}], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"6e1039f9-e6da-e14a-8458-c6ed7fc01b02"],

Cell[BoxData[
 TemplateBox[{
  "SetSpinSystem", "set", 
   "\"the spin system has been set to \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"1\\\", \\\",\\\", \
FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", RowBox[{\\\"2\\\", \\\",\\\", FractionBox[\\\"1\\\", \\\"2\
\\\"]}], \\\"}\\\"}]}], \\\"}\\\"}]\\)\"", 2, 38, 10, 33226927765450090976, 
   "Local", "QM`Hilbert`SetSpinSystem"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
