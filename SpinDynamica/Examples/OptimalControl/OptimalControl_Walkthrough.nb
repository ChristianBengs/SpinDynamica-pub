Cell[CellGroupData[{

Cell["\<\
8. Strong-Wolfe Line Search, Physical RF Constraints, FISTA & Continuation \
(Phase 1)\
\>", "Section",ExpressionUUID->"2fb20f37-d605-a34a-ac95-08324f85dfae"],

Cell[CellGroupData[{

Cell["\<\
8.1 Strong-Wolfe vs Armijo, Polar RF Disk (AmplitudeNormBound) & SlewRateBound\
\>", "Subsection",ExpressionUUID->"91d8f7c4-541c-7a46-841a-f355bc27e8e5"],

Cell["\<\
Phase 1 upgrades unconstrained L-BFGS / BFGS / ConjugateGradient to a \
safeguarded Strong-Wolfe line search (with projected Armijo fallback when \
bounds are active) and introduces true polar RF disk limits via \
AmplitudeNormBound (Sqrt[ux^2 + uy^2] <= wMax, eliminating the Sqrt[2] \
Cartesian box corner overshoot) alongside discrete-time derivative limits \
SlewRateBound.\
\>", "Text",ExpressionUUID->"a49a0fcd-4de6-6842-bb4d-060793da37ac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uPi2", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"Pi", " ", "/", " ", "2."}], ")"}], " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], "]"}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"probP1", " ", "=", " ", 
    RowBox[{"OptimalControlProblem", "[", 
     RowBox[{
      RowBox[{"80.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.01", ",", " ", "24"}], "}"}], ",", " ", 
      RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"resSW", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probP1", ",", " ", 
     RowBox[{"LineSearch", " ", "->", " ", "\"\<StrongWolfe\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "80"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resArm", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probP1", ",", " ", 
     RowBox[{"LineSearch", " ", "->", " ", "\"\<Armijo\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "80"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resBox85", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probP1", ",", " ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "85."}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "100"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resDisk85", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probP1", ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "85."}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resSlew18", " ", "=", " ", 
    RowBox[{"GRAPEOptimize", "[", 
     RowBox[{
      RowBox[{"50.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.015", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
      RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"AmplitudeNormBound", " ", "->", " ", "90."}], ",", " ", 
      RowBox[{"SlewRateBound", " ", "->", " ", "18000."}], ",", " ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
      RowBox[{"MaxIterations", " ", "->", " ", "140"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "9"}]}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Heteronuclear", " ", "channel"}], "-", 
    RowBox[{
    "pair", " ", "disk", " ", "bounds", " ", "on", " ", "a", " ", "2"}], "-", 
    RowBox[{"spin", " ", "INEPT", " ", "transfer"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resHetDisk", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"30.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"45.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"140.", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.015", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "120."}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", "180."}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simHetDisk", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resHetDisk", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<StrongWolfe\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resSW", "[", "\"\<FinalFidelity\>\"", "]"}], ",", " ", 
      RowBox[{"resSW", "[", "\"\<Evaluations\>\"", "]"}], ",", " ", 
      RowBox[{"resSW", "[", "\"\<LineSearchMethod\>\"", "]"}]}], "}"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<Armijo\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resArm", "[", "\"\<FinalFidelity\>\"", "]"}], ",", " ", 
      RowBox[{"resArm", "[", "\"\<Evaluations\>\"", "]"}], ",", " ", 
      RowBox[{"resArm", "[", "\"\<LineSearchMethod\>\"", "]"}]}], "}"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<Box85_MaxRadiusHz\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resBox85", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",", 
        " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Disk85_MaxRadiusHz\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"resDisk85", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",",
         " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Disk85_Viol\>\"", " ", "->", " ", 
    RowBox[{"resDisk85", "[", "\"\<MaxConstraintViolation\>\"", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<DiskSlew_F\>\"", " ", "->", " ", 
    RowBox[{"resSlew18", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<DiskSlew_MaxRate\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Differences", "[", 
        RowBox[{"resSlew18", "[", "\"\<Controls\>\"", "]"}], "]"}], "]"}], 
      " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"0.015", " ", "/", " ", "30."}], ")"}]}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<HetDisk_F\>\"", " ", "->", " ", 
    RowBox[{"resHetDisk", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<HetDisk_SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simHetDisk", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
