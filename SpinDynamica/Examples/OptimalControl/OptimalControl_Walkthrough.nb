Cell[CellGroupData[{

Cell["\<\
3. Spin-1 State Transfer & Coupled Two-Spin Quantum Gates (CNOT)\
\>", "Section",ExpressionUUID->"5a913b77-b4e9-9c49-a625-aa2956b17ac8"],

Cell[CellGroupData[{

Cell["\<\
3.1 Spin-1 (I = 1, D = 3) State Transfer & Propagation Kernel Comparison\
\>", "Subsection",ExpressionUUID->"c1f0f8f0-d0db-c443-ab66-e9ff5c3d3ba8"],

Cell["\<\
SpinDynamica supports arbitrary spin quantum numbers. Here we transfer |-1> \
-> |+1> on a spin-1 nucleus (I = 1) with both Zeeman offset and quadrupolar \
interaction, and compare all propagation/gradient kernels (\"Spectral\", \
\"BlockMatrixExp\", \"StateVector\", \"FirstOrder\") via \
EvaluateOptimalControl.\
\>", "Text",ExpressionUUID->"152fb69e-b35e-3840-b62c-1445509c7f3c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bS1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ksS1", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "bS1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resSpin1", " ", "=", " ", 
    RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"25.", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
       RowBox[{"15.", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ")"}]}]}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"StateTarget", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ksS1", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], " ", "->", " ", 
         RowBox[{"ksS1", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"ObjectiveType", " ", "->", " ", "\"\<StateFidelity\>\""}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"0.02", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
      RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
      RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "3"}]}], "\n", "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Inspect", " ", "exact", " ", "agreement", " ", "across", " ", 
    "propagation", " ", "kernels"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"uSample", " ", "=", " ", 
   RowBox[{"resSpin1", "[", "\"\<Controls\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kernelFids", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ev", " ", "=", " ", 
          RowBox[{"EvaluateOptimalControl", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"CompileOptimalControlProblem", "[", 
             RowBox[{"OptimalControlProblem", "[", "\n", "        ", 
              RowBox[{
               RowBox[{
                RowBox[{"25.", " ", 
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", 
                " ", 
                RowBox[{"15.", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"opI", "[", 
                    RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", 
                   " ", 
                   RowBox[{"opI", "[", 
                    RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ")"}]}]}], 
               ",", "\n", "        ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
               "\n", "        ", 
               RowBox[{"StateTarget", "[", 
                RowBox[{
                 RowBox[{"ksS1", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], " ", "->", " ", 
                 RowBox[{"ksS1", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0.02", ",", " ", "30"}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
               " ", 
               RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
               " ", 
               RowBox[{"Method", " ", "->", " ", "meth"}]}], "]"}], "]"}], ",",
             "\n", "      ", "uSample", ",", " ", "True"}], "]"}]}], "}"}], ",",
         "\n", "    ", 
        RowBox[{"meth", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Fidelity\>\"", " ", "->", " ", 
            RowBox[{"ev", "[", "\"\<Fidelity\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<GradNorm\>\"", " ", "->", " ", 
            RowBox[{"Norm", "[", 
             RowBox[{"ev", "[", "\"\<Gradient\>\"", "]"}], "]"}]}]}], 
          "|>"}]}]}], "\n", "  ", "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"meth", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Spectral\>\"", ",", " ", "\"\<BlockMatrixExp\>\"", ",", 
          " ", "\"\<StateVector\>\"", ",", " ", "\"\<FirstOrder\>\""}], 
         "}"}]}], "}"}]}], "\n", "]"}], " ", "//", " ", "Association"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Spin1FinalFidelity\>\"", " ", "->", " ", 
    RowBox[{"resSpin1", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<Kernels\>\"", " ", "->", " ", "kernelFids"}]}], 
  "|>"}]}], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"81189d0a-0067-7f45-bc03-bd003f0b1165"],

