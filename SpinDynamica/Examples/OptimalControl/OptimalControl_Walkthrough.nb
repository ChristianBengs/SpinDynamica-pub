Cell[CellGroupData[{

Cell["1. Single-Spin State & Unitary Control (GRAPE Foundations)", "Section",ExpressionUUID->"16ada327-32cc-ea41-a146-712974a2c26e"],

Cell[CellGroupData[{

Cell["\<\
1.1 Symbolic Problem Definition & Analytical Gradient Verification\
\>", "Subsection",ExpressionUUID->"ce7ba25b-ab05-3846-8779-0f2db73602f9"],

Cell["\<\
Optimal control models a spin Hamiltonian as H(t) = H_0 + Sum_k u_k(t) H_k \
using standard SpinDynamica spin operators. Below we define an \
OptimalControlProblem for a single-spin universal (pi/2)_x gate with a 50 Hz \
resonance offset, compile it with CompileOptimalControlProblem, and verify \
the exact analytical GRAPE gradient against central finite differences using \
VerifyOptimalControlGradient.\
\>", "Text",ExpressionUUID->"2eb7d72d-5063-0344-b617-aa36e8011db1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uPi2", " ", "=", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", 
      RowBox[{"(", 
       RowBox[{"Pi", " ", "/", " ", "2."}], ")"}], " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"MatrixRepresentation", "[", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], 
        "]"}], "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"probGate", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"50.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "120."}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", "\n", "  ", 
     RowBox[{"RandomSeed", " ", "->", " ", "1"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"compGate", " ", "=", " ", 
   RowBox[{"CompileOptimalControlProblem", "[", "probGate", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gradChk", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", 
    RowBox[{"compGate", ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"40.", ",", " ", 
         RowBox[{"-", "20."}]}], "}"}], ",", " ", "30"}], "]"}], ",", " ", 
     RowBox[{"StepSize", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"KeyTake", "[", 
  RowBox[{"gradChk", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<PassedQ\>\"", ",", " ", "\"\<MaxAbsoluteError\>\"", ",", 
     " ", "\"\<MaxRelativeError\>\""}], "}"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"19b837a8-f810-f84c-954b-6465a888f13e"],

Cell[BoxData[
 TemplateBox[{
  "SetSpinSystem", "set", 
   "\"the spin system has been set to \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{\\\"{\\\", RowBox[{\\\"1\\\", \\\",\\\", FractionBox[\\\"1\\\", \\\"2\
\\\"]}], \\\"}\\\"}], \\\"}\\\"}]\\)\"", 2, 4, 4, 33226927765450090976, 
   "Local", "QM`Hilbert`SetSpinSystem"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.0042849033548584`*^9},
 CellLabel->
  "During evaluation of \
In[4]:=",ExpressionUUID->"7742ea5f-23f3-b940-b1f9-68f8d1a35de6"],

Cell[BoxData[
 TemplateBox[{
  "SetBasis", "set", 
   "\"the state basis has been set to \\!\\(\\*RowBox[{\\\"ZeemanBasis\\\", \
\\\"[\\\", RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"{\\\", RowBox[{\\\"1\\\", \
\\\",\\\", FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}], \\\"}\\\"}], \
\\\",\\\", RowBox[{\\\"BasisLabels\\\", \\\"\[Rule]\\\", \
\\\"Automatic\\\"}]}], \\\"]\\\"}]\\).\"", 2, 4, 5, 33226927765450090976, 
   "Local", "QM`Hilbert`SetBasis"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.0042849033694305`*^9},
 CellLabel->
  "During evaluation of \
In[4]:=",ExpressionUUID->"1624feb6-c519-7644-8b71-aa576d07c8a6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"PassedQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"MaxAbsoluteError\"\>", "\[Rule]", 
    "4.3193473545502986`*^-14"}], ",", 
   RowBox[{"\<\"MaxRelativeError\"\>", "\[Rule]", 
    "3.0755574672240304`*^-8"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.004284903500313*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"a6af0b30-5b84-2f41-8223-b9d4cf1533da"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1.2 Optimizing a Single-Spin Unitary Gate & Independent SpinDynamica \
Verification\
\>", "Subsection",ExpressionUUID->"1ed78aa5-01ab-344e-85cb-8cfaacf040d8"],

Cell["\<\
Run GRAPEOptimize on the compiled or symbolic problem. Inspect the \
OptimalControlResult properties and independently verify both fidelity and \
final unitary propagator inside SpinDynamica using \
VerifyOptimalControlSimulation.\
\>", "Text",ExpressionUUID->"9abd42f0-0a8a-1146-b476-1ac7b676275d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resGate", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "probGate", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simGate", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resGate", "]"}]}], ";"}], "\n", 
 RowBox[{"Join", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<FinalFidelity\>\"", " ", "->", " ", 
      RowBox[{"resGate", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Iterations\>\"", " ", "->", " ", 
      RowBox[{"resGate", "[", "\"\<Iterations\>\"", "]"}]}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Status\>\"", " ", "->", " ", 
      RowBox[{"resGate", "[", "\"\<Status\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<MaxAmplitudeHz\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"resGate", "[", "\"\<Controls\>\"", "]"}], "]"}], "]"}]}]}], 
    "|>"}], ",", "\n", "  ", 
   RowBox[{"KeyTake", "[", 
    RowBox[{"simGate", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<FidelityMatchQ\>\"", ",", " ", "\"\<FidelityError\>\"", ",",
        " ", "\"\<PropagatorError\>\""}], "}"}]}], "]"}]}], "\n", 
  "]"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"cf8ca992-8efe-da49-8067-4c4c155247d3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"FinalFidelity\"\>", "\[Rule]", "0.9999714509139015`"}], ",", 
   RowBox[{"\<\"Iterations\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"Status\"\>", "\[Rule]", "\<\"TargetFidelityReached\"\>"}], ",", 
   RowBox[{"\<\"MaxAmplitudeHz\"\>", "\[Rule]", "119.99999999999999`"}], ",", 
   RowBox[{"\<\"FidelityMatchQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"FidelityError\"\>", "\[Rule]", "2.886579864025407`*^-15"}], ",", 
   RowBox[{"\<\"PropagatorError\"\>", "\[Rule]", 
    "1.4502827756432372`*^-15"}]}], "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0042849036610794`*^9},
 CellLabel->"Out[13]=",ExpressionUUID->"9376dd83-0360-2846-b32a-3e230405a566"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
1.3 Waveform, Amplitude/Phase, Convergence & Bloch-Vector Trajectories\
\>", "Subsection",ExpressionUUID->"5dba05b6-4e91-da4f-ab3f-8688f2bac2c1"],

Cell["\<\
Visualize the Cartesian and polar (amplitude/phase) waveforms with \
PlotOptimalControlWaveform, monitor optimization progress with \
PlotOptimalControlConvergence, and propagate expectation values with \
PlotOptimalControlTrajectory.\
\>", "Text",ExpressionUUID->"037a5a2d-d196-dc4b-aff6-4bb7a0ccd739"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"PlotOptimalControlWaveform", "[", 
       RowBox[{"resGate", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "\"\<Cartesian RF (Hz)\>\""}], ",",
         " ", 
        RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}], ",", "\n", 
      "  ", 
      RowBox[{"PlotOptimalControlWaveform", "[", 
       RowBox[{"resGate", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<AmplitudePhase\>\""}], ",", 
        " ", 
        RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}]}], "\n", "}"}], 
    ",", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"PlotOptimalControlConvergence", "[", 
       RowBox[{"resGate", ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Infidelity\>\""}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}], ",", "\n", 
      "  ", 
      RowBox[{"PlotOptimalControlTrajectory", "[", 
       RowBox[{"resGate", ",", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}], ",", " ", 
        RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}]}], "\n", 
     "}"}]}], "}"}], "]"}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"aaccbc83-ceaa-2a45-b059-897ed9d952dc"],

