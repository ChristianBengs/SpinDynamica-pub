Cell[CellGroupData[{

Cell["\<\
4.3 Cooperative Objectives (Universal Point-to-Point Rotation)\
\>", "Subsection",ExpressionUUID->"e239df1c-5fb8-4647-a7dd-dc922193fecf"],

Cell["\<\
CooperativeObjective simultaneously optimizes a single waveform across \
multiple initial->target pairs with optional weights (controlled via \
NormalizeWeights -> True | False). Below we synthesize a universal pi_x pulse \
by driving Ix -> Ix, Iy -> -Iy, and Iz -> -Iz simultaneously, then \
cross-check with TransformationAmplitude.\
\>", "Text",ExpressionUUID->"0a741d1d-6b84-6542-84d1-706bc956f59b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resCoop", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"40.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"CooperativeObjective", "[", 
      RowBox[{
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2.", ",", " ", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
            RowBox[{"-", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "}"}], ",", 
         "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"1.", ",", " ", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", "->", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}]}], "}"}], ",", 
         "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"1.", ",", " ", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", "->", " ", 
            RowBox[{"-", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}]}], "}"}]}], 
        "\n", "  ", "}"}], ",", " ", 
       RowBox[{"NormalizeWeights", " ", "->", " ", "True"}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "24"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "80"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "33"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simCoop", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resCoop", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"taCheck", " ", "=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{"N", "[", 
     RowBox[{"TransformationAmplitude", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
        RowBox[{"-", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
       RowBox[{"OptimalControlEventList", "[", "resCoop", "]"}]}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<CooperativeFidelity\>\"", " ", "->", " ", 
    RowBox[{"resCoop", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<IzToMinusIz_TransformationAmplitude\>\"", " ", "->", " ", 
    "taCheck"}], ",", "\n", "  ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simCoop", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"cf9d6cbd-9662-5f4d-8c6a-6fa9f6d37442"],

