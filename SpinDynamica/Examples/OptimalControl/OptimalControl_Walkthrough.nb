    "spin", " ", "transfer", " ", "exported", " ", "as", " ", "a", " ", 
     "PulseSequence", " ", "with", " ", "ShapedPulse"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"resHomo", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"120.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"80.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"60.", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", "+", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", "+", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}]}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "30"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "14"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psHomo", " ", "=", " ", 
   RowBox[{"OptimalControlPulseSequence", "[", 
    RowBox[{"resHomo", ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
