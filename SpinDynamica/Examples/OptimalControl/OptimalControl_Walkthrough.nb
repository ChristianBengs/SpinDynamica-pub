Cell[CellGroupData[{

Cell["6.3 Nonlinear Powder Grids & Heterogeneous Spin Ensembles", "Subsection",ExpressionUUID->"a72540b1-456e-fe4d-9ee7-a0aff0f538e7"],

Cell["\<\
Weighted nonlinear Hamiltonians (such as second-rank Legendre CSA powder \
grids weighted by Sin[beta]) and OptimalControlEnsemble[{prob1, prob2}] \
combining different spin systems or objectives fall back seamlessly to exact \
numerical evaluation.\
\>", "Text",ExpressionUUID->"75208942-9f62-d442-8cc7-4967c634be0c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"betaGrid", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"beta", ",", " ", 
       RowBox[{"N", "[", 
        RowBox[{"Sin", "[", "beta", "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"beta", ",", " ", 
       RowBox[{"Pi", "/", "8"}], ",", " ", 
       RowBox[{"7", " ", 
        RowBox[{"Pi", "/", "8"}]}], ",", " ", 
       RowBox[{"Pi", "/", "4"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensPowder", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"0.5", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", 
          RowBox[{
           RowBox[{"Cos", "[", "beta", "]"}], "^", "2"}]}], " ", "-", " ", 
         "1."}], ")"}], " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"0.3", " ", 
       RowBox[{"Sin", "[", "beta", "]"}], " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}], "]"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", " ", "20"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"beta", " ", "->", " ", "betaGrid"}], "}"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"resPowder", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ensPowder", ",", " ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "8."}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "100"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "404"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simPowder", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resPowder", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<PowderMean\>\"", " ", "->", " ", 
    RowBox[{"resPowder", "[", "\"\<MeanMemberFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<PowderMin\>\"", " ", "->", " ", 
    RowBox[{"resPowder", "[", "\"\<MinMemberFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simPowder", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], 
  "|>"}]}], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"c5c33c4d-f90b-5d41-970e-0cae334b1f42"],

