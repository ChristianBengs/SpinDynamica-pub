Cell[CellGroupData[{

Cell["\<\
11. Subspace Targets, Virtual-Z Phase Freedom & Hardware Export (Phase 2C)\
\>", "Section",ExpressionUUID->"7dcaed1c-dd25-5b45-a984-299131e48424"],

Cell[CellGroupData[{

Cell["\<\
11.1 Embedded Subspace Unitary Gates & Leakage Suppression \
(SubspaceUnitaryTarget, LeakageWeight)\
\>", "Subsection",ExpressionUUID->"664d449d-ee46-6d46-862a-b86ed2c1f05a"],

Cell["\<\
SubspaceUnitaryTarget[Usub, subspace] targets a unitary transformation \
restricted to a k-dimensional embedded subspace (from state indices, Kets, or \
an orthonormal isometry matrix) while penalizing subspace population loss \
L(U) = 1 - Tr[W^H W]/k weighted by LeakageWeight.\
\>", "Text",ExpressionUUID->"10f873e5-6688-8942-a6c0-e79381267ed7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", " ", 
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hadamard2", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}], " ", "/", " ", 
     RowBox[{"Sqrt", "[", "2.", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSubNoLeak", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{
       RowBox[{"2000.", " ", "*", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "ctrls4",
        ",", "\n", "    ", 
       RowBox[{"SubspaceUnitaryTarget", "[", 
        RowBox[{"hadamard2", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"PhaseFreedom", " ", "->", " ", "\"\<Diagonal\>\""}], ",", 
         " ", 
         RowBox[{"LeakageWeight", " ", "->", " ", "0."}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"{", 
        RowBox[{"6.*^-4", ",", " ", "12"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "51"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSubLeak", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{
       RowBox[{"2000.", " ", "*", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "ctrls4",
        ",", "\n", "    ", 
       RowBox[{"SubspaceUnitaryTarget", "[", 
        RowBox[{"hadamard2", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
         RowBox[{"PhaseFreedom", " ", "->", " ", "\"\<Diagonal\>\""}], ",", 
         " ", 
         RowBox[{"LeakageWeight", " ", "->", " ", "1.0"}]}], "]"}], ",", "\n",
        "    ", 
       RowBox[{"{", 
        RowBox[{"6.*^-4", ",", " ", "12"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "200"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
