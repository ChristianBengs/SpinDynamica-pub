Cell[CellGroupData[{

Cell["\<\
10. Trajectory Running Costs & Slice Duration Optimization (Phase 2B)\
\>", "Section",ExpressionUUID->"67b03fd2-4b9b-914f-88da-adb1d3865297"],

Cell[CellGroupData[{

Cell["\<\
10.1 Forbidden Intermediate-State Suppression (RunningCost & StatePenalty)\
\>", "Subsection",ExpressionUUID->"90d9f7f5-daef-fe4f-9240-c6b494a634ba"],

Cell["\<\
RunningCost -> StatePenalty[...] evaluates intermediate state populations or \
expectation values at every slice boundary and injects exact adjoint boundary \
costates. Below we steer |alpha,alpha> -> |beta,beta> while suppressing the \
forbidden |alpha,beta> state by >10^5-fold without sacrificing terminal \
fidelity.\
\>", "Text",ExpressionUUID->"0a3b3fed-731b-6643-af38-906cf19572bb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", " ", 
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
  RowBox[{"ks2", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psi1", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"ks2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psi2", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"ks2", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"psi4", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"ks2", "[", 
         RowBox[{"[", "4", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probNoPen", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{
     RowBox[{"2000.", " ", "*", " ", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "ctrls4", ",",
      " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{"psi1", " ", "->", " ", "psi4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.5*^-3", ",", " ", "24"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"probPen", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{
     RowBox[{"2000.", " ", "*", " ", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "ctrls4", ",",
      " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{"psi1", " ", "->", " ", "psi4"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1.5*^-3", ",", " ", "24"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", 
     "  ", 
     RowBox[{"RunningCost", " ", "->", " ", 
      RowBox[{"StatePenalty", "[", 
       RowBox[{"psi2", ",", " ", "4.0", ",", " ", 
        RowBox[{"TimeWeighting", " ", "->", " ", "\"\<Uniform\>\""}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vgPen", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", 
    RowBox[{"probPen", ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"500.", ",", " ", 
       RowBox[{"{", 
        RowBox[{"24", ",", " ", "4"}], "}"}]}], "]"}], ",", " ", 
     RowBox[{"StepSize", " ", "->", " ", "0.5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resNoPen", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probNoPen", ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "250"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "31"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resPen", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probPen", ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "400"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "None"}], ",", " ", 
     RowBox[{"GradientTolerance", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "7"}]}]}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "31"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trajPopNoPen", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "psi2", "]"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{"#", " ", ".", " ", "psi1"}], ")"}]}], "]"}], "^", "2"}], 
      " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"PropagateControls", "[", 
       RowBox[{
        RowBox[{"resNoPen", "[", "\"\<CompiledProblem\>\"", "]"}], ",", " ", 
        RowBox[{"resNoPen", "[", "\"\<Controls\>\"", "]"}]}], "]"}], 
      "[", "\"\<CumulativePropagators\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trajPopPen", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "psi2", "]"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{"#", " ", ".", " ", "psi1"}], ")"}]}], "]"}], "^", "2"}], 
      " ", "&"}], ",", " ", 
     RowBox[{
      RowBox[{"PropagateControls", "[", 
       RowBox[{
        RowBox[{"resPen", "[", "\"\<CompiledProblem\>\"", "]"}], ",", " ", 
        RowBox[{"resPen", "[", "\"\<Controls\>\"", "]"}]}], "]"}], 
      "[", "\"\<CumulativePropagators\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simPen", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", 
    RowBox[{"resPen", ",", " ", 
     RowBox[{"Tolerance", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<RunningCost_GradRelErr\>\"", " ", "->", " ", 
    RowBox[{"vgPen", "[", "\"\<MaxRelativeError\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Unpenalized_MaxPop\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Rest", "[", "trajPopNoPen", "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Unpenalized_TerminalF\>\"", " ", "->", " ", 
    RowBox[{"resNoPen", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Penalized_MaxPop\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Rest", "[", "trajPopPen", "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Penalized_TerminalF\>\"", " ", "->", " ", 
    RowBox[{"resPen", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simPen", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->
  "In[142]:=",ExpressionUUID->"7533bd54-9939-4246-8aea-5d6e20572038"],

