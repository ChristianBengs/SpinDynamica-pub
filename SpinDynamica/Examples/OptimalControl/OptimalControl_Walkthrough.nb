In[38]:=",ExpressionUUID->"9d25d480-7a89-7746-95a4-b21acebe0e01"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"INEPT_Fidelity\"\>", "\[Rule]", "0.9999241772715763`"}], ",", 
   RowBox[{"\<\"SDMatch\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0042849105731926`*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"8054eb7f-6ab3-364e-9908-d5345f1bf52c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PlotOptimalControlTrajectory", "[", 
  RowBox[{"resInept", ",", " ", 
   RowBox[{"opI", "[", 
    RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<I1z\>\"", ",", " ", "\"\<2 I1z I2z\>\"", ",", 
      " ", "\"\<I2z\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotLabel", " ", "->", " ", "\"\<INEPT Operator Trajectory\>\""}],
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"1f07b401-dd32-2048-864f-28281e7b22f4"],

