Cell[CellGroupData[{

Cell["\<\
11.2 Parametric Virtual-Z Phase Freedom (LeftZ / RightZ / BothZ / Generators) \
& OptimalPhases\
\>", "Subsection",ExpressionUUID->"681eaa8b-2c57-4943-ad76-3c5111b8d947"],

Cell["\<\
PhaseFreedom accepts non-parametric invariants (None, \"Global\", \
\"Diagonal\"/\"SubspaceDiagonal\") as well as smooth joint-optimized virtual \
rotations (\"LeftZ\", \"RightZ\", \"BothZ\", spin subsets, or custom \
Hermitian \"Generators\") compatible with Strong-Wolfe L-BFGS and FISTA. Here \
a 400 us CNOT infeasible without phase freedom converges rapidly to F > \
0.9995 under \"BothZ\".\
\>", "Text",ExpressionUUID->"b8bb7099-d5e3-7b4e-ae69-6ff7f05306f0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hCNOT", " ", "=", " ", 
   RowBox[{
    RowBox[{"2500.", " ", "*", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
    RowBox[{"3500.", " ", "*", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
    RowBox[{"1500.", " ", "*", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cnotTar", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "1.", ",", " ", "0.", ",", " ", "0."}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "0.", ",", " ", "1."}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"0.", ",", " ", "0.", ",", " ", "1.", ",", " ", "0."}], "}"}]}],
     "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vgPhiBothZ", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{"hCNOT", ",", " ", "ctrls4", ",", " ", 
       RowBox[{"UnitaryTarget", "[", 
        RowBox[{"cnotTar", ",", " ", 
         RowBox[{"PhaseFreedom", " ", "->", " ", "\"\<BothZ\>\""}]}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"4.*^-4", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"200.", ",", " ", 
            RowBox[{"-", "150."}], ",", " ", "180.", ",", " ", "120."}], 
           "}"}], ",", " ", "10"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.31", ",", " ", 
         RowBox[{"-", "0.74"}], ",", " ", "1.15", ",", " ", 
         RowBox[{"-", "0.42"}]}], "}"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"StepSize", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.5", ",", " ", "Automatic", ",", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "5"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pfCompare", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", " ", "=", " ", 
          RowBox[{"GRAPEOptimize", "[", 
           RowBox[{
            RowBox[{"OptimalControlProblem", "[", 
             RowBox[{"hCNOT", ",", " ", "ctrls4", ",", " ", 
              RowBox[{"UnitaryTarget", "[", 
               RowBox[{"cnotTar", ",", " ", 
                RowBox[{"PhaseFreedom", " ", "->", " ", "pfMode"}]}], "]"}], ",",
               " ", 
              RowBox[{"{", 
               RowBox[{"4.*^-4", ",", " ", "10"}], "}"}], ",", " ", 
              RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], 
             "]"}], ",", "\n", "      ", 
            RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
            RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
            RowBox[{"RandomSeed", " ", "->", " ", "61"}]}], "]"}]}], "}"}], ",",
         "\n", "    ", 
        RowBox[{"pfMode", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Fidelity\>\"", " ", "->", " ", 
            RowBox[{"r", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", " ", 
           RowBox[{"\"\<Iters\>\"", " ", "->", " ", 
            RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}]}]}], "|>"}]}]}], 
       "\n", "  ", "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"pfMode", ",", " ", 
        RowBox[{"{", 
         RowBox[{
         "None", ",", " ", "\"\<Global\>\"", ",", " ", "\"\<Diagonal\>\"", ",",
           " ", "\"\<LeftZ\>\"", ",", " ", "\"\<BothZ\>\""}], "}"}]}], 
       "}"}]}], "\n", "]"}], " ", "//", " ", "Association"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resBothZ", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{"hCNOT", ",", " ", "ctrls4", ",", " ", 
       RowBox[{"UnitaryTarget", "[", 
        RowBox[{"cnotTar", ",", " ", 
         RowBox[{"PhaseFreedom", " ", "->", " ", "\"\<BothZ\>\""}]}], "]"}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"4.*^-4", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",",
      "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "61"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simBothZ", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", 
    RowBox[{"resBothZ", ",", " ", 
     RowBox[{"Tolerance", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"iz1Mat", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"MatrixRepresentation", "[", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", "b2"}], "]"}], 
    "]"}]}], ";", " ", 
  RowBox[{"iz2Mat", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"MatrixRepresentation", "[", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", "b2"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pv", " ", "=", " ", 
   RowBox[{"resBothZ", "[", 
    RowBox[{"\"\<OptimalPhases\>\"", ",", " ", "\"\<Vector\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"uEffManual", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"pv", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", "iz1Mat"}], "]"}], " ", ".", 
      " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"pv", "[", 
         RowBox[{"[", "2", "]"}], "]"}], " ", "iz2Mat"}], "]"}]}], ")"}], " ",
     ".", " ", 
    RowBox[{"simBothZ", "[", "\"\<SpinDynamicaResult\>\"", "]"}], " ", ".", 
    " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"pv", "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "iz1Mat"}], "]"}], " ", ".", 
      " ", 
      RowBox[{"MatrixExp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"pv", "[", 
         RowBox[{"[", "4", "]"}], "]"}], " ", "iz2Mat"}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<PhaseGradRelErr\>\"", " ", "->", " ", 
    RowBox[{"vgPhiBothZ", "[", "\"\<PhaseMaxRelativeError\>\"", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<ModeComparison\>\"", " ", "->", " ", "pfCompare"}], ",", "\n",
    "  ", 
   RowBox[{"\"\<OptimalPhases_rad\>\"", " ", "->", " ", "pv"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<ManualPhaseFidelityDiff\>\"", " ", "->", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "cnotTar", "]"}], " ", ".", " ",
            "uEffManual"}], "]"}], "]"}], "^", "2"}], " ", "/", " ", "16."}], 
      " ", "-", " ", 
      RowBox[{"resBothZ", "[", "\"\<FinalFidelity\>\"", "]"}]}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
