Cell[CellGroupData[{

Cell["\<\
7. Exporting Optimal Pulses into Native SpinDynamica Workflows\
\>", "Section",ExpressionUUID->"8876f058-efa9-1d41-9342-51252ef8098e"],

Cell[CellGroupData[{

Cell["\<\
7.1 OptimalControlWaveform, OptimalControlEventList, Trajectory & Signal1D\
\>", "Subsection",ExpressionUUID->"3582874d-f218-664a-9c6a-f7316a0d8163"],

Cell["\<\
Every OptimalControlResult exports seamlessly to native SpinDynamica building \
blocks: OptimalControlWaveform returns structured slice arrays, while \
OptimalControlEventList produces {{H_j, dt_j}, ...} ready for \
NPropagationOperator, NPropagate, Trajectory, and Signal1D Preparation.\
\>", "Text",ExpressionUUID->"599bb203-f587-3e42-8b60-6ca0b9c101a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"wf", " ", "=", " ", 
   RowBox[{"OptimalControlWaveform", "[", "resGate", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evGate", " ", "=", " ", 
   RowBox[{"OptimalControlEventList", "[", "resGate", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uSD", " ", "=", " ", 
   RowBox[{"Normal", "[", 
    RowBox[{"MatrixRepresentation", "[", 
     RowBox[{
      RowBox[{"NPropagationOperator", "[", 
       RowBox[{"evGate", ",", " ", 
        RowBox[{"Basis", " ", "->", " ", "b1"}]}], "]"}], ",", " ", "b1"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"trajGate", " ", "=", " ", 
    RowBox[{"Trajectory", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], ",", " ", 
      "evGate"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Use", " ", "the", " ", "optimal", " ", 
    RowBox[{"(", 
     RowBox[{"pi", "/", "2"}], ")"}], "_x", " ", "pulse", " ", "as", " ", 
    "Preparation", " ", "for", " ", "a", " ", "1", "D", " ", "NMR", " ", 
    "FID"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sigOC", " ", "=", " ", 
   RowBox[{"Signal1D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0.1", ",", " ", "0.0005"}], "}"}], ",", " ", 
     RowBox[{"2", " ", "Pi", " ", "120.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"Preparation", " ", "->", " ", "evGate"}], ",", "\n", "  ", 
     RowBox[{"InitialDensityOperator", " ", "->", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", "\n", "  ", 
     RowBox[{"Observable", " ", "->", " ", "1"}], ",", "\n", "  ", 
     RowBox[{"ReportSignalCalculationMethod", " ", "->", " ", "False"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<WaveformKeys\>\"", " ", "->", " ", 
    RowBox[{"Keys", "[", "wf", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<NumEvents\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", "evGate", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<PropagatorDiff\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"uSD", " ", "-", " ", 
       RowBox[{"resGate", "[", "\"\<FinalPropagator\>\"", "]"}]}], "]"}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<EndBlochVector\>\"", " ", "->", " ", 
    RowBox[{"Chop", "[", 
     RowBox[{"Through", "[", 
      RowBox[{"trajGate", "[", "0.01", "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<SignalHead\>\"", " ", "->", " ", 
    RowBox[{"Head", "[", "sigOC", "]"}]}]}], "\n", "|>"}]}], "Input",
 CellLabel->"In[85]:=",ExpressionUUID->"a20f8ef7-8f16-8b4d-9c80-6833a8853a5d"],

