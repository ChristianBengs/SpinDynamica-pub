Cell[CellGroupData[{

Cell["5. Open-System (Dissipative Liouville-Space) Optimal Control", "Section",ExpressionUUID->"cdfdcf03-2fb4-1b4a-9565-a1f3b95d4968"],

Cell["\<\
When the drift contains a Superoperator such as \
PhenomenologicalRelaxationSuperoperator or Lindbladian (or when \
PropagateSpace -> \"Liouville\" is requested), OptimalControl automatically \
switches to exact Liouville-space propagation and adjoint gradients, verified \
directly against SpinDynamica superpropagators.\
\>", "Text",ExpressionUUID->"29a8ac06-d915-cc47-9de7-4412772f2426"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gRel", " ", "=", " ", 
   RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
    RowBox[{"1", ",", " ", "1.5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probLiouv", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"gRel", " ", "+", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"CommutationSuperoperator", "[", 
         RowBox[{"5.", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}]}], ")"}]}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "16"}], "}"}], ",", "\n", "  ", 
     RowBox[{"PropagateSpace", " ", "->", " ", "\"\<Liouville\>\""}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chkLiouvGrad", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", 
    RowBox[{"probLiouv", ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"25.", ",", " ", 
         RowBox[{"-", "15."}]}], "}"}], ",", " ", "16"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"resLiouv", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probLiouv", ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "50"}], ",", " ", 
     RowBox[{"InitialControls", " ", "->", " ", "5."}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simLiouv", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resLiouv", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<PropagateSpace\>\"", " ", "->", " ", 
    RowBox[{"resLiouv", "[", 
     RowBox[{"\"\<CompiledProblem\>\"", ",", " ", "\"\<Space\>\""}], "]"}]}], 
   ",", "\n", "  ", 
   RowBox[{"\"\<GradientPassedQ\>\"", " ", "->", " ", 
    RowBox[{"chkLiouvGrad", "[", "\"\<PassedQ\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<DissipativeTransfer\>\"", " ", "->", " ", 
    RowBox[{"resLiouv", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simLiouv", "[", "\"\<FidelityMatchQ\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FidelityError\>\"", " ", "->", " ", 
    RowBox[{"simLiouv", "[", "\"\<FidelityError\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"38c3c3af-555f-f24a-88e7-c7726169727d"],

