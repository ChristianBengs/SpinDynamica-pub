Notebook[{

Cell[CellGroupData[{
Cell["SpinDynamica Optimal Control (GRAPE) Walkthrough", "Title",ExpressionUUID->"b90e1288-f8cc-b344-b036-040667882bf0"],

Cell["\<\
A comprehensive interactive guide to state transfer, unitary gates, NMR \
coherence control, open-system relaxation, physical RF & slew constraints, \
FISTA sparsity, continuation schedules, solid-state MAS drift (CF4), \
trajectory running costs, slice duration optimization, subspace & virtual-Z \
gates, and spectrometer pulse export.\
\>", "Subtitle",ExpressionUUID->"c0611b99-7ebe-1149-82cf-e490ef067776"],

Cell[CellGroupData[{

Cell["0. Setup & Loading SpinDynamica", "Section",ExpressionUUID->"e9d834bb-0c51-4040-82c6-579055e39a2d"],

Cell["\<\
Add the SpinDynamica package directory to $Path (searching upward from the \
notebook directory) and load SpinDynamica`. The OptimalControl` subsystems \
are loaded automatically.\
\>", "Text",ExpressionUUID->"341c704f-d01c-9644-8a37-1ead8f83bb73"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
              " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", "\n",
           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "4", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$Path", ",", " ", "found"}], "]"}]}], "]"}], ";"}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"Select", "[", 
  RowBox[{"$Packages", ",", " ", 
   RowBox[{
    RowBox[{"StringStartsQ", "[", 
     RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", "&"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"73b43615-53f6-d84c-9045-d005c0a44d43"],

