Cell[CellGroupData[{

Cell["\<\
10.2 Joint Slice Duration & Delay Optimization (OptimizeDurations, \
FixedTotalDuration, DelaysOnly)\
\>", "Subsection",ExpressionUUID->"7d107940-8eb8-8f49-92dc-f9416c235630"],

Cell["\<\
OptimizeDurations computes exact analytical derivatives with respect to slice \
durations dt_j (including causal suffix-sum chain rules over continuous CF4 \
MAS drifts). Supports bounded durations (DurationBounds), \
fixed-total-duration simplex projection (FixedTotalDuration -> True), and \
\"DelaysOnly\" free-evolution delay refinement.\
\>", "Text",ExpressionUUID->"3b153141-8934-894a-8de2-44b1749540e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", " ", 
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"probMASDur", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{"Hdip", ",", " ", "ctrls4", ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"0.8", " ", "*", " ", "trMAS"}], ",", " ", "8"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"InitialTimePoint", " ", "->", " ", 
      RowBox[{"trMAS", " ", "/", " ", "4."}]}], ",", " ", 
     RowBox[{"DriftIntegration", " ", "->", " ", "\"\<CF4\>\""}], ",", " ", 
     RowBox[{"OptimizeDurations", " ", "->", " ", "True"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vgMASDur", " ", "=", " ", 
    RowBox[{"VerifyOptimalControlGradient", "[", 
     RowBox[{"probMASDur", ",", " ", 
      RowBox[{"uProbe", "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", ";;", " ", "8"}], "]"}], "]"}], ",", " ", 
      RowBox[{"StepSize", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", " ", "Automatic"}], "}"}]}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"resFixedDur", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"1500.", " ", "*", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
        RowBox[{"3500.", " ", "*", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
        RowBox[{"2000.", " ", "*", " ", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", " ", 
       "ctrls4", ",", "\n", "    ", 
       RowBox[{"StateTarget", "[", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "]"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{"4.*^-4", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", 
       "    ", 
       RowBox[{"OptimizeDurations", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FixedTotalDuration", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"DurationBounds", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"2.*^-5", ",", " ", "2.*^-4"}], "}"}]}]}], "]"}], ",", "\n", 
     "  ", 
     RowBox[{"InitialControls", " ", "->", " ", "800."}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "23"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simFixedDur", " ", "=", " ", 
    RowBox[{"VerifyOptimalControlSimulation", "[", 
     RowBox[{"resFixedDur", ",", " ", 
      RowBox[{"Tolerance", " ", "->", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"echoInit", " ", "=", " ", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0.", ",", " ", 
     RowBox[{"{", 
      RowBox[{"3", ",", " ", "4"}], "}"}]}], "]"}]}], ";", " ", 
  RowBox[{
   RowBox[{"echoInit", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", "=", " ", "5000."}], ";",
   " ", 
  RowBox[{
   RowBox[{"echoInit", "[", 
    RowBox[{"[", 
     RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], " ", "=", " ", "5000."}], ";",
   " ", 
  RowBox[{
   RowBox[{"echoInit", "[", 
    RowBox[{"[", 
     RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], " ", "=", " ", "5000."}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"resDelays", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{
       RowBox[{"1000.", " ", "*", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "ctrls4",
        ",", " ", 
       RowBox[{"StateTarget", "[", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"5.*^-5", ",", " ", "0.25*^-3", ",", " ", "5.*^-5"}], "}"}], ",",
        " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
       RowBox[{"OptimizeDurations", " ", "->", " ", "\"\<DelaysOnly\>\""}], ",",
        "\n", "    ", 
       RowBox[{"InitialControls", " ", "->", " ", "echoInit"}], ",", " ", 
       RowBox[{"DurationBounds", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"5.*^-5", ",", " ", "1.5*^-3"}], "}"}]}], ",", " ", 
       RowBox[{"AmplitudeBound", " ", "->", " ", "12000."}]}], "]"}], ",", 
     "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simDelays", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", 
    RowBox[{"resDelays", ",", " ", 
     RowBox[{"Tolerance", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<MAS_DurGradRelErr\>\"", " ", "->", " ", 
    RowBox[{"vgMASDur", "[", "\"\<DurationMaxRelativeError\>\"", "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<FixedDur_F\>\"", " ", "->", " ", 
    RowBox[{"resFixedDur", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FixedDur_SumErr\>\"", " ", "->", " ", 
