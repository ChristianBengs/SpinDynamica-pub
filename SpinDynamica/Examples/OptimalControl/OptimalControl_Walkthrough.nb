Cell[CellGroupData[{

Cell["6. Robust & Cooperative Ensemble Optimal Control", "Section",ExpressionUUID->"58d1c1ae-7850-5e4a-be15-de5e57b6ac8c"],

Cell[CellGroupData[{

Cell["6.1 Broadband Offset Compensation (\"Mean\" vs \"SoftMin\")", \
"Subsection",ExpressionUUID->"21f93811-5cbf-e34b-bbbd-a7db33258501"],

Cell["\<\
Use OptimalControlEnsemble with EnsembleParameters to design pulses robust \
against resonance offsets delta in [-5, +5] kHz. Affine parameter terms are \
automatically hoisted and evaluated fast across all ensemble members. Compare \
average maximization (\"Mean\") vs worst-case smoothing ({\"SoftMin\", \
beta}), inspect EvaluateEnsembleFidelity, and plot the profile.\
\>", "Text",ExpressionUUID->"d65a8664-3675-c647-bf9b-1bc9a806e60d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ks1", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensMean", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"delta", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"delta", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "5."}], ",", " ", "5.", ",", " ", "1."}], "]"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"EnsembleAggregation", " ", "->", " ", "\"\<Mean\>\""}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensSoft", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"delta", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"delta", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "5."}], ",", " ", "5.", ",", " ", "1."}], "]"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"EnsembleAggregation", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SoftMin\>\"", ",", " ", "20."}], "}"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"resMean", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ensMean", ",", " ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "8."}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.996"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "101"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSoft", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
