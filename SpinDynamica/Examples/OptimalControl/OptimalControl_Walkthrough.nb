Cell[CellGroupData[{

Cell["\<\
9. Solid-State / MAS Time-Dependent Drift Hamiltonians (Phase 2A)\
\>", "Section",ExpressionUUID->"61c6aa03-1a9d-1d45-a0e1-7bfbb8657b6e"],

Cell[CellGroupData[{

Cell["\<\
9.1 Continuous MAS Drift, InitialTimePoint & DriftIntegration Schemes (CF4 / \
SubSlices)\
\>", "Subsection",ExpressionUUID->"0d04595b-7b38-604c-afcd-23b4dea79cfa"],

Cell["\<\
Phase 2A extends OptimalControlProblem and OptimalControlEnsemble to \
continuously time-dependent and periodic Hamiltonians such as Magic-Angle \
Spinning (MAS) PeriodicFunction / TimeDependentGeneratorFunction drifts, with \
exact InitialTimePoint rotor-phase control and 4th-order commutator-free \
Magnus integration (\"CF4\" / {\"CF4\", q}).\
\>", "Text",ExpressionUUID->"b90235a4-b187-2443-9b65-bfbc87e1f65a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", " ", 
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ctrls4", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"trMAS", " ", "=", " ", 
   RowBox[{"1.", " ", "/", " ", "10000."}]}], ";", " ", 
  RowBox[{"wr", " ", "=", " ", 
   RowBox[{"2.", " ", 
    RowBox[{"Pi", " ", "/", " ", "trMAS"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hdip", " ", "=", " ", 
   RowBox[{"PeriodicFunction", "[", 
    RowBox[{"t", ",", " ", "trMAS", ",", " ", 
     RowBox[{"Evaluate", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"1500.", " ", "*", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
       RowBox[{"3500.", " ", "*", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n", "  ", 
       RowBox[{"4000.", " ", "*", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"wr", " ", "t"}], "]"}], " ", "*", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n", "  ", 
       RowBox[{"6000.", " ", "*", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"wr", " ", "t"}], "]"}], " ", "+", " ", 
          RowBox[{"0.5", " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"2", " ", "wr", " ", "t"}], "]"}]}]}], ")"}], " ", "*", 
        " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", ".", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "-", " ", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}]}], "\n", 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "901", "]"}], ";", " ", 
  RowBox[{"uProbe", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "3000."}], ",", " ", "3000."}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"12", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"propsMAS", " ", "=", " ", 
   RowBox[{
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"scheme", " ", "->", " ", 
       RowBox[{
        RowBox[{"EvaluateOptimalControl", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"CompileOptimalControlProblem", "[", 
           RowBox[{"OptimalControlProblem", "[", 
            RowBox[{"Hdip", ",", " ", "ctrls4", ",", " ", 
             RowBox[{"StateTarget", "[", 
              RowBox[{
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2.", " ", "*", " ", "trMAS"}], ",", " ", "12"}], 
              "}"}], ",", " ", 
             RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
             " ", 
             RowBox[{"InitialTimePoint", " ", "->", " ", 
              RowBox[{"trMAS", " ", "/", " ", "4."}]}], ",", " ", 
             RowBox[{"DriftIntegration", " ", "->", " ", "scheme"}]}], "]"}], 
           "]"}], ",", "\n", "    ", "uProbe", ",", " ", "True"}], "]"}], 
        "[", "\"\<FinalPropagator\>\"", "]"}]}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"scheme", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Midpoint\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SubSlices\>\"", ",", " ", "4"}], "}"}], ",", 
          " ", "\"\<CF4\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<CF4\>\"", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<CF4\>\"", ",", " ", "4"}], "}"}]}], "}"}]}], "}"}]}], 
     "\n", "]"}], " ", "//", " ", "Association"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uRefCF44", " ", "=", " ", 
   RowBox[{"propsMAS", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<CF4\>\"", ",", " ", "4"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vgMAS", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{"Hdip", ",", " ", "ctrls4", ",", " ", 
       RowBox[{"StateTarget", "[", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2.", " ", "*", " ", "trMAS"}], ",", " ", "12"}], "}"}], ",",
        " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
       RowBox[{"InitialTimePoint", " ", "->", " ", 
        RowBox[{"trMAS", " ", "/", " ", "4."}]}], ",", " ", 
       RowBox[{"DriftIntegration", " ", "->", " ", "\"\<CF4\>\""}]}], "]"}], ",",
      "\n", "  ", "uProbe", ",", " ", 
     RowBox[{"StepSize", " ", "->", " ", "0.5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<DiffVsCF4x4\>\"", " ", "->", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Midpoint\>\"", " ", "->", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"propsMAS", "[", "\"\<Midpoint\>\"", "]"}], " ", "-", " ", 
          "uRefCF44"}], "]"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<SubSlices4\>\"", " ", "->", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"propsMAS", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<SubSlices\>\"", ",", " ", "4"}], "}"}], "]"}], " ", "-",
           " ", "uRefCF44"}], "]"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CF4\>\"", " ", "->", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"propsMAS", "[", "\"\<CF4\>\"", "]"}], " ", "-", " ", 
          "uRefCF44"}], "]"}], "]"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<CF4x2\>\"", " ", "->", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"propsMAS", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<CF4\>\"", ",", " ", "2"}], "}"}], "]"}], " ", "-", 
          " ", "uRefCF44"}], "]"}], "]"}]}]}], "|>"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<CF4_GradRelErr\>\"", " ", "->", " ", 
    RowBox[{"vgMAS", "[", "\"\<MaxRelativeError\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"bbabac94-ae56-7c49-8963-bd0b8504fc87"],

