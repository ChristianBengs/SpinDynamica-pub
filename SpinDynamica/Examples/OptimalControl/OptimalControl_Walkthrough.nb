Cell[CellGroupData[{

Cell["\<\
9.2 Rotor-Phase Invariant MAS Recoupling & Signal1D COMPUTE Verification\
\>", "Subsection",ExpressionUUID->"94095ec3-79c5-dd47-9e80-469a53673749"],

Cell["\<\
Sweep InitialTimePoint across rotor phases via EnsembleParameters to design a \
gamma/rotor-phase-invariant I1z -> I2z recoupling pulse over two rotor \
periods, verify it against NPropagationOperator via \
VerifyOptimalControlSimulation, and cross-check follow-up MAS Signal1D \
acquisition under SignalCalculationMethod -> \"COMPUTE\" vs \"Direct\".\
\>", "Text",ExpressionUUID->"504c1e39-03d9-164d-9caa-39a674ce3fef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ensMAS", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{"Hdip", ",", " ", "ctrls4", ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2.", " ", "*", " ", "trMAS"}], ",", " ", "24"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"t0Sym", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"0.", ",", " ", 
          RowBox[{"trMAS", " ", "/", " ", "4."}], ",", " ", 
          RowBox[{"trMAS", " ", "/", " ", "2."}], ",", " ", 
          RowBox[{"3.", " ", "*", " ", 
           RowBox[{"trMAS", " ", "/", " ", "4."}]}]}], "}"}]}], "}"}]}], ",", 
     "\n", "  ", 
     RowBox[{"InitialTimePoint", " ", "->", " ", "t0Sym"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"DriftIntegration", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CF4\>\"", ",", " ", "2"}], "}"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"resMAS", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ensMAS", ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "18000."}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "140"}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "77"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simMAS", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", 
    RowBox[{"resMAS", ",", " ", 
     RowBox[{"Tolerance", " ", "->", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rhoAfterMAS", " ", "=", " ", 
   RowBox[{
    RowBox[{"NPropagate", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"OptimalControlEventList", "[", 
       RowBox[{"resMAS", ",", " ", 
        RowBox[{"IncludeDrift", " ", "->", " ", "False"}], ",", " ", 
