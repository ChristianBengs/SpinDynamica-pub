Cell[CellGroupData[{

Cell["\<\
6.2 2D Offset x RF Inhomogeneity & J-Compensated NMR Ensembles\
\>", "Subsection",ExpressionUUID->"f7286f2a-7ecc-8d4d-9edd-a67105b75231"],

Cell["\<\
Combine EnsembleParameters with RFInhomogeneity -> {0.8, ..., 1.2} for \
two-dimensional robustness maps, and build J-compensated two-spin transfers \
(optionally setting Parallel -> 2 for multi-kernel speedups).\
\>", "Text",ExpressionUUID->"1f81cdac-341d-c142-8f8d-b7f10ac29e0f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ens2D", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"delta", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", " ", "32"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"delta", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "2.5"}], ",", " ", "2.5", ",", " ", "1.25"}], "]"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"RFInhomogeneity", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
       "0.8", ",", " ", "0.9", ",", " ", "1.0", ",", " ", "1.1", ",", " ", 
        "1.2"}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"EnsembleAggregation", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SoftMin\>\"", ",", " ", "15."}], "}"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"res2D", " ", "=", " ", 
    RowBox[{"GRAPEOptimize", "[", 
     RowBox[{"ens2D", ",", " ", 
      RowBox[{"AmplitudeBound", " ", "->", " ", "8."}], ",", " ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
      RowBox[{"MaxIterations", " ", "->", " ", "140"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "202"}]}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"J", "-", 
    RowBox[{"compensated", " ", "2"}], "-", 
    RowBox[{"spin", " ", "INEPT", " ", "across", " ", "J", " ", 
     RowBox[{"in", " ", "[", 
      RowBox[{"120", ",", " ", "160"}], "]"}], " ", "Hz", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"set", " ", "Parallel"}], " ", "->", " ", 
       RowBox[{
        RowBox[{"2", " ", "for", " ", "multi"}], "-", "kernel"}]}], ")"}]}]}],
    " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensJ", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"jVal", " ", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.015", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"jVal", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
         "120.", ",", " ", "130.", ",", " ", "140.", ",", " ", "150.", ",", 
          " ", "160."}], "}"}]}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resJ", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"ensJ", ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.996"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "150"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "303"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<2D_GridShape\>\"", " ", "->", " ", 
    RowBox[{"res2D", "[", "\"\<GridShape\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<2D_MeanFidelity\>\"", " ", "->", " ", 
    RowBox[{"res2D", "[", "\"\<MeanMemberFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<2D_MinFidelity\>\"", " ", "->", " ", 
    RowBox[{"res2D", "[", "\"\<MinMemberFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<JRobust_MeanFidelity\>\"", " ", "->", " ", 
    RowBox[{"resJ", "[", "\"\<MeanMemberFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<JRobust_MinFidelity\>\"", " ", "->", " ", 
    RowBox[{"resJ", "[", "\"\<MinMemberFidelity\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"203adafd-c599-b941-a72e-a4ac94bfede8"],

