Cell[CellGroupData[{

Cell["\<\
7.2 Order-0 Generators (OptimalControlGenerator) & ShapedPulse Sequences \
(OptimalControlPulseSequence)\
\>", "Subsection",ExpressionUUID->"b6f1e5d6-5a32-854d-98da-9288eaf85007"],

Cell["\<\
Export pulses either as a piecewise-constant TimeDependentGeneratorFunction \
via OptimalControlGenerator[res, t], or (for homonuclear/single-spin XY \
controls) as a SpinDynamica PulseSequence[ShapedPulse[...]] via \
OptimalControlPulseSequence.\
\>", "Text",ExpressionUUID->"c8452cec-db54-a04f-9d4e-c7540a9b0ae4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";", " ", 
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"genInept", " ", "=", " ", 
   RowBox[{"OptimalControlGenerator", "[", 
    RowBox[{"resInept", ",", " ", "tGlobal"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uGen", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"MatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"NPropagationOperator", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"genInept", ",", " ", "0.015"}], "}"}], ",", " ", 
         RowBox[{"Basis", " ", "->", " ", "b2"}]}], "]"}], ",", " ", "b2"}], 
      "]"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Homonuclear", " ", "2"}], "-", 
