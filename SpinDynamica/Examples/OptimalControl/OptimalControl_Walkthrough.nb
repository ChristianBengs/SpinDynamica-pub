Cell[CellGroupData[{

Cell["2.2 Optimizer Selection & Grid-Refinement Warm Restarts", "Subsection",ExpressionUUID->"00484d0f-7b6f-9241-9422-87012f8c3380"],

Cell["\<\
Compare Optimizer choices (\"LBFGS\", \"BFGS\", \"ConjugateGradient\") and \
demonstrate passing a coarse 12-slice OptimalControlResult directly into \
InitialControls to warm-start a finer 24-slice optimization.\
\>", "Text",ExpressionUUID->"6b8ee021-1a36-6940-ae82-e37fd4151ba2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"optCompare", " ", "=", " ", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"r", " ", "=", " ", 
           RowBox[{"GRAPEOptimize", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
             " ", 
             RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0.01", ",", " ", "10"}], "}"}], ",", "\n", "      ", 
             RowBox[{"Optimizer", " ", "->", " ", "optName"}], ",", " ", 
             RowBox[{"MaxIterations", " ", "->", " ", "50"}], ",", " ", 
             RowBox[{"InitialControls", " ", "->", " ", "20."}], ",", " ", 
             RowBox[{"RandomSeed", " ", "->", " ", "7"}]}], "]"}]}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"optName", " ", "->", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Fidelity\>\"", " ", "->", " ", 
             RowBox[{"r", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", " ", 
            RowBox[{"\"\<Iterations\>\"", " ", "->", " ", 
             RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}]}]}], "|>"}]}]}], 
        "\n", "  ", "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"optName", ",", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<LBFGS\>\"", ",", " ", "\"\<BFGS\>\"", ",", 
           " ", "\"\<ConjugateGradient\>\""}], "}"}]}], "}"}]}], "\n", "]"}], 
     " ", "//", " ", "Association"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Coarse", " ", "optimization", " ", "followed", " ", "by", " ", 
    "resampled", " ", "warm", " ", "restart"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"resCoarse", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"10.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "12"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"InitialScale", " ", "->", " ", "5."}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "55"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resFine", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"10.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "24"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"InitialControls", " ", "->", " ", "resCoarse"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "40"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Optimizers\>\"", " ", "->", " ", "optCompare"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<CoarseFidelity\>\"", " ", "->", " ", 
    RowBox[{"resCoarse", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<WarmRestartFineFidelity\>\"", " ", "->", " ", 
    RowBox[{"resFine", "[", "\"\<FinalFidelity\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"5c793e93-fca4-8b4a-a9af-b2d4c3a6155a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Optimizers\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
