Cell[CellGroupData[{

Cell["\<\
8.3 Continuation Schedules (TimeStepSchedule, SoftMinSchedule), MultiStart & \
Live StepMonitor\
\>", "Subsection",ExpressionUUID->"60e41f78-9fea-cc4b-97ba-da849446fe59"],

Cell["\<\
Combine coarse-to-fine TimeStepSchedule, SoftMinSchedule beta annealing, \
MultiStart (with deterministic BlockRandom seeds), and non-intrusive \
outer-iteration StepMonitor callbacks on a 27-member 2D Offset x RF \
Inhomogeneity ensemble.\
\>", "Text",ExpressionUUID->"c0fd931e-b267-9243-bba8-9a7ec8472cbf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
  RowBox[{"ks1", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ensBBCont", " ", "=", " ", 
   RowBox[{"OptimalControlEnsemble", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"delta", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", "0.002", ",", "\n",
      "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", "  ", 
     RowBox[{"EnsembleParameters", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"delta", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "5."}], ",", " ", "5.", ",", " ", "1.25"}], "]"}]}], 
       "}"}]}], ",", "\n", "  ", 
     RowBox[{"RFInhomogeneity", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.85", ",", " ", "1.0", ",", " ", "1.15"}], "}"}]}], ",", 
     "\n", "  ", 
     RowBox[{"EnsembleAggregation", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SoftMin\>\"", ",", " ", "25."}], "}"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"monLog", " ", "=", " ", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resCont", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{"ensBBCont", ",", " ", 
     RowBox[{"AmplitudeNormBound", " ", "->", " ", "8."}], ",", "\n", "  ", 
     RowBox[{"TimeStepSchedule", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"16", ",", " ", "32"}], "}"}]}], ",", " ", 
     RowBox[{"SoftMinSchedule", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0.", ",", " ", "8.", ",", " ", "25."}], "}"}]}], ",", " ", 
     RowBox[{"MultiStart", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "90"}], ",", "\n", "  ", 
     RowBox[{"StepMonitor", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"monLog", ",", " ", "#"}], "]"}], " ", "&"}], ")"}]}], ",", 
     " ", 
     RowBox[{"MonitorInterval", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "77"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simCont", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resCont", "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<MeanF\>\"", " ", "->", " ", 
    RowBox[{"resCont", "[", "\"\<MeanMemberFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
