Cell[CellGroupData[{

Cell["4.2 Non-Hermitian Coherence-Order Transfer (CoherenceTarget)", \
"Subsection",ExpressionUUID->"bc057661-d5db-5b4f-a816-6bdb97e820be"],

Cell["\<\
CoherenceTarget supports non-Hermitian spin raising/lowering operators, \
either phase-sensitive (PhaseInsensitive -> False) or phase-insensitive \
(PhaseInsensitive -> True), with configurable TargetNormalization \
(\"Frobenius\", \"TargetNorm\", \"None\").\
\>", "Text",ExpressionUUID->"e326dae3-9c69-dd40-bb5b-1fc41f004cb6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resCoh", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"25.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"35.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"140.", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"CoherenceTarget", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<-\>\""}], "]"}]}], " ", "->", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<+\>\""}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"PhaseInsensitive", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"TargetNormalization", " ", "->", " ", "\"\<Frobenius\>\""}]}],
       "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.015", ",", " ", "36"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "160"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "15"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<ZQ_to_DQ_Fidelity\>\"", " ", "->", " ", 
    RowBox[{"resCoh", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<Iterations\>\"", " ", "->", " ", 
    RowBox[{"resCoh", "[", "\"\<Iterations\>\"", "]"}]}]}], "|>"}]}], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"776743a4-cbd8-e145-a0cd-d56983b885eb"],

