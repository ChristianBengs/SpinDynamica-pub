 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"PropagateSpace\"\>", "\[Rule]", "\<\"Liouville\"\>"}], ",", 
   RowBox[{"\<\"GradientPassedQ\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"DissipativeTransfer\"\>", "\[Rule]", "0.9931410856258525`"}], 
   ",", 
