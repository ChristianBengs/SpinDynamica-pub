        "\[RightAssociation]"}]}]}], "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"CoarseFidelity\"\>", "\[Rule]", "0.9999805596970593`"}], ",", 
   RowBox[{"\<\"WarmRestartFineFidelity\"\>", "\[Rule]", 
    "0.9999853601230274`"}]}], "\[RightAssociation]"}]], "Output",
