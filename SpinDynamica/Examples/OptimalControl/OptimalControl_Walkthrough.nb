Cell[CellGroupData[{

Cell["\<\
11.3 Simultaneous Multi-Channel PulseSequence, OptimalControlPulseTable & \
Bruker/SIMPSON/CSV Export\
\>", "Subsection",ExpressionUUID->"09166e5e-63a0-9246-8f3e-202cf842b343"],

Cell["\<\
Export multi-spin / multi-channel pulses directly to native SpinDynamica \
simultaneous PulseSequence[spins, {Delay[totalDur, \
TimeDependentGeneratorFunction[...]]}], polar amplitude/phase tables via \
OptimalControlPulseTable, and spectrometer or simulator strings/files in \
\"Bruker\" (JCAMP-DX), \"SIMPSON\", and \"CSV\" formats (including Resample \
for variable-duration pulses).\
\>", "Text",ExpressionUUID->"fbac67e6-bb9c-cb44-90dd-ca127e51ff40"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pseq4", " ", "=", " ", 
   RowBox[{"OptimalControlPulseSequence", "[", 
    RowBox[{"resBothZ", ",", " ", 
     RowBox[{"IncludeDrift", " ", "->", " ", "True"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uSeq4", " ", "=", " ", 
   RowBox[{"MatrixRepresentation", "[", 
    RowBox[{
     RowBox[{"NPropagationOperator", "[", 
      RowBox[{"pseq4", ",", " ", 
       RowBox[{"Basis", " ", "->", " ", "b2"}]}], "]"}], ",", " ", "b2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uEv4", " ", "=", " ", 
   RowBox[{"MatrixRepresentation", "[", 
    RowBox[{
     RowBox[{"NPropagationOperator", "[", 
      RowBox[{
       RowBox[{"OptimalControlEventList", "[", 
        RowBox[{"resBothZ", ",", " ", 
         RowBox[{"IncludeDrift", " ", "->", " ", "True"}]}], "]"}], ",", " ", 
       RowBox[{"Basis", " ", "->", " ", "b2"}]}], "]"}], ",", " ", "b2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tbl4", " ", "=", " ", 
    RowBox[{"OptimalControlPulseTable", "[", "resBothZ", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"brkAll", " ", "=", " ", 
   RowBox[{"ExportOptimalControlPulse", "[", 
    RowBox[{"resBothZ", ",", " ", "\"\<Bruker\>\"", ",", " ", 
     RowBox[{"Channel", " ", "->", " ", "All"}], ",", " ", 
     RowBox[{"Title", " ", "->", " ", "\"\<CNOT_BothZ\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"simpAll", " ", "=", " ", 
   RowBox[{"ExportOptimalControlPulse", "[", 
    RowBox[{"resBothZ", ",", " ", "\"\<SIMPSON\>\"", ",", " ", 
     RowBox[{"Channel", " ", "->", " ", "All"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"csvAll", " ", "=", " ", 
   RowBox[{"ExportOptimalControlPulse", "[", 
    RowBox[{"resBothZ", ",", " ", "\"\<CSV\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"brkResamp", " ", "=", " ", 
   RowBox[{"ExportOptimalControlPulse", "[", 
    RowBox[{"resFixedDur", ",", " ", "\"\<Bruker\>\"", ",", " ", 
     RowBox[{"Channel", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"Resample", " ", "->", " ", "12"}], ",", " ", 
     RowBox[{"Title", " ", "->", " ", "\"\<FixedDur_Resamp12\>\""}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<PulseSequence_PropErr\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"uSeq4", " ", "-", " ", "uEv4"}], "]"}], "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<TableChannels\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", 
     RowBox[{"tbl4", "[", "\"\<Channels\>\"", "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<BrukerCh1ValidQ\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"StringContainsQ", "[", 
      RowBox[{
       RowBox[{"brkAll", "[", "1", "]"}], ",", " ", "\"\<##JCAMP-DX=\>\""}], 
      "]"}], " ", "&&", " ", 
     RowBox[{"StringContainsQ", "[", 
      RowBox[{
       RowBox[{"brkAll", "[", "1", "]"}], ",", " ", "\"\<##END=\>\""}], 
      "]"}]}]}], ",", "\n", "  ", 
   RowBox[{"\"\<SimpsonChannels\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", "simpAll", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<CSVHasCh2PhaseQ\>\"", " ", "->", " ", 
    RowBox[{"StringContainsQ", "[", 
     RowBox[{"csvAll", ",", " ", "\"\<Ch2_Phase_Deg\>\""}], "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<ResampledBruker12Q\>\"", " ", "->", " ", 
    RowBox[{"StringContainsQ", "[", 
     RowBox[{"brkResamp", ",", " ", "\"\<##NPOINTS= 12\>\""}], "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CSVHeader\>\"", " ", "->", " ", 
    RowBox[{"First", "[", 
     RowBox[{"StringSplit", "[", 
      RowBox[{"csvAll", ",", " ", "\"\<\\n\>\""}], "]"}], "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"0ffda19b-00e8-9a4e-8f58-a5ec96744def"],

