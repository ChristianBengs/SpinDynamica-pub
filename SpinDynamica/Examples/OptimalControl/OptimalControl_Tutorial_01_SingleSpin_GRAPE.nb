Cell["\<\
VerifyOptimalControlGradient checks the analytical GRAPE gradient against \
central finite differences. Evaluating at a generic non-stationary waveform \
(using StepSize -> 10^-4 Hz so finite-difference cancellation stays well \
below ControlUnits scale) gives a clean quantitative pass, whereas at a fully \
converged optimum the true gradient itself is O(10^-7). Finally, \
VerifyOptimalControlSimulation independently propagates the exported pulse \
using SpinDynamica's native NPropagationOperator to confirm exact agreement.\
\>", "Text",ExpressionUUID->"7968d262-db7b-0240-864c-1e118e3236fd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uProbe", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "250."}], ",", "250."}], "}"}], ",", 
     RowBox[{"Dimensions", "[", 
      RowBox[{"resInv", "[", "\"\<Controls\>\"", "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gradCheck", "=", 
   RowBox[{"VerifyOptimalControlGradient", "[", 
    RowBox[{"probInv", ",", "uProbe", ",", 
     RowBox[{"StepSize", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "4"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simCheck", "=", 
   RowBox[{"VerifyOptimalControlSimulation", "[", "resInv", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Gradient Check\>\"", "->", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"gradCheck", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<MaxAbsoluteError\>\"", ",", "\"\<MaxRelativeError\>\"", 
        ",", "\"\<PassedQ\>\""}], "}"}]}], "]"}]}], ",", 
   RowBox[{"\"\<Simulation Check\>\"", "->", 
    RowBox[{"KeyTake", "[", 
     RowBox[{"simCheck", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<FidelityMatchQ\>\"", ",", "\"\<FidelityError\>\"", 
        ",", "\"\<PropagatorError\>\""}], "}"}]}], "]"}]}]}], "}"}]}], "Input",\

 CellLabel->"In[8]:=",ExpressionUUID->"cee0ea79-7f56-8848-a7ed-990d5b459d8a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Gradient Check\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"MaxAbsoluteError\"\>", "\[Rule]", 
       "8.472125453441726`*^-12"}], ",", 
      RowBox[{"\<\"MaxRelativeError\"\>", "\[Rule]", 
       "4.125441331655975`*^-8"}], ",", 
      RowBox[{"\<\"PassedQ\"\>", "\[Rule]", "True"}]}], 
     "\[RightAssociation]"}]}], ",", 
   RowBox[{"\<\"Simulation Check\"\>", "\[Rule]", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"\<\"FidelityMatchQ\"\>", "\[Rule]", "True"}], ",", 
      RowBox[{"\<\"FidelityError\"\>", "\[Rule]", "3.774758283725532`*^-15"}],
       ",", 
      RowBox[{"\<\"PropagatorError\"\>", "\[Rule]", 
       "2.837048893407221`*^-15"}]}], "\[RightAssociation]"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[8]=",ExpressionUUID->"615144ff-23a0-0342-993a-d9d338b07608"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Single-Spin Target Types", "Section",ExpressionUUID->"edc7e190-2a1e-7647-8a51-4bbafdf34278"],

Cell["\<\
Without changing the spin system or controls, you can swap the target object \
to design point-to-point state transfers or universal quantum gates:
  - ObservableTarget[init -> tar, TargetNormalization -> \"Frobenius\" | \
\"TargetNorm\" | \"None\"]: maximizes normalized Re Tr[tar^H rho(T)], ideal \
for traceless NMR spin operators.
  - StateTarget[ket1 -> ket2, ObjectiveType -> \"StateFidelity\"]: for pure \
state kets or positive-semidefinite density matrices.
  - UnitaryTarget[U, PhaseFreedom -> None | \"Global\"]: implements a \
spin-rotation gate across all initial states (PhaseFreedom -> \"Global\" \
ignores an irrelevant global phase factor on SU(2)/U(2)).\
\>", "Text",ExpressionUUID->"dd4519e3-58a8-f44f-a240-e1332ffa0a71"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kets", "=", 
   RowBox[{"BasisKets", "[", 
    RowBox[{"ZeemanBasis", "[", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resKet", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"kets", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "->", 
        RowBox[{"kets", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"ObjectiveType", "->", "\"\<StateFidelity\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resUnitGlob", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", 
     RowBox[{"UnitaryTarget", "[", 
      RowBox[{
       RowBox[{"RotationOperator", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
       
       RowBox[{"PhaseFreedom", "->", "\"\<Global\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resUnitExact", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", 
     RowBox[{"UnitaryTarget", "[", 
      RowBox[{
       RowBox[{"RotationOperator", "[", 
        RowBox[{"1", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], ",", "\"\<y\>\""}], "}"}]}], "]"}], ",", 
       
       RowBox[{"PhaseFreedom", "->", "None"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<ObservableTarget (Iz -> -Iz)\>\"", ",", 
       RowBox[{"resInv", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resInv", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<StateTarget (|alpha> -> |beta>)\>\"", ",", 
       RowBox[{"resKet", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resKet", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<UnitaryTarget (90y, PhaseFreedom -> Global)\>\"", ",", 
       RowBox[{"resUnitGlob", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resUnitGlob", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"\"\<UnitaryTarget (90y, PhaseFreedom -> None)\>\"", ",", 
       RowBox[{"resUnitExact", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resUnitExact", "[", "\"\<Iterations\>\"", "]"}]}], "}"}]}], 
    "}"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Target Specification\>\"", ",", "\"\<FinalFidelity\>\"", 
        ",", "\"\<Iterations\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"582139bd-c899-4a46-aa69-db89e1681dc2"],

