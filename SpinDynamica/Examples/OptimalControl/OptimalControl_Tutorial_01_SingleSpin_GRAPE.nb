Cell[CellGroupData[{

Cell["5. Realistic RF Constraints and Regularization", "Section",ExpressionUUID->"b3a5cf0b-38ff-f44f-8101-c4070fc4d8a0"],

Cell["\<\
Unconstrained pulses can develop large peak amplitudes or rapid \
slice-to-slice oscillations. SpinDynamica lets you constrain and regularize \
waveforms cleanly in ControlUnits:
  - AmplitudeBound -> wMax (or ControlBounds -> {min, max}): Cartesian box \
limit -wMax <= ux, uy <= +wMax.
  - AmplitudeNormBound -> wMax: physical polar disk limit Sqrt[ux^2 + uy^2] \
<= wMax.
  - PowerPenalty / SmoothnessPenalty: smooth quadratic RF power and roughness \
penalties.
  - SlewRateBound, L1Penalty, and TVPenalty: hardware slew-rate bounds and \
nonsmooth sparsity/total-variation penalties. Because these introduce \
nonsmooth or proximal structure, SpinDynamica automatically switches from \
L-BFGS to Optimizer -> \"FISTA\" (issuing OptimalControlProblem::nonsmoothopt \
if a smooth optimizer was requested).\
\>", "Text",ExpressionUUID->"1f2bbbe3-4ae8-4347-8699-e866f36d75a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resDisk", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSmooth", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}], ",", 
     RowBox[{"PowerPenalty", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", 
     RowBox[{"SmoothnessPenalty", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resFista", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}], ",", 
     RowBox[{"SlewRateBound", "->", "3.*^6"}], ",", 
     RowBox[{"TVPenalty", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "5"}]}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Disk (Fid, MaxAmp Hz)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resDisk", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"resDisk", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"\"\<Smooth Reg (Fid, MaxAmp Hz)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resSmooth", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
      RowBox[{"Max", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"resSmooth", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"\"\<Slew + TV (Fid, Optimizer Used)\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"resFista", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
      RowBox[{"resFista", "[", "\"\<Optimizer\>\"", "]"}]}], "}"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"89179f72-de6a-4047-b859-9475e3a93743"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Disk (Fid, MaxAmp Hz)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.9999996335586745`", ",", "499.1323379327903`"}], "}"}]}], ",", 
   RowBox[{"\<\"Smooth Reg (Fid, MaxAmp Hz)\"\>", "\[Rule]", 
