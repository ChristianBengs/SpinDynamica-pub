Cell["\<\
SpinDynamica provides dedicated visualizers for optimal-control results: \
PlotOptimalControlWaveform (either \"Cartesian\" ux/uy or polar \
\"AmplitudePhase\"), PlotOptimalControlConvergence (\"Infidelity\" on a log \
scale), and PlotOptimalControlTrajectory for expectation values of spin \
observables along the pulse.\
\>", "Text",ExpressionUUID->"c5b3bf82-cfcb-d642-9049-4da8c9c41f0b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotOptimalControlWaveform", "[", 
      RowBox[{"resInv", ",", 
       RowBox[{"Method", "->", "\"\<Cartesian\>\""}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<ux\>\"", ",", "\"\<uy\>\""}], "}"}], ",", "Above"}], 
         "]"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Optimized RF (Cartesian)\>\""}]}], 
      "]"}], ",", 
     RowBox[{"PlotOptimalControlConvergence", "[", 
      RowBox[{"resInv", ",", 
       RowBox[{"Method", "->", "\"\<Infidelity\>\""}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Convergence\>\""}]}], "]"}]}], "}"}], ",", 
   RowBox[{"ImageSize", "->", "760"}], ",", 
   RowBox[{"Spacings", "->", "25"}]}], "]"}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"65e79da3-3394-144f-8211-810ec14efcbd"],

