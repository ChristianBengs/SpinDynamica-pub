Cell[CellGroupData[{

Cell["9. Summary and Quick Reference", "Section",ExpressionUUID->"96305b98-615b-2f4d-9a01-d391e303e069"],

Cell["\<\
A clean single-spin optimal-control workflow consists of four steps:
  1. Build an OptimalControlProblem with explicit units (ControlUnits -> \"Hz\
\") and an appropriate target.
  2. Run GRAPEOptimize (starting with default L-BFGS), adding \
AmplitudeNormBound, smooth penalties, or smooth bases/windows as needed.
  3. Verify the solution independently with VerifyOptimalControlSimulation \
and inspect waveforms, convergence, and spin trajectories.
  4. Export directly back into SpinDynamica (OptimalControlEventList, \
OptimalControlPulseSequence) or spectrometer shape formats \
(ExportOptimalControlPulse).\
\>", "Text",ExpressionUUID->"410b5ab3-dbcb-e543-be03-bc0a60259e0b"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"Symbol / Option\"\>", "\<\"Purpose\"\>", "\<\"Key Notes\"\>"},
    {"\<\"OptimalControlProblem[H0, ctrls, tar, t]\"\>", "\<\"Define control \
problem\"\>", "\<\"Timing {T, n}, T (with TimeSteps), or {dt1, ...}\"\>"},
    {"\<\"GRAPEOptimize[prob, opts]\"\>", "\<\"Optimize waveform via \
GRAPE\"\>", "\<\"Alias OptimalControlOptimize; returns OptimalControlResult\"\
\>"},
    {"\<\"ObservableTarget / StateTarget / UnitaryTarget\"\>", "\<\"Target \
objective constructors\"\>", "\<\"Use ObservableTarget for traceless NMR spin \
operators\"\>"},
    {"\<\"PhaseFreedom / TargetNormalization\"\>", "\<\"Phase invariance & \
normalization\"\>", "\<\"\\\"Global\\\" / None; \\\"Frobenius\\\" / \
\\\"TargetNorm\\\" / \\\"None\\\"\"\>"},
    {"\<\"FrequencyUnits / ControlUnits\"\>", "\<\"Drift and RF channel units\
\"\>", "\<\"\\\"rad/s\\\" (default), \\\"Hz\\\", \\\"kHz\\\", \
\\\"MHz\\\"\"\>"},
    {"\<\"AmplitudeBound / AmplitudeNormBound\"\>", "\<\"Cartesian box / \
polar disk RF limits\"\>", "\<\"Scalar or per-channel / channel-group specs\"\
\>"},
    {"\<\"PowerPenalty / SmoothnessPenalty\"\>", "\<\"Smooth quadratic \
regularizers\"\>", "\<\"Suppress RF energy & slice-to-slice ringing\"\>"},
    {"\<\"SlewRateBound / L1Penalty / TVPenalty\"\>", "\<\"Rate limits & \
nonsmooth regularizers\"\>", "\<\"Auto-selects Optimizer -> \
\\\"FISTA\\\"\"\>"},
    {"\<\"ControlParameterization / ControlWindow\"\>", "\<\"Smooth basis & \
edge envelope\"\>", "\<\"\\\"PiecewiseConstant\\\", {\\\"Fourier\\\", n}, {\\\
\"BSpline\\\", n}; \\\"Hann\\\"\"\>"},
    {"\<\"Optimizer / MultiStart / TimeStepSchedule\"\>", "\<\"Solver & \
globalization controls\"\>", "\<\"\\\"LBFGS\\\", \\\"ConjugateGradient\\\", \
\\\"SteepestAscent\\\", \\\"FISTA\\\"\"\>"},
    {"\<\"VerifyOptimalControlGradient / Simulation\"\>", "\<\"Accuracy & \
native SpinDynamica check\"\>", "\<\"Use non-stationary test probe & StepSize \
~ 10^-4 for Hz\"\>"},
    {"\<\"OptimalControlEventList / PulseSequence / Table\"\>", \
"\<\"SpinDynamica integration\"\>", "\<\"Feeds directly into NPropagate, \
Signal1D, Signal2D\"\>"},
    {"\<\"ExportOptimalControlPulse\"\>", "\<\"Spectrometer file formatting\"\
\>", "\<\"\\\"Bruker\\\", \\\"SIMPSON\\\", \\\"CSV\\\" with Resample, \
Channel, Title\"\>"},
    {"\<\"PlotOptimalControlWaveform / Convergence / Trajectory\"\>", \
"\<\"Visual diagnostics\"\>", "\<\"Cartesian or AmplitudePhase, Infidelity, \
expectation curves\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.85], {
        GrayLevel[1], 
        RGBColor[0.97, 0.98, 1.]}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",ExpressionUUID->"8cd066de-e692-4e48-88f6-b4eb90bc34b8"]
}, Open  ]]
}, Open  ]]
