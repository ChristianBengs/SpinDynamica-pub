Cell[CellGroupData[{

Cell["7. Optimizers, Warm Restarts, and MultiStart", "Section",ExpressionUUID->"d8153ac6-da01-c646-b690-aa57bd39b371"],

Cell["\<\
GRAPEOptimize uses \"LBFGS\" by default for smooth problems (LBFGSMemory -> \
15), and also supports \"BFGS\", \"ConjugateGradient\", \"SteepestAscent\", \
\"FISTA\", plus second-order Newton/Trust-Region solvers. You can also \
warm-start from any previous OptimalControlResult via InitialControls, refine \
grids from coarse to fine using TimeStepSchedule, or take the best of several \
initializations with MultiStart.\
\>", "Text",ExpressionUUID->"86d7fac3-eec4-1344-b76b-9ed9b9d52486"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resCG", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probInv", ",", 
     RowBox[{"Optimizer", "->", "\"\<ConjugateGradient\>\""}], ",", 
     RowBox[{"MaxIterations", "->", "60"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSA", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probInv", ",", 
     RowBox[{"Optimizer", "->", "\"\<SteepestAscent\>\""}], ",", 
     RowBox[{"MaxIterations", "->", "60"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resSched", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probInv", ",", 
     RowBox[{"TimeStepSchedule", "->", 
      RowBox[{"{", 
       RowBox[{"15", ",", "40"}], "}"}]}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resWarm", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"AmplitudeNormBound", "->", "500."}], ",", 
     RowBox[{"InitialControls", "->", "resCG"}], ",", 
     RowBox[{"RandomSeed", "->", "42"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resMS", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probInv", ",", 
     RowBox[{"MultiStart", "->", "3"}], ",", 
     RowBox[{"RandomSeed", "->", "100"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<L-BFGS (default)\>\"", ",", 
       RowBox[{"resInv", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resInv", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<ConjugateGradient\>\"", ",", 
       RowBox[{"resCG", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resCG", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<SteepestAscent (60 iters)\>\"", ",", 
       RowBox[{"resSA", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resSA", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<TimeStepSchedule {15, 40}\>\"", ",", 
       RowBox[{"resSched", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resSched", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Warm start + 500 Hz Disk\>\"", ",", 
       RowBox[{"resWarm", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resWarm", "[", "\"\<Iterations\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<MultiStart -> 3\>\"", ",", 
       RowBox[{"resMS", "[", "\"\<FinalFidelity\>\"", "]"}], ",", 
       RowBox[{"resMS", "[", "\"\<Iterations\>\"", "]"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Strategy\>\"", ",", "\"\<FinalFidelity\>\"", 
        ",", "\"\<Iterations\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"584ddd09-46e1-3f43-b867-f1d7b6a4a197"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"Strategy\"\>",
       HoldForm], 
      TagBox["\<\"FinalFidelity\"\>",
       HoldForm], 
      TagBox["\<\"Iterations\"\>",
       HoldForm]},
     {"\<\"L-BFGS (default)\"\>", "0.9999996311183534`", "4"},
     {"\<\"ConjugateGradient\"\>", "0.9999492178736435`", "4"},
     {"\<\"SteepestAscent (60 iters)\"\>", "0.9999273698162852`", "3"},
     {"\<\"TimeStepSchedule {15, 40}\"\>", "0.9999682891838579`", "4"},
     {"\<\"Warm start + 500 Hz Disk\"\>", "0.9999552050497115`", "2"},
     {"\<\"MultiStart -> 3\"\>", "0.999999998339353`", "4"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"Strategy", "FinalFidelity", "Iterations"}}]]]], "Output",
 CellLabel->"Out[14]=",ExpressionUUID->"cd24003e-30a1-bb4e-a75a-c530cfdc27fc"]
}, Open  ]]
