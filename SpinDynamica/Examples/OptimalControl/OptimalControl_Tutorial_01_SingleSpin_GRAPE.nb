Notebook[{

Cell[CellGroupData[{
Cell["\<\
SpinDynamica Optimal Control Tutorial 01: Single-Spin GRAPE Foundations\
\>", "Title",ExpressionUUID->"a8d3a6d0-d705-a74e-a602-63c893636e92"],

Cell["\<\
Constructing OptimalControlProblem tasks, running GRAPEOptimize, verifying \
gradients and propagators, applying RF constraints and smooth bases, and \
exporting waveforms.\
\>", "Subtitle",ExpressionUUID->"0bd07b43-b552-854f-b932-3e402f3702b0"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"47a77a32-e639-3344-afad-83c3b4363e8e"],

Cell["\<\
Evaluate both setup cells in order. Cell 1 locates the SpinDynamica \
repository root upward from NotebookDirectory[] using System` symbols only \
and loads SpinDynamica`; Cell 2 verifies that all OptimalControl` packages \
loaded cleanly.\
\>", "Text",ExpressionUUID->"30eaa8cd-4b2d-c34c-8dea-7c71aaf2b032"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nbRepoRoot", "=", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"StringQ", "[", "nbRepoRoot", "]"}], "&&", 
     RowBox[{"nbRepoRoot", "=!=", "\"\<\>\""}], "&&", 
     RowBox[{"!", 
      RowBox[{"FileExistsQ", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
          ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"parent", "=", 
        RowBox[{"ParentDirectory", "[", "nbRepoRoot", "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"parent", "===", "nbRepoRoot"}], ",", 
        RowBox[{
         RowBox[{"nbRepoRoot", "=", 
          RowBox[{"Directory", "[", "]"}]}], ";", 
         RowBox[{"Break", "[", "]"}]}], ",", 
        RowBox[{"nbRepoRoot", "=", "parent"}]}], "]"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"FileExistsQ", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
        ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", 
    RowBox[{"Needs", "[", 
     RowBox[{"\"\<SpinDynamica`\>\"", ",", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "nbRepoRoot", ",", "\"\<SpinDynamica\>\"", 
         ",", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}]}], "]"}], ",", 
    RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"d8495ff8-3d7e-bd42-a741-2f2eef749837"],

Cell["\<\
SetUserLevel::ini : The user level is being initialized to 2. The user level \
may be set to an integer between 1 and 3 by using SetUserLevel[level]. Low \
user levels provide strong syntax trapping at the expense of slow execution \
for some routines. High user levels relax the syntax trapping in order to \
provide better execution speeds.\
\>", "Message", "MSG",ExpressionUUID->"d77f9268-5070-d540-a14b-cbe17272626b"],

Cell["SetUserLevel::ul : The user level has been set to 2.", "Message", "MSG",ExpressionUUID->"f50c955b-2eaf-6949-9699-57c0b4ad29f4"],

Cell["\<\
SetUserLevel::modsymbs : Additional definitions have been given to the \
following symbols: {Commutator, Duration, Exp, Expand, Plus, Power, Simplify, \
SolidAngle, Times, WignerD}\
\>", "Message", "MSG",ExpressionUUID->"76382dc9-b28d-f747-8d42-b4f36536c07a"]
}, Open  ]],

