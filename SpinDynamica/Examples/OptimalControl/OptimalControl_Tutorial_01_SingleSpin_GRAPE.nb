Cell[CellGroupData[{

Cell["6. Smooth Waveform Parameterizations and Envelopes", "Section",ExpressionUUID->"4e992041-60e9-f64d-8afa-317c87354bb5"],

Cell["\<\
Instead of optimizing every slice independently (\"PiecewiseConstant\"), \
ControlParameterization projects controls onto a low-dimensional smooth basis \
\[AHat]\.80\.94 such as {\"Fourier\", n}, {\"BSpline\", n}, or \
{\"Chebyshev\", deg} \[AHat]\.80\.94 and ControlWindow applies an envelope \
(such as \"Hann\", \"Hamming\", or \"Blackman\") so amplitudes start and end \
cleanly at zero.\
\>", "Text",ExpressionUUID->"4bd31d24-4a5c-9548-a82e-e04d0bca49fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"resFourier", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"ControlParameterization", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Fourier\>\"", ",", "8"}], "}"}]}], ",", 
     RowBox[{"ControlWindow", "->", "\"\<Hann\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resBSpline", "=", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", "40"}], "}"}], ",", 
     RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}], ",", 
     RowBox[{"ControlParameterization", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<BSpline\>\"", ",", "12"}], "}"}]}], ",", 
     RowBox[{"ControlWindow", "->", "\"\<Hann\>\""}], ",", 
     RowBox[{"RandomSeed", "->", "42"}], ",", 
     RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Fourier (8 modes + Hann) Fid\>\"", "->", 
    RowBox[{"resFourier", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
   RowBox[{"\"\<BSpline (12 knots + Hann) Fid\>\"", "->", 
    RowBox[{"resBSpline", "[", "\"\<FinalFidelity\>\"", "]"}]}]}], 
  "}"}]}], "Input",
 CellLabel->"In[12]:=",ExpressionUUID->"eda2b88f-05d8-9e4d-94f0-48f56a195ec6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Fourier (8 modes + Hann) Fid\"\>", "\[Rule]", 
    "0.9999999924195857`"}], ",", 
   RowBox[{"\<\"BSpline (12 knots + Hann) Fid\"\>", "\[Rule]", 
    "0.9999961434366254`"}]}], "}"}]], "Output",
 CellLabel->"Out[12]=",ExpressionUUID->"0c9b53da-90ae-724c-a357-c2e1578a9059"]
}, Open  ]],

