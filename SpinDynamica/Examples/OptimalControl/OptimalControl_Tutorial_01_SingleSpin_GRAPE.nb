Cell[CellGroupData[{

Cell["1. Defining an OptimalControlProblem", "Section",ExpressionUUID->"d87a1cf1-acfa-2e4a-a8d4-3b31a6173c1f"],

Cell["\<\
An optimal-control task in SpinDynamica is defined by four ingredients:
  1. A drift Hamiltonian H0 (static or time-dependent),
  2. A list of control Hamiltonians {H1, H2, ...},
  3. A target specification (state, observable, coherence, or unitary gate),
  4. A timing specification ({totalDuration, nSlices}, scalar totalDuration \
with TimeSteps -> n, or an explicit list of slice durations).

Here we define a single liquid-state spin-1/2 with a 150 Hz chemical-shift \
offset and two orthogonal RF control channels {Ix, Iy}. FrequencyUnits \
defaults to \"rad/s\", while ControlUnits -> \"Hz\" lets us enter and read RF \
amplitudes directly in Hz.\
\>", "Text",ExpressionUUID->"f7f47c01-7dfb-8d45-b84c-cb1c471fd016"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"1", "/", "2"}]}], "}"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{"2.", "*", "Pi", "*", "150.", "*", 
    RowBox[{"opI", "[", 
     RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ctrls", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<x\>\""}], "]"}], ",", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<y\>\""}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"targetInv", "=", 
   RowBox[{"ObservableTarget", "[", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "->", 
     RowBox[{"-", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"probInv", "=", 
  RowBox[{"OptimalControlProblem", "[", 
   RowBox[{"H0", ",", "ctrls", ",", "targetInv", ",", 
    RowBox[{"{", 
     RowBox[{"0.002", ",", "40"}], "}"}], ",", 
    RowBox[{"FrequencyUnits", "->", "\"\<rad/s\>\""}], ",", 
    RowBox[{"ControlUnits", "->", "\"\<Hz\>\""}]}], "]"}]}]}], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"5bcaea0f-4d3a-6d49-bee0-4b7141859468"],

Cell["\<\
                                                          1
SetSpinSystem::set : the spin system has been set to {{1, -}}
                                                          2\
\>", "Message", "MSG",ExpressionUUID->"ce018d3a-b002-ee46-82a9-ecd6d6a21c9b"],

Cell["\<\
                                                                 1
SetBasis::set : the state basis has been set to ZeemanBasis[{{1, -}}, \
BasisLabels -> Automatic].
                                                                 2\
\>", "Message", "MSG",ExpressionUUID->"2038fcef-a097-1348-b931-9f89ba30a706"],

Cell[BoxData[
 RowBox[{"OptimalControlProblem", "[", 
  RowBox[{
   RowBox[{"942.4777960769379`", " ", 
    TagBox[
     SubscriptBox["I", 
      RowBox[{"1", "z"}]],
     DisplayForm]}], ",", 
   RowBox[{"{", 
    RowBox[{
     TagBox[
      SubscriptBox["I", 
       RowBox[{"1", "x"}]],
      DisplayForm], ",", 
     TagBox[
      SubscriptBox["I", 
       RowBox[{"1", "y"}]],
      DisplayForm]}], "}"}], ",", 
   RowBox[{"ObservableTarget", "[", 
    RowBox[{
     TagBox[
      SubscriptBox["I", 
       RowBox[{"1", "z"}]],
      DisplayForm], "\[Rule]", 
     RowBox[{"-", 
      TagBox[
       SubscriptBox["I", 
        RowBox[{"1", "z"}]],
       DisplayForm]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"0.002`", ",", "40"}], "}"}], ",", 
   RowBox[{"FrequencyUnits", "\[Rule]", "\<\"rad/s\"\>"}], ",", 
   RowBox[{"ControlUnits", "\[Rule]", "\<\"Hz\"\>"}]}], "]"}]], "Output",
 CellLabel->"Out[3]=",ExpressionUUID->"35dec09f-eb4e-6148-a8c7-365efc255403"]
}, Open  ]],

Cell["\<\
Throughout this notebook we keep this same spin-1/2 system and 2 ms timing \
grid so each section isolates only the new options being introduced.\
\>", "Text",ExpressionUUID->"aef5deac-a580-014b-8dcb-d83174f8e37f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Your First GRAPEOptimize Run", "Section",ExpressionUUID->"993b4343-ee91-6743-9fb9-60515b6e0d5c"],

Cell["\<\
Pass the OptimalControlProblem (or its positional arguments directly) to \
GRAPEOptimize (alias OptimalControlOptimize). Setting RandomSeed makes the \
initial random guess reproducible, and TargetFidelity -> 0.9999 stops early \
once fidelity exceeds 99.99%.\
\>", "Text",ExpressionUUID->"375db502-a3bf-d54c-9a9f-b32063829e98"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"resInv", "=", 
  RowBox[{"GRAPEOptimize", "[", 
   RowBox[{"probInv", ",", 
    RowBox[{"RandomSeed", "->", "42"}], ",", 
    RowBox[{"TargetFidelity", "->", "0.9999"}]}], "]"}]}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"478597dd-8c61-d042-b1eb-bc324729f27a"],

