     RowBox[{"resInv", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Status\>\"", "->", 
     RowBox[{"resInv", "[", "\"\<Status\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Optimizer\>\"", "->", 
     RowBox[{"resInv", "[", "\"\<Optimizer\>\"", "]"}]}], ",", 
    RowBox[{"\"\<Iterations\>\"", "->", 
     RowBox[{"resInv", "[", "\"\<Iterations\>\"", "]"}]}], ",", 
