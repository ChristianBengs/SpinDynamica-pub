     RowBox[{"0.38419014500263027`", ",", "241.10391668095124`"}], "}"}]}], ",", 
   RowBox[{"\<\"Slew + TV (Fid, Optimizer Used)\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.9998812028207757`", ",", "\<\"FISTA\"\>"}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[10]=",ExpressionUUID->"33ff2f8c-a81b-bc41-a8a1-554515e7066d"]
}, Open  ]],

