Cell[CellGroupData[{

Cell["8. Exporting and Using Optimized Pulses", "Section",ExpressionUUID->"fc13bada-1c4f-6b4a-9fb1-617c773307ec"],

Cell["\<\
Once optimized, an OptimalControlResult converts directly back into \
SpinDynamica simulation primitives \[AHat]\.80\.94 OptimalControlEventList \
(for NPropagate / NPropagationOperator / Signal1D / Signal2D), \
OptimalControlGenerator, OptimalControlPulseSequence, OptimalControlWaveform, \
and OptimalControlPulseTable \[AHat]\.80\.94 as well as spectrometer formats \
(\"Bruker\", \"SIMPSON\", \"CSV\") via ExportOptimalControlPulse.\
\>", "Text",ExpressionUUID->"eb3e4d4d-1e1f-0a4d-8d20-10bb22869d62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evList", "=", 
   RowBox[{"OptimalControlEventList", "[", "resDisk", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pSeq", "=", 
   RowBox[{"OptimalControlPulseSequence", "[", "resDisk", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rhoFinal", "=", 
   RowBox[{
    RowBox[{"NPropagate", "[", "evList", "]"}], "[", 
    RowBox[{"opI", "[", 
     RowBox[{"1", ",", "\"\<z\>\""}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zb", "=", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mIz", "=", 
   RowBox[{"MatrixRepresentation", "[", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ",", "zb"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mRhoFinal", "=", 
   RowBox[{"MatrixRepresentation", "[", 
    RowBox[{"rhoFinal", ",", "zb"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tbl", "=", 
   RowBox[{"OptimalControlPulseTable", "[", 
    RowBox[{"resDisk", ",", 
     RowBox[{"PhaseUnits", "->", "\"\<Degrees\>\""}], ",", 
     RowBox[{"AmplitudeScaling", "->", "\"\<Percent\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<PulseSequence Head\>\"", "->", 
    RowBox[{"Head", "[", "pSeq", "]"}]}], ",", 
   RowBox[{"\"\<NPropagate Final <Iz> (expect -1)\>\"", "->", 
    RowBox[{"Re", "[", 
     RowBox[{
      RowBox[{"Tr", "[", 
       RowBox[{"mIz", ".", "mRhoFinal"}], "]"}], "/", 
      RowBox[{"Tr", "[", 
       RowBox[{"mIz", ".", "mIz"}], "]"}]}], "]"}]}], ",", 
   RowBox[{"\"\<PulseTable Slices & Keys\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tbl", "[", "\"\<NumSlices\>\"", "]"}], ",", 
      RowBox[{"Keys", "[", "tbl", "]"}]}], "}"}]}]}], "}"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"332f99b8-1089-4143-8800-73a2cba6bd2a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"PulseSequence Head\"\>", "\[Rule]", "PulseSequence"}], ",", 
   RowBox[{"\<\"NPropagate Final <Iz> (expect -1)\"\>", "\[Rule]", 
    RowBox[{"-", "0.9999996335586717`"}]}], ",", 
   RowBox[{"\<\"PulseTable Slices & Keys\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"40", ",", 
      RowBox[{"{", 
       RowBox[{"\<\"NumSlices\"\>", ",", "\<\"TotalDuration\"\>", 
        ",", "\<\"TimeSteps\"\>", ",", "\<\"TimeEdges\"\>", 
        ",", "\<\"TimeMidpoints\"\>", ",", "\<\"UniformTimeStepQ\"\>", 
        ",", "\<\"PhaseUnits\"\>", ",", "\<\"AmplitudeScaling\"\>", 
        ",", "\<\"Channels\"\>", ",", "\<\"Table\"\>"}], "}"}]}], "}"}]}]}], 
  "}"}]], "Output",
 CellLabel->"Out[15]=",ExpressionUUID->"26c6be25-d5dd-d146-bfea-de396b654dbb"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<Bruker JCAMP-DX Preview\>\"", "->", 
    RowBox[{"StringTake", "[", 
     RowBox[{
      RowBox[{"ExportOptimalControlPulse", "[", 
       RowBox[{"resDisk", ",", "\"\<Bruker\>\"", ",", 
        RowBox[{"Resample", "->", "40"}], ",", 
        RowBox[{"Title", "->", "\"\<SingleSpin_Inv\>\""}]}], "]"}], ",", 
      RowBox[{"UpTo", "[", "200", "]"}]}], "]"}]}], ",", 
   RowBox[{"\"\<SIMPSON Preview\>\"", "->", 
    RowBox[{"StringTake", "[", 
     RowBox[{
      RowBox[{"ExportOptimalControlPulse", "[", 
       RowBox[{"resDisk", ",", "\"\<SIMPSON\>\"", ",", 
        RowBox[{"Resample", "->", "40"}]}], "]"}], ",", 
      RowBox[{"UpTo", "[", "140", "]"}]}], "]"}]}], ",", 
   RowBox[{"\"\<CSV Preview\>\"", "->", 
    RowBox[{"StringTake", "[", 
     RowBox[{
      RowBox[{"ExportOptimalControlPulse", "[", 
       RowBox[{"resDisk", ",", "\"\<CSV\>\"", ",", 
        RowBox[{"Resample", "->", "40"}]}], "]"}], ",", 
      RowBox[{"UpTo", "[", "140", "]"}]}], "]"}]}]}], "}"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"768954dc-4994-c346-acd2-237b89bac049"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Bruker JCAMP-DX Preview\"\>", 
    "\[Rule]", "\<\"##TITLE= SingleSpin_Inv (Ch 1)\\n##JCAMP-DX= 5.00 Bruker \
JCAMP library\\n##DATA TYPE= Shape Data\\n##ORIGIN= SpinDynamica \
OptimalControl\\n##OWNER= SpinDynamica\\n##MINX= 0.000000\\n##MAXX= \
100.000000\\n##MINY= 0.0\"\>"}], ",", 
   RowBox[{"\<\"SIMPSON Preview\"\>", 
    "\[Rule]", "\<\"337.00297144089905 267.1563495663829\\n226.25049398085088 \
193.31445813087083\\n461.7546434201032 \
312.47092156488526\\n293.88208962296017 260.21942\"\>"}], ",", 
   RowBox[{"\<\"CSV Preview\"\>", 
    "\[Rule]", \
"\<\"Slice,TimeStart_s,TimeEnd_s,TimeMid_s,Duration_s,Ch1_Ux_Hz,Ch1_Uy_Hz,Ch1_\
Amp_Hz,Ch1_Amp_Pct,Ch1_Phase_Deg\\n1,0.0,0.00004999999999999997,0.000\"\>"}]}]\
, "}"}]], "Output",
 CellLabel->"Out[16]=",ExpressionUUID->"86d40b3f-73df-0846-8888-237a2147710b"]
