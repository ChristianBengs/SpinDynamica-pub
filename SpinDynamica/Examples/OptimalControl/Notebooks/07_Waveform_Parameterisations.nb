Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLab7A", "[", 
     RowBox[{
     "family_String", ",", " ", "nParam_Integer", ",", " ", "bsDeg_Integer", ",",
       " ", "nt_Integer", ",", " ", "winName_String"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dtVec", ",", " ", "winOpt", ",", " ", "spec", ",", " ", "bas", ",", 
        " ", "B", ",", " ", "colsToPlot", ",", " ", "svals", ",", " ", 
        "condNum", ",", " ", "pCols", ",", " ", "pSV"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"dtVec", " ", "=", " ", 
