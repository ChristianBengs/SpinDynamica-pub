Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"39c1d271-6574-2741-8195-a015b900cb8f"],

Cell["\<\
Piecewise-constant control allows each time slice an independent amplitude, \
which can generate high-frequency slice-to-slice oscillations exceeding probe \
resonator bandwidths. Linearly expanding u(t) = B . p across smooth \
orthogonal polynomials, Fourier harmonics, or locally supported B-splines \
(optionally multiplied by an envelope window vanishing cleanly at t = 0 and t \
= T) reduces search dimensionality and guarantees smooth hardware pulses.\
\>", "Text",ExpressionUUID->"91d4ffa7-9ac4-0441-b649-449c266b80ba"],

Cell["\<\
Construct and compare PiecewiseConstant, Fourier, FourierSine, Chebyshev, \
BSpline, and BasisMatrix representations.\
\>", "Item",ExpressionUUID->"a1ca4ab1-59ae-6942-a245-4074a54164b9"],

Cell["\<\
Inspect basis-function shapes, window tapering (Hann, Hamming, Blackman), and \
singular-value spectra of B via BuildControlBasis.\
\>", "Item",ExpressionUUID->"abbed3c7-940f-ef40-b8b2-500309ecf542"],

Cell["\<\
Understand how SpinDynamica uses thin-SVD Q-space reduction when constrained \
smooth bases encounter hard disk or slew bounds.\
\>", "Item",ExpressionUUID->"527e8629-16fe-6b40-8ad5-14880328e48a"],

Cell["\<\
Compare waveform smoothness and Fourier spectra interactively.\
\>", "Item",ExpressionUUID->"264eaf64-80ee-5540-8c78-aa12473403b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"60d7bd92-a311-b54f-81f3-41f9ef5bbcac"],

Cell["\<\
At normalised slice midpoints tau_j = t_{mid,j}/T in (0, 1), \
BuildControlBasis[spec, dtVec, window] constructs B = diag(w) B_raw in R^{Nt \
x P}, mapping reduced coefficients P_coeff in R^{P x M} linearly via u = B . \
P_coeff. Exact gradients pull back via the chain rule as grad_P = B^T . \
grad_u.\
\>", "Text",ExpressionUUID->"0ee18809-1c95-e549-9a99-83a920465dd9"],

Cell["\<\
When a windowed spline basis is combined with AmplitudeNormBound or \
SlewRateBound, tiny edge window weights cause B^T B to have condition number \
kappa ~ 10^5. SpinDynamica avoids ill-conditioning by computing thin SVD B = \
Q R (Q^T Q = I_r) and executing proximal ADMM steps directly inside isometric \
Q-space before inverting back to P_coeff.\
\>", "Text",ExpressionUUID->"436beb64-c3ec-434d-ac09-277d22409b53"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"b7853c5c-213f-ad4f-868b-3701286c8db5"],

Cell["\<\
Compare five basis parameterisations on the off-resonance single-spin pi/2_x \
gate (+60 Hz offset, 10 ms, 40 slices), plus constrained Hann-windowed cubic \
B-splines under joint circular disk and slew bounds via Q-space ADMM.\
\>", "Text",ExpressionUUID->"56d4ac23-4474-4d45-aa8d-7ee143175de2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uPi2", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"Pi", "/", "2."}], ")"}], " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], "]"}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pRef", "[", 
     RowBox[{"spec_", ",", " ", 
      RowBox[{"win_", ":", " ", "None"}], ",", " ", "extraOpts___Rule"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"GRAPEOptimize", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"60.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0.01", ",", " ", "40"}], "}"}], ",", "\n", "  ", 
      RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
      RowBox[{"ControlParameterization", " ", "->", " ", "spec"}], ",", " ", 
      RowBox[{"ControlWindow", " ", "->", " ", "win"}], ",", "\n", "  ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
      RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "19"}], ",", " ", "extraOpts"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"rPWC", " ", "=", " ", 
   RowBox[{"pRef", "[", "\"\<PiecewiseConstant\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rFour", " ", "=", " ", 
   RowBox[{"pRef", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Fourier\>\"", ",", " ", "5"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rFSin", " ", "=", " ", 
   RowBox[{"pRef", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<FourierSine\>\"", ",", " ", "8"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rCheb", " ", "=", " ", 
   RowBox[{"pRef", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Chebyshev\>\"", ",", " ", "8"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rBS", " ", "=", " ", 
    RowBox[{"pRef", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<BSpline\>\"", ",", " ", "10"}], "}"}], ",", 
      " ", "\"\<Hann\>\""}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Custom", " ", "Gaussian"}], "-", 
    RowBox[{"modulated", " ", 
     RowBox[{"Legendre", "/", "Chebyshev"}], " ", "basis", " ", "matrix", " ",
      "via", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<BasisMatrix\>\"", ",", " ", "mat"}], "}"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"customMat", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "4."}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j", " ", "-", " ", "20.5"}], ")"}], "/", "20."}], ")"}],
           "^", "2"}]}], "]"}], " ", "*", " ", 
       RowBox[{"LegendreP", "[", 
        RowBox[{"m", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", " ", "-", " ", "20.5"}], ")"}], "/", "20."}]}], 
        "]"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "40"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rCust", " ", "=", " ", 
   RowBox[{"pRef", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<BasisMatrix\>\"", ",", " ", "customMat"}], "}"}], ",", 
     " ", "\"\<Hann\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rConBS", " ", "=", " ", 
    RowBox[{"pRef", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<BSpline\>\"", ",", " ", "12"}], "}"}], ",", 
      " ", "\"\<Hann\>\"", ",", " ", 
      RowBox[{"AmplitudeNormBound", " ", "->", " ", "120."}], ",", " ", 
      RowBox[{"SlewRateBound", " ", "->", " ", "40000."}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"AssociationMap", "[", 
  RowBox[{
   RowBox[{"Function", "[", 
    RowBox[{"r", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ParamsShape\>\"", " ", "->", " ", 
