       RowBox[{"\"\<Iters\>\"", " ", "->", " ", 
        RowBox[{"r", "[", "\"\<Iterations\>\"", "]"}]}]}], "|>"}]}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<PiecewiseConstant\>\"", " ", "->", " ", "rPWC"}], ",", " ", 
     RowBox[{"\"\<Fourier(5)\>\"", " ", "->", " ", "rFour"}], ",", " ", 
     RowBox[{"\"\<FourierSine(8)\>\"", " ", "->", " ", "rFSin"}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Chebyshev(8)\>\"", " ", "->", " ", "rCheb"}], ",", " ", 
     RowBox[{"\"\<HannBSpline(10)\>\"", " ", "->", " ", "rBS"}], ",", " ", 
     RowBox[{"\"\<CustomBasis(7)\>\"", " ", "->", " ", "rCust"}], ",", " ", 
     RowBox[{"\"\<HannBSpline_QADMM\>\"", " ", "->", " ", "rConBS"}]}], 
    "|>"}]}], "]"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"beabdbb8-3087-d147-a233-28f29d4ac819"],

