      "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", "\n", "  ", 
       RowBox[{"uPi2", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "2."}], ")"}], " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b"}], 
            "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"winOpt", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"winName", " ", "===", " ", "\"\<None\>\""}], ",", " ", 
          "None", ",", " ", "winName"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"spec", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"family", ",", "\n", "    ", "\"\<Fourier\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Fourier\>\"", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"Quotient", "[", 
               RowBox[{"nParam", ",", " ", "2"}], "]"}]}], "]"}]}], "}"}], ",",
           "\n", "    ", "\"\<FourierSine\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<FourierSine\>\"", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", " ", "nParam"}], "]"}]}], "}"}], ",", "\n", 
          "    ", "\"\<Chebyshev\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<Chebyshev\>\"", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"nParam", " ", "-", " ", "1"}]}], "]"}]}], "}"}], ",", 
          "\n", "    ", "_", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<BSpline\>\"", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"2", ",", " ", "nParam"}], "]"}]}], "}"}]}], "\n", "  ", 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"extra", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", "useCon", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AmplitudeNormBound", " ", "->", " ", "120."}], ",", " ", 
            RowBox[{"SlewRateBound", " ", "->", " ", "40000."}]}], "}"}], ",",
           " ", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"GRAPEOptimize", "[", 
         RowBox[{
          RowBox[{"60.", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"0.01", ",", " ", "40"}], "}"}], ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", 
          "    ", 
          RowBox[{"ControlParameterization", " ", "->", " ", "spec"}], ",", 
          " ", 
          RowBox[{"ControlWindow", " ", "->", " ", "winOpt"}], ",", "\n", 
          "    ", 
          RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
          RowBox[{"MaxIterations", " ", "->", " ", "130"}], ",", " ", 
          RowBox[{"RandomSeed", " ", "->", " ", "19"}], ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", "extra"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"specFreq", " ", "=", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"Fourier", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"res", "[", "\"\<Controls\>\"", "]"}], "[", 
