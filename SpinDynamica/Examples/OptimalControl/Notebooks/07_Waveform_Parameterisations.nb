Notebook[{

Cell[CellGroupData[{
Cell["07. Waveform Parameterisations and Window Envelopes", "Title",ExpressionUUID->"cea8b17c-1442-2446-a92d-ab38b28797b0"],

Cell["\<\
PiecewiseConstant, Fourier, FourierSine, Chebyshev, B-Splines, custom \
BasisMatrix, Hann/Blackman envelopes, singular-value conditioning, and \
Q-space ADMM.\
\>", "Subtitle",ExpressionUUID->"c8d08138-a620-5f4f-8ac8-1edf26d63228"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"2853a170-bdd9-6a41-b580-3b741f718891"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses reduced-basis examples from Tutorial02 \
and Tutorial08 (Manual Chapter 11).\
\>", "Text",ExpressionUUID->"8b8825cb-08c9-8049-ac97-697fed174b96"],

Cell[CellGroupData[{

Cell[BoxData[{
