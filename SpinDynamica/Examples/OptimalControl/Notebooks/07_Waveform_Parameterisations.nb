Cell["\<\
Lab 7B runs parameterised GRAPE optimisation on demand (including constrained \
Hann/Blackman Q-space ADMM when Disk + Slew is checked) and displays both \
time-domain and DFT spectral bandwidth:\
\>", "Text",ExpressionUUID->"50ce308b-8881-ac43-a691-47d6254a3f56"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"family", " ", "=", " ", "\"\<BSpline\>\""}], ",", " ", 
     RowBox[{"nParam", " ", "=", " ", "12"}], ",", " ", 
     RowBox[{"winName", " ", "=", " ", "\"\<Hann\>\""}], ",", " ", 
     RowBox[{"useCon", " ", "=", " ", "True"}], ",", " ", 
     RowBox[{"data", " ", "=", " ", "lab7BDefault"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Panel", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Basis Family\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "family", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<BSpline\>\"", ",", " ", "\"\<Fourier\>\"", ",", 
                 " ", "\"\<FourierSine\>\"", ",", " ", "\"\<Chebyshev\>\""}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Param Target P\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "nParam", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", " ", "16", ",", " ", "1"}], "}"}]}], 
                 "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "nParam", "]"}]}], "}"}], "]"}]}], 
            "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Envelope Window\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "winName", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<None\>\"", ",", " ", "\"\<Hann\>\"", ",", 
                 " ", "\"\<Hamming\>\"", ",", " ", "\"\<Blackman\>\""}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Hard Limits\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Checkbox", "[", 
                 RowBox[{"Dynamic", "[", "useCon", "]"}], "]"}], ",", 
                " ", "\"\< AmplitudeNormBound 120 Hz + SlewRateBound 40 kHz/s \
(Q-space ADMM)\>\""}], "}"}], "]"}]}], "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<Run Parameterised GRAPE\>\"", ",", " ", 
         RowBox[{"data", " ", "=", " ", 
          RowBox[{"runLab7B", "[", 
           RowBox[{
           "family", ",", " ", "nParam", ",", " ", "winName", ",", " ", 
            "useCon"}], "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"renderLab7B", "[", "data", "]"}], "]"}]}], "\n", "  ", "}"}],
      "]"}], "]"}]}], "\n", "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"84d584ef-e605-4d4e-9f7c-e723b829c8bb"],

