 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab3A", "[", 
     RowBox[{
     "jHz_", ",", " ", "v1Hz_", ",", " ", "v2Hz_", ",", " ", "durMs_", ",", 
      " ", "mode_String"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "h0", ",", " ", "hc", ",", " ", "uCNOT", ",", " ", "targ", ",", " ", 
        "initOp", ",", " ", "obsList", ",", " ", "res", ",", " ", "sim"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"h0", " ", "=", " ", 
        RowBox[{
         RowBox[{"v1Hz", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
         RowBox[{"v2Hz", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
         RowBox[{"jHz", " ", 
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}]}], ";", "\n", 
       "  ", 
       RowBox[{"hc", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"uCNOT", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1.", ",", " ", "0.", ",", " ", "0."}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "0.", ",", " ", "1."}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "0.", ",", " ", "1.", ",", " ", "0."}], 
           "}"}]}], "}"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"targ", ",", " ", "initOp", ",", " ", "obsList"}], "}"}], 
        " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"mode", ",", "\n", "    ", "\"\<I1z -> I2z\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ObservableTarget", "[", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], "}"}], 
          ",", "\n", "    ", "\"\<INEPT: I1x -> 2 I1y I2z\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ObservableTarget", "[", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", "->", " ", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "]"}], ",",
             " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
              RowBox[{"2", " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], "}"}], 
          ",", "\n", "    ", "\"\<ZQ -> DQ Coherence\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"CoherenceTarget", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<-\>\""}], "]"}]}], " ", "->", 
               " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<+\>\""}], "]"}]}]}], ",", " ", 
              RowBox[{"PhaseInsensitive", " ", "->", " ", "True"}]}], "]"}], ",",
             " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], "}"}], 
          ",", "\n", "    ", "_", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"UnitaryTarget", "[", "uCNOT", "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "}"}]}], 
           "}"}]}], "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"GRAPEOptimize", "[", 
         RowBox[{"h0", ",", " ", "hc", ",", " ", "targ", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"durMs", "/", "1000."}], "]"}], ",", " ", "30"}], "}"}], 
          ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", 
          "    ", 
          RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
          RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
          RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"sim", " ", "=", " ", 
        RowBox[{"VerifyOptimalControlSimulation", "[", "res", "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "res"}], ",", " ", 
