Notebook[{
Cell["03. NMR Polarisation and Coherence Transfer", "Title",ExpressionUUID->"0e96f366-87b3-ba48-baa0-8f7ee2386ca4"],

Cell["\<\
Coupled heteronuclear I1z -> I2z transfer, INEPT antiphase creation, \
TransformationAmplitude conventions, ZQ -> DQ coherences, and open-system \
Liouville relaxation.\
\>", "Subtitle",ExpressionUUID->"ee53dc44-a9d2-ea48-bc1a-0b309e3e8b18"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"d4c0c865-0ac4-f749-87da-d697e4213f27"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Tutorials/Tutorial03_TwoSpinPolarisationTransfer.wls \
and Tutorial04_INEPTCoherenceTransfer.wls (Manual Chapters 8, 15).\
\>", "Text",ExpressionUUID->"ffef45ac-bfaf-c545-95f9-3490bba2d603"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
              " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", "\n",
           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$Path", ",", " ", "found"}], "]"}]}], "]"}], ";"}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   " ", 
   RowBox[{"\"\<OptimalControlContexts\>\"", " ", "->", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"$Packages", ",", " ", 
      RowBox[{
       RowBox[{"StringStartsQ", "[", 
        RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "|>"}]}], "Input",ExpressionUUID->"54dab118-5b51-\
e349-9f0f-3818d834bb34"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"b519b1e0-e58f-2245-a208-8592f087fb3a"],

Cell["\<\
Multi-spin NMR spectroscopy frequently aims to transfer spin order between \
coupled nuclei (such as heteronuclear polarisation transfer I1z -> I2z or \
antiphase INEPT conversion I1x -> 2 I1y I2z) or convert between specific \
quantum coherence orders without demanding a full four-qubit unitary matrix. \
Selecting ObservableTarget or CoherenceTarget lowers optimisation difficulty, \
shortens pulse durations, and accommodates open-system relaxation in \
Liouville space.\
\>", "Text",ExpressionUUID->"85fdbb0d-0597-9346-ae93-1e98b384de8f"],

Cell["\<\
Construct coupled heteronuclear two-spin transfer problems using \
ObservableTarget and CoherenceTarget.\
\>", "Item",ExpressionUUID->"ef69dd30-1932-bb4b-9550-4c4ec0f9ac8a"],

Cell["\<\
Compare Frobenius normalisation against TargetNormalization -> \"TargetNorm\" \
and verify exact agreement with SpinDynamica TransformationAmplitude.\
\>", "Item",ExpressionUUID->"c50cd6ea-f647-d34a-8015-9c3e1eaf686e"],

Cell["\<\
Optimise non-Hermitian zero-quantum to double-quantum transfers \
(phase-sensitive and PhaseInsensitive).\
\>", "Item",ExpressionUUID->"629f7903-a71c-714f-bb8d-dfa0a95afde3"],

Cell["\<\
Formulate dissipative open-system GRAPE in Liouville space with \
PhenomenologicalRelaxationSuperoperator.\
\>", "Item",ExpressionUUID->"1031c715-962a-714f-bb27-d2c346ff987f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"7312f21a-d10e-ca47-84ac-e1825b857044"],

Cell["\<\
In a weakly coupled heteronuclear two-spin-1/2 system with shifts (v1, v2) Hz \
and scalar coupling J Hz, H0 = 2*Pi*(v1*I1z + v2*I2z + J*I1z.I2z) and four \
independent RF controls {I1x, I1y, I2x, I2y} steer the initial density \
operator M1 toward O = M2 under rho(T) = U_T M1 U_T^dag. ObservableTarget \
maximises either Phi_lin = Re Tr[O^dag rho(T)] / s or Phi_mag = |Tr[O^dag \
rho(T)] / s|^2.\
\>", "Text",ExpressionUUID->"2d56066f-57fc-c447-a107-1f3f5c7de9cb"],

Cell["\<\
Two normalisations are critical: TargetNormalization -> \"Frobenius\" \
(default) sets s = ||M1||_F ||O||_F so |Phi| <= 1 across operators of unequal \
norm; TargetNormalization -> \"TargetNorm\" sets s = ||O||_F^2 = Tr[O^dag O], \
reproducing Re[TransformationAmplitude[M1 -> O, events]] exactly. In \
Liouville space, operator vectors obey d|rho>/dt = L(t)|rho> with slice \
superpropagators P_j = Exp[+dt_j L_j].\
\>", "Text",ExpressionUUID->"c6527251-dcba-c345-acd9-1e4855e4b7b6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"1a5776f7-5c67-2e4f-81d5-993cdabbd13d"],

Cell["\<\
Execute four validated regimes from Tutorials 03 and 04: (1) heteronuclear \
I1z -> I2z transfer and TransformationAmplitude check, (2) antiphase INEPT \
I1x -> 2 I1y I2z, (3) non-Hermitian ZQ -> DQ coherence transfer (I1+ I2- -> \
I1+ I2+), and (4) single-spin dissipative transfer Iz -> Ix in Liouville \
space (T1 = 1.0 s, T2 = 1.5 s via PhenomenologicalRelaxationSuperoperator[1, \
1.5]).\
\>", "Text",ExpressionUUID->"62fd491e-3605-e942-9cff-256a1b349341"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SetSpinSystem", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1.", " ", "Two"}], "-", 
       RowBox[{"spin", " ", "heteronuclear", " ", "I1z"}]}], " ", "->", " ", 
      "I2z"}], " ", "&"}], " ", "TransformationAmplitude", " ", 
    RowBox[{"(", 
     RowBox[{"Tutorial", " ", "03"}], ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"H0Two", " ", "=", " ", 
   RowBox[{
    RowBox[{"30.", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
    RowBox[{"45.", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
    RowBox[{"140.", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Hc2", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resIzSz", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"H0Two", ",", " ", "Hc2", ",", " ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.015", ",", " ", "36"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"taVal", " ", "=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{"N", "[", 
     RowBox[{"TransformationAmplitude", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
       RowBox[{"OptimalControlEventList", "[", "resIzSz", "]"}]}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evTN", " ", "=", " ", 
    RowBox[{"EvaluateOptimalControl", "[", 
     RowBox[{
      RowBox[{"OptimalControlProblem", "[", 
       RowBox[{"H0Two", ",", " ", "Hc2", ",", "\n", "  ", 
        RowBox[{"ObservableTarget", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{
          "TargetNormalization", " ", "->", " ", "\"\<TargetNorm\>\""}]}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.015", ",", " ", "36"}], "}"}], ",", "\n", "  ", 
        RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
        RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",", 
      " ", 
      RowBox[{"resIzSz", "[", "\"\<Controls\>\"", "]"}]}], "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2.", " ", "INEPT"}], " ", "&"}], " ", "ZQ"}], "->", 
    RowBox[{"DQ", " ", "Coherence", " ", "Transfer", " ", 
     RowBox[{"(", 
      RowBox[{"Tutorial", " ", "04"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"resInept", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"140.", " ", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", "Hc2", ",",
      "\n", "  ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], "]"}], ",", " ", 
     
     RowBox[{"{", 
      RowBox[{"0.012", ",", " ", "30"}], "}"}], ",", "\n", "  ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "10"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resZQDQ", " ", "=", " ", 
    RowBox[{"GRAPEOptimize", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"25.", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
       RowBox[{"35.", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
       RowBox[{"140.", " ", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", ".", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", " ", "Hc2", 
      ",", "\n", "  ", 
      RowBox[{"CoherenceTarget", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<-\>\""}], "]"}]}], " ", "->", " ", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<+\>\""}], "]"}], " ", ".", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<+\>\""}], "]"}]}]}], ",", " ", 
        RowBox[{"PhaseInsensitive", " ", "->", " ", "True"}]}], "]"}], ",", 
      "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"0.015", ",", " ", "36"}], "}"}], ",", " ", 
      RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "15"}]}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"3.", " ", "Open"}], "-", 
    RowBox[{"system", " ", "Liouville", " ", "transfer", " ", "with", " ", 
     RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
      RowBox[{"T1", ",", " ", "T2"}], "]"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gRel", " ", "=", " ", 
   RowBox[{"PhenomenologicalRelaxationSuperoperator", "[", 
    RowBox[{"1", ",", " ", "1.5"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resLiouv", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"gRel", " ", "+", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"CommutationSuperoperator", "[", 
         RowBox[{"5.", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}]}], ")"}]}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "20"}], "}"}], ",", "\n", "  ", 
     RowBox[{"MaxIterations", " ", "->", " ", "60"}], ",", " ", 
     RowBox[{"InitialControls", " ", "->", " ", "5."}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simLiouv", " ", "=", " ", 
    RowBox[{"VerifyOptimalControlSimulation", "[", "resLiouv", "]"}]}], ";"}],
   "\n"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<I1z_to_I2z_F\>\"", " ", "->", " ", 
    RowBox[{"resIzSz", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<TargetNorm_vs_TA_Diff\>\"", " ", "->", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"evTN", "[", "\"\<Fidelity\>\"", "]"}], " ", "-", " ", 
      "taVal"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<INEPT_Antiphase_F\>\"", " ", "->", " ", 
    RowBox[{"resInept", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<ZQ_to_DQ_F\>\"", " ", "->", " ", 
    RowBox[{"resZQDQ", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Liouville_Relax_F\>\"", " ", "->", " ", 
    RowBox[{"resLiouv", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Liouville_SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simLiouv", "[", "\"\<FidelityMatchQ\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",ExpressionUUID->"2a2e0ec1-d87d-da49-80e4-3752ee1e52ab"],

Cell["\<\
Plot the heteronuclear I1z -> I2z polarisation pathway alongside the \
dissipative Liouville trajectory:\
\>", "Text",ExpressionUUID->"eabccd54-950f-ea42-a0ad-f96d7276244c"],

