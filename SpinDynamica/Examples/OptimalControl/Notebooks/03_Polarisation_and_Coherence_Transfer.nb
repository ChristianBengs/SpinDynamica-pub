Tutorial04_INEPTCoherenceTransfer.wls",
  FontFamily->"Courier",
  FontSize->11],
 ") and ",
 StyleBox["Manual Ch. 8, 15",
  FontFamily->"Courier",
  FontSize->11],
 "."
}], "Item",ExpressionUUID->"f2aff33f-e914-6d4e-a13a-21fce38cf658"]
}, Open  ]]
