Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"7df29fb7-1e31-f544-9870-6b86882a0a00"],

Cell["\<\
Lab 1A defines clean helper functions runLab1A and renderLab1A driving an \
interactive DynamicModule. Adjust the resonance offset, pulse duration, slice \
count, circular RF limit (AmplitudeNormBound), or target mode, then click \
'Run GRAPE Optimisation' (executed asynchronously via Method -> \"Queued\"). \
Switching the View selector updates plots instantaneously without rerunning \
GRAPE.\
\>", "Text",ExpressionUUID->"605e20a0-3b8a-d441-b140-24e089b59888"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab1A", "[", 
     RowBox[{
     "offsetHz_", ",", " ", "durMs_", ",", " ", "nt_", ",", " ", "rfBoundHz_",
       ",", " ", "mode_String", ",", " ", 
      RowBox[{"seed_", ":", " ", "11"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b", ",", " ", "ks", ",", " ", "u90", ",", " ", "u180", ",", " ", 
        "targ", ",", " ", "initOp", ",", " ", "obsList", ",", " ", "res", ",",
         " ", "sim"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", "\n", "  ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
       RowBox[{"ks", " ", "=", " ", 
        RowBox[{"BasisKets", "[", "b", "]"}]}], ";", "\n", "  ", 
       RowBox[{"u90", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "2."}], ")"}], " ", 
