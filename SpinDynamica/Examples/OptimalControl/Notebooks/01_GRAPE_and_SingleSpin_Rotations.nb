Cell["\<\
Visualise the optimised inversion waveform (Cartesian and amplitude/phase), \
log-infidelity convergence curve, and Bloch-vector trajectory:\
\>", "Text",ExpressionUUID->"97e126da-7d33-bf45-b7dc-1526ce1621ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"PlotOptimalControlWaveform", "[", 
       RowBox[{"resInv", ",", " ", 
        RowBox[{"PlotLabel", " ", "->", " ", "\"\<Cartesian RF (Hz)\>\""}], ",",
         " ", 
        RowBox[{"ImageSize", " ", "->", " ", "320"}]}], "]"}], ",", "\n", 
      "  ", 
      RowBox[{"PlotOptimalControlWaveform", "[", 
       RowBox[{"resInv", ",", " ", 
