Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"55f8f215-8377-d34b-8a4d-c3484a120f06"],

Cell["\<\
Analytical composite pulses frequently struggle when resonance offsets \
approach or exceed the available RF nutation strength, or when arbitrary \
unitary propagators must be synthesised inside tight duration windows. \
Gradient Ascent Pulse Engineering (GRAPE) numerically shapes x- and y-phase \
RF waveforms directly against the quantum propagator so all spin interactions \
are harnessed constructively rather than treated as unwanted perturbations.\
\>", "Text",ExpressionUUID->"ffca9cfb-4f00-e84d-8862-4ab484c7c2f8"],

Cell["\<\
Define a single spin-1/2 OptimalControlProblem in Hz units cleanly using \
ZeemanBasis[] and opI.\
\>", "Item",ExpressionUUID->"ec72b703-18a5-4f46-8a5f-1cee1975aec1"],

Cell["\<\
Distinguish point-to-point state-transfer targets (StateTarget / \
ObservableTarget) from universal gate synthesis (UnitaryTarget).\
\>", "Item",ExpressionUUID->"5287a4c4-218d-4e49-886c-a4bada51157c"],

Cell["\<\
Verify optimised propagators independently against SpinDynamica's \
NPropagationOperator.\
\>", "Item",ExpressionUUID->"5a3f6761-04a0-314c-ae15-a368f8b96c7f"],

Cell["\<\
Explore interactively how offset, pulse duration, slice resolution, and RF \
ceiling affect fidelity and Bloch trajectories.\
\>", "Item",ExpressionUUID->"362dfc64-8a76-5747-b2bb-0ec1090e1ff7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"a4a38c15-8b59-394b-a797-0fbbc95e236e"],

Cell["\<\
In the rotating frame with chemical-shift offset delta (Hz) and quadrature RF \
amplitudes (ux(t), uy(t)) (Hz), setting FrequencyUnits -> \"Hz\" and \
ControlUnits -> \"Hz\" instructs SpinDynamica to multiply operators by 2*Pi \
internally so the control Hamiltonian is H(t) = 2*Pi * (delta * Iz + ux(t) * \
Ix + uy(t) * Iy). Under piecewise-constant discretisation over slice \
durations dt_j, each slice propagator is U_j = Exp[-I H_j dt_j] and total \
propagator is U_T = U_Nt ... U_2 U_1.\
\>", "Text",ExpressionUUID->"b1c87be9-bee0-f240-8af3-314b3f42f6b0"],

Cell["\<\
Two distinct physical objectives apply to single-spin rotations: \
StateTarget[|alpha> -> |beta>] (or ObservableTarget[Iz -> -Iy]) maximises a \
single transfer pathway |<psi_T | U_T | psi_0>|^2, leaving orthogonal \
coherence phases unconstrained. By contrast, UnitaryTarget[U_tar] maximises \
the phase-invariant Hilbert-Schmidt gate fidelity F_U = |Tr[U_tar^dag U_T] / \
D|^2 in [0, 1], locking all Cartesian spin components simultaneously.\
\>", "Text",ExpressionUUID->"d79a0352-446d-8645-ae60-0a0d67e5a3d8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"d9dcf6a3-da8d-ef4e-9060-0de92734ad3a"],

Cell["\<\
Below we run the validated Tutorial01 inversion (|alpha> -> |beta> at +50 Hz \
offset) and Tutorial02 universal (pi/2)_x gate at +80 Hz offset, then \
quantitatively demonstrate why a point-to-point Iz -> -Iy pulse falls short \
of a universal rotation gate despite achieving F = 0.999994 on its single \
chosen state.\
\>", "Text",ExpressionUUID->"0fd284aa-d4e7-c24c-97a1-c05f38ca2105"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ks1", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uPi2", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"Pi", " ", "/", " ", "2."}], ")"}], " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], "]"}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"uPiX", " ", "=", " ", 
    RowBox[{"MatrixExp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "Pi", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"MatrixRepresentation", "[", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], 
        "]"}], "]"}]}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"1.", " ", "Off"}], "-", 
    RowBox[{"resonance", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"+", "50"}], " ", "Hz"}], ")"}], " ", "state", " ", 
     "inversion", " ", 
     RowBox[{"(", 
      RowBox[{"Tutorial", " ", "01"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"probInv", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{
     RowBox[{"50.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "30"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"gradChk", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlGradient", "[", 
    RowBox[{"probInv", ",", " ", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"25.", ",", " ", 
         RowBox[{"-", "15."}]}], "}"}], ",", " ", "30"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"resInv", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"probInv", ",", " ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "120."}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "101"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simInv", " ", "=", " ", 
    RowBox[{"VerifyOptimalControlSimulation", "[", "resInv", "]"}]}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"2.", " ", "Universal", " ", 
      RowBox[{"(", 
       RowBox[{"pi", "/", "2"}], ")"}], "_x", " ", "gate", " ", "vs", " ", 
      "point"}], "-", "to", "-", 
     RowBox[{"point", " ", "Iz"}]}], " ", "->", " ", 
    RowBox[{
     RowBox[{"-", "Iy"}], " ", 
     RowBox[{"(", 
      RowBox[{"Tutorial", " ", "02"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"resU90", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"80.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "30"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resP2P", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{"80.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"-", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}]}], "]"}], ",", "\n", 
     "  ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "30"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gateFidOfP2P", " ", "=", " ", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"ConjugateTranspose", "[", "uPi2", "]"}], " ", ".", " ", 
         RowBox[{"resP2P", "[", "\"\<FinalPropagator\>\"", "]"}]}], "]"}], 
       " ", "/", " ", "2."}], "]"}], "^", "2"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<GradCheckPassed\>\"", " ", "->", " ", 
    RowBox[{"gradChk", "[", "\"\<PassedQ\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Inversion_F\>\"", " ", "->", " ", 
    RowBox[{"resInv", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Inversion_SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simInv", "[", "\"\<FidelityMatchQ\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Universal90_F\>\"", " ", "->", " ", 
    RowBox[{"resU90", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<PointToPoint_TransferF\>\"", " ", "->", " ", 
    RowBox[{"resP2P", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<PointToPoint_UnitaryPi2F\>\"", " ", "->", " ", 
    "gateFidOfP2P"}]}], "\n", "|>"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"3c29de7f-51e8-eb48-b2aa-d804e97bd334"],

