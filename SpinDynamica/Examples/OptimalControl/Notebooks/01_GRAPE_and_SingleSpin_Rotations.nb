Cell["\<\
Lab 1B uses an instant Manipulate to inspect forward-only spin evolution \
(PropagateControls) on the worked inversion pulse without re-optimising: \
scrub the slice index k from 0 to 30 or shift the test frequency offset away \
from +50 Hz to observe how sensitively a non-robust single-offset pulse \
degrades off-resonance.\
\>", "Text",ExpressionUUID->"c630d98f-3094-8745-a161-7e23c9912208"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"renderLab1B", "[", 
    RowBox[{"res_OptimalControlResult", ",", " ", "kSlice_Integer", ",", " ", 
     RowBox[{"testOffsetHz_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "b", ",", " ", "iX", ",", " ", "iY", ",", " ", "iZ", ",", " ", "nt", ",",
        " ", "dt", ",", " ", "uCtrl", ",", " ", "uCum", ",", " ", "states", ",",
        " ", "traj", ",", " ", "curVec", ",", " ", "mX", ",", " ", "mY", ",", 
       " ", "mZ"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", "\n", "  ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"ZeemanBasis", "[", "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"iX", ",", " ", "iY", ",", " ", "iZ"}], "}"}], " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"2.", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "ax"}], "]"}], ",", " ", "b"}], "]"}], 
           "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ax", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", 
             " ", "\"\<z\>\""}], "}"}]}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"uCtrl", " ", "=", " ", 
       RowBox[{"res", "[", "\"\<Controls\>\"", "]"}]}], ";", " ", 
      RowBox[{"dt", " ", "=", " ", 
       RowBox[{"res", "[", "\"\<TimeSteps\>\"", "]"}]}], ";", " ", 
      RowBox[{"nt", " ", "=", " ", 
       RowBox[{"Length", "[", "dt", "]"}]}], ";", "\n", "  ", 
      RowBox[{"uCum", " ", "=", " ", 
       RowBox[{"FoldList", "[", 
        RowBox[{"Dot", ",", " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
         RowBox[{"Table", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"dt", "[", 
              RowBox[{"[", "j", "]"}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"2.", " ", "Pi", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"testOffsetHz", " ", "0.5", " ", "iZ"}], " ", "+", 
                 " ", 
                 RowBox[{
                  RowBox[{"uCtrl", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", " ", "1"}], "]"}], "]"}], " ", "0.5", " ",
                   "iX"}], " ", "+", " ", 
                 RowBox[{
                  RowBox[{"uCtrl", "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", " ", "2"}], "]"}], "]"}], " ", "0.5", " ",
                   "iY"}]}], ")"}]}], ")"}]}], "]"}], ",", "\n", "    ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "nt"}], "}"}]}], "]"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"states", " ", "=", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"#", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"0.5", " ", "iZ"}], ")"}], " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], " ", "&"}], ",", 
         " ", "uCum"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"traj", " ", "=", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{"0.5", " ", "iX"}], ")"}]}], "]"}], "]"}], "*", 
             "2."}], ",", " ", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{"0.5", " ", "iY"}], ")"}]}], "]"}], "]"}], "*", 
             "2."}], ",", " ", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"#", " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{"0.5", " ", "iZ"}], ")"}]}], "]"}], "]"}], "*", 
             "2."}]}], "}"}], " ", "&"}], ",", " ", "states"}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"curVec", " ", "=", " ", 
       RowBox[{"traj", "[", 
        RowBox[{"[", 
         RowBox[{"kSlice", " ", "+", " ", "1"}], "]"}], "]"}]}], ";", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mX", ",", " ", "mY", ",", " ", "mZ"}], "}"}], " ", "=", " ", 
       "curVec"}], ";", "\n", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Slice k = \>\"", ",", " ", "kSlice", ",", 
            " ", "\"\</\>\"", ",", " ", "nt", ",", 
            " ", "\"\<   Test offset = \>\"", ",", " ", "testOffsetHz", ",", 
            " ", "\"\< Hz   Bloch = \>\"", ",", " ", 
            RowBox[{"NumberForm", " ", "/@", " ", 
             RowBox[{"{", 
              RowBox[{"mX", ",", " ", "mY", ",", " ", "mZ"}], "}"}]}]}], 
           "}"}], "]"}], ",", "\n", "    ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Prepend", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Accumulate", "[", "dt", "]"}], "*", "1000."}], ",",
                   " ", "0."}], "]"}], ",", " ", "#"}], "}"}], "]"}], " ", 
             "&"}], " ", "/@", " ", 
            RowBox[{"Transpose", "[", "traj", "]"}]}], ",", "\n", "      ", 
           RowBox[{"PlotLegends", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<2<Ix>\>\"", ",", " ", "\"\<2<Iy>\>\"", ",", 
              " ", "\"\<2<Iz>\>\""}], "}"}]}], ",", " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Time (ms)\>\"", ",", 
              " ", "\"\<Bloch Component\>\""}], "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", "\n", 
           "      ", 
           RowBox[{"Epilog", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"Dashed", ",", " ", "Gray", ",", " ", 
              RowBox[{"Line", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Accumulate", "[", 
                    RowBox[{"Prepend", "[", 
                    RowBox[{"dt", ",", " ", "0."}], "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"kSlice", " ", "+", " ", "1"}], "]"}], "]"}], "*",
                     "1000."}], ",", " ", 
                   RowBox[{"-", "1.05"}]}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Accumulate", "[", 
                    RowBox[{"Prepend", "[", 
                    RowBox[{"dt", ",", " ", "0."}], "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"kSlice", " ", "+", " ", "1"}], "]"}], "]"}], "*",
                     "1000."}], ",", " ", "1.05"}], "}"}]}], "}"}], "]"}]}], 
             "}"}]}], ",", "\n", "      ", 
           RowBox[{"ImageSize", " ", "->", " ", "460"}]}], "]"}]}], "\n", 
        "  ", "}"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"renderLab1B", "[", 
    RowBox[{"resInv", ",", " ", "kSlice", ",", " ", "testOffsetHz"}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"kSlice", ",", " ", "30", ",", " ", "\"\<Slice Index k\>\""}], 
      "}"}], ",", " ", "0", ",", " ", "30", ",", " ", "1", ",", " ", 
     RowBox[{"Appearance", " ", "->", " ", "\"\<Labeled\>\""}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "testOffsetHz", ",", " ", "50.", ",", " ", "\"\<Test Offset (Hz)\>\""}],
       "}"}], ",", " ", 
     RowBox[{"-", "150."}], ",", " ", "150.", ",", " ", "5.", ",", " ", 
     RowBox[{"Appearance", " ", "->", " ", "\"\<Labeled\>\""}]}], "}"}]}], 
  "\n", "]"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"7aec71ba-59ad-1b4c-9950-93b7e52fbbff"],

