Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"6651e93d-74d1-1149-a06d-5f799618e156"],

Cell["\<\
Lab 6A explores constrained and regularised single-spin pi/2_x design \
interactively: switch between Box, Polar Disk, Disk + SlewRate, and Disk + L1 \
+ TV while visualising the 2D (ux, uy) control trajectory against both the \
physical disk circle and Cartesian square. Lab 6B provides a live Bruker / \
SIMPSON / CSV formatter and resampler on rHet.\
\>", "Text",ExpressionUUID->"8c9ad134-afcc-8344-90d8-ed8ae0fb6d3d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab6A", "[", 
     RowBox[{
     "cMode_String", ",", " ", "wMaxHz_", ",", " ", "slewHzPerS_", ",", " ", 
      "l1_", ",", " ", "tv_", ",", " ", "optName_String"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b", ",", " ", "uPi2", ",", " ", "optList", ",", " ", "res", ",", " ", 
        "sim"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", "\n", "  ", 
       RowBox[{"uPi2", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"Pi", "/", "2."}], ")"}], " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b"}], 
            "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"optList", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "cMode", ",", "\n", "    ", "\"\<Cartesian Box\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"AmplitudeBound", " ", "->", " ", 
            RowBox[{"N", "[", "wMaxHz", "]"}]}], "}"}], ",", "\n", 
          "    ", "\"\<Polar Disk\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"AmplitudeNormBound", " ", "->", " ", 
            RowBox[{"N", "[", "wMaxHz", "]"}]}], "}"}], ",", "\n", 
          "    ", "\"\<Disk + SlewRate\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AmplitudeNormBound", " ", "->", " ", 
             RowBox[{"N", "[", "wMaxHz", "]"}]}], ",", " ", 
            RowBox[{"SlewRateBound", " ", "->", " ", 
             RowBox[{"N", "[", "slewHzPerS", "]"}]}]}], "}"}], ",", "\n", 
          "    ", "\"\<Disk + L1 + TV\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"AmplitudeNormBound", " ", "->", " ", 
             RowBox[{"N", "[", "wMaxHz", "]"}]}], ",", " ", 
            RowBox[{"L1Penalty", " ", "->", " ", 
             RowBox[{"N", "[", "l1", "]"}]}], ",", " ", 
            RowBox[{"TVPenalty", " ", "->", " ", 
             RowBox[{"N", "[", "tv", "]"}]}]}], "}"}], ",", "\n", "    ", "_",
           ",", " ", 
          RowBox[{"{", "}"}]}], "\n", "  ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"Quiet", "[", 
         RowBox[{
          RowBox[{"GRAPEOptimize", "[", 
           RowBox[{
            RowBox[{"50.", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
            RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", "\n", "    ", 
            RowBox[{"{", 
             RowBox[{"0.015", ",", " ", "30"}], "}"}], ",", " ", 
            RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
            " ", 
            RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n",
             "    ", 
            RowBox[{"Optimizer", " ", "->", " ", "optName"}], ",", " ", 
            RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
            RowBox[{"MaxIterations", " ", "->", " ", "140"}], ",", " ", 
            RowBox[{"RandomSeed", " ", "->", " ", "9"}], ",", "\n", "    ", 
            RowBox[{"Sequence", " ", "@@", " ", "optList"}]}], "]"}], ",", 
          " ", 
          RowBox[{"{", 
           RowBox[{"OptimalControlProblem", "::", "nonsmoothopt"}], "}"}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"sim", " ", "=", " ", 
        RowBox[{"VerifyOptimalControlSimulation", "[", "res", "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "res"}], ",", " ", 
         RowBox[{"\"\<Sim\>\"", " ", "->", " ", "sim"}], ",", " ", 
         RowBox[{"\"\<Mode\>\"", " ", "->", " ", "cMode"}], ",", " ", 
         RowBox[{"\"\<WMax\>\"", " ", "->", " ", 
          RowBox[{"N", "[", "wMaxHz", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLab6A", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"res", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<Result\>\"", "]"}]}], ",", " ", 
        RowBox[{"u", " ", "=", " ", 
         RowBox[{
          RowBox[{"d", "[", "\"\<Result\>\"", "]"}], "[", "\"\<Controls\>\"", 
          "]"}]}], ",", " ", 
        RowBox[{"wM", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<WMax\>\"", "]"}]}], ",", " ", "maxR", ",", 
        " ", "tvVal", ",", " ", "boxPts", ",", " ", "cirPts", ",", " ", 
        "pPlane", ",", " ", "pWave"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"maxR", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"u", "^", "2"}], ",", " ", 
            RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"tvVal", " ", "=", " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Differences", "[", "u", "]"}], "]"}], "]"}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"pPlane", " ", "=", " ", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"u", ",", " ", 
