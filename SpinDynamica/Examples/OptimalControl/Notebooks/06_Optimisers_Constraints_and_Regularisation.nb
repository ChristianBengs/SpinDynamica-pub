Notebook[{
Cell["\<\
06. Optimisers, Constraints, Regularisation and Hardware Export\
\>", "Title",ExpressionUUID->"aecad1bc-8dcd-864c-99cd-1a050db202cc"],

Cell["\<\
Strong-Wolfe L-BFGS vs FISTA, polar AmplitudeNormBound vs Cartesian box \
bounds, SlewRateBound, L1+TV sparsity, and Bruker/SIMPSON/CSV export.\
\>", "Subtitle",ExpressionUUID->"67796a11-8c1f-0d4f-b5bd-a491e87dee79"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"ca39648e-8094-6d42-b68c-65d715cde3f3"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Tutorials/Tutorial02_Universal90Rotation.wls and \
Tutorial08_ConstrainedRFPulseDesign.wls (Manual Chapters 10, 12, 23).\
\>", "Text",ExpressionUUID->"92ea38a2-a3f2-9c49-8ad1-35663399d00d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
              " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", "\n",
           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$Path", ",", " ", "found"}], "]"}]}], "]"}], ";"}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   " ", 
   RowBox[{"\"\<OptimalControlContexts\>\"", " ", "->", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"$Packages", ",", " ", 
      RowBox[{
       RowBox[{"StringStartsQ", "[", 
        RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "|>"}]}], "Input",ExpressionUUID->"ca68b429-2105-\
5149-b97d-4b6aa822e458"]
