Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"cMode", " ", "=", " ", "\"\<Polar Disk\>\""}], ",", " ", 
     RowBox[{"wMax", " ", "=", " ", "85."}], ",", " ", 
     RowBox[{"slew", " ", "=", " ", "25000."}], ",", " ", 
     RowBox[{"l1", " ", "=", " ", "1.*^-4"}], ",", " ", 
     RowBox[{"tv", " ", "=", " ", "2.*^-4"}], ",", " ", 
     RowBox[{"opt", " ", "=", " ", "\"\<Automatic\>\""}], ",", " ", 
     RowBox[{"data", " ", "=", " ", "lab6ADefault"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Panel", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Constraint Mode\>\"", ",", " ", 
             RowBox[{"PopupMenu", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "cMode", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Unconstrained\>\"", ",", 
                 " ", "\"\<Cartesian Box\>\"", ",", " ", "\"\<Polar Disk\>\"",
                  ",", " ", "\"\<Disk + SlewRate\>\"", ",", 
                 " ", "\"\<Disk + L1 + TV\>\""}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Optimiser\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "opt", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Automatic\>\"", ",", " ", "\"\<LBFGS\>\"", ",", 
                 " ", "\"\<FISTA\>\""}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
           "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<RF Limit (Hz)\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "wMax", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"60.", ",", " ", "140.", ",", " ", "5."}], "}"}]}],
                  "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "wMax", "]"}]}], "}"}], "]"}]}], 
            "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Slew Bound (Hz/s)\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Slider", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "slew", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"8000.", ",", " ", "50000.", ",", " ", "2000."}], 
                   "}"}]}], "]"}], ",", " ", "\"\< \>\"", ",", " ", 
                RowBox[{"Dynamic", "[", "slew", "]"}]}], "}"}], "]"}]}], 
            "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<L1 / TV Weights\>\"", ",", " ", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<L1: \>\"", ",", " ", 
                RowBox[{"InputField", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "l1", "]"}], ",", " ", "Number", ",",
                   " ", 
                  RowBox[{"FieldSize", " ", "->", " ", "6"}]}], "]"}], ",", 
                " ", "\"\<   TV: \>\"", ",", " ", 
                RowBox[{"InputField", "[", 
                 RowBox[{
                  RowBox[{"Dynamic", "[", "tv", "]"}], ",", " ", "Number", ",",
                   " ", 
                  RowBox[{"FieldSize", " ", "->", " ", "6"}]}], "]"}]}], 
               "}"}], "]"}]}], "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<Run Constrained Optimiser\>\"", ",", " ", 
         RowBox[{"data", " ", "=", " ", 
          RowBox[{"runLab6A", "[", 
           RowBox[{
           "cMode", ",", " ", "wMax", ",", " ", "slew", ",", " ", "l1", ",", 
            " ", "tv", ",", " ", "opt"}], "]"}]}], ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Dynamic", "[", 
        RowBox[{"renderLab6A", "[", "data", "]"}], "]"}]}], "\n", "  ", "}"}],
      "]"}], "]"}]}], "\n", "]"}]], "Input",ExpressionUUID->"ef52d3ae-f763-\
