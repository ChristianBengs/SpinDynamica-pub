Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"e0ec66e2-459a-1547-a0a9-845ed2652494"],

Cell["\<\
Experimental NMR amplifiers cannot follow unbounded or discontinuously \
jumping waveforms: RF probes saturate radially at sqrt(ux^2 + uy^2) <= \
omega_max, probes arc across sharp edges, and high duty cycles heat samples. \
SpinDynamica distinguishes smooth unconstrained/box quasi-Newton optimisation \
(Strong-Wolfe L-BFGS) from proximal splitting (safeguarded FISTA with Condat \
1D TV and multi-block ADMM) for polar disks, slew ceilings, and sparsity/TV \
regularisers.\
\>", "Text",ExpressionUUID->"bc98f4f9-60ee-6b4a-ab5a-2b773adce56f"],

Cell["\<\
Compare StrongWolfe vs Armijo line searches across LBFGS, BFGS, \
ConjugateGradient, SteepestAscent, and FISTA.\
\>", "Item",ExpressionUUID->"91e41449-0380-334e-9d22-3c6c4137d485"],

Cell["\<\
Eliminate the sqrt(2) Cartesian corner excess using polar disk \
AmplitudeNormBound and heteronuclear channel pairs.\
\>", "Item",ExpressionUUID->"43613279-3361-1c45-b2fe-6d05d5e9fab5"],

Cell["\<\
Enforce slew-rate bounds and nonsmooth L1 + TV penalties automatically via \
FISTA.\
\>", "Item",ExpressionUUID->"43854234-592d-c64c-bfb1-2183e65d554c"],

Cell["\<\
Inspect formatted Bruker, SIMPSON, and CSV exports dynamically with \
resampling and verify round-trip fidelity.\
\>", "Item",ExpressionUUID->"6361925d-544e-7646-a77e-c756454d2f17"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"73a54da7-9913-794b-b9e1-e66d83b985c1"],

Cell["\<\
Cartesian box bounds |u_x|, |u_y| <= wMax allow peak RF nutation omega_1 = \
sqrt(u_x^2 + u_y^2) up to sqrt(2) wMax (a +41.4% hardware excess). \
AmplitudeNormBound projects onto circular disks sqrt(u_{c1}^2 + u_{c2}^2) <= \
wMax cleanly. Combining disk limits with SlewRateBound (|u_{j+1,k} - u_{j,k}| \
/ dt_bar <= S_max), L1Penalty (lambda_1 ||u||_1), or TVPenalty (lambda_TV Sum \
|u_{j+1} - u_j|) switches automatically to safeguarded monotone FISTA solving \
multi-block over-relaxed ADMM proximal subproblems.\
\>", "Text",ExpressionUUID->"5af105e9-77ce-9f41-bf0b-71a7541ccbd9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"aa774559-70a6-5741-afc4-e0e1bce0fa87"],

Cell["\<\
Run the validated Tutorial 08 suite comparing AmplitudeBound vs \
AmplitudeNormBound at 85 Hz, FISTA L1+TV plateau reduction, and heteronuclear \
pair disks {{1,2} -> 120 Hz, {3,4} -> 180 Hz} followed by SIMPSON round-trip \
verification.\
\>", "Text",ExpressionUUID->"f0f3b6b0-a261-fa42-8a07-5969c1baf251"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uPi2", " ", "=", " ", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", 
     RowBox[{"(", 
      RowBox[{"Pi", "/", "2."}], ")"}], " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"MatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", "b1"}], "]"}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"prob1", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{
     RowBox[{"80.", " ", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"UnitaryTarget", "[", "uPi2", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.01", ",", " ", "24"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"rBox", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{"prob1", ",", " ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "85."}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "5"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rDisk", " ", "=", " ", 
    RowBox[{"GRAPEOptimize", "[", 
     RowBox[{"prob1", ",", " ", 
      RowBox[{"AmplitudeNormBound", " ", "->", " ", "85."}], ",", " ", 
      RowBox[{"TargetFidelity", " ", "->", " ", "0.9995"}], ",", " ", 
      RowBox[{"RandomSeed", " ", "->", " ", "5"}]}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Heteronuclear", " ", "INEPT", " ", "pair", " ", "disk", " ", "bounds"}],
      " ", "&"}], " ", 
    RowBox[{
     RowBox[{"SIMPSON", "/", "Bruker"}], "/", "CSV"}], " ", "export"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rHet", " ", "=", " ", 
   RowBox[{"GRAPEOptimize", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"30.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"45.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"140.", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ".", 
        RowBox[{"opI", "[", 
         RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"ObservableTarget", "[", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"0.012", ",", " ", "24"}], "}"}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n", "  ", 
     
     RowBox[{"AmplitudeNormBound", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], " ", "->", " ", "120."}], ",", 
        " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], " ", "->", " ", "180."}]}], 
       "}"}]}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
     RowBox[{"MaxIterations", " ", "->", " ", "120"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tblHet", " ", "=", " ", 
   RowBox[{"OptimalControlPulseTable", "[", "rHet", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simpAll", " ", "=", " ", 
    RowBox[{"ExportOptimalControlPulse", "[", 
     RowBox[{"rHet", ",", " ", "\"\<SIMPSON\>\"", ",", " ", 
      RowBox[{"Channel", " ", "->", " ", "All"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<Box_MaxRadiusHz\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rBox", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",", " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Disk_MaxRadiusHz\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rDisk", "[", "\"\<Controls\>\"", "]"}], "^", "2"}], ",", 
        " ", 
        RowBox[{"{", "2", "}"}]}], "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Disk_Viol\>\"", " ", "->", " ", 
    RowBox[{"rDisk", "[", "\"\<MaxConstraintViolation\>\"", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<Het_Fidelity\>\"", " ", "->", " ", 
    RowBox[{"rHet", "[", "\"\<FinalFidelity\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Het_Ch1MaxHz\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"tblHet", "[", "\"\<Channels\>\"", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<AmplitudeHz\>\"", "]"}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Het_Ch2MaxHz\>\"", " ", "->", " ", 
