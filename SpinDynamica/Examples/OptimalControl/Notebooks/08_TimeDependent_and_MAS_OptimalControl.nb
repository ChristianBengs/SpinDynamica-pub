Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"716a65e7-d518-db47-9cc8-3de3d690bc82"],

Cell["\<\
Lab 8A instantaneously explores MAS DriftIntegration accuracy across spinning \
frequency nu_r, dipolar strength, slices per rotor period, and rotor starting \
phase t0/Tr (forward-only comparison against CF4x4, zero optimisation).\
\>", "Text",ExpressionUUID->"b72efd41-59db-de4d-ba2f-cec62117ede0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLab8A", "[", 
     RowBox[{
      RowBox[{"nuRKHz_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"dKHz_", "?", "NumericQ"}], ",", " ", "slicesPerTr_Integer", ",",
       " ", 
      RowBox[{"fracT0_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ctrls4", ",", " ", "tr", ",", " ", "wr", ",", " ", "tVar", ",", " ", 
        "hMod", ",", " ", "nt", ",", " ", "t0", ",", " ", "uTest", ",", " ", 
        "refU", ",", " ", "schemes", ",", " ", "errs", ",", " ", "names"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"Quiet", "@", 
        RowBox[{"SetSpinSystem", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"ctrls4", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"tr", " ", "=", " ", 
        RowBox[{"1.", " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"1000.", " ", "*", " ", "nuRKHz"}], ")"}]}]}], ";", " ", 
       RowBox[{"wr", " ", "=", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Pi", " ", "/", " ", "tr"}]}]}], ";", "\n", "  ", 
       RowBox[{"hMod", " ", "=", " ", 
        RowBox[{"PeriodicFunction", "[", 
         RowBox[{"tVar", ",", " ", "tr", ",", " ", 
          RowBox[{"Evaluate", "[", "\n", "    ", 
           RowBox[{
            RowBox[{"1500.", " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
            RowBox[{"3500.", " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n", 
            "    ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1000.", " ", "*", " ", "dKHz"}], ")"}], " ", "*", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"wr", " ", "tVar"}], "]"}], " ", "+", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", " ", "wr", " ", "tVar"}], "]"}]}]}], ")"}], " ",
              "*", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", 
                RowBox[{
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ".", 
                 RowBox[{"opI", "[", 
                  RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], " ", "-", 
               " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ".", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "-", " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ".", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}]}], 
           "\n", "  ", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"nt", " ", "=", " ", 
        RowBox[{"2", " ", "*", " ", "slicesPerTr"}]}], ";", " ", 
       RowBox[{"t0", " ", "=", " ", 
        RowBox[{"fracT0", " ", "*", " ", "tr"}]}], ";", "\n", "  ", 
       RowBox[{"SeedRandom", "[", "90", "]"}], ";", " ", 
       RowBox[{"uTest", " ", "=", " ", 
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "3000."}], ",", " ", "3000."}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"nt", ",", " ", "4"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"refU", " ", "=", " ", 
        RowBox[{
         RowBox[{"EvaluateOptimalControl", "[", 
          RowBox[{
           RowBox[{"OptimalControlProblem", "[", 
            RowBox[{"hMod", ",", " ", "ctrls4", ",", " ", 
             RowBox[{"StateTarget", "[", 
              RowBox[{
               RowBox[{"opI", "[", 
                RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
               RowBox[{"opI", "[", 
                RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", 
             "\n", "    ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"2.", " ", "*", " ", "tr"}], ",", " ", "nt"}], "}"}], ",",
              " ", 
             RowBox[{"InitialTimePoint", " ", "->", " ", "t0"}], ",", " ", 
             RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
             " ", 
             RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
             RowBox[{"DriftIntegration", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<CF4\>\"", ",", " ", "4"}], "}"}]}]}], "]"}], ",", 
           " ", "uTest"}], "]"}], "[", "\"\<FinalPropagator\>\"", "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"schemes", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Midpoint\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SubSlices\>\"", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SubSlices\>\"", ",", " ", "4"}], "}"}], ",", 
          " ", "\"\<CF4\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<CF4\>\"", ",", " ", "2"}], "}"}]}], "}"}]}], ";", 
       "\n", "  ", 
       RowBox[{"names", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Midpoint\>\"", ",", " ", "\"\<SubSlices(2)\>\"", ",", 
          " ", "\"\<SubSlices(4)\>\"", ",", " ", "\"\<CF4\>\"", ",", 
          " ", "\"\<CF4(2)\>\""}], "}"}]}], ";", "\n", "  ", 
       RowBox[{"errs", " ", "=", " ", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"s", ",", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"EvaluateOptimalControl", "[", "\n", "    ", 
                 RowBox[{
                  RowBox[{"OptimalControlProblem", "[", 
                   RowBox[{"hMod", ",", " ", "ctrls4", ",", " ", 
                    RowBox[{"StateTarget", "[", 
                    RowBox[{
                    RowBox[{"opI", "[", 
                    RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", 
                    " ", 
                    RowBox[{"opI", "[", 
                    RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",",
                     " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"2.", " ", "*", " ", "tr"}], ",", " ", "nt"}], 
                    "}"}], ",", "\n", "      ", 
                    RowBox[{"InitialTimePoint", " ", "->", " ", "t0"}], ",", 
                    " ", 
                    RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], 
                    ",", " ", 
                    RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",",
                     " ", 
                    RowBox[{"DriftIntegration", " ", "->", " ", "s"}]}], 
                   "]"}], ",", " ", "uTest"}], "]"}], 
                "[", "\"\<FinalPropagator\>\"", "]"}], " ", "-", " ", 
               "refU"}], "]"}], "]"}]}], "]"}], ",", " ", "schemes"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{
          RowBox[{"Row", "[", 
           RowBox[{"{", 
            
            RowBox[{"\"\<nu_r = \>\"", ",", " ", "nuRKHz", ",", 
             " ", "\"\< kHz (Tr = \>\"", ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"10", "^", "6"}], " ", "tr"}], ",", " ", "4"}], "]"}],
              ",", " ", "\"\< us)   D = \>\"", ",", " ", "dKHz", ",", 
             " ", "\"\< kHz   Nt = \>\"", ",", " ", "nt", ",", 
             " ", "\"\< (\>\"", ",", " ", "slicesPerTr", ",", 
             " ", "\"\</Tr)\>\""}], "}"}], "]"}], ",", "\n", "    ", 
          RowBox[{"BarChart", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", ",", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "9"}]}]}], "]"}], " ", "&"}], " ", "/@", " ", 
             "errs"}], ",", " ", 
            RowBox[{"ScalingFunctions", " ", "->", " ", "\"\<Log\>\""}], ",", 
            " ", 
            RowBox[{"ChartLabels", " ", "->", " ", "names"}], ",", " ", 
            RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
            RowBox[{"FrameLabel", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
              "None", ",", " ", "\"\<Max Propagator Error vs CF4(4)\>\""}], 
              "}"}]}], ",", " ", 
            RowBox[{"PlotRange", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}], ",", " ", "1."}], "}"}]}], ",", " ", 
            RowBox[{"ImageSize", " ", "->", " ", "470"}]}], "]"}]}], "\n", 
         "  ", "}"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab8B", "[", 
     RowBox[{
     "nuRKHz_", ",", " ", "nRotors_Integer", ",", " ", "nPhases_Integer", ",",
       " ", "intMode_", ",", " ", "rfMaxKHz_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ctrls4", ",", " ", "tr", ",", " ", "wr", ",", " ", "tVar", ",", " ", 
        "hMod", ",", " ", "t0Vals", ",", " ", "nt", ",", " ", "ens", ",", " ",
         "res", ",", " ", "sim"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"Quiet", "@", 
        RowBox[{"SetSpinSystem", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", 
             RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"ctrls4", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"tr", " ", "=", " ", 
        RowBox[{"1.", " ", "/", " ", 
         RowBox[{"(", 
          RowBox[{"1000.", " ", "*", " ", "nuRKHz"}], ")"}]}]}], ";", " ", 
       RowBox[{"wr", " ", "=", " ", 
        RowBox[{"2.", " ", 
         RowBox[{"Pi", " ", "/", " ", "tr"}]}]}], ";", "\n", "  ", 
       RowBox[{"hMod", " ", "=", " ", 
        RowBox[{"PeriodicFunction", "[", 
         RowBox[{"tVar", ",", " ", "tr", ",", " ", 
          RowBox[{"Evaluate", "[", "\n", "    ", 
           RowBox[{
            RowBox[{"1500.", " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
            RowBox[{"3500.", " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
            RowBox[{"4000.", " ", "*", " ", 
             RowBox[{"Cos", "[", 
              RowBox[{"wr", " ", "tVar"}], "]"}], " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", "\n", 
            "    ", 
            RowBox[{"6000.", " ", "*", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Cos", "[", 
                RowBox[{"wr", " ", "tVar"}], "]"}], " ", "+", " ", 
               RowBox[{"0.5", " ", 
                RowBox[{"Sin", "[", 
                 RowBox[{"2", " ", "wr", " ", "tVar"}], "]"}]}]}], ")"}], " ",
              "*", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", 
                RowBox[{
                 RowBox[{"opI", "[", 
                  RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ".", 
                 RowBox[{"opI", "[", 
                  RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], " ", "-", 
               " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ".", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}]}], " ", "-", " ", 
               RowBox[{
                RowBox[{"opI", "[", 
                 RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ".", 
                RowBox[{"opI", "[", 
                 RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}]}], ")"}]}]}], 
           "\n", "  ", "]"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"t0Vals", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", " ", "-", " ", "1."}], ")"}], " ", "*", " ", 
           RowBox[{"tr", " ", "/", " ", "nPhases"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "nPhases"}], "}"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"nt", " ", "=", " ", 
        RowBox[{"12", " ", "*", " ", "nRotors"}]}], ";", "\n", "  ", 
       RowBox[{"ens", " ", "=", " ", 
        RowBox[{"OptimalControlEnsemble", "[", 
         RowBox[{"hMod", ",", " ", "ctrls4", ",", " ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"nRotors", " ", "*", " ", "tr"}], ",", " ", "nt"}], "}"}],
           ",", "\n", "    ", 
          RowBox[{"EnsembleParameters", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"t0Sym", " ", "->", " ", "t0Vals"}], "}"}]}], ",", " ", 
          RowBox[{"InitialTimePoint", " ", "->", " ", "t0Sym"}], ",", "\n", 
          "    ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          RowBox[{"DriftIntegration", " ", "->", " ", "intMode"}]}], "]"}]}], 
       ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"GRAPEOptimize", "[", 
         RowBox[{"ens", ",", " ", 
          RowBox[{"AmplitudeNormBound", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{"1000.", " ", "*", " ", "rfMaxKHz"}], ")"}]}], ",", " ", 
          RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
          RowBox[{"MaxIterations", " ", "->", " ", "100"}], ",", " ", 
          RowBox[{"RandomSeed", " ", "->", " ", "77"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"sim", " ", "=", " ", 
        RowBox[{"VerifyOptimalControlSimulation", "[", 
         RowBox[{"res", ",", " ", 
          RowBox[{"Tolerance", " ", "->", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "4"}]}]}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "res"}], ",", " ", 
         RowBox[{"\"\<Sim\>\"", " ", "->", " ", "sim"}], ",", " ", 
         RowBox[{"\"\<NuRKHz\>\"", " ", "->", " ", "nuRKHz"}], ",", " ", 
         RowBox[{"\"\<NRotors\>\"", " ", "->", " ", "nRotors"}], ",", " ", 
         RowBox[{"\"\<NPhases\>\"", " ", "->", " ", "nPhases"}], ",", " ", 
         RowBox[{"\"\<IntMode\>\"", " ", "->", " ", "intMode"}]}], "|>"}]}]}],
      "\n", "]"}]}], ";"}], "\n"}], "\n", 
