Cell[CellGroupData[{
Cell["08. Time-Dependent Hamiltonians and MAS Optimal Control", "Title",ExpressionUUID->"bc6498b7-f64e-d744-94ab-bafa1459e7ef"],

Cell["\<\
PeriodicFunction magic-angle spinning drifts, CF4 commutator-free Magnus \
integration, rotor-phase-invariant recoupling, and post-pulse Signal1D \
COMPUTE verification.\
\>", "Subtitle",ExpressionUUID->"b5e07a87-dde4-a844-a720-4c43260135fd"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"73ffe9ee-3df8-ff48-b4df-1610ff25d1b2"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Tutorials/Tutorial09_MASOptimalControl.wls (Manual \
Chapter 18).\
\>", "Text",ExpressionUUID->"78fc0652-2cf6-fd4f-a535-eda143341008"],

