           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
