          "}"}]}], ",", " ", 
        RowBox[{"EnsembleAggregation", " ", "->", " ", "\"\<Mean\>\""}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"AmplitudeNormBound", " ", "->", " ", "8."}], ",", " ", 
