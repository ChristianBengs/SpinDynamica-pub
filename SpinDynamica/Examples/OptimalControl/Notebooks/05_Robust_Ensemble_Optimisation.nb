Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"cc0aca10-4dda-914c-8b10-9adbe8435d08"],

Cell["\<\
Lab 5A lets you adjust bandwidth, training step spacing (including triggering \
1.0 kHz aliasing!), RF spread, aggregation mode, and SoftMinSchedule when you \
click 'Run Ensemble Optimisation', immediately contrasting training fidelity \
against dense out-of-sample fidelity.\
\>", "Text",ExpressionUUID->"19db72dc-66a4-0841-a9f4-e8fd4ce21df2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab5A", "[", 
     RowBox[{
     "bwKHz_", ",", " ", "stepKHz_", ",", " ", "useRF_", ",", " ", 
      "aggMode_String", ",", " ", "useSched_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b1", ",", " ", "ks1", ",", " ", "ensTrain", ",", " ", "aggSpec", ",", 
        " ", "rfSpec", ",", " ", "smOpt", ",", " ", "res", ",", " ", 
        "ensTest", ",", " ", "evalTrain", ",", " ", "evalTest"}], "}"}], ",", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", "\n", "  ", 
       RowBox[{"b1", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
       RowBox[{"ks1", " ", "=", " ", 
        RowBox[{"BasisKets", "[", "b1", "]"}]}], ";", "\n", "  ", 
       RowBox[{"aggSpec", " ", "=", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"aggMode", ",", " ", "\"\<SoftMin(15)\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SoftMin\>\"", ",", " ", "15."}], "}"}], ",", 
          " ", "\"\<SoftMin(30)\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SoftMin\>\"", ",", " ", "30."}], "}"}], ",", " ", "_",
           ",", " ", "\"\<Mean\>\""}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"rfSpec", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", "useRF", "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.85", ",", " ", "1.0", ",", " ", "1.15"}], "}"}], ",", 
          " ", "None"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"smOpt", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TrueQ", "[", "useSched", "]"}], " ", "&&", " ", 
           RowBox[{"aggMode", " ", "=!=", " ", "\"\<Mean\>\""}]}], ",", " ", 
          "Automatic", ",", " ", "None"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"ensTrain", " ", "=", " ", 
        RowBox[{"OptimalControlEnsemble", "[", 
         RowBox[{
          RowBox[{"delta", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{
            RowBox[{"ks1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"ks1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"0.002", ",", " ", "24"}], "}"}], ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", " ", 
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}], ",", "\n", 
          "    ", 
          RowBox[{"EnsembleParameters", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"delta", " ", "->", " ", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
               RowBox[{"N", "[", "bwKHz", "]"}], ",", " ", 
               RowBox[{"N", "[", "stepKHz", "]"}]}], "]"}]}], "}"}]}], ",", 
          "\n", "    ", 
          RowBox[{"RFInhomogeneity", " ", "->", " ", "rfSpec"}], ",", " ", 
          RowBox[{"EnsembleAggregation", " ", "->", " ", "aggSpec"}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"GRAPEOptimize", "[", 
         RowBox[{"ensTrain", ",", " ", 
          RowBox[{"AmplitudeNormBound", " ", "->", " ", "8."}], ",", " ", 
          RowBox[{"SoftMinSchedule", " ", "->", " ", "smOpt"}], ",", " ", 
          RowBox[{"TargetFidelity", " ", "->", " ", "0.995"}], ",", " ", 
          RowBox[{"MaxIterations", " ", "->", " ", "80"}], ",", " ", 
          RowBox[{"RandomSeed", " ", "->", " ", "101"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"ensTest", " ", "=", " ", 
        RowBox[{"OptimalControlEnsemble", "[", 
         RowBox[{
          RowBox[{"delta", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
