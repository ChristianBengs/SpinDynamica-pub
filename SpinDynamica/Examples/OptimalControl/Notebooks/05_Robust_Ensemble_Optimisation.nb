            RowBox[{"N", "[", "bwKHz", "]"}], ",", " ", "0.1"}], "]"}]}], ",",
          "\n", "    ", 
         RowBox[{"\"\<TrainPts\>\"", " ", "->", " ", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
            RowBox[{"N", "[", "bwKHz", "]"}], ",", " ", 
            RowBox[{"N", "[", "stepKHz", "]"}]}], "]"}]}], ",", " ", 
         RowBox[{"\"\<UseRF\>\"", " ", "->", " ", 
          RowBox[{"TrueQ", "[", "useRF", "]"}]}], ",", " ", 
         RowBox[{"\"\<Agg\>\"", " ", "->", " ", "aggMode"}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
