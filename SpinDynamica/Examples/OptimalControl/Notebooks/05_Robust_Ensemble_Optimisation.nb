Notebook[{
Cell["05. Robust Ensemble Optimisation", "Title",ExpressionUUID->"3a3d5a9e-8772-784d-9005-6a8a5c8dd65b"],

Cell["\<\
Broadband offset compensation, Nyquist grid-density limits, Mean vs SoftMin \
aggregation, 2D Offset x RF inhomogeneity continuation, and out-of-sample \
testing.\
\>", "Subtitle",ExpressionUUID->"c32a5284-de14-7944-aa89-cb2006e09670"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"7a4b8ef0-2db6-f446-9f00-b7e9ee7fcd3c"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Tutorials/Tutorial06_BroadbandRobustInversion.wls and \
Tutorial07_RFInhomogeneityRobustness.wls (Manual Chapters 13, 17).\
\>", "Text",ExpressionUUID->"ff7497aa-97b8-e848-99de-8436738c7626"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
