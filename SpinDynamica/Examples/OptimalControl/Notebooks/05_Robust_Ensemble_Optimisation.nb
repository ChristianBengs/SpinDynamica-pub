Cell["\<\
Lab 5B is an instant Manipulate forward inspector on the pre-optimised 2D \
pulse res2D: drag offset delta in [-4, +4] kHz and B1 scale in [0.8, 1.2] to \
inspect live inversion trajectories cleanly without rerunning optimisation.\
\>", "Text",ExpressionUUID->"15340e99-c647-ce4d-8b06-ea730dbaca27"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"renderLab5B", "[", 
    RowBox[{"res_OptimalControlResult", ",", " ", 
     RowBox[{"deltaTest_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"rfScale_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "b", ",", " ", "iX", ",", " ", "iY", ",", " ", "iZ", ",", " ", "dt", ",",
        " ", "uCtrl", ",", " ", "uCum", ",", " ", "zTraj", ",", " ", "finIz", 
       ",", " ", "fid"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"ZeemanBasis", "[", "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"iX", ",", " ", "iY", ",", " ", "iZ"}], "}"}], " ", "=", " ", 
       
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"2.", " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "ax"}], "]"}], ",", " ", "b"}], "]"}], 
           "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ax", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\"", ",", 
             " ", "\"\<z\>\""}], "}"}]}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"dt", " ", "=", " ", 
       RowBox[{"res", "[", "\"\<TimeSteps\>\"", "]"}]}], ";", " ", 
      RowBox[{"uCtrl", " ", "=", " ", 
       RowBox[{"res", "[", "\"\<Controls\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"uCum", " ", "=", " ", 
       RowBox[{"FoldList", "[", 
        RowBox[{"Dot", ",", " ", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", " ", 
         RowBox[{"Table", "[", "\n", "    ", 
          RowBox[{
           RowBox[{"MatrixExp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"dt", "[", 
              RowBox[{"[", "j", "]"}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"2000.", " ", "Pi", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"deltaTest", " ", "0.5", " ", "iZ"}], " ", "+", " ", 
                 
                 RowBox[{"rfScale", " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"uCtrl", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "1"}], "]"}], "]"}], " ", "0.5", " ",
                     "iX"}], " ", "+", " ", 
                    RowBox[{
                    RowBox[{"uCtrl", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", ",", " ", "2"}], "]"}], "]"}], " ", "0.5", " ",
                     "iY"}]}], ")"}]}]}], ")"}]}], ")"}]}], "]"}], ",", "\n", 
           "    ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "dt", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
      ";", "\n", "  ", 
      RowBox[{"zTraj", " ", "=", " ", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#", " ", ".", " ", 
               RowBox[{"(", 
                RowBox[{"0.5", " ", "iZ"}], ")"}], " ", ".", " ", 
               RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], " ", ".",
              " ", "iZ"}], "]"}], "]"}], " ", "&"}], ",", " ", "uCum"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"finIz", " ", "=", " ", 
       RowBox[{"Last", "[", "zTraj", "]"}]}], ";", " ", 
      RowBox[{"fid", " ", "=", " ", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"uCum", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "2", ",", " ", "1"}], "]"}], "]"}], 
         "]"}], "^", "2"}]}], ";", "\n", "  ", 
      RowBox[{"Column", "[", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<delta = \>\"", ",", " ", "deltaTest", ",", 
            " ", "\"\< kHz   RF scale = \>\"", ",", " ", "rfScale", ",", 
            " ", "\"\<   2<Iz(T)> = \>\"", ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"finIz", ",", " ", "5"}], "]"}], ",", 
            " ", "\"\<   Inversion F = \>\"", ",", " ", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"fid", ",", " ", "5"}], "]"}]}], "}"}], "]"}], ",", "\n",
          "    ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Prepend", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Accumulate", "[", "dt", "]"}], "*", "1000."}], ",", 
                " ", "0."}], "]"}], ",", " ", "zTraj"}], "}"}], "]"}], ",", 
           " ", 
           RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "      ", 
           RowBox[{"FrameLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<Time (ms)\>\"", ",", " ", "\"\<2<Iz(t)>\>\""}], 
             "}"}]}], ",", " ", 
           RowBox[{"PlotRange", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.05"}], ",", " ", "1.05"}], "}"}]}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "450"}]}], "]"}]}], "\n", 
        "  ", "}"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"renderLab5B", "[", 
    RowBox[{"res2D", ",", " ", "deltaTest", ",", " ", "rfScale"}], "]"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"deltaTest", ",", " ", "0.", ",", " ", "\"\<Offset (kHz)\>\""}],
       "}"}], ",", " ", 
