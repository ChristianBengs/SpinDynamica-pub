                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
               RowBox[{"N", "[", "bwKHz", "]"}], ",", " ", "0.1"}], "]"}]}], 
            "}"}]}], ",", " ", 
          RowBox[{"RFInhomogeneity", " ", "->", " ", "rfSpec"}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"evalTest", " ", "=", " ", 
        RowBox[{"EvaluateEnsembleFidelity", "[", 
         RowBox[{"ensTest", ",", " ", 
          RowBox[{"res", "[", "\"\<Controls\>\"", "]"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"<|", 
        RowBox[{
