           RowBox[{"2", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"b2", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
       RowBox[{"ks2", " ", "=", " ", 
        RowBox[{"BasisKets", "[", "b2", "]"}]}], ";", "\n", "  ", 
       RowBox[{"ctrls4", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
          RowBox[{"opI", "[", 
           RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
