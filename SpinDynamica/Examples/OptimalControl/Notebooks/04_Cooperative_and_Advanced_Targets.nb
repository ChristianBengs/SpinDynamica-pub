           RowBox[{"2", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "}"}]}], "}"}], "]"}], ";", "\n", "  ", 
       RowBox[{"ctrls4", " ", "=", " ", 
        RowBox[{"{", 
