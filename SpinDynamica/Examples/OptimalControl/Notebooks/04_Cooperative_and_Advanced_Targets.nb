          RowBox[{"opI", "[", 
           RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"cnot4", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1.", ",", " ", "0.", ",", " ", "0.", ",", " ", "0."}], 
           "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.", ",", " ", "1.", ",", " ", "0.", ",", " ", "0."}], 
           "}"}], ",", " ", 
