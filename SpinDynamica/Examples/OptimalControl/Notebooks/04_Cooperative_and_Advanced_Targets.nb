           RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}]}], ";", "\n", 
       "  ", 
       RowBox[{"psi1", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"ks2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
          "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"psi2", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"ks2", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
          "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"psi4", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"MatrixRepresentation", "[", 
            RowBox[{
             RowBox[{"ks2", "[", 
              RowBox[{"[", "4", "]"}], "]"}], ",", " ", "b2"}], "]"}], "]"}], 
          "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"GRAPEOptimize", "[", 
         RowBox[{
          RowBox[{"2000.", " ", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], ".", 
            RowBox[{"opI", "[", 
             RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", " ", 
          "ctrls4", ",", " ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{"psi1", " ", "->", " ", "psi4"}], "]"}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"1.5*^-3", ",", " ", "24"}], "}"}], ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", "\n",
           "    ", 
          RowBox[{"RunningCost", " ", "->", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"weight", " ", ">", " ", "0."}], ",", " ", 
             RowBox[{"StatePenalty", "[", 
              RowBox[{"psi2", ",", " ", 
               RowBox[{"N", "[", "weight", "]"}], ",", " ", 
               RowBox[{"TimeWeighting", " ", "->", " ", "twMode"}]}], "]"}], ",",
              " ", "None"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"MaxIterations", " ", "->", " ", "250"}], ",", " ", 
          RowBox[{"TargetFidelity", " ", "->", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"weight", " ", ">", " ", "0."}], ",", " ", "None", ",", 
             " ", "0.9999"}], "]"}]}], ",", " ", 
          RowBox[{"GradientTolerance", " ", "->", " ", 
           RowBox[{"10", "^", 
