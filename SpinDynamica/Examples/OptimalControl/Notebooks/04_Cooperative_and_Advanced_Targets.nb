 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab4B", "[", 
     RowBox[{"weight_", ",", " ", "twMode_String"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b2", ",", " ", "ks2", ",", " ", "ctrls4", ",", " ", "psi1", ",", " ", 
