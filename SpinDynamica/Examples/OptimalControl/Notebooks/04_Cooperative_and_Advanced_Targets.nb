Notebook[{
Cell["04. Cooperative Control and Advanced NMR Targets", "Title",ExpressionUUID->"8cdc5650-8120-9b4b-bc9e-03f678fe6f0f"],

Cell["\<\
Cooperative multi-axis pulses, heterogeneous spin ensembles, \
RunningCost/StatePenalty forbidden-state suppression, SubspaceUnitaryTarget, \
virtual-Z PhaseFreedom, and OptimizeDurations.\
\>", "Subtitle",ExpressionUUID->"83f9f15e-d617-8340-b57b-5c5e238b9e75"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"62bf5988-4fdc-bf41-b7c9-02781a3e6104"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All five OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Tutorials/Tutorial05_CooperativeOptimisation.wls and \
Tutorial10_AdvancedTargetsAndTiming.wls (Manual Chapters 16, 19).\
\>", "Text",ExpressionUUID->"6a9cd938-5da8-fb40-8921-b9e598d3e3e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
