Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"347d4d75-4797-c142-8e6d-f91a83040bea"],

Cell["\<\
Lab 2A instantaneously sweeps central finite-difference step sizes log10(h) \
from -9 to -1 and varies slice duration dt (by scaling total duration T), \
comparing VerifyOptimalControlGradient errors for exact Spectral vs \
approximate FirstOrder gradients. Notice the U-shaped round-off vs truncation \
curve of Spectral gradients versus the plateauing O(dt) bias of FirstOrder.\
\>", "Text",ExpressionUUID->"23f662ac-434a-fd48-bf8d-a0458eee85a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"renderLab2A", "[", 
    RowBox[{
     RowBox[{"durMs_", "?", "NumericQ"}], ",", " ", 
