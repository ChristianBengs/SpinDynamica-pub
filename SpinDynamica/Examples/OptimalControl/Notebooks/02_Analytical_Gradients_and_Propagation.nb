Cell["\<\
Lab 2B benchmarks single-evaluation wall time and memory across Hilbert \
kernels (\"Spectral\", \"BlockMatrixExp\", \"StateVector\", \"FirstOrder\") \
for N = 1..4 spins on demand when you click 'Benchmark Kernels'.\
\>", "Text",ExpressionUUID->"088b26e2-bf2a-284f-933a-c145610432bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"runLab2B", "[", 
    RowBox[{"nSpins_Integer", ",", " ", "nt_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ctrls", ",", " ", "initKet", ",", " ", "tarKet", ",", " ", "meths", ",",
        " ", "baseProb", ",", " ", "timings", ",", " ", "evals", ",", " ", 
       "uTest"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"SetSpinSystem", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"nSpins", " ", "===", " ", "1"}], ",", " ", "1", ",", " ", 
         RowBox[{"Range", "[", "nSpins", "]"}]}], "]"}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"b", " ", "=", " ", 
          RowBox[{"ZeemanBasis", "[", "]"}]}], "}"}], ",", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"initKet", ",", " ", "tarKet"}], "}"}], " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"BasisKets", "[", "b", "]"}], "]"}], ",", " ", 
           RowBox[{"Last", "[", 
            RowBox[{"BasisKets", "[", "b", "]"}], "]"}]}], "}"}]}]}], "]"}], ";",
       "\n", "  ", 
      RowBox[{"ctrls", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"s", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"s", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"s", ",", " ", "nSpins"}], "}"}]}], "]"}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"uTest", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"50.", ",", " ", 
         RowBox[{"{", 
          RowBox[{"nt", ",", " ", 
           RowBox[{"Length", "[", "ctrls", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"meths", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Spectral\>\"", ",", " ", "\"\<StateVector\>\"", ",", 
         " ", "\"\<BlockMatrixExp\>\"", ",", " ", "\"\<FirstOrder\>\""}], 
        "}"}]}], ";", "\n", "  ", 
      RowBox[{"timings", " ", "=", " ", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"m", ",", "\n", "    ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"comp", ",", " ", "tMean"}], "}"}], ",", "\n", "      ", 
             RowBox[{
              RowBox[{"comp", " ", "=", " ", 
               RowBox[{"CompileOptimalControlProblem", "[", 
                RowBox[{"OptimalControlProblem", "[", "\n", "        ", 
                 RowBox[{
                  RowBox[{"Sum", "[", 
                   RowBox[{
                    RowBox[{"25.", " ", "s", " ", 
                    RowBox[{"opI", "[", 
                    RowBox[{"s", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", " ", "nSpins"}], "}"}]}], "]"}], ",", 
                  " ", "ctrls", ",", " ", 
                  RowBox[{"StateTarget", "[", 
                   RowBox[{"initKet", " ", "->", " ", "tarKet"}], "]"}], ",", 
                  " ", 
                  RowBox[{"{", 
                   RowBox[{"0.01", ",", " ", "nt"}], "}"}], ",", "\n", 
                  "        ", 
                  RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",",
                   " ", 
                  RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}], ",",
                   " ", 
                  RowBox[{"Method", " ", "->", " ", "m"}]}], "]"}], "]"}]}], ";",
               "\n", "      ", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Warm", " ", "up", " ", "once", " ", "then", " ", "average", " ",
                 "5", " ", "evaluations"}], " ", "*)"}], "\n", "      ", 
              RowBox[{"EvaluateOptimalControl", "[", 
               RowBox[{"comp", ",", " ", "uTest"}], "]"}], ";", "\n", 
              "      ", 
              RowBox[{"tMean", " ", "=", " ", 
               RowBox[{
                RowBox[{"Mean", "[", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"First", "[", 
                    RowBox[{"AbsoluteTiming", "[", 
                    RowBox[{
                    RowBox[{"EvaluateOptimalControl", "[", 
                    RowBox[{"comp", ",", " ", "uTest"}], "]"}], ";"}], "]"}], 
                    "]"}], ",", " ", 
                   RowBox[{"{", "5", "}"}]}], "]"}], "]"}], " ", "*", " ", 
                "1000."}]}], ";", "\n", "      ", "tMean"}]}], "\n", "    ", 
            "]"}]}], "]"}], ",", " ", "meths"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<NSpins\>\"", " ", "->", " ", "nSpins"}], ",", " ", 
        RowBox[{"\"\<Dim\>\"", " ", "->", " ", 
         RowBox[{"2", "^", "nSpins"}]}], ",", " ", 
        RowBox[{"\"\<NumControls\>\"", " ", "->", " ", 
         RowBox[{"2", " ", "nSpins"}]}], ",", " ", 
        RowBox[{"\"\<Nt\>\"", " ", "->", " ", "nt"}], ",", " ", 
        RowBox[{"\"\<TimingsMs\>\"", " ", "->", " ", "timings"}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"renderLab2B", "[", "d_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Column", "[", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Spins N = \>\"", ",", " ", 
         RowBox[{"d", "[", "\"\<NSpins\>\"", "]"}], ",", 
         " ", "\"\< (Hilbert dim D = \>\"", ",", " ", 
         RowBox[{"d", "[", "\"\<Dim\>\"", "]"}], ",", " ", "\"\<, M = \>\"", ",",
          " ", 
         RowBox[{"d", "[", "\"\<NumControls\>\"", "]"}], ",", 
         " ", "\"\<, Nt = \>\"", ",", " ", 
         RowBox[{"d", "[", "\"\<Nt\>\"", "]"}], ",", " ", "\"\<)\>\""}], 
        "}"}], "]"}], ",", "\n", "  ", 
      RowBox[{"BarChart", "[", 
       RowBox[{
        RowBox[{"Values", "[", 
         RowBox[{"d", "[", "\"\<TimingsMs\>\"", "]"}], "]"}], ",", " ", 
        RowBox[{"ChartLabels", " ", "->", " ", 
         RowBox[{"Keys", "[", 
          RowBox[{"d", "[", "\"\<TimingsMs\>\"", "]"}], "]"}]}], ",", " ", 
        RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", "    ", 
        RowBox[{"FrameLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", "\"\<Time per Gradient Eval (ms)\>\""}], 
          "}"}]}], ",", " ", 
        RowBox[{
