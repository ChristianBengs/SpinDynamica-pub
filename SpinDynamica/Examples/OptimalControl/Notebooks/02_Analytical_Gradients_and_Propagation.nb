Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"d22efc3c-af2c-ac4c-ac00-b7b54740425f"],

Cell["\<\
Quasi-Newton optimisers such as Strong-Wolfe L-BFGS rely on exact directional \
derivatives: noisy finite-difference slopes or O(dt) first-order gradient \
approximations frequently stall near F > 0.999. SpinDynamica implements four \
closed-system Hilbert propagation/gradient kernels (Spectral, BlockMatrixExp, \
StateVector, FirstOrder) alongside exact Liouville block-exponential \
gradients, decoupling symbolic SpinDynamica setup from packed \
machine-precision linear algebra.\
\>", "Text",ExpressionUUID->"e67a6bd1-9ac3-ed47-bd2f-733827836a87"],

Cell["\<\
Understand exactly how FrequencyUnits and ControlUnits scale drift and RF \
operators (and when factors of 2*Pi apply).\
\>", "Item",ExpressionUUID->"56b32d9a-b3ff-bb4b-8870-d1f977ca828c"],

Cell["\<\
Inspect the exact Spectral Sinc Fr\[EAcute]chet kernel and test its stability \
at identically degenerate Hamiltonians (H_j = 0).\
\>", "Item",ExpressionUUID->"164961a5-4b66-d441-90e2-8d2ff01b207d"],

Cell["\<\
Verify Spectral, BlockMatrixExp, and StateVector gradients against central \
finite differences and contrast FirstOrder bias.\
\>", "Item",ExpressionUUID->"08ee029c-73f5-8b4a-b0c9-0e3966678642"],

Cell["\<\
Explore finite-difference truncation vs round-off errors interactively.\
\>", "Item",ExpressionUUID->"a969c89c-4739-9f4a-a79e-205d2fd15b46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"bba74816-5971-e94c-bd8f-8856a962e96b"],

Cell["\<\
In Hilbert space with FrequencyUnits scaling H_0 and ControlUnits scaling H_k \
into rad/s, each slice propagator U_j = Exp[-I dt_j (H_{0,j} + Sum_k u_{j,k} \
H_k)] is Hermitian-symmetrised and diagonalised: H_j = V_j Lambda_j V_j^dag. \
Using backward adjoint matrices X_{N_t} = C^dag and X_{j-1} = X_j U_j with \
A_j = F_{j-1} X_j, the exact partial derivative across all M channels \
simultaneously requires only ONE eigendecomposition per slice:\
\>", "Text",ExpressionUUID->"cf6c8e28-e0ea-e94a-ba02-ee7606a7a29f"],

Cell["\<\
Q_j = (V_j^dag A_j V_j) * Phi,   Phi_ab = Exp[-I (dt_j / 2)(lambda_a + \
lambda_b)] * Sinc[(dt_j / 2)(lambda_a - lambda_b)],   dPhi/du_{j,k} = dt_j * \
Im Tr[V_j Q_j V_j^dag H_k].\
\>", "Text",ExpressionUUID->"2f59aaba-bc6c-6849-a02a-4dc9e6716f71"],

Cell["\<\
Because Sinc[x] = Sin[x]/x evaluates smoothly to 1 at x = 0 without \
branching, degenerate eigenvalues produce zero division-by-zero instability. \
By contrast, FirstOrder approximates dU_j/du_{j,k} ~ -I dt_j H_k U_j, \
incurring O(dt_j ||u||) error.\
\>", "Text",ExpressionUUID->"5fbabb96-e082-8544-a877-051a6127581a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"b04774c4-a0b7-ef4a-8075-3dc8472d1d01"],

Cell["\<\
Below we verify mixed unit factors (FrequencyUnits -> \"Hz\", ControlUnits -> \
\"kHz\"), cross-check Spectral, BlockMatrixExp, StateVector, and FirstOrder \
kernels on a coupled two-spin state transfer, and test zero-Hamiltonian \
degeneracy stability.\
\>", "Text",ExpressionUUID->"622d84e7-a5a9-5d46-8254-e164090e7bd0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"1.", " ", "Unit", " ", "factor", " ", "check"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"compUnits", " ", "=", " ", 
    RowBox[{"CompileOptimalControlProblem", "[", "\n", "  ", 
     RowBox[{"OptimalControlProblem", "[", 
      RowBox[{
       RowBox[{"50.", " ", 
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"opI", "[", 
         RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}], " ", "->", " ", 
        RowBox[{"-", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}]}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{"0.01", ",", " ", "10"}], "}"}], ",", " ", 
       RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
       RowBox[{"ControlUnits", " ", "->", " ", "\"\<kHz\>\""}]}], "]"}], 
     "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2.", " ", "Kernel", " ", "cross"}], "-", 
    RowBox[{"checks", " ", "on", " ", "2"}], "-", 
    RowBox[{"spin", " ", "coupled", " ", "system"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"SetSpinSystem", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b2", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
  RowBox[{"ks2", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"uTest", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"10.", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"0.4", " ", "j"}], " ", "+", " ", "k"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "12"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mkProb", "[", "meth_", "]"}], " ", ":=", " ", 
   RowBox[{"OptimalControlProblem", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"15.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "-", " ", 
      RowBox[{"20.", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<z\>\""}], "]"}]}], " ", "+", " ", 
      RowBox[{"40.", " ", 
       RowBox[{
        RowBox[{"opI", "[", "1", "]"}], " ", ".", " ", 
        RowBox[{"opI", "[", "2", "]"}]}]}]}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"2", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks2", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks2", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.02", ",", " ", "12"}], "}"}], ",", " ", 
     RowBox[{"Method", " ", "->", " ", "meth"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eSpec", " ", "=", " ", 
   RowBox[{"EvaluateOptimalControl", "[", 
    RowBox[{
     RowBox[{"mkProb", "[", "\"\<Spectral\>\"", "]"}], ",", " ", "uTest"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eBlock", " ", "=", " ", 
   RowBox[{"EvaluateOptimalControl", "[", 
    RowBox[{
     RowBox[{"mkProb", "[", "\"\<BlockMatrixExp\>\"", "]"}], ",", " ", 
     "uTest"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"eSV", " ", "=", " ", 
   RowBox[{"EvaluateOptimalControl", "[", 
    RowBox[{
     RowBox[{"mkProb", "[", "\"\<StateVector\>\"", "]"}], ",", " ", "uTest"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eFirst", " ", "=", " ", 
    RowBox[{"EvaluateOptimalControl", "[", 
     RowBox[{
      RowBox[{"mkProb", "[", "\"\<FirstOrder\>\"", "]"}], ",", " ", "uTest"}],
      "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"3.", " ", "Degeneracy", " ", "test", " ", "at", " ", "H_j"}], 
    " ", "=", " ", "0"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"degChk", " ", "=", " ", 
    RowBox[{"VerifyOptimalControlGradient", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"OptimalControlProblem", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{"{", 
         RowBox[{"opI", "[", 
          RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], "}"}], ",", " ", 
        RowBox[{"StateTarget", "[", 
         RowBox[{
          RowBox[{"ks2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
          RowBox[{"ks2", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.01", ",", " ", "4"}], "}"}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", "0.", "}"}], ",", " ", "4"}], "]"}], ",", " ", 
      RowBox[{"StepSize", " ", "->", " ", 
       RowBox[{"10", "^", 
        RowBox[{"-", "5"}]}]}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<DriftUnitFactor_over_Pi\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"compUnits", "[", "\"\<DriftUnitFactor\>\"", "]"}], " ", "/", 
     " ", "Pi"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<ControlUnitFactor_over_Pi\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"compUnits", "[", "\"\<ControlUnitFactor\>\"", "]"}], " ", "/", 
     " ", "Pi"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<SpectralVsBlockGradErr\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"eSpec", "[", "\"\<Gradient\>\"", "]"}], " ", "-", " ", 
       RowBox[{"eBlock", "[", "\"\<Gradient\>\"", "]"}]}], "]"}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<SpectralVsSVGradErr\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"eSpec", "[", "\"\<Gradient\>\"", "]"}], " ", "-", " ", 
       RowBox[{"eSV", "[", "\"\<Gradient\>\"", "]"}]}], "]"}], "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<SpectralVsFirstOrderErr\>\"", " ", "->", " ", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"eSpec", "[", "\"\<Gradient\>\"", "]"}], " ", "-", " ", 
       RowBox[{"eFirst", "[", "\"\<Gradient\>\"", "]"}]}], "]"}], "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<ZeroHamDegeneracyPassed\>\"", " ", "->", " ", 
    RowBox[{"degChk", "[", "\"\<PassedQ\>\"", "]"}]}]}], "\n", 
  "|>"}]}], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"150517c1-f765-5d44-92a5-70aaa2ae21e2"],

