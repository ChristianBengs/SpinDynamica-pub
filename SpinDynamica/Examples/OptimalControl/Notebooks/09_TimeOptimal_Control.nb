      "]"}], "]"}]}], "\n", "]"}]], "Input",ExpressionUUID->"1107224c-5acf-\
fc46-9733-74498e550d5c"],

Cell["\<\
Lab 9B compares Mean, SoftMin, and strict worst-case Minimum feasibility \
criteria across a 1D broadband offset ensemble validated out-of-sample on a \
33-point grid:\
\>", "Text",ExpressionUUID->"7f4559c5-ab74-5749-9aae-7443c4457e1e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab9B", "[", 
     RowBox[{"crit_String", ",", " ", 
      RowBox[{"bwKHz_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"rfKHz_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b1", ",", " ", "ks1", ",", " ", "delta", ",", " ", "ensTrain", ",", 
        " ", "ensVal", ",", " ", "aggSpec", ",", " ", "res", ",", " ", 
        "valRes", ",", " ", "bestR", ",", " ", "valEval"}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
       RowBox[{"b1", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
       RowBox[{"ks1", " ", "=", " ", 
        RowBox[{"BasisKets", "[", "b1", "]"}]}], ";", "\n", "  ", 
       RowBox[{"aggSpec", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"crit", " ", "===", " ", "\"\<Mean\>\""}], ",", 
          " ", "\"\<Mean\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<SoftMin\>\"", ",", " ", "20."}], "}"}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"ensTrain", " ", "=", " ", 
        RowBox[{"OptimalControlEnsemble", "[", 
         RowBox[{
          RowBox[{"delta", " ", "*", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{
            RowBox[{"ks1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"ks1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.0005", ",", " ", "16"}], "}"}], ",", "\n", "    ", 
          RowBox[{"EnsembleParameters", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"delta", " ", "->", " ", 
             RowBox[{"Subdivide", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "1000."}], " ", "*", " ", 
                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
               RowBox[{"1000.", " ", "*", " ", 
                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", "8"}], "]"}]}], 
            "}"}]}], ",", "\n", "    ", 
          RowBox[{"EnsembleAggregation", " ", "->", " ", "aggSpec"}], ",", 
          " ", 
          RowBox[{"AmplitudeNormBound", " ", "->", " ", 
           RowBox[{"1000.", " ", "*", " ", 
            RowBox[{"N", "[", "rfKHz", "]"}]}]}], ",", "\n", "    ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"ensVal", " ", "=", " ", 
        RowBox[{"OptimalControlEnsemble", "[", 
         RowBox[{
          RowBox[{"delta", " ", "*", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
            RowBox[{"opI", "[", 
             RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", "\n", 
          "    ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{
            RowBox[{"ks1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"ks1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.0005", ",", " ", "16"}], "}"}], ",", "\n", "    ", 
          RowBox[{"EnsembleParameters", " ", "->", " ", 
           RowBox[{"{", 
            RowBox[{"delta", " ", "->", " ", 
             RowBox[{"Subdivide", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "1000."}], " ", "*", " ", 
                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
               RowBox[{"1000.", " ", "*", " ", 
                RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", "32"}], "]"}]}],
             "}"}]}], ",", "\n", "    ", 
          RowBox[{"AmplitudeNormBound", " ", "->", " ", 
           RowBox[{"1000.", " ", "*", " ", 
            RowBox[{"N", "[", "rfKHz", "]"}]}]}], ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"TimeOptimalControlOptimize", "[", 
         RowBox[{"ensTrain", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "\"\<Progressive\>\""}], ",", " ", 
          RowBox[{"FidelityCriterion", " ", "->", " ", "crit"}], ",", "\n", 
          "    ", 
          RowBox[{"TargetFidelity", " ", "->", " ", "0.99"}], ",", " ", 
          RowBox[{"MinimumDuration", " ", "->", " ", "0.0001"}], ",", " ", 
          RowBox[{"DurationTolerance", " ", "->", " ", "1.5*^-5"}], ",", "\n",
           "    ", 
          RowBox[{"MaxIterations", " ", "->", " ", "180"}], ",", " ", 
          RowBox[{"ValidationEnsemble", " ", "->", " ", "ensVal"}], ",", " ", 
          
          RowBox[{"RandomSeed", " ", "->", " ", "101"}]}], "]"}]}], ";", "\n",
        "  ", 
       RowBox[{"valRes", " ", "=", " ", 
        RowBox[{"res", "[", "\"\<ValidationResult\>\"", "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"bestR", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{
            RowBox[{"res", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], ",", 
            " ", "_OptimalControlResult"}], "]"}], ",", " ", 
          RowBox[{"res", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], ",", 
          " ", 
          RowBox[{"res", "[", "\"\<BestResult\>\"", "]"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"valEval", " ", "=", " ", 
        RowBox[{"EvaluateEnsembleFidelity", "[", "\n", "    ", 
         RowBox[{
          RowBox[{"OptimalControlEnsemble", "[", 
           RowBox[{
            RowBox[{"delta", " ", "*", " ", 
             RowBox[{"opI", "[", 
              RowBox[{"1", ",", " ", "\"\<z\>\""}], "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], ",", " ", 
              RowBox[{"opI", "[", 
               RowBox[{"1", ",", " ", "\"\<y\>\""}], "]"}]}], "}"}], ",", 
            "\n", "      ", 
            RowBox[{"StateTarget", "[", 
             RowBox[{
              RowBox[{"ks1", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
              RowBox[{"ks1", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
            RowBox[{"bestR", "[", "\"\<TimeSteps\>\"", "]"}], ",", "\n", 
            "      ", 
            RowBox[{"EnsembleParameters", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{"delta", " ", "->", " ", 
               RowBox[{"Subdivide", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "1000."}], " ", "*", " ", 
                  RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", 
                 RowBox[{"1000.", " ", "*", " ", 
                  RowBox[{"N", "[", "bwKHz", "]"}]}], ",", " ", "32"}], 
                "]"}]}], "}"}]}], ",", "\n", "      ", 
            RowBox[{"AmplitudeNormBound", " ", "->", " ", 
             RowBox[{"1000.", " ", "*", " ", 
              RowBox[{"N", "[", "rfKHz", "]"}]}]}], ",", " ", 
            RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", 
            " ", 
            RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}], ",",
           "\n", "    ", 
          RowBox[{"bestR", "[", "\"\<Controls\>\"", "]"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "res"}], ",", " ", 
         RowBox[{"\"\<ValRes\>\"", " ", "->", " ", "valRes"}], ",", " ", 
         RowBox[{"\"\<ValEval\>\"", " ", "->", " ", "valEval"}], ",", " ", 
         RowBox[{"\"\<Best\>\"", " ", "->", " ", "bestR"}], ",", " ", 
         RowBox[{"\"\<Crit\>\"", " ", "->", " ", "crit"}], ",", " ", 
         RowBox[{"\"\<BWKHz\>\"", " ", "->", " ", "bwKHz"}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLab9B", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"res", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<Result\>\"", "]"}]}], ",", " ", 
        RowBox[{"vr", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<ValRes\>\"", "]"}]}], ",", " ", 
        RowBox[{"ve", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<ValEval\>\"", "]"}]}], ",", " ", "pts"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"pts", " ", "=", " ", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"N", "[", 
            RowBox[{"d", "[", "\"\<BWKHz\>\"", "]"}], "]"}]}], ",", " ", 
          RowBox[{"N", "[", 
           RowBox[{"d", "[", "\"\<BWKHz\>\"", "]"}], "]"}], ",", " ", "32"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"Column", "[", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{
          RowBox[{"Panel", "[", 
           RowBox[{"Row", "[", 
            RowBox[{"{", "\n", "      ", 
             RowBox[{"\"\<Criterion: \>\"", ",", " ", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"d", "[", "\"\<Crit\>\"", "]"}], ",", " ", "Bold"}], 
               "]"}], ",", "\n", "      ", "\"\<   T* = \>\"", ",", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"NumericQ", "[", 
                 RowBox[{
                 "res", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}], "]"}],
                 ",", " ", 
                RowBox[{
                 RowBox[{"ToString", "[", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{
                    RowBox[{"1000.", " ", "*", " ", 
                    RowBox[{
                    "res", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}]}], ",",
                     " ", "5"}], "]"}], "]"}], " ", "<>", 
                 " ", "\"\< ms\>\""}], ",", " ", "\"\<None\>\""}], "]"}], ",",
               "\n", "      ", "\"\<   Train Min = \>\"", ",", " ", 
              RowBox[{"NumberForm", "[", 
               RowBox[{
                RowBox[{"res", "[", "\"\<MinFidelity\>\"", "]"}], ",", " ", 
                "5"}], "]"}], ",", "\n", "      ", "\"\<   Val(33) Min = \>\"",
               ",", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"AssociationQ", "[", "vr", "]"}], ",", " ", 
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"vr", "[", "\"\<MinFidelity\>\"", "]"}], ",", " ", 
                   "5"}], "]"}], "]"}], ",", " ", "\"\<N/A\>\""}], "]"}]}], 
             "\n", "    ", "}"}], "]"}], "]"}], ",", "\n", "    ", 
          RowBox[{"Row", "[", 
           RowBox[{"{", "\n", "      ", 
            RowBox[{
             RowBox[{"PlotOptimalControlWaveform", "[", 
              RowBox[{
               RowBox[{"d", "[", "\"\<Best\>\"", "]"}], ",", " ", 
               RowBox[{"ImageSize", " ", "->", " ", "330"}]}], "]"}], ",", 
             "\n", "      ", 
             RowBox[{"ListLinePlot", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{"pts", ",", " ", 
                  RowBox[{"ve", "[", "\"\<MemberFidelities\>\"", "]"}]}], 
                 "}"}], "]"}], ",", " ", 
               RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", 
               "        ", 
               RowBox[{"FrameLabel", " ", "->", " ", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Offset (kHz)\>\"", ",", 
                  " ", "\"\<Validation Fidelity\>\""}], "}"}]}], ",", " ", 
               RowBox[{"PlotRange", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"0.9", ",", " ", "1.01"}], "}"}]}], ",", "\n", 
               "        ", 
               RowBox[{"GridLines", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{"None", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"{", 
                    RowBox[{"0.99", ",", " ", "Dashed"}], "}"}], "}"}]}], 
                 "}"}]}], ",", " ", 
               RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "\n", 
            "    ", "}"}], "]"}]}], "\n", "  ", "}"}], "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"lab9BDefault", " ", "=", " ", 
   RowBox[{"runLab9B", "[", 
    RowBox[{"\"\<Minimum\>\"", ",", " ", "2.", ",", " ", "5."}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
