Notebook[{
Cell["09. Time-Optimal Control and Pontryagin Diagnostics", "Title",ExpressionUUID->"f5c298ad-e8da-cb4d-b4d2-18bd2786394a"],

Cell["\<\
Quantum speed limits, numerical Time-Optimal Pulse (TOP) curves, joint \
control-and-duration Augmented Lagrangian solvers, robust ensemble duration \
trade-offs, and sub-slice Pontryagin Maximum Principle switching-function \
diagnostics.\
\>", "Subtitle",ExpressionUUID->"829b8f6c-b6fd-a048-8874-0db3afd87b6f"],

Cell[CellGroupData[{

Cell["0. Setup and Loading SpinDynamica", "Section",ExpressionUUID->"1dc47474-2c37-ac44-b99c-dff8d49785e5"],

Cell["\<\
Add the SpinDynamica package directory to $Path by searching upward from the \
notebook directory and load SpinDynamica`. All six OptimalControl` \
subpackages load automatically. Reuses \
Examples/OptimalControl/Example6_TimeOptimalControl.wls and \
Example7_RobustTimeOptimalEnsemble.wls (Manual Chapter 32).\
\>", "Text",ExpressionUUID->"11c81df6-d79d-7648-9dfd-a82f5af092ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
              " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", "\n",
           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$Path", ",", " ", "found"}], "]"}]}], "]"}], ";"}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   " ", 
   RowBox[{"\"\<OptimalControlContexts\>\"", " ", "->", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"$Packages", ",", " ", 
      RowBox[{
       RowBox[{"StringStartsQ", "[", 
        RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", 
       "&"}]}], "]"}]}]}], "|>"}]}], "Input",ExpressionUUID->"56268d60-8e45-\
804f-a844-1dba89e42ab4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",ExpressionUUID->"077fdc07-7638-e04f-b90c-c1218a60fc27"],

Cell["\<\
In magnetic resonance experiments limited by T1/T2 relaxation or RF probe \
heating, finding the shortest pulse duration that reaches a required fidelity \
threshold is often critical. OptimalControl`TimeOptimal` automates this \
search on top of SpinDynamica's fast GRAPE kernels and analytical duration \
derivatives.\
\>", "Text",ExpressionUUID->"11075449-487a-164c-9c28-2420c35da825"],

Cell["\<\
Map numerical Time-Optimal Pulse (TOP) curves F*(T) and locate the shortest \
numerically feasible duration with Progressive, Joint, JointPenalized, and \
Hybrid strategies.\
\>", "Item",ExpressionUUID->"a81cff9a-de3a-7148-87a7-479f1a58917c"],

Cell["\<\
Benchmark numerical speed limits against exact analytical bounds T_min(F) = \
ArcSin[Sqrt[F]] / (Pi nu_max).\
\>", "Item",ExpressionUUID->"2c5cc94b-44a5-314f-a30b-b5f3d11946b9"],

Cell["\<\
Explore the cost of robustness on 1D broadband inversion ensembles under \
Mean, SoftMin, and worst-case Minimum criteria with out-of-sample \
ValidationEnsemble verification.\
\>", "Item",ExpressionUUID->"aa968546-78e7-8e47-9080-2cf53250f98d"],

Cell["\<\
Inspect continuous sub-slice Pontryagin Maximum Principle (PMP) switching \
functions s_k(t) via VerifyOptimalControlStationarity and \
PlotSwitchingFunctions.\
\>", "Item",ExpressionUUID->"533f06ed-b19f-5a41-862b-e1128904115c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Mathematical Background", "Section",ExpressionUUID->"00d6bd7f-b3b9-1147-963e-ae6f091f0605"],

Cell["\<\
Given admissible controls u in U, define F*(T) = max_u F(u, T). \
TimeOptimalControlOptimize seeks T* = inf {T > 0 : F*(T) >= F_target}. Method \
-> \"Progressive\" brackets T* via geometric contraction and safeguarded \
bisection with NormalizedTime or AreaPreserving warm starts. Method -> \
\"Joint\" uses exact chain-rule duration sensitivities (OptimizeDurations -> \
\"Total\") inside a single-run C1 Augmented Lagrangian maximisation of \
-T/T_ref - P_smooth - (max(0, mu - rho(F - F_target))^2 - mu^2)/(2 rho).\
\>", "Text",ExpressionUUID->"a24f714e-1b48-6849-a5b7-73961993c962"],

Cell["\<\
At fixed T, VerifyOptimalControlStationarity evaluates continuous switching \
functions s_k(t) across StationaritySubdivisions per slice and measures \
complementarity residuals. Explicit scope note: numerical convergence or \
small PMP residuals verify local first-order constrained stationarity within \
the chosen slice grid and restart budget, not mathematical proof of global or \
physical time optimality.\
\>", "Text",ExpressionUUID->"c7a6b205-016d-104e-a5dc-09e4fd81e455"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Worked Example", "Section",ExpressionUUID->"d58ec96a-9515-d14c-bd53-1335afd4bef6"],

Cell["\<\
Solve on-resonance spin-1/2 state inversion (|nu_x| <= 500 Hz, F_target = \
0.999, exact analytical speed limit 0.979865 ms) with Method -> \"Hybrid\", \
scan the TOP curve across [0.65 .. 1.40] ms, and run PMP switching-function \
verification:\
\>", "Text",ExpressionUUID->"094fb9e4-ff64-7f4f-adea-ded222143831"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b1", " ", "=", " ", 
   RowBox[{"ZeemanBasis", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ks1", " ", "=", " ", 
   RowBox[{"BasisKets", "[", "b1", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pInv", " ", "=", " ", 
   RowBox[{"OptimalControlProblem", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"{", 
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], "}"}], ",", " ", 
     RowBox[{"StateTarget", "[", 
      RowBox[{
       RowBox[{"ks1", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
       RowBox[{"ks1", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.002", ",", " ", "20"}], "}"}], ",", "\n", "  ", 
     RowBox[{"AmplitudeBound", " ", "->", " ", "500."}], ",", " ", 
     RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
     RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"tExactMs", " ", "=", " ", 
   RowBox[{"1000.", " ", "*", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"ArcSin", "[", 
       RowBox[{"Sqrt", "[", "0.999", "]"}], "]"}], " ", "/", " ", 
      RowBox[{"(", 
       RowBox[{"Pi", " ", "*", " ", "500."}], ")"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"resHyb", " ", "=", " ", 
   RowBox[{"TimeOptimalControlOptimize", "[", 
    RowBox[{"pInv", ",", " ", 
     RowBox[{"Method", " ", "->", " ", "\"\<Hybrid\>\""}], ",", " ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", "\n", "  ", 
     RowBox[{"DurationTolerance", " ", "->", " ", "2.*^-6"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"curveInv", " ", "=", " ", 
   RowBox[{"TimeOptimalPulseCurve", "[", 
    RowBox[{"pInv", ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "0.00065", ",", " ", "0.00080", ",", " ", "0.00090", ",", " ", 
       "0.00095", ",", " ", "0.000985", ",", " ", "0.00105", ",", " ", 
       "0.00140"}], "}"}], ",", "\n", "  ", 
     RowBox[{"TargetFidelity", " ", "->", " ", "0.999"}], ",", " ", 
     RowBox[{"RandomSeed", " ", "->", " ", "31"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diagInv", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlStationarity", "[", 
    RowBox[{
     RowBox[{"resHyb", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], ",", " ", 
     RowBox[{"StationaritySubdivisions", " ", "->", " ", "8"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"simInv", " ", "=", " ", 
   RowBox[{"VerifyOptimalControlSimulation", "[", 
    RowBox[{"resHyb", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<AnalyticalLimitMs\>\"", " ", "->", " ", "tExactMs"}], ",", 
   " ", 
   RowBox[{"\"\<HybridTStarMs\>\"", " ", "->", " ", 
    RowBox[{"1000.", " ", "*", " ", 
     RowBox[{"resHyb", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}]}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<AchievedFidelity\>\"", " ", "->", " ", 
    RowBox[{"resHyb", "[", "\"\<AchievedFidelity\>\"", "]"}]}], ",", " ", 
   RowBox[{"\"\<SDMatch\>\"", " ", "->", " ", 
    RowBox[{"simInv", "[", "\"\<FidelityMatchQ\>\"", "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<PMP_QuadErr\>\"", " ", "->", " ", 
    RowBox[{"diagInv", "[", "\"\<QuadratureGradientError\>\"", "]"}]}], ",", 
   " ", 
   RowBox[{"\"\<PMP_RelInt\>\"", " ", "->", " ", 
    RowBox[{"diagInv", "[", "\"\<RelativeIntegratedResidual\>\"", "]"}]}], ",",
    "\n", "  ", 
   RowBox[{"\"\<PMP_SatQ\>\"", " ", "->", " ", 
    RowBox[{"diagInv", "[", "\"\<StationaritySatisfiedQ\>\"", "]"}]}]}], 
  "|>"}]}], "Input",ExpressionUUID->"d53330c3-9cce-9c48-9439-531e359fd160"],

Cell["\<\
Visualise the log-infidelity TOP curve alongside the 3-panel Pontryagin \
switching-function diagnostic:\
\>", "Text",ExpressionUUID->"6f2cffdb-80d4-8844-9efd-2c7b6e57e532"],

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"PlotTimeOptimalPulseCurve", "[", 
     RowBox[{"curveInv", ",", " ", 
      RowBox[{"Method", " ", "->", " ", "\"\<Infidelity\>\""}], ",", " ", 
