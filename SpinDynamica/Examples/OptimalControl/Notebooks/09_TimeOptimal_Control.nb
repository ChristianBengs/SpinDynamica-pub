ssionUUID->"e7520dac-4ce0-6148-9b86-1cf1494342e4"],

Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"meth", " ", "=", " ", "\"\<Hybrid\>\""}], ",", " ", 
     RowBox[{"fTar", " ", "=", " ", "0.999"}], ",", " ", 
     RowBox[{"ampHz", " ", "=", " ", "500."}], ",", " ", 
     RowBox[{"data", " ", "=", " ", "lab9ADefault"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"Panel", "[", 
    RowBox[{"Column", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Search Method\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "meth", "]"}], ",", " ", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Progressive\>\"", ",", " ", "\"\<Joint\>\"", ",",
                  " ", "\"\<Hybrid\>\""}], "}"}]}], "]"}]}], "}"}], ",", "\n",
            "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<Target Fidelity\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "fTar", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"0.99", ",", " ", "0.999", ",", " ", "0.9999"}], 
                "}"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"{", 
            RowBox[{"\"\<RF Amplitude Bound (Hz)\>\"", ",", " ", 
             RowBox[{"SetterBar", "[", 
              RowBox[{
               RowBox[{"Dynamic", "[", "ampHz", "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"300.", ",", " ", "500.", ",", " ", "800."}], "}"}]}],
               "]"}]}], "}"}]}], "\n", "    ", "}"}], ",", " ", 
         RowBox[{"Alignment", " ", "->", " ", "Left"}]}], "]"}], ",", "\n", 
       "    ", 
       RowBox[{"Button", "[", 
        RowBox[{"\"\<Run Time-Optimal Search\>\"", ",", " ", 
         RowBox[{"data", " ", "=", " ", 
          RowBox[{"runLab9A", "[", 
           RowBox[{"meth", ",", " ", "fTar", ",", " ", "ampHz"}], "]"}]}], ",",
          " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Queued\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"Dynamic", "[", 
