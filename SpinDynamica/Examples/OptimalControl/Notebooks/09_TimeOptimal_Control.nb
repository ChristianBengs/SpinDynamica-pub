}, Open  ]],

Cell[CellGroupData[{

Cell["Interactive Exploration", "Section",ExpressionUUID->"3a018b16-66b6-a046-a789-1e479c745ff4"],

Cell["\<\
Lab 9A compares search strategies (Progressive, Joint AL, Hybrid), target \
fidelity, and peak RF amplitude on single-spin inversion, reporting \
speed-limit gap and live PMP switching diagnostics on demand via queued \
evaluation.\
\>", "Text",ExpressionUUID->"6e2c1a28-bef2-6f4d-b7b8-fef839a8f70b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"runLab9A", "[", 
     RowBox[{"method_String", ",", " ", 
      RowBox[{"targetFid_", "?", "NumericQ"}], ",", " ", 
      RowBox[{"ampBoundHz_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "b1", ",", " ", "ks1", ",", " ", "prob", ",", " ", "res", ",", " ", 
        "sim", ",", " ", "bestR", ",", " ", "stat", ",", " ", "tExact"}], 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"SetSpinSystem", "[", "1", "]"}], ";", " ", 
       RowBox[{"b1", " ", "=", " ", 
        RowBox[{"ZeemanBasis", "[", "]"}]}], ";", " ", 
       RowBox[{"ks1", " ", "=", " ", 
        RowBox[{"BasisKets", "[", "b1", "]"}]}], ";", "\n", "  ", 
       RowBox[{"prob", " ", "=", " ", 
        RowBox[{"OptimalControlProblem", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{"opI", "[", 
            RowBox[{"1", ",", " ", "\"\<x\>\""}], "]"}], "}"}], ",", " ", 
          RowBox[{"StateTarget", "[", 
           RowBox[{
            RowBox[{"ks1", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "->", " ", 
            RowBox[{"ks1", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"0.0025", ",", " ", "20"}], "}"}], ",", "\n", "    ", 
          RowBox[{"AmplitudeBound", " ", "->", " ", 
           RowBox[{"N", "[", "ampBoundHz", "]"}]}], ",", " ", 
          RowBox[{"FrequencyUnits", " ", "->", " ", "\"\<Hz\>\""}], ",", " ", 
          
          RowBox[{"ControlUnits", " ", "->", " ", "\"\<Hz\>\""}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"res", " ", "=", " ", 
        RowBox[{"TimeOptimalControlOptimize", "[", 
         RowBox[{"prob", ",", " ", 
          RowBox[{"Method", " ", "->", " ", "method"}], ",", " ", 
          RowBox[{"TargetFidelity", " ", "->", " ", 
           RowBox[{"N", "[", "targetFid", "]"}]}], ",", "\n", "    ", 
          RowBox[{"DurationTolerance", " ", "->", " ", "2.*^-6"}], ",", " ", 
          RowBox[{"RandomSeed", " ", "->", " ", "11"}]}], "]"}]}], ";", "\n", 
       "  ", 
       RowBox[{"bestR", " ", "=", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{
            RowBox[{"res", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], ",", 
            " ", "_OptimalControlResult"}], "]"}], ",", " ", 
          RowBox[{"res", "[", "\"\<ShortestFeasibleResult\>\"", "]"}], ",", 
          " ", 
          RowBox[{"res", "[", "\"\<BestResult\>\"", "]"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"sim", " ", "=", " ", 
        RowBox[{"VerifyOptimalControlSimulation", "[", "bestR", "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"stat", " ", "=", " ", 
        RowBox[{"VerifyOptimalControlStationarity", "[", 
         RowBox[{"bestR", ",", " ", 
          RowBox[{"StationaritySubdivisions", " ", "->", " ", "8"}]}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"tExact", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"ArcSin", "[", 
           RowBox[{"Sqrt", "[", "targetFid", "]"}], "]"}], " ", "/", " ", 
          RowBox[{"(", 
           RowBox[{"Pi", " ", "*", " ", "ampBoundHz"}], ")"}]}], "]"}]}], ";",
        "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Result\>\"", " ", "->", " ", "res"}], ",", " ", 
         RowBox[{"\"\<Stat\>\"", " ", "->", " ", "stat"}], ",", " ", 
         RowBox[{"\"\<Sim\>\"", " ", "->", " ", "sim"}], ",", " ", 
         RowBox[{"\"\<ExactMs\>\"", " ", "->", " ", 
          RowBox[{"1000.", " ", "*", " ", "tExact"}]}], ",", " ", 
         RowBox[{"\"\<Method\>\"", " ", "->", " ", "method"}], ",", " ", 
         RowBox[{"\"\<Target\>\"", " ", "->", " ", "targetFid"}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"renderLab9A", "[", "d_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"res", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<Result\>\"", "]"}]}], ",", " ", 
        RowBox[{"st", " ", "=", " ", 
         RowBox[{"d", "[", "\"\<Stat\>\"", "]"}]}]}], "}"}], ",", "\n", "  ", 
      
      RowBox[{"Column", "[", 
       RowBox[{"{", "\n", "    ", 
        RowBox[{
         RowBox[{"Panel", "[", 
          RowBox[{"Row", "[", 
           RowBox[{"{", "\n", "      ", 
            RowBox[{"\"\<Method: \>\"", ",", " ", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"d", "[", "\"\<Method\>\"", "]"}], ",", " ", "Bold"}], 
              "]"}], ",", "\n", "      ", "\"\<   Exact Limit = \>\"", ",", 
             " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"d", "[", "\"\<ExactMs\>\"", "]"}], ",", " ", "5"}], 
              "]"}], ",", " ", "\"\< ms\>\"", ",", "\n", 
             "      ", "\"\<   T* = \>\"", ",", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"NumericQ", "[", 
                RowBox[{"res", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}],
                 "]"}], ",", " ", 
               RowBox[{
                RowBox[{"ToString", "[", 
                 RowBox[{"NumberForm", "[", 
                  RowBox[{
                   RowBox[{"1000.", " ", "*", " ", 
                    RowBox[{
                    "res", "[", "\"\<ShortestFeasibleDuration\>\"", "]"}]}], ",",
                    " ", "5"}], "]"}], "]"}], " ", "<>", " ", "\"\< ms\>\""}],
                ",", " ", "\"\<None\>\""}], "]"}], ",", "\n", 
             "      ", "\"\<   F = \>\"", ",", " ", 
             RowBox[{"NumberForm", "[", 
              RowBox[{
               RowBox[{"res", "[", "\"\<AchievedFidelity\>\"", "]"}], ",", 
               " ", "6"}], "]"}], ",", "\n", 
             "      ", "\"\<   PMP SatQ = \>\"", ",", " ", 
             RowBox[{"st", "[", "\"\<StationaritySatisfiedQ\>\"", "]"}], ",", 
             "\n", "      ", "\"\<   SDMatch = \>\"", ",", " ", 
             RowBox[{
              RowBox[{"d", "[", "\"\<Sim\>\"", "]"}], 
              "[", "\"\<FidelityMatchQ\>\"", "]"}]}], "\n", "    ", "}"}], 
           "]"}], "]"}], ",", "\n", "    ", 
         RowBox[{"Row", "[", 
          RowBox[{"{", "\n", "      ", 
           RowBox[{
            RowBox[{"PlotTimeOptimalPulseCurve", "[", 
             RowBox[{"res", ",", " ", 
              RowBox[{"Method", " ", "->", " ", "\"\<ShortestFeasible\>\""}], 
              ",", " ", 
              RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}], ",", 
            "\n", "      ", 
            RowBox[{"PlotSwitchingFunctions", "[", 
             RowBox[{"st", ",", " ", 
              RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "\n", 
           "    ", "}"}], "]"}]}], "\n", "  ", "}"}], "]"}]}], "\n", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"lab9ADefault", " ", "=", " ", 
   RowBox[{"runLab9A", "[", 
    RowBox[{"\"\<Hybrid\>\"", ",", " ", "0.999", ",", " ", "500."}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<TStarMs\>\"", " ", "->", " ", 
    RowBox[{"1000.", " ", "*", " ", 
     RowBox[{
      RowBox[{"lab9ADefault", "[", "\"\<Result\>\"", "]"}], 
