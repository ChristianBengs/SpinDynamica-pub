Cell[BoxData[
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"crit", " ", "=", " ", "\"\<Minimum\>\""}], ",", " ", 
     RowBox[{"bw", " ", "=", " ", "2."}], ",", " ", 
