Notebook[{
Cell["\<\
SpinDynamica Optimal Control \[LongDash] Interactive Notebook Tutorials\
\>", "Title",ExpressionUUID->"d94ab3d4-7a1c-a343-91cd-9ef95433d0b4"],

Cell["\<\
Interactive, exploratory Mathematica tutorials adapting the validated \
SpinDynamica Optimal Control tutorial scripts and manual into hands-on NMR \
spin-control laboratories.\
\>", "Subtitle",ExpressionUUID->"9b9c79f9-9423-4142-825f-fd940f1ab036"],

Cell[CellGroupData[{

Cell["Welcome and Notebook Philosophy", "Section",ExpressionUUID->"53081ff2-21f4-5047-a090-c4660de447f9"],

Cell["\<\
This notebook collection complements the comprehensive SpinDynamica Optimal \
Control Markdown Manual, API Reference, and executable .wls tutorial suite \
under Examples/OptimalControl/Tutorials/. Every notebook is completely \
self-contained, loads SpinDynamica cleanly in a fresh kernel, presents a \
validated worked example from the reference tutorials, and provides \
interactive DynamicModule / Manipulate controls for exploring physical and \
numerical trade-offs.\
\>", "Text",ExpressionUUID->"8ec98f21-1a44-d640-a890-66e286a163a6"],

Cell["\<\
Safety against expensive recomputation: whenever an interactive control \
adjusts parameters of a GRAPE optimisation (duration, offset grid, RF \
ceiling, constraint weights, MAS rotor phases), changes take effect only when \
you click the explicit 'Run ...' button (using Method -> \"Queued\" to avoid \
FrontEnd timeouts). Light-weight visualisations, trajectory scrubbers, basis \
spectra, quadrature-error scans, and hardware-export previews update \
instantaneously.\
\>", "Text",ExpressionUUID->"dc04bc39-1c49-8e4b-bb77-cff64595d2ba"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Environment Verification", "Section",ExpressionUUID->"486fc542-9ae6-0841-b743-7b8f2c1eff54"],

Cell["\<\
Evaluate the setup cell below to verify that Mathematica resolves the \
intended SpinDynamica build and loads all six OptimalControl` contexts \
(Kernels, Objectives, GRAPE, Ensemble, TimeOptimal, Visualization).\
\>", "Text",ExpressionUUID->"a61a009c-0afe-a746-8cb9-f784cb8ebff6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dir", " ", "=", " ", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", 
          RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ",", " ", 
      RowBox[{"found", " ", "=", " ", "None"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FileExistsQ", "[", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "dir", ",", " ", "\"\<SpinDynamica\>\"", ",", 
              " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}], ",", "\n",
           "      ", 
          RowBox[{
           RowBox[{"found", " ", "=", " ", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", " ", "\"\<SpinDynamica\>\""}], "}"}], 
             "]"}]}], ";", " ", 
           RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"dir", " ", "=", " ", 
         RowBox[{"ParentDirectory", "[", "dir", "]"}]}]}], ",", " ", 
       RowBox[{"{", "6", "}"}]}], "]"}], ";", "\n", "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"found", " ", "===", " ", "None"}], " ", "&&", " ", 
        RowBox[{"FileExistsQ", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directory", "[", "]"}], ",", " ", "\"\<SpinDynamica\>\"",
             ",", " ", "\"\<SpinDynamica.m\>\""}], "}"}], "]"}], "]"}]}], ",",
        "\n", "    ", 
       RowBox[{"found", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directory", "[", "]"}], ",", 
           " ", "\"\<SpinDynamica\>\""}], "}"}], "]"}]}]}], "]"}], ";", "\n", 
     "  ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "found", "]"}], " ", "&&", " ", 
        RowBox[{"!", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"$Path", ",", " ", "found"}], "]"}]}]}], ",", " ", 
       RowBox[{"PrependTo", "[", 
        RowBox[{"$Path", ",", " ", "found"}], "]"}]}], "]"}], ";"}]}], "\n", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<SpinDynamica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"<|", "\n", "  ", 
  RowBox[{
   RowBox[{"\"\<SpinDynamicaFile\>\"", " ", "->", " ", 
    RowBox[{"FindFile", "[", "\"\<SpinDynamica`\>\"", "]"}]}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Version\>\"", " ", "->", " ", "$SpinDynamicaVersion"}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<OptimalControlPackages\>\"", " ", "->", " ", 
    RowBox[{"Select", "[", 
     RowBox[{"$Packages", ",", " ", 
      RowBox[{
       RowBox[{"StringStartsQ", "[", 
        RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", 
       "&"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<ExportedSymbolCount\>\"", " ", "->", " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"Names", "[", 
         RowBox[{"#", " ", "<>", " ", "\"\<*\>\""}], "]"}], "]"}], " ", "&"}],
       " ", "/@", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"$Packages", ",", " ", 
        RowBox[{
         RowBox[{"StringStartsQ", "[", 
          RowBox[{"#", ",", " ", "\"\<OptimalControl`\>\""}], "]"}], " ", 
         "&"}]}], "]"}]}], "]"}]}]}], "\n", "|>"}]}], "Input",ExpressionUUID->\
