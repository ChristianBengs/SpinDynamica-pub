}, Open  ]],

Cell[CellGroupData[{

Cell["Tutorial Notebooks Index (Click Any Link to Open)", "Section",ExpressionUUID->"8877132a-2aba-4e4a-9eff-ffcc614fc190"],

Cell[TextData[{
 StyleBox[ButtonBox["01. GRAPE Foundations and Single-Spin Rotations",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "01_GRAPE_and_SingleSpin_Rotations.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] State inversion vs universal 90-degree gates, Bloch \
trajectories, and interactive pulse-duration/amplitude/offset trade-offs. ",
 StyleBox["(Reuses Tutorial01, Tutorial02; Manual Ch. 1, 3, 14)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"417debd1-1860-0c46-8a6e-488ae26781d0"],

Cell[TextData[{
 StyleBox[ButtonBox["02. Analytical Gradients and Numerical Propagation",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "02_Analytical_Gradients_and_Propagation.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] FrequencyUnits/ControlUnits scaling, Spectral Sinc \
Fr\[EAcute]chet vs BlockMatrixExp/StateVector/FirstOrder kernels, degeneracy \
stability, and finite-difference verification. ",
 StyleBox["(Reuses Tutorial01; Manual Ch. 4\[Dash]7, 22)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"cabf5ff0-0dcf-9d40-9715-67734461b210"],

Cell[TextData[{
 StyleBox[ButtonBox["03. NMR Polarisation and Coherence Transfer",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "03_Polarisation_and_Coherence_Transfer.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] Heteronuclear I1z -> I2z, INEPT I1x -> 2 I1y I2z, \
TransformationAmplitude equivalence, ZQ -> DQ non-Hermitian coherence \
transfer, and open-system Liouville relaxation. ",
 StyleBox["(Reuses Tutorial03, Tutorial04; Manual Ch. 8, 15)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"41030601-1dff-c842-8a7b-b2d33b81aa8c"],

Cell[TextData[{
 StyleBox[ButtonBox["04. Cooperative Control and Advanced NMR Targets",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "04_Cooperative_and_Advanced_Targets.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] Weighted CooperativeObjective, heterogeneous N=1+N=2 \
co-design, RunningCost/StatePenalty forbidden-state suppression, \
SubspaceUnitaryTarget, Virtual-Z PhaseFreedom, and OptimizeDurations. ",
 StyleBox["(Reuses Tutorial05, Tutorial10; Manual Ch. 16, 19)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"16dde461-82f0-0440-8b64-0c248bac5cb5"],

Cell[TextData[{
 StyleBox[ButtonBox["05. Robust Ensemble Optimisation",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "05_Robust_Ensemble_Optimisation.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] Broadband inversion, grid-aliasing vs Nyquist spacing (1/T), \
Mean vs SoftMin aggregation, 2D offset x RF inhomogeneity, continuation \
schedules, and out-of-sample evaluation. ",
 StyleBox["(Reuses Tutorial06, Tutorial07; Manual Ch. 13, 17)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"8ed41b32-29b0-7241-8a61-994a1cc00926"],

Cell[TextData[{
 StyleBox[ButtonBox["06. Optimisers, Constraints and Regularisation",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], 
      "06_Optimisers_Constraints_and_Regularisation.nb"}]]], "Hyperlink"],
 " \[LongDash] LBFGS/BFGS/CG/SteepestAscent/FISTA, Strong-Wolfe vs Armijo, \
Cartesian box vs polar disk AmplitudeNormBound, SlewRateBound, L1+TV \
sparsity, and Bruker/SIMPSON/CSV export. ",
 StyleBox["(Reuses Tutorial02, Tutorial08; Manual Ch. 10, 12, 23)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"fa9df660-3c2b-ea49-a350-49fbdbf72f14"],

Cell[TextData[{
 StyleBox[ButtonBox["07. Waveform Parameterisations and Window Envelopes",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "07_Waveform_Parameterisations.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] PiecewiseConstant, Fourier, FourierSine, Chebyshev, B-Splines, \
Hann/Hamming/Blackman windows, singular-value spectra, and Q-space \
constrained ADMM. ",
 StyleBox["(Reuses Tutorial02, Tutorial08; Manual Ch. 11)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"7a21d293-510d-5d43-9319-eb0f37c825cf"],

Cell[TextData[{
 StyleBox[ButtonBox["08. Time-Dependent Hamiltonians and MAS Optimal Control",
  
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "08_TimeDependent_and_MAS_OptimalControl.nb"}]]], 
  "Hyperlink"],
 " \[LongDash] PeriodicFunction MAS drifts, Midpoint vs CF4/SubSlices \
convergence, CF4 gradients, rotor-phase-invariant dipolar recoupling, and \
post-pulse Signal1D COMPUTE verification. ",
 StyleBox["(Reuses Tutorial09; Manual Ch. 18)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"af663cb2-3be0-264f-b1b5-c42c176e1d52"],

Cell[TextData[{
 StyleBox[ButtonBox["09. Time-Optimal Control and Pontryagin Diagnostics",
  BaseStyle->"Hyperlink",
  Evaluator->Automatic,
  Method->"Preemptive",
  ButtonFunction:>NotebookOpen[
    FileNameJoin[{
      NotebookDirectory[], "09_TimeOptimal_Control.nb"}]]], "Hyperlink"],
 " \[LongDash] Analytical quantum speed limits, TOP curves, Progressive vs \
Joint/Hybrid searches, robust ensemble duration trade-offs, and continuous \
sub-slice Pontryagin switching-function diagnostics. ",
 StyleBox["(Reuses Examples 6\[Dash]7; Manual Ch. 32)",
  FontSlant->"Italic"]
}], "Item",ExpressionUUID->"a37f74d9-d622-2a47-a2f1-b5de8d23aeca"]
}, Open  ]],

