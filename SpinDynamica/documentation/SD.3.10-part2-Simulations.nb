Cell[CellGroupData[{

Cell["EnsembleAverage", "Subsubsection",
 CellChangeTimes->{{3.544595756798325*^9, 3.544595769301099*^9}, {
  3.574262905860809*^9, 
  3.574262910963329*^9}},ExpressionUUID->"9a9bec3e-03f6-4917-a731-\
bc8914935a43"],

Cell["\<\
EnsembleAverage may be used together with TransformationAmplitudeTable. The \
following example plots the offset dependence of a composite pulse, including \
also a range in rf amplitudes. The x-coordinates are converted to Hz:\
\>", "Text",
 CellChangeTimes->{{3.544596336436264*^9, 3.544596407049268*^9}, {
   3.544604749592227*^9, 3.5446047701736*^9}, {3.5742629296211143`*^9, 
