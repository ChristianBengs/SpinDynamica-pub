db6672b8e4b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TransformationAmplitudeTable", "[", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\n", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"AmplitudeFactor", "\[Rule]", "ampfac"}], ",", 
      RowBox[{"NutationFrequency", "\[Rule]", 
       RowBox[{"2", "\[Pi]", " ", "1", " ", 
        SuperscriptBox["10", "3"]}]}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Pi]", " ", "2", " ", 
       SuperscriptBox["10", "3"]}], ",", 
      RowBox[{"2", "\[Pi]", " ", "2", " ", 
       SuperscriptBox["10", "3"]}], ",", 
      RowBox[{"{", "51", "}"}]}], "}"}], ",", 
    RowBox[{"EnsembleAverage", "->", 
     RowBox[{"{", 
      RowBox[{"ampfac", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0.5", ",", "1.5", ",", "0.1"}], "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"BackgroundGenerator", "\[Rule]", 
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"TableCoordinates", "\[Rule]", 
     RowBox[{"\[CapitalOmega]", "/", 
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}]}]}]}], "\n", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"%", ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<resonance offset / Hz\>\"", ",", "\"\<z\[Rule]z\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
