Cell[TextData[{
 "The ",
 StyleBox["TrajectoryFunction",
  FontWeight->"Bold"],
 " consists of distinct ranges which are spliced together.  This is handled \
internally and requires no user intervention. Very complex sequences may be \
handled, for example:"
}], "Text",
 CellChangeTimes->{{3.544550810024175*^9, 
  3.54455090417165*^9}},ExpressionUUID->"e4946364-506b-4608-8f27-\
b4189b6f8a52"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sequence", "=", 
   RowBox[{"Repeat", "[", 
    RowBox[{
     RowBox[{"PulseSequence", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "3"}], ",", "\"\<x\>\""}], "}"}], "]"}], 
         ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "6"}], ",", 
            RowBox[{"2", 
             RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}], "]"}], ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"NutationFrequency", "\[Rule]", 
        RowBox[{"2", "\[Pi]"}]}]}], "]"}], ",", "30"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"traj", "=", 
  RowBox[{"Trajectory", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", "sequence"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.544550914926505*^9, 3.544551032971019*^9}, {
  3.709547851964268*^9, 3.70954785285396*^9}, {3.816861222854024*^9, 
