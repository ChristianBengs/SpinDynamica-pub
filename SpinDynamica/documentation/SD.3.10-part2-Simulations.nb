Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ztraj2", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PulseSequence", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], 
         ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"NutationFrequency", "\[Rule]", 
        RowBox[{"2", "\[Pi]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", 
      RowBox[{"2", "\[Pi]", " ", "0.1", " ", 
       RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ztraj2", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
