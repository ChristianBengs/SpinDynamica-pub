Cell[TextData[{
 "The option ",
 StyleBox["InitialDensityOperator",
  FontWeight->"Bold"],
 " is used to define the spin density operator to which the ",
 StyleBox["Preparation",
  FontWeight->"Bold"],
 " is applied. "
}], "Text",
 CellChangeTimes->{{3.544623820956916*^9, 3.544623864194604*^9}, {
  3.544966538251601*^9, 3.544966570263727*^9}, {3.544967013737056*^9, 
  3.544967033704801*^9}},ExpressionUUID->"40a848dd-03e5-418e-94b3-\
45aa36d86881"],

Cell[TextData[{
 "The default value of ",
 StyleBox["InitialDensityOperator",
  FontWeight->"Bold"],
 " is ",
 StyleBox["opI[\[OpenCurlyDoubleQuote]z\[CloseCurlyDoubleQuote]]",
  FontWeight->"Bold"],
 ", implying equal z-polarization for all spins in the system. "
}], "Text",
 CellChangeTimes->{{3.544623870508128*^9, 3.544623904887675*^9}, {
  3.5449665744846487`*^9, 3.544966618603216*^9}, {3.544967037610432*^9, 
  3.5449670619338717`*^9}},ExpressionUUID->"d5a3c7ab-71d1-4bd7-8a15-\
feb4dc233d8f"],

Cell["For example, consider a coupled 2 spin system:", "Text",
 CellChangeTimes->{{3.544624085853735*^9, 3.544624089703988*^9}, {
  3.544624128167091*^9, 3.544624153541571*^9}, {3.544624246470708*^9, 
  3.5446242727442718`*^9}, {3.544966664877672*^9, 3.544966671213958*^9}, {
  3.544967074401273*^9, 
  3.544967094687712*^9}},ExpressionUUID->"f0778ab8-1138-42e6-aa04-\
56a7a78073a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "100", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "50"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "20", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", 
     RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "400"}], ",", "1024"}], "}"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
