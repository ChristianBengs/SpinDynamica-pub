Cell[TextData[{
 "A radiofrequency field subjected to a linear frequency sweep may be coded \
using ",
 ButtonBox["ShapedPulse:",
  BaseStyle->"Hyperlink",
  ButtonData->"ShapeFunction"]
}], "Text",
 CellChangeTimes->{{3.544552441636301*^9, 3.544552483935111*^9}, {
