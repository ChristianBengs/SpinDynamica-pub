Cell[TextData[{
 "The parameter ",
 StyleBox["InterpolationPoints",
  FontWeight->"Bold"],
 " now takes the value ",
 StyleBox["1000,",
  FontWeight->"Bold"],
 " if it is not specified explicitly in the call to ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544549571215297*^9, 3.544549600525486*^9}, {
  3.552278000919763*^9, 3.552278001660035*^9}, {3.574259891106308*^9, 
  3.574259897569167*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"3c0effb2-6939-4403-97da-e2082b07da81"]
