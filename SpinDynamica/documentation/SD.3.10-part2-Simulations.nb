Cell["\<\
Note the adjustment of the sampling interval, and that the periodic \
time-dependent modulation gives rise to modulation sidebands in the spectrum. \
Spinning sidebands in liquids and solids may be simulated this way.  \
\>", "Text",
 CellChangeTimes->{{3.54495757034486*^9, 3.544957597385602*^9}, {
  3.5449642618685436`*^9, 3.54496430008664*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"0ca122d0-3211-4dfd-9279-fb00a8105fc6"],

Cell[TextData[{
 "In the case of periodic background generators, the option ",
 StyleBox["CarouselAverage\[Rule]True",
  FontWeight->"Bold"],
 " may be used to compute the average over all modulation phases (see M. H. \
Levitt, \[OpenCurlyDoubleQuote]Why do Spinning Sidebands Have the Same \
Phase?,\[CloseCurlyDoubleQuote] J. Magn. Reson. 82, 427 (1989)):"
}], "Text",
 CellChangeTimes->{{3.5449642311003036`*^9, 3.544964258851996*^9}, {
  3.544964302262871*^9, 3.544964387948029*^9}, {3.5742699801534753`*^9, 
