Cell[TextData[{
 "If you want to average over 100 simulations, using equally spaced values of \
the rf nutation frequency between 1.0 kHz and 1.2 kHz, this is easily done \
using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["Subdivide",
  FontWeight->"Bold"],
 " routine:"
}], "Text",
 CellChangeTimes->{{3.5742616902476463`*^9, 3.574261810610693*^9}, {
  3.574261883738071*^9, 3.574261884801882*^9}, {3.680340631279723*^9, 
  3.680340632007653*^9}, {3.789290984238867*^9, 3.789291028603887*^9}, {
  3.789291136270143*^9, 
  3.789291148529297*^9}},ExpressionUUID->"ea826b2d-d067-4d1d-a37a-\
0634ede1922a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"10", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"EnsembleAverage", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], 
        StyleBox[",",
         FontWeight->"Bold"], 
        RowBox[{
         StyleBox["2",
          FontWeight->"Bold"], 
         StyleBox["\[Pi]",
          FontWeight->"Bold"], 
         StyleBox[" ",
          FontWeight->"Bold"], 
         SuperscriptBox[
          StyleBox["10",
           FontWeight->"Bold"], "3"], 
         StyleBox[" ",
          FontWeight->"Bold"], 
         RowBox[{
          StyleBox["Subdivide",
           FontWeight->"Bold"], 
          StyleBox["[",
           FontWeight->"Bold"], 
          RowBox[{"1", ",", "1.2", ",", "100"}], "]"}]}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445545057470436`*^9, 3.544554588440064*^9}, {
  3.574261823615006*^9, 3.574261869361948*^9}, {3.728130069096859*^9, 
  3.728130070466478*^9}, {3.728130113296068*^9, 3.7281301344332247`*^9}, {
  3.7281301694337053`*^9, 3.728130169552089*^9}, {3.789291036995032*^9, 
  3.789291057372566*^9}, {3.789291087832159*^9, 3.789291106670541*^9}},
 CellLabel->
