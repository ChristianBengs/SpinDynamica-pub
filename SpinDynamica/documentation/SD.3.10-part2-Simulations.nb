Cell[CellGroupData[{

Cell["NPropagationSuperoperator", "Subsection",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.54435984217771*^9}, {
  3.575598482501603*^9, 3.575598484449917*^9}, {3.57559885187908*^9, 
  3.575598854149022*^9}, {3.575599023952792*^9, 3.575599024717863*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellTags->"Signal1D",ExpressionUUID->"e121ecf4-8f85-44bd-8d1a-ffdff8e10fbd"],

Cell[TextData[{
 "NPropagationSuperoperator determines the overall propagation superoperator \
(superpropagator) of a series of events. The event specifications, and use of \
",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "and other options, are the same as in the routines above. The output of the \
routine is of the form ",
 StyleBox["Superoperator",
  FontWeight->"Bold"],
 " (see part 4 of the documentation). "
}], "Text",
 CellChangeTimes->{{3.544549694695115*^9, 3.544549774147787*^9}, {
   3.5446063219736023`*^9, 3.54460645985575*^9}, {3.544607424476499*^9, 
   3.544607424905135*^9}, {3.544608243870809*^9, 3.544608267148535*^9}, 
   3.544608333394639*^9, {3.544609007281818*^9, 3.54460903949083*^9}, {
   3.5449821055863333`*^9, 3.5449821145857983`*^9}, {3.5755985018558483`*^9, 
   3.57559854709648*^9}, {3.575598582244341*^9, 3.575598630347045*^9}, {
   3.575598857658437*^9, 3.575598897523856*^9}, {3.575599028306562*^9, 
   3.575599044566146*^9}, 3.709547934583783*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"75a90dbd-c621-442f-8624-426a4e9ddbc8"],

Cell[TextData[{
 "The general syntax is ",
 StyleBox["NPropagationSuperoperator[events, options]",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.575598686854257*^9, 3.575598711837219*^9}, {
   3.5755989100822268`*^9, 3.5755989224431143`*^9}, 3.575599048756022*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"e6ebab03-1114-4755-a591-7c25639db82b"],

Cell["\<\
The example below calculates the propagation superoperator of a series of \
events:\
\>", "Text",
 CellChangeTimes->{{3.575598556538352*^9, 3.5755985977301207`*^9}, {
  3.5755987249461193`*^9, 3.575598728803247*^9}, {3.575598927376453*^9, 
