   3.574264890255624*^9, 3.574264914011578*^9}, 3.574265021094639*^9, {
   3.574269177128945*^9, 3.574269186423038*^9}, {3.574269217144648*^9, 
   3.574269268067683*^9}, 
   3.7095479314182277`*^9},ExpressionUUID->"a6cd6487-ddba-41a4-9f5f-\
3356423ad80d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "3", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ispins", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";", 
  RowBox[{"Sspins", "=", 
   RowBox[{"{", "3", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "6", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "40", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
      RowBox[{"opI", "[", 
       RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "40", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"2", ",", "\"\<z\>\""}], "]"}], ".", 
      RowBox[{"opI", "[", 
       RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hdec", "=", 
   RowBox[{"2", "\[Pi]", " ", "100", " ", 
    RowBox[{"opI", "[", 
     RowBox[{"Ispins", ",", "\"\<x\>\""}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", "\[IndentingNewLine]", 
     RowBox[{"Signal1D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "300"}], ",", "\"\<1k\>\""}], "}"}], 
