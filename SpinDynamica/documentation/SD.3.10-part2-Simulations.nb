Cell["\<\
TransformationAmplitudeTable may also be used with 2 or more variable \
parameters. \
\>", "Text",
 CellChangeTimes->{{3.575597762439609*^9, 3.575597832357411*^9}, 
   3.575598001071224*^9, 3.575598189064661*^9, {3.7219509531802483`*^9, 
   3.721950963705909*^9}},ExpressionUUID->"56d32c92-2295-489c-95fd-\
03fb78ef3e23"],

Cell[TextData[{
 "The example below calculates the effect of resonance offset and rf \
amplitude errors on population inversion induced by a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["90", "x"], 
    SubscriptBox["180", "y"], 
    SubscriptBox["90", "x"]}], TraditionalForm]],ExpressionUUID->
  "b4a249df-eed9-420f-9c50-62752c8f167a"],
 " composite pulse, and plots the result using ",
 "ContourPlot",
 ":"
}], "Text",
 CellChangeTimes->{{3.575598107295772*^9, 3.575598148087007*^9}, {
  3.721950968249674*^9, 3.721951058314155*^9}, {3.910152185225402*^9, 
  3.9101521881297603`*^9}},ExpressionUUID->"0581828e-f202-41fd-aa90-\
b26ad33fe66a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TransformationAmplitudeTable", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"AmplitudeFactor", "\[Rule]", "\[Epsilon]"}], ",", 
      RowBox[{"NutationFrequency", "\[Rule]", 
       RowBox[{"2", "\[Pi]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", 
      RowBox[{
       RowBox[{"-", "1.5"}], " ", "2", "\[Pi]"}], ",", 
      RowBox[{"1.5", " ", "2", "\[Pi]"}], ",", 
      RowBox[{"{", "30", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[Epsilon]", ",", "0.5", ",", "1.5", ",", 
      RowBox[{"{", "30", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"BackgroundGenerator", "\[Rule]", 
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"TableCoordinates", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalOmega]", "/", 
        RowBox[{"(", 
         RowBox[{"2", "\[Pi]"}], ")"}]}], ",", "\[Epsilon]"}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListContourPlot", "[", 
  RowBox[{"%", ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<relative resonance offset\>\"", ",", 
      "\"\<rf amplitude factor\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
   3.575597869524095*^9, 3.575597946793298*^9}, 3.575598018529356*^9, {
