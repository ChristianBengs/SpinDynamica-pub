Cell[TextData[{
 "A weak preparation pulse may be defined by using the ",
 StyleBox["Pulse",
  FontWeight->"Bold"],
 " routine, but including a specification for either ",
 StyleBox["PulseDuration",
  FontWeight->"Bold"],
 " or ",
 StyleBox["NutationFrequency",
  FontWeight->"Bold"],
 ". In the example below, the nutation frequency of the pulse is set to 5 Hz, \
leading to a high degree of frequency selectivity:"
}], "Text",
 CellChangeTimes->{{3.544624298172449*^9, 3.544624307283445*^9}, {
   3.544966635797387*^9, 3.544966637683978*^9}, {3.544966692218857*^9, 
   3.54496669643923*^9}, {3.54496673052956*^9, 3.544966738802372*^9}, {
   3.544966814425617*^9, 3.54496683281571*^9}, {3.57426657345147*^9, 
   3.574266600736594*^9}, 3.574266874036429*^9, {3.744543187727731*^9, 
   3.744543212972415*^9}, {3.744543287158846*^9, 
   3.744543316834241*^9}},ExpressionUUID->"c1e6191a-dca6-4912-93ce-\
1e1b255ec8bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", 
     RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "400"}], ",", "1024"}], "}"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Preparation", "\[Rule]", 
        RowBox[{"Pulse", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], ",", 
          RowBox[{"NutationFrequency", "\[Rule]", 
           RowBox[{"2", "\[Pi]", " ", "5"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "]"}]], "Input",
