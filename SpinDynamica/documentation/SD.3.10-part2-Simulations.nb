   3.709547930920353*^9},ExpressionUUID->"97acb181-6d6a-4c79-ae10-\
a9b20346b0d1"],

Cell[TextData[{
 "The option ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 " sets the background evolution generator for the calculation. This \
evolution generator is combined with any other events during the generation \
of the signal. "
}], "Text",
 CellChangeTimes->{{3.544957064933367*^9, 3.544957093579094*^9}, {
   3.544957191873803*^9, 3.5449572833586817`*^9}, {3.574264637654095*^9, 
   3.574264653501905*^9}, 
   3.709547931054019*^9},ExpressionUUID->"e5f4a8b1-1bf8-4f48-bc38-\
4fab61ec84e1"],

Cell[TextData[{
 "This example uses ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 " to simulate the spectrum of a single S-spin coupled to two I-spins"
}], "Text",
 CellChangeTimes->{{3.544957064933367*^9, 3.544957093579094*^9}, {
   3.544957191873803*^9, 3.544957270383176*^9}, {3.574264258327318*^9, 
