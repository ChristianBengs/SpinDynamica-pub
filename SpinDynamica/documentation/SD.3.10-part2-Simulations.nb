Cell["\<\
A Pake pattern for coupled spin-1/2 pairs may be simulated by taking the \
ensemble average over the angle \[Beta] between the internuclear vector and \
the external magnetic field. Note that cos\[Beta] is used as the random \
variable instead of \[Beta], since an isotropic distribution of molecular \
orientations corresponds to a uniform distribution of cos\[Beta] in the range \
[-1,1].\
\>", "Text",
 CellChangeTimes->{{3.552226972004459*^9, 3.552226991730855*^9}, {
  3.552229087631385*^9, 3.552229091494898*^9}, {3.552278461876701*^9, 
  3.5522784676470423`*^9}, {3.574270375143207*^9, 3.574270439769551*^9}, {
  3.5742706914610643`*^9, 3.574270792099985*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"b8d2d28d-8e95-4799-b099-084a9f030048"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", 
     RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
