Cell[TextData[{
 "The ensemble variable (",
 StyleBox["\[Omega]nut",
  FontWeight->"Bold"],
 " in the example above) may be contained in any of the event specifications \
or any of the options, including the BackgroundGenerator. The example below \
shows the simulation of a spin echo. An inhomogeneous magnetic field is \
simulated by setting the resonance offset to a normally distributed random \
variable:"
}], "Text",
 CellChangeTimes->{{3.544555153581542*^9, 3.5445552152188473`*^9}, {
   3.544594615305869*^9, 3.544594729733042*^9}, {3.5445949773455477`*^9, 
   3.544595031677187*^9}, {3.5445950635146713`*^9, 3.544595071609448*^9}, 
   3.709547928193076*^9},ExpressionUUID->"4ff34afc-2a2b-4e09-8806-\
6259691329c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<x\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"10", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"RotationSuperoperator", "[", 
        RowBox[{"{", 
         RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"None", ",", 
         RowBox[{"20", " ", 
          RowBox[{"10", "^", 
           RowBox[{"-", "3"}]}]}]}], "}"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", 
      RowBox[{"\[CapitalOmega]", " ", 
       RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"EnsembleAverage", "\[Rule]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"\[CapitalOmega]", " ", ",", "\[IndentingNewLine]", 
        RowBox[{
         StyleBox["RandomVariate",
          FontWeight->"Bold"], 
         StyleBox["[",
          FontWeight->"Bold"], 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{
            RowBox[{"2", "\[Pi]", " ", "500"}], ",", 
            RowBox[{"2", "\[Pi]", " ", "200"}]}], "]"}], ",", "1000"}], 
         "]"}]}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"30", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445545057470436`*^9, 3.544554588440064*^9}, {
   3.5445549959146976`*^9, 3.54455501521493*^9}, {3.544555059064495*^9, 
