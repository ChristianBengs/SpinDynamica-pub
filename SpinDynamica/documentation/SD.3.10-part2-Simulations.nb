Cell[TextData[{
 "A ",
 StyleBox["Signal",
  FontWeight->"Bold"],
 " object may be converted into the frequency domain by applying the complex \
Fourier transform routine ",
 StyleBox["FT ",
  FontWeight->"Bold"],
 "(this is a ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " routine which is an extension of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " routine ",
 StyleBox["Fourier",
  FontWeight->"Bold"],
 "). "
}], "Text",
 CellChangeTimes->{{3.54460711914415*^9, 
  3.544607191837938*^9}},ExpressionUUID->"49ca71c2-ff69-4253-9c2c-\
b5e088b08d1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{"FT", "[", "signal", "]"}], "]"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.544607015701186*^9, 3.544607070122204*^9}, {
   3.544607203831371*^9, 3.5446072398133297`*^9}, 3.5446072836891003`*^9, {
