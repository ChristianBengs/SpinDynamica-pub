         RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
        RowBox[{"1", "/", "4"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", 
        RowBox[{"1", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
        RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}], "\[IndentingNewLine]", 
    "]"}], "[", 
   RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "]"}]}]}], "Input",
