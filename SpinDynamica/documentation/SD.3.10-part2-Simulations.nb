Cell[CellGroupData[{

Cell["TransformationAmplitudeBounds", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.544359813166822*^9}, {
   3.544981518469788*^9, 3.544981519732613*^9}, 3.728210692850772*^9},
