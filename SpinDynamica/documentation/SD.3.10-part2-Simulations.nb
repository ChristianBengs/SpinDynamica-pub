Cell[CellGroupData[{

Cell["TransformationAmplitudeTable", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.544359848250125*^9}, 
   3.544463309307725*^9},
 CellTags->
  "TransformationAmplitudeTable",ExpressionUUID->"a30deb43-7c01-4776-8b85-\
c4e9efe65b8a"],

Cell["\<\
TransformationAmplitudeTable allows construction of a set of \
TransformationAmplitude values, with a variable parameter taking a set of \
equally-spaced values, similar to the Table routine of Mathematica. \
\>", "Text",
 CellChangeTimes->{{3.544595676670926*^9, 3.544595734821675*^9}, 
   3.544597064410241*^9},ExpressionUUID->"9b79261b-eedf-451d-9ce9-\
2fdc78a1b0dc"],

Cell["The variation of multiple parameters is also possible.  ", "Text",
 CellChangeTimes->{{3.721950271534445*^9, 
  3.721950287389485*^9}},ExpressionUUID->"3452f344-ae08-43c7-a510-\
1779765389d2"],

Cell["\<\
The output of TransformationAmplitudeTable may be plotted using ListPlot (for \
one variable) or ListContourPlot (for two variables).\
\>", "Text",
 CellChangeTimes->{{3.721950290140773*^9, 
  3.7219503200668297`*^9}},ExpressionUUID->"7d1ef5b9-4254-4c7b-a4df-\
5476f9b1b205"],

Cell["\<\
By default, TransformationAmplitudeTable uses parallel evaluation over all \
available kernels.\
\>", "Text",
 CellChangeTimes->{{3.616752774033694*^9, 
  3.616752805278365*^9}},ExpressionUUID->"e57f65fa-d400-4f28-9c25-\
c7dbb6441d24"],

Cell[CellGroupData[{

Cell["basic functionality", "Subsubsection",
 CellChangeTimes->{{3.544595756798325*^9, 3.544595759461074*^9}, {
  3.7219504539442663`*^9, 
  3.72195046912052*^9}},ExpressionUUID->"8ef43c61-c288-4dd8-a46c-\
0c2da87c3f0d"],

Cell["\<\
The basic syntax of TransformationAmplitudeTable is as follows:\
\>", "Text",
 CellChangeTimes->{{3.544595848523198*^9, 3.544595860873725*^9}, {
  3.54459590574984*^9, 
  3.5445959064413977`*^9}},ExpressionUUID->"9ff9bd5a-16a7-400e-afd2-\
7b136cf1de87"],

Cell["\<\
TransformationAmplitudeTable[a\[Rule]b, events, {n,nmin,nmax,dn}, options]\
\>", "Text",
 CellChangeTimes->{{3.5445958642886257`*^9, 
  3.544595901401365*^9}},ExpressionUUID->"9af77054-e3d9-4a4e-aa34-\
f2ad96ac37ff"],

Cell["\<\
where a is the initial density operator, b is the target density operator \
(which may also be a list of several operators, as in Trajectory), events \
contains the specifications for the evolution events, and n is the iteration \
variable, which runs between nmin and nmax in steps of dn. If dn is omitted, \
then dn=1 is assumed. The options may contain a set of replacement rules, \
including specifications for BackgroundGenerator and EnsembleAverage. Any of \
the events or the BackgroundGenerator specifications may depend on n. \
\>", "Text",
 CellChangeTimes->{{3.544595914206235*^9, 3.544596011941909*^9}, {
  3.544596042564815*^9, 3.544596095514714*^9}, {3.7095479288337884`*^9, 
  3.7095479290127664`*^9}, {3.7095482854886904`*^9, 
  3.7095482866102877`*^9}},ExpressionUUID->"dd1fc8bc-2c8c-489f-87ab-\
5c52887d1292"],

Cell["\<\
For example, the following syntax plots the z-inversion performance of a \
composite pulse against the rf amplitude factor:\
\>", "Text",
 CellChangeTimes->{{3.544596111027958*^9, 3.544596160952854*^9}, {
   3.816857747271605*^9, 3.816857752422659*^9}, 3.8168577992288313`*^9, {
   3.816857890043075*^9, 3.816857920245073*^9}, {3.816857989370089*^9, 
   3.816858011460105*^9}, {3.816861728330616*^9, 
   3.816861766550156*^9}},ExpressionUUID->"226880b4-dc2b-4a8a-8dfb-\
e894faa3e64b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TransformationAmplitudeTable", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PulseSequence", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pulse", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
       
       RowBox[{"Pulse", "[", 
        RowBox[{"{", 
         RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
       RowBox[{"Pulse", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"AmplitudeFactor", "\[Rule]", "ampfac"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"ampfac", ",", "0", ",", "2", ",", "0.05"}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.5445961686990156`*^9, 3.544596213700069*^9}, {
   3.5742628445154347`*^9, 3.574262848672704*^9}, {3.7095482953817887`*^9, 
