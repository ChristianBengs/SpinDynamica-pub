Cell[CellGroupData[{

Cell["NPropagationOperator", "Subsection",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.54435984217771*^9}, {
  3.575598482501603*^9, 3.575598484449917*^9}, {3.57559885187908*^9, 
  3.575598854149022*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellTags->"Signal1D",ExpressionUUID->"738b1b65-354d-4bcb-b999-a68f46bc03dd"],

Cell[TextData[{
 StyleBox["NPropagationOperator",
  FontWeight->"Bold"],
 " determines the overall propagation operator (propagator) of a series of \
events. The event specifications, and use of ",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "and other options, are the same as in the routines above. The output of the \
routine is of the form ",
 StyleBox["Operator",
  FontWeight->"Bold"],
 " (see part 3 of the documentation). "
}], "Text",
 CellChangeTimes->{{3.544549694695115*^9, 3.544549774147787*^9}, {
   3.5446063219736023`*^9, 3.54460645985575*^9}, {3.544607424476499*^9, 
   3.544607424905135*^9}, {3.544608243870809*^9, 3.544608267148535*^9}, 
   3.544608333394639*^9, {3.544609007281818*^9, 3.54460903949083*^9}, {
   3.5449821055863333`*^9, 3.5449821145857983`*^9}, {3.5755985018558483`*^9, 
   3.57559854709648*^9}, {3.575598582244341*^9, 3.575598630347045*^9}, {
   3.575598857658437*^9, 3.575598897523856*^9}, 3.7095479344116917`*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"c0750b35-8bc5-42c6-ac65-3d37738a8cfc"],

Cell[TextData[{
 "The general syntax is ",
 StyleBox["NPropagationOperator[events, options]",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.575598686854257*^9, 3.575598711837219*^9}, {
  3.5755989100822268`*^9, 3.5755989224431143`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"44a1bd10-f2fe-43c3-9a80-20aa2dd0da85"],

Cell["\<\
The example below calculates the propagator of a series of events:\
\>", "Text",
 CellChangeTimes->{{3.575598556538352*^9, 3.5755985977301207`*^9}, {
  3.5755987249461193`*^9, 3.575598728803247*^9}, {3.575598927376453*^9, 
  3.5755989313874073`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"1f350435-b295-41b5-a602-9705b9a9cad1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"propagator", "=", 
  RowBox[{"NPropagationOperator", "[", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"1", "/", "4"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
