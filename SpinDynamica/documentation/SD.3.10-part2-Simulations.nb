Cell["\<\
The following syntax sums together the trajectories for these 1000 values of \
the nutation frequency, with equal weights. The result simulates the effect \
of rf inhomogeneity causing a decay of the nutation curve:\
\>", "Text",
 CellChangeTimes->{{3.544554944105188*^9, 3.544554981375875*^9}, {
  3.544555323937755*^9, 3.544555324110433*^9}, {3.552278147225168*^9, 
  3.552278165407456*^9}, {3.789291258741085*^9, 
  3.78929125934397*^9}},ExpressionUUID->"d2ac42a3-9437-443c-bdc0-\
7112f05f79f3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]nut", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"10", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"EnsembleAverage", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\[Omega]nut", ",", 
        StyleBox["\[Omega]nutvals",
         FontWeight->"Bold"]}], 
       StyleBox["}",
        FontWeight->"Bold"]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445545057470436`*^9, 3.544554588440064*^9}, {
  3.5445549959146976`*^9, 3.54455501521493*^9}, {3.544555059064495*^9, 
  3.544555063382057*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"a4a67a96-9e02-4e91-856e-17a11bd217dc"],

