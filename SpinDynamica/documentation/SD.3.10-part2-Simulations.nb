   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
