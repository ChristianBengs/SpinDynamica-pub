Cell[TextData[{
 "In most ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " front ends, you can use mouse drags to rotate the object on the screen. \
This functionality allows the rapid calculation of 3D graphical \
representations of spin dynamical evolution. "
}], "Text",
 CellChangeTimes->{{3.574262656149713*^9, 3.574262695505797*^9}, {
  3.680340439675651*^9, 
  3.680340464536971*^9}},ExpressionUUID->"6849d32d-e914-4e1f-aa56-\
49c32afc9ca0"]
}, Closed]],

Cell[CellGroupData[{

Cell["BackgroundGenerator", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
   3.544550277066109*^9, 3.544550282913748*^9}, {3.544550413768497*^9, 
   3.544550416909446*^9}, {3.544551099276265*^9, 3.544551103339709*^9}, {
   3.544551160790145*^9, 3.544551165485888*^9}, 3.544551227091996*^9, {
   3.544551267973143*^9, 3.544551272037014*^9}, {3.544552067345557*^9, 
   3.54455207139655*^9}, {3.544552110405758*^9, 3.54455213552413*^9}, 
   3.709547926817582*^9},ExpressionUUID->"7532b982-4619-477d-b1a9-\
e15ae939cfb5"],

Cell[TextData[{
 "Setting the ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 " option causes an evolution generator to act throughout the sequence, in \
combination with the specified events, without being specified explicitly \
during each event "
}], "Text",
 CellChangeTimes->{{3.5445521388035*^9, 3.544552221505099*^9}, {
   3.616752090718421*^9, 3.616752101304253*^9}, 
   3.7095479270239058`*^9},ExpressionUUID->"2d9c521e-c3d5-4785-b614-\
f6865dae8af0"],

Cell["\<\
For example, this code simulates the trajectory of z-magnetization through a \
composite pulse sequence, in the absence of a resonance offset:\
\>", "Text",
 CellChangeTimes->{{3.544552224487174*^9, 
  3.5445522458318453`*^9}},ExpressionUUID->"9c2bafe8-47e7-4206-9ab0-\
6df361807296"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ztraj1", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PulseSequence", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], 
         ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"NutationFrequency", "\[Rule]", 
        RowBox[{"2", "\[Pi]"}]}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ztraj1", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
  3.544550574860662*^9, 3.5445506029714*^9}, {3.5445506338562*^9, 
  3.5445507080017986`*^9}, {3.54455074311629*^9, 3.54455079533016*^9}, {
  3.544552263762131*^9, 3.544552306239681*^9}, {3.816861372241475*^9, 
  3.816861379928657*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"11bf60d2-02e4-425f-9f37-8511ce3c6e71"],

