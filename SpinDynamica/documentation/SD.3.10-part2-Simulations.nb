Cell["\<\
Any valid sequence of events may be used for the preparation sequence.\
\>", "Text",
 CellChangeTimes->{{3.544966908828153*^9, 3.544966918660923*^9}, {
  3.574266619702546*^9, 3.57426663138395*^9}, {3.574843670225713*^9, 
  3.574843674324182*^9}},ExpressionUUID->"debf6745-e4ad-4feb-b9ef-\
22673239de03"],

Cell[TextData[{
 "It is possible to use a different ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 " for the spin dynamics during the preparation sequence, and the signal \
evolution events, by using the syntax ",
 StyleBox["BackgroundGenerator\[Rule]{prepbackg,detbackg}",
  FontWeight->"Bold"],
 ", where ",
 StyleBox["prepbackg",
  FontWeight->"Bold"],
 " is the ",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "during the preparation, and is the ",
 StyleBox["detbackg",
  FontWeight->"Bold"],
 " is the ",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "during the signal detection."
}], "Text",
 CellChangeTimes->{{3.574266640087628*^9, 3.574266753814391*^9}, {
  3.7095479324236174`*^9, 3.709547932863448*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"53e6f052-fe86-40b6-b3b1-2077ec1aa9ef"],

Cell["\<\
The example below uses this feature to effectively shift the rf carrier \
frequency during the preparation sequence:\
\>", "Text",
 CellChangeTimes->{{3.5742668000026617`*^9, 3.574266839726336*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"9f866f74-a8b8-4878-bbde-fbb23b4bdc4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", 
     RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "400"}], ",", "1024"}], "}"}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"BackgroundGenerator", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"H0", "-", 
           RowBox[{"2", "\[Pi]", " ", "30", " ", 
            RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "H0"}], "}"}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"Preparation", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Pulse", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], ",", 
           RowBox[{"NutationFrequency", "\[Rule]", 
            RowBox[{"2", "\[Pi]", " ", "5"}]}]}], "]"}], "}"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.54462415546112*^9, 3.544624241137917*^9}, {
