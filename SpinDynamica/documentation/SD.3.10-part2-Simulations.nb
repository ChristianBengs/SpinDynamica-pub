Cell[CellGroupData[{

Cell["Signal1D", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.54435984217771*^9}},
 Background->None,
 CellTags->"Signal1D",ExpressionUUID->"545d7c50-0a5b-4043-8623-f73653c1330c"],

Cell[TextData[{
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " calculates a uniformly sampled one-dimensional time-domain signal, \
specified by the number of sampling points, the sampling interval, the events \
during the signal evolution, and many other options. "
}], "Text",
 CellChangeTimes->{{3.544549694695115*^9, 3.544549774147787*^9}, {
   3.5446063219736023`*^9, 3.54460645985575*^9}, {3.544607424476499*^9, 
   3.544607424905135*^9}, {3.544608243870809*^9, 3.544608267148535*^9}, 
   3.544608333394639*^9, {3.544609007281818*^9, 3.54460903949083*^9}, {
   3.5449821055863333`*^9, 
   3.5449821145857983`*^9}},ExpressionUUID->"769e8248-e7c9-49af-bb8c-\
4ba466d11442"],

Cell[CellGroupData[{

Cell["basic functionality", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
  3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
  3.544606485581957*^9}},ExpressionUUID->"3efcf268-f944-4baf-8b95-\
263061827c1f"],

Cell[TextData[{
 "The basic syntax of ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " is as follows:"
}], "Text",
 CellChangeTimes->{{3.544549895831808*^9, 3.544549944045988*^9}, {
  3.544550115805558*^9, 3.544550218203819*^9}, {3.544606493760046*^9, 
  3.5446065025014973`*^9}},ExpressionUUID->"6226dcfc-aa2a-4c8d-bc69-\
46e96b8f26c2"],

Cell[TextData[StyleBox["Signal1D[{tmin,tmax,dt}, DetectionSpecifications, \
options]",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.5446065079171*^9, 3.544606555274903*^9}, {
  3.544965492977978*^9, 3.544965493862862*^9}, {3.544965721447486*^9, 
  3.544965747950252*^9}, {3.574843221648436*^9, 
  3.57484322709852*^9}},ExpressionUUID->"018aadd2-b6cc-4726-bffe-\
6c6da0108065"],

Cell[TextData[{
 "where ",
 StyleBox["tmin",
  FontWeight->"Bold"],
 " and ",
 StyleBox["tmax",
  FontWeight->"Bold"],
 " are the minimum and maximum time points of the sampled signal, and ",
 StyleBox["\[Delta]t",
  FontWeight->"Bold"],
 " is the spacing between sampling points. "
}], "Text",
 CellChangeTimes->{{3.544606567281096*^9, 3.544606652407436*^9}, 
   3.544965498060965*^9},ExpressionUUID->"0057f29b-2093-43a8-94ba-\
43c3693a5c07"],

Cell[TextData[{
 "The symbol ",
 StyleBox["DetectionSpecifications",
  FontWeight->"Bold"],
 " may be (1) a single evolution generator (a Hamiltonian, or a relaxation \
superoperator, or a combination of these), or (2) a list of events to be \
executed during signal detection. Case 1 is discussed here. Case 2 is \
discussed ",
 ButtonBox["later",
  BaseStyle->"Hyperlink",
  ButtonData->"DetectionEvents"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544606567281096*^9, 3.544606652407436*^9}, {
  3.544965498060965*^9, 3.544965651856694*^9}, {3.544965685370833*^9, 
  3.544965685372492*^9}, {3.544965731954625*^9, 
  3.5449657953622913`*^9}},ExpressionUUID->"cb498bc6-d08b-493a-855d-\
72523694f26c"],

Cell["\<\
A simple example of case 1, showing the simulation of an AB spectral pattern, \
is as follows:\
\>", "Text",
 CellChangeTimes->{{3.5446066694569883`*^9, 3.544606677096139*^9}, {
  3.544607857641361*^9, 3.544607871254418*^9}, {3.5449658016605053`*^9, 
  3.544965803089907*^9}},ExpressionUUID->"ec327fd1-ab93-4e5b-9e42-\
cbb48ce4d06e"],

