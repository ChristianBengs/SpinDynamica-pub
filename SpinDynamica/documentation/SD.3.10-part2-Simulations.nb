Cell[TextData[{
 "Suppose now that you wish to take the average of two simulations, using \
different values of the rf field, expressed as a nutation frequency. Suppose \
that the two nutation frequencies are 1.0 kHz and 1.2 kHz. Define a nutation \
frequency variable ",
 StyleBox["\[Omega]nut, ",
  FontWeight->"Bold"],
 "and perform the average computation using ",
 StyleBox["EnsembleAverage:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.5742616902476463`*^9, 3.574261810610693*^9}, {
  3.574261883738071*^9, 3.574261884801882*^9}, {3.680340631279723*^9, 
  3.680340632007653*^9}},ExpressionUUID->"699fbb43-d5f7-4fb3-91e3-\
daa18057c98f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"10", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"EnsembleAverage", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], 
        StyleBox[",",
         FontWeight->"Bold"], 
        RowBox[{
         StyleBox["{",
          FontWeight->"Bold"], 
         RowBox[{
          RowBox[{
           StyleBox["2",
            FontWeight->"Bold"], 
           StyleBox["\[Pi]",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           SuperscriptBox[
            StyleBox["10",
             FontWeight->"Bold"], "3"]}], ",", 
          RowBox[{
           StyleBox["2",
            FontWeight->"Bold"], 
           StyleBox["\[Pi]",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           StyleBox["1.2",
            FontWeight->"Bold"], 
           StyleBox[" ",
            FontWeight->"Bold"], 
           SuperscriptBox[
            StyleBox["10",
             FontWeight->"Bold"], "3"]}]}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445545057470436`*^9, 3.544554588440064*^9}, {
  3.574261823615006*^9, 3.574261869361948*^9}, {3.728130069096859*^9, 
  3.728130070466478*^9}, {3.728130113296068*^9, 3.7281301344332247`*^9}, {
