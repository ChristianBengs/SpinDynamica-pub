Cell[CellGroupData[{

Cell[TextData[{
 "MaxStepSize ",
 StyleBox["and ",
  FontWeight->"Plain"],
 "MaxSteps"
}], "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 3.5445543033258867`*^9}, {
  3.552226585187185*^9, 3.552226588080554*^9}, {3.562217977104733*^9, 
  3.562217982454028*^9}, {3.5622183441509037`*^9, 3.5622183613906317`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"a0d79f80-2d30-4f24-ac29-d312595fc0e2"],

Cell[TextData[{
 "The spin dynamics during time-dependent events is calculated using the ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " routine of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". Any of the options used by ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " may be supplied to ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 ". See the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " documentation for ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " to elucidate the possible arguments. "
}], "Text",
 CellChangeTimes->{{3.562217991327833*^9, 3.5622180851316957`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"7149d0b9-78b1-4745-b74b-5dbd2f9626c9"],

Cell[TextData[{
 "One of the most important arguments for ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " are:\n1.  ",
 StyleBox["MaxStepSize",
  FontWeight->"Bold"],
 " which governs the maximum timestep used when solving the differential \
equations. The default used in ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " is Automatic. The adaptive numerical integrators of Mathematica will then \
try to choose the optimal ",
 StyleBox["MaxStepSize",
  FontWeight->"Bold"],
 ". However, in some cases, the ",
 StyleBox["MaxStepSize",
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "should be set manually. This could be in cases of large or strongly \
oscillating Hamiltonians. If in doubt some experimentation is needed.  \n2. \
",
 StyleBox["MaxSteps",
  FontWeight->"Bold"],
 " governs the largest number of steps used to divide up a time-dependent \
event, when using ",
 StyleBox["NDSolve",
  FontWeight->"Bold"],
 " for numerical solution of the differential equations. The default in ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " is Automatic. This may need to be increased in some cases. "
}], "Text",
 CellChangeTimes->{{3.5622180900053*^9, 3.562218222434689*^9}, {
  3.562218368765572*^9, 3.562218392050538*^9}, {3.5622187764528847`*^9, 
  3.562218858015408*^9}, {3.728210032666405*^9, 3.728210069060704*^9}, {
  3.7282101983666916`*^9, 3.72821026997598*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"d5bd9607-b2ac-424d-b85a-c9aae4dad3b7"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["TransformationAmplitude", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.544359813166822*^9}},
 CellTags->
  "TransformationAmplitude",ExpressionUUID->"e4303c9e-5faf-47b4-a121-\
a9bd709257f4"],

Cell["\<\
TransformationAmplitude provides the end result of a Trajectory calculation, \
i.e. an answer to questions such as \[OpenCurlyDoubleQuote]how much of \
operator b is generated when density operator a evolves under a sequence of \
events\[CloseCurlyDoubleQuote]? \
\>", "Text",
 CellChangeTimes->{{3.54459523743001*^9, 3.544595304956652*^9}, {
  3.544595805597172*^9, 
  3.544595814077085*^9}},ExpressionUUID->"6129abc7-2b7c-4228-ae4a-\
6a8ba5e62a5c"],

Cell[CellGroupData[{

Cell["single event", "Subsubsection",
 CellChangeTimes->{{3.574262147478273*^9, 
  3.574262149075801*^9}},ExpressionUUID->"1e552a48-af76-4513-ae47-\
946296ce998a"],

Cell[TextData[{
 "For example, evolving ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "z"], TraditionalForm]],ExpressionUUID->
  "950a3cd2-4aa7-48fb-b904-2e61f6bc212b"],
 " under a 180\[Degree] pulse inverts the sign of -",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "z"], TraditionalForm]],ExpressionUUID->
  "f654c27e-4a08-4dff-825b-d3709a44cd34"],
 ":"
}], "Text",
 CellChangeTimes->{{3.5445953085799446`*^9, 
  3.544595354857032*^9}},ExpressionUUID->"8a485f44-787e-4ea3-9362-\
8a3fed490bf8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TransformationAmplitude", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
   RowBox[{"Pulse", "[", 
    RowBox[{"{", 
     RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}]}], "]"}]], "Input",
