Cell["\<\
Trajectory calculates the expectation values of any number of operators at \
the same time (starting from the same initial condition), for example:\
\>", "Text",
 CellChangeTimes->{{3.5445511097311277`*^9, 3.544551184837406*^9}, {
  3.54455123272435*^9, 3.544551235284214*^9}, {3.544551275173427*^9, 
  3.544551301740365*^9}, {3.574262624227797*^9, 
  3.574262635917288*^9}},ExpressionUUID->"40607900-7094-47c1-bb51-\
2dfcac259648"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"xtraj", ",", "ytraj", ",", "ztraj"}], "}"}], "=", 
  "\[IndentingNewLine]", 
  RowBox[{"Trajectory", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"opI", "[", "\"\<x\>\"", "]"}], ",", 
       RowBox[{"opI", "[", "\"\<y\>\"", "]"}], ",", 
       RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"NutationFrequency", "\[Rule]", 
       RowBox[{"2", "\[Pi]"}]}], ",", 
      RowBox[{"AmplitudeFactor", "\[Rule]", "0.8"}]}], "]"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
  3.544550574860662*^9, 3.5445506029714*^9}, {3.5445506338562*^9, 
