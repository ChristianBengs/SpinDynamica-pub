Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"val", ",", "rules"}], "}"}], "=", 
  RowBox[{"MaximizeTransformationAmplitude", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Delay", "[", "\[Tau]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
