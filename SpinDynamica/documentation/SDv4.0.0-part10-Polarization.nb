 RowBox[{
  FractionBox["1", "8"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"4", " ", 
     SuperscriptBox["p", "2"], " ", 
     RowBox[{"(", 
      TagBox[
       RowBox[{
        TagBox[
