Cell[TextData[{
 StyleBox["SingletPolarizedDensityOperator",
  FontWeight->"Bold"],
 " is used to set up a density operator with a specified degree of singlet \
polarization for a set of spin pairs, or several spin pairs. "
}], "Text",
