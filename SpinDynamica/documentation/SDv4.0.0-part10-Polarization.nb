Cell["\<\
In the example below, a 2-spin-1/2 system is prepared in a fully polarized \
state, and a rf field is applied to just one of the spins. The simulation \
shows how the polarization level and singlet polarization level evolve:\
\>", "Text",
 CellChangeTimes->{{3.6811094136524158`*^9, 
  3.681109468215167*^9}},ExpressionUUID->"c3e438ac-8c8e-42a2-97d6-\
513ff875af79"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"ztraj", ",", "straj"}], "}"}], "=", 
  RowBox[{"Trajectory", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PolarizedDensityOperator", "[", "]"}], "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"PolarizationLevelOperator", "[", "]"}], ",", 
       RowBox[{"SingletPolarizationLevelOperator", "[", "]"}]}], "}"}]}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"2", "\[Pi]", " ", 
       RowBox[{"opI", "[", 
        RowBox[{"1", ",", "\"\<x\>\""}], "]"}]}], ",", "1"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ztraj", "[", "t", "]"}], ",", 
     RowBox[{"straj", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.6811088491280203`*^9, 3.68110885931251*^9}, {
  3.681109335387054*^9, 3.681109379778251*^9}, {3.6811094768905697`*^9, 
  3.681109519640234*^9}, {3.72821424238519*^9, 3.728214251937737*^9}},
 CellLabel->
  "In[475]:=",ExpressionUUID->"1497fb0a-e05a-48a1-ad13-29687b9a29c3"],

