        TagBox[
         TagBox[
          SubscriptBox["I", 
           RowBox[{"2", "z"}]],
          DisplayForm],
         DisplayForm]}],
       DisplayForm], ")"}]}], "+", 
    RowBox[{"4", " ", 
     SuperscriptBox["p", "2"], " ", 
     RowBox[{"(", 
      TagBox[
       RowBox[{
