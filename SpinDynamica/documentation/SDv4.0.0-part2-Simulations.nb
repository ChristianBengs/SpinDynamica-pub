Cell[CellGroupData[{

Cell["NormalizationFactor", "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 3.5445543033258867`*^9}, {
  3.575597754474698*^9, 
  3.575597758383108*^9}},ExpressionUUID->"5fa6fbfc-2982-4c4c-809c-\
01432eddb692"],

Cell["\<\
The option NormalizationFactor\[Rule]normfac may be used to divide the output \
of TransformationAmplitudeTable by normfac. The default value is 1. \
\>", "Text",
 CellChangeTimes->{{3.575597762439609*^9, 3.575597832357411*^9}, 
   3.575598001071224*^9, 
   3.575598189064661*^9},ExpressionUUID->"a85519e7-725a-4f0a-9f90-\
82692c3ef7cd"],

Cell["\<\
The example below shows the result of two calculations, one using the default \
value of NormalizationFactor, and one with a user-specified value.\
\>", "Text",
 CellChangeTimes->{{3.575598107295772*^9, 
  3.575598148087007*^9}},ExpressionUUID->"f5d7aa70-9f59-47cd-aafb-\
01a8aca8185c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TransformationAmplitudeTable", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Repeat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", "n"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "10"}], "}"}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"TransformationAmplitudeTable", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Repeat", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", "n"}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"NormalizationFactor", "\[Rule]", "2"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
   3.575597869524095*^9, 3.575597946793298*^9}, 3.575598018529356*^9, {
