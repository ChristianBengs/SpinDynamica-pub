   3.586353350701581*^9, 3.587554156287427*^9, 3.587572754870964*^9, 
   3.588071765869379*^9, 3.620580589425194*^9, 3.621573105167169*^9, 
   3.640873247531419*^9, 3.680340276364828*^9, 3.718534287834825*^9, {
   3.728129956387539*^9, 3.7281299618971553`*^9}, 3.7281312681636095`*^9, 
   3.728209818285396*^9, 3.728392268869232*^9, 3.7286332916370697`*^9, 
   3.7583038694286823`*^9, 3.7892898693899198`*^9, 3.816523243672484*^9, 
   3.8166802971134567`*^9, 3.816856718323533*^9, 3.8377806944955597`*^9, 
   3.8971550029575214`*^9, 3.910152014996715*^9, 3.916897619946419*^9, 
