Cell[TextData[{
 "If you want to average over 100 simulations, using equally spaced values of \
the rf nutation frequency between 1.0 kHz and 1.2 kHz, this is easily done \
using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["Subdivide",
  FontWeight->"Bold"],
 " routine:"
}], "Text",
 CellChangeTimes->{{3.5742616902476463`*^9, 3.574261810610693*^9}, {
  3.574261883738071*^9, 3.574261884801882*^9}, {3.680340631279723*^9, 
  3.680340632007653*^9}, {3.789290984238867*^9, 3.789291028603887*^9}, {
  3.789291136270143*^9, 
  3.789291148529297*^9}},ExpressionUUID->"ea826b2d-d067-4d1d-a37a-\
0634ede1922a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"10", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"EnsembleAverage", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        StyleBox["\[Omega]nut",
         FontWeight->"Bold"], 
