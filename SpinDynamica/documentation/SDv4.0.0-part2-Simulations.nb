3211aae915a4"],

Cell[TextData[{
 StyleBox["TransformationAmplitudeBounds",
  FontWeight->"Bold"],
 " provides the ",
 StyleBox["minimum",
  FontSlant->"Italic"],
 " and ",
 StyleBox["maximum possible",
  FontSlant->"Italic"],
 " ",
 StyleBox["TransformationAmplitude",
  FontWeight->"Bold"],
 " for a unitary transformation (corresponding to a pulse sequence neglecting \
relaxation). "
}], "Text",
 CellChangeTimes->{{3.54459523743001*^9, 3.544595304956652*^9}, {
  3.544595805597172*^9, 3.544595814077085*^9}, {3.544981524102762*^9, 
  3.544981581156332*^9}, {3.7282107164772086`*^9, 3.728210729681673*^9}, {
  3.728210800559784*^9, 
  3.728210802210464*^9}},ExpressionUUID->"6916dc65-8e2f-4429-b663-\
cb2bd33b5051"],

Cell["\<\
For the theory of bounds on transformation amplitudes, see O. W. \
S\[OSlash]rensen, J. Magn. Reson. 86, 435-440 (1990), M. H. Levitt, J. Magn. \
Reson. 99, 1 (1992) and M. H. Levitt, J. Magn. Reson. 262, 91 (2016).\
\>", "Text",
 CellChangeTimes->{{3.544981592851239*^9, 3.544981616170084*^9}, {
  3.5449816501134872`*^9, 3.544981672816813*^9}, {3.7282108147907352`*^9, 
  3.728210817165975*^9}, {3.728211098222125*^9, 
  3.728211134534662*^9}},ExpressionUUID->"0b69744f-f90e-4cde-aae7-\
86df7b2c86b6"],

Cell["\<\
For example, the calculation below shows that the polarization of an I-spin \
can be fully converted into the polarization of an S-spin:\
\>", "Text",
