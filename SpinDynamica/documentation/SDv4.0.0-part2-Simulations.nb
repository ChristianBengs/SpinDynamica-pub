Cell[CellGroupData[{

Cell["LineBroadening", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
  3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
  3.544606485581957*^9}, {3.544607568489716*^9, 
  3.544607572464236*^9}},ExpressionUUID->"acada425-df03-47d2-b52f-\
deb30f8d1a51"],

Cell[TextData[{
 "The option ",
 StyleBox["LineBroadening",
  FontWeight->"Bold"],
 " specifies the full-width-at-half-height of Lorentzian linebroadening, in \
units of rad ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "e6bbc384-a12d-4448-914f-dfe58c389835"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544791933819415*^9, 
  3.544791987642565*^9}},ExpressionUUID->"a2cd02d9-1b24-4a3c-9a2e-\
c48f81229b49"],

Cell[TextData[{
 "The default setting is ",
 StyleBox["Automatic",
  FontWeight->"Bold"],
 ", which sets the LineBroadening so as to reduce the signal envelope to 1% \
at the end of the time-domain signal. The setting ",
 StyleBox["LineBroadening\[Rule]None",
  FontWeight->"Bold"],
 " may be used to eliminate the linebroadening, for example: "
}], "Text",
 CellChangeTimes->{{3.54479200138356*^9, 
  3.544792066930216*^9}},ExpressionUUID->"d5119d01-293a-4123-874c-\
92bada985fc8"],

