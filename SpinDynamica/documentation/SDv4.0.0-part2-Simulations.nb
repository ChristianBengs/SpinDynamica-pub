Cell[TextData[{
 "It is also possible to specify the spectral bandwidth (in rad\
\[NonBreakingSpace]",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "1ddc14fb-fff6-4d11-bc14-563ec9884195"],
 ") and the number of points, using the syntax {tmin,{\[Omega]SW,npoints}}. \
In the example below, the spectral bandwidth is specified as 200\
\[NonBreakingSpace]Hz and the number of points as 1k:"
}], "Text",
 CellChangeTimes->{{3.626944161663739*^9, 3.62694421599879*^9}, {
  3.626944328811018*^9, 3.626944409408046*^9}, {3.626944484515504*^9, 
  3.626944510205832*^9}},ExpressionUUID->"2f034e57-eb8a-4e61-89c4-\
98ea76163a5d"],

