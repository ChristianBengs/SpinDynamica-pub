   3.744543212972415*^9}, {3.744543287158846*^9, 
   3.744543316834241*^9}},ExpressionUUID->"c1e6191a-dca6-4912-93ce-\
1e1b255ec8bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", 
     RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "400"}], ",", "1024"}], "}"}], "}"}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Preparation", "\[Rule]", 
        RowBox[{"Pulse", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], ",", 
          RowBox[{"NutationFrequency", "\[Rule]", 
           RowBox[{"2", "\[Pi]", " ", "5"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "]"}]], "Input",
