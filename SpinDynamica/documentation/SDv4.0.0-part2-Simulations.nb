Cell[TextData[StyleBox["Signal1D[{tmin,tmax,dt}, events, options]",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.5446065079171*^9, 3.544606555274903*^9}, {
  3.544964737313364*^9, 
  3.544964738985202*^9}},ExpressionUUID->"8bb2eba8-9580-47fb-bc91-\
bedd4cde0883"],

Cell[TextData[{
 "where ",
 StyleBox["events",
  FontWeight->"Bold"],
 " specifies the list of events happening during the signal detection. This \
allows simulation of the magnetic resonance signal during a pulse sequence. \
In the following simulation an rf field is turned on during the first 0.1 \
second of the signal detection. The rest of the signal detection interval is \
automatically padded with an event of the form ",
 StyleBox["{None,\[NonBreakingSpace]\[Tau]}:",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.544606567281096*^9, 3.544606652407436*^9}, {
  3.544964744206328*^9, 3.544964829222454*^9}, {3.54496588651092*^9, 
  3.544965926121127*^9}, {3.574843715442289*^9, 
  3.574843778939567*^9}},ExpressionUUID->"779be54a-9a2b-49b1-8445-\
eaed7efe9046"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "30", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "10"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "20", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signal", "=", 
   RowBox[{"Signal1D", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"{", "200", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "\[Pi]", " ", "100", " ", 
         RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", "0.1"}], "}"}], "}"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "[", "signal", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.544606679050853*^9, 3.544606709024903*^9}, {
   3.544606894033489*^9, 3.544606894324732*^9}, {3.544607032160694*^9, 
