Cell[TextData[{
 StyleBox["EnsembleAverage may also be combined with the powerful routines in \
",
  FontSlant->"Plain"],
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 StyleBox[" for generating and sampling random distributions. ",
  FontSlant->"Plain"],
 "For example, an inhomogeneous rf field is more accurately by simulated by \
constructing a normally distributed ensemble of rf nutation frequencies. The ",
 StyleBox["RandomVariate",
  FontWeight->"Bold"],
 " routine of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " may be used to generate a set of 1000 random values sampled from a normal \
distribution. In the example below the distribution is centred at 1 kHz with \
a standard deviation of 100 Hz:"
}], "Text",
 CellChangeTimes->{{3.544554557078017*^9, 3.544554559006209*^9}, {
   3.544554596732869*^9, 3.544554672043668*^9}, {3.544554780258999*^9, 
   3.544554818527129*^9}, {3.5445549046335793`*^9, 3.544554932328446*^9}, 
   3.544555042541198*^9, {3.544555105943862*^9, 3.544555107391218*^9}, {
   3.544555238882214*^9, 3.544555240343045*^9}, {3.574261950038026*^9, 
   3.574261962746757*^9}, {3.789291162656488*^9, 3.789291188866481*^9}, {
   3.789291245541361*^9, 
   3.789291246059915*^9}},ExpressionUUID->"8b2a4c8b-c401-4aa9-ac37-\
b8d6554ec4bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   StyleBox["\[Omega]nutvals",
    FontWeight->"Bold"], 
   StyleBox["=",
    FontWeight->"Bold"], 
   RowBox[{
    StyleBox["RandomVariate",
     FontWeight->"Bold"], 
    StyleBox["[",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"10", "^", "3"}]}], ",", 
       RowBox[{"2", "\[Pi]", " ", "100"}]}], "]"}], ",", "1000"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.544554649694259*^9, 3.544554653936666*^9}, {
  3.544554824691914*^9, 3.5445548855870256`*^9}, {3.544554964786289*^9, 
  3.544554968195831*^9}, {3.544555045686769*^9, 3.544555045855717*^9}, {
  3.789291194216935*^9, 3.789291194484528*^9}, {3.789291248743388*^9, 
  3.789291251156454*^9}},
 CellLabel->
  "In[192]:=",ExpressionUUID->"ac878e5c-d5cf-471f-b1aa-8e1dbe97c10b"],

Cell["You can examine the distribution of values using Histogram", "Text",
 CellChangeTimes->{{3.789291207007062*^9, 
  3.7892912168469*^9}},ExpressionUUID->"78684723-8785-447c-82dc-bde52e87c1e6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Histogram", "[", 
  StyleBox[
   RowBox[{"\[Omega]nutvals", "/", 
    RowBox[{"(", 
     RowBox[{"2", "\[Pi]"}], ")"}]}],
   FontWeight->"Bold"], 
  StyleBox["]",
   FontWeight->"Bold"]}]], "Input",
 CellChangeTimes->{{3.789291220061154*^9, 3.789291233084858*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"82101e6d-941e-446e-ba72-58ed203b9ca4"],

Cell[BoxData[
 GraphicsBox[{
