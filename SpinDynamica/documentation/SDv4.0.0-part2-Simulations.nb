Cell[TextData[{
 "Surprisingly, it is ",
 StyleBox["not",
  FontSlant->"Italic"],
 " possible to obtain more polarization on the S-spin if there are ",
 StyleBox["two",
  FontSlant->"Italic"],
 " I-spins:"
}], "Text",
