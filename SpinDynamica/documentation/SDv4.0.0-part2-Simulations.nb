  1, 0.925, 0.925],ExpressionUUID->"c6470dc4-957c-4f0f-97d0-b56e03a49070"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "30", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "10"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "20", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signal", "=", "\[IndentingNewLine]", 
   RowBox[{"Signal1D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"{", "200", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Repeat", "[", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], "\[Pi]", " ", "100", " ", 
           RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
          RowBox[{"5", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "100", " ", 
           RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
          RowBox[{"5", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}]}]}], "}"}]}], "}"}], "\[IndentingNewLine]", 
      "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "[", "signal", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
