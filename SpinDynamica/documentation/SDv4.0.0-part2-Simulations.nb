Cell["\<\
Repeat may be used to generate a repetitive pulse sequence starting at the \
beginning of the signal detection. In the example below, a set of 2 events is \
repeated 10 times at the beginning of signal detection.\
\>", "Text",
 CellChangeTimes->{{3.544965175332732*^9, 3.544965211317807*^9}, {
   3.572631902163043*^9, 3.572631902728375*^9}, {3.574269396517744*^9, 
   3.574269415259547*^9}, 
   3.709550959047127*^9},ExpressionUUID->"08b3fb7d-a798-43ab-9c56-\
3c4390ef49f8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "30", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "10"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "20", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signal", "=", "\[IndentingNewLine]", 
   RowBox[{"Signal1D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", 
       RowBox[{"{", "200", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Repeat", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], "\[Pi]", " ", "100", " ", 
            RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "\[Pi]", " ", "100", " ", 
            RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "10"}], "\[IndentingNewLine]", "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "[", "signal", "]"}], ",", "\[IndentingNewLine]", 
