Cell["\<\
As before, Mathematica\[CloseCurlyQuote]s 3D routines are easily used to plot \
the magnetization trajectories during the chirp:\
\>", "Text",
 CellChangeTimes->{{3.58807198809141*^9, 3.58807200830683*^9}, {
  3.588072051742644*^9, 
  3.588072067870603*^9}},ExpressionUUID->"b8362ce1-4948-4b10-ba14-\
0486b761dc37"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xtraj", ",", "ytraj", ",", "ztraj"}], "}"}], "=", 
   RowBox[{"Trajectory", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}], ",", 
        RowBox[{"opI", "[", "\"\<y\>\"", "]"}], ",", 
        RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "ChirpPulse"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SphereAndAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xtraj", "[", "t", "]"}], ",", 
       RowBox[{"ytraj", "[", "t", "]"}], ",", 
       RowBox[{"ztraj", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"Duration", "[", "ChirpPulse", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Axes", "\[Rule]", "None"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Boxed", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
