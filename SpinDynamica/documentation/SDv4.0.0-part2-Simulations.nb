Cell["\<\
A frequent use of this is to normalize the result of a calculation against \
the thermal equilibrium signal. For example, the lines below determine the \
thermal equilibrium density operator for protons at a Larmor frequency of \
-500 MHz and temperature 300 K, and then determine the thermal equilibrium \
z-magnetization:\
\>", "Text",
 CellChangeTimes->{{3.616752252097225*^9, 3.616752363387534*^9}, 
   3.616752504021174*^9},ExpressionUUID->"531d87fa-13a2-499f-9b69-\
c1dac264f17a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Omega]0", "=", 
   RowBox[{"2", "\[Pi]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "500"}], " ", 
      SuperscriptBox["10", "6"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Temperature", "=", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]eq", "=", 
   RowBox[{"ThermalEquilibriumDensityOperator", "[", 
    RowBox[{
     RowBox[{"\[Omega]0", " ", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "Temperature"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{"Meq", "=", 
  RowBox[{"OperatorAmplitude", "[", 
   RowBox[{"\[Rho]eq", "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.6167523369709578`*^9, 3.616752399969191*^9}, {
  3.616752506800912*^9, 3.616752549701148*^9}},
 CellLabel->
  "In[202]:=",ExpressionUUID->"a76fc7b2-b828-4bf5-81e4-ff295b6501db"],

