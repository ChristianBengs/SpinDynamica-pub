Cell[TextData[{
 "Note that the optimized value is +1, since the routine was instructed to \
maximize the conversion of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "z"], TraditionalForm]],ExpressionUUID->
  "2d407920-6aa4-4d2f-a521-b228cb966076"],
 " to -",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "z"], TraditionalForm]],ExpressionUUID->
  "74085fd0-64b9-4a1a-a80d-9f0ba1b2d019"],
 ". "
}], "Text",
 CellChangeTimes->{{3.744294858932683*^9, 3.744294915432353*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"e2bb2297-9ddf-4c26-962a-147991b233df"],

Cell["\<\
The same optimization can give a different value when a different starting \
point is chosen:\
\>", "Text",
 CellChangeTimes->{{3.744294923256415*^9, 3.7442949424409866`*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"edbdfd33-e162-4fe8-866c-6fd6abf12ff9"],

