Cell[CellGroupData[{

Cell["Preparation", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
   3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
   3.544606485581957*^9}, {3.544607568489716*^9, 3.544607607441374*^9}, {
   3.5446076513588247`*^9, 3.5446076541501307`*^9}, 3.5446238104708157`*^9, {
   3.54496653211151*^9, 3.544966534189505*^9}},
 CellTags->
  "Preparation",ExpressionUUID->"8b347e6d-e1e1-4210-91b0-4dc57ffa7db0"],

Cell[TextData[{
 "The option ",
 StyleBox["Preparation",
  FontWeight->"Bold"],
 " is used to define the preparation sequence applied to the spin density \
operator, before the signal is detected. "
}], "Text",
 CellChangeTimes->{{3.544623820956916*^9, 3.544623864194604*^9}, {
  3.544966538251601*^9, 
  3.544966570263727*^9}},ExpressionUUID->"5572d01a-07c2-4a54-a86b-\
6dd0c3ba39b0"],

Cell[TextData[{
 "The default value of ",
 StyleBox["Preparation",
  FontWeight->"Bold"],
 " is ",
 StyleBox["Pulse[{\[Pi]/2,\[CloseCurlyDoubleQuote]x\[CloseCurlyDoubleQuote]}]",
  FontWeight->"Bold"],
 ", implying an ideal 90\[Degree] pulse of phase 0, applied to all spins in \
the system. "
}], "Text",
 CellChangeTimes->{{3.544623870508128*^9, 3.544623904887675*^9}, {
  3.5449665744846487`*^9, 3.544966618603216*^9}, {3.816862704287526*^9, 
  3.816862705088595*^9}},ExpressionUUID->"57fe75be-ce9b-4935-9fbf-\
485fdd6c920b"],

