Cell["\<\
In the following simulation, the trajectory of z-magnetization is simulated \
during a 360\[Degree] pulse applied to a thermal equilibrium state, and \
normalized against the thermal equilibrium magnetization:\
\>", "Text",
 CellChangeTimes->{{3.61675241683466*^9, 
  3.616752477041358*^9}},ExpressionUUID->"6d24ea4a-0bb4-488e-b782-\
57ee62d6d7a0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{"\[Rho]eq", "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", "1"}], "}"}], ",", 
     RowBox[{"NormalizationFactor", "\[Rule]", "Meq"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time /s\>\"", 
      ",", "\"\<\!\(\*SubscriptBox[\(M\), \(z\)]\)/\!\(\*SubscriptBox[\(M\), \
\(eq\)]\)\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.616752562166156*^9, 3.616752608058387*^9}, {
  3.789291343309313*^9, 3.7892913959511137`*^9}},
 CellLabel->
  "In[207]:=",ExpressionUUID->"0beb6025-c1d8-4c2c-b080-bf54c342979d"],

