Cell[TextData[{
 "A numerical value may also be given for ",
 StyleBox["LineBroadening",
  FontWeight->"Bold"],
 ". This specifies the full-width-at-half-height for the spectrum after \
Lorentzian linebroadening, in units of rad ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "ce68e03c-9cc8-41fe-99b3-0a551a2d1624"],
 ":"
}], "Text",
