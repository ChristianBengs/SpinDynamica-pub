Cell[CellGroupData[{

Cell["EnsembleAverage", "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 
  3.5445543033258867`*^9}},ExpressionUUID->"0e48671b-05f8-4728-acdb-\
694dabb068c5"],

Cell[TextData[{
 "The ",
 ButtonBox["EnsembleAverage",
  BaseStyle->"Hyperlink",
  ButtonData->"EnsembleAverage"],
 " option may be used to take the weighted sum of many trajectories. "
}], "Text",
 CellChangeTimes->{{3.5445543661919*^9, 3.5445544034898767`*^9}, {
  3.544554442402239*^9, 
  3.5445544670540752`*^9}},ExpressionUUID->"c7bf967e-56f2-4816-b876-\
afbe5640951c"],

Cell["\<\
For example, consider this simulation of the nutation of z-magnetization \
under a rf field along the x-axis:\
\>", "Text",
 CellChangeTimes->{{3.5445544698938923`*^9, 
  3.54455450195959*^9}},ExpressionUUID->"9b1c063f-a8e9-4782-84e3-\
2012dea2e170"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"traj", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"10", "^", "3"}], " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", 
       RowBox[{"10", " ", 
        RowBox[{"10", "^", 
         RowBox[{"-", "3"}]}]}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"traj", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "3"}]}]}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445545057470436`*^9, 3.544554588440064*^9}, {
  3.816861525533054*^9, 3.8168615421842957`*^9}},
