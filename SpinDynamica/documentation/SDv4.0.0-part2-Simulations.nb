cea6408f4f11"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TransformationAmplitudeTable", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"AmplitudeFactor", "\[Rule]", "ampfac"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"ampfac", ",", "0", ",", "2", ",", 
      RowBox[{"{", "20", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"TableCoordinates", "\[Rule]", 
     RowBox[{"ampfac", "*", "100"}]}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"%", ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<amplitude factor / %\>\"", ",", "\"\<z\[Rule]z\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445961686990156`*^9, 3.544596213700069*^9}, {
