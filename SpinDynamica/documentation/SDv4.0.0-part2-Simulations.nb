Cell[TextData[{
 "An additional Hamiltonian may be specified to simulate the effect of a \
continuous decoupling field applied to the I-spins, throughout the entire \
detection interval. This Hamiltonian is combined with the ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.544957064933367*^9, 3.544957093579094*^9}, {
   3.544957191873803*^9, 3.544957270383176*^9}, {3.574264258327318*^9, 
