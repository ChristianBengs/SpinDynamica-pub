Cell["Options and defaults", "Subsection",
 CellChangeTimes->{{3.544465375144247*^9, 3.544465378279257*^9}, {
  3.54446541289677*^9, 
  3.544465416967773*^9}},ExpressionUUID->"08551068-3ebf-47a0-85ab-\
979f1ffb38c9"],

Cell[TextData[{
 "All ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " routines use the standard structure of ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " objects. Routines are summoned using replacement rules of the form ",
 StyleBox["a\[Rule]b",
  FontWeight->"Bold"],
 " for the optional parameters (the symbol \[Rule] may be typeset using \
[esc]->[esc] where [esc] is the \[OpenCurlyDoubleQuote]escape\
\[CloseCurlyDoubleQuote] key). If these specifications are omitted, the \
routine uses defaults which are often appropriate. "
}], "Text",
 CellChangeTimes->{{3.544465545740328*^9, 3.5444656631546903`*^9}, {
  3.544466984021751*^9, 3.54446698444738*^9}, {3.544549168228601*^9, 
  3.544549241798909*^9}, {3.544549317124732*^9, 3.544549378197194*^9}, {
  3.574259690663043*^9, 
  3.574259695956182*^9}},ExpressionUUID->"f60c496d-3fd5-404e-9c53-\
a61f356608ad"],

Cell[TextData[{
 "For example, consider the routine ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " discussed below. The default settings for the ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " options may be examined as follows:"
}], "Text",
 CellChangeTimes->{{3.544465668362971*^9, 
  3.544465711977125*^9}},ExpressionUUID->"f1068fa2-3b79-4c2e-8076-\
c2c89576491e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "Trajectory", "]"}]], "Input",
 CellChangeTimes->{{3.544465717159956*^9, 3.544465720516458*^9}},
 CellLabel->
  "In[146]:=",ExpressionUUID->"2c386bba-f191-4398-8f25-a3cb383eb41e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"OperatorBasis", "\[RuleDelayed]", 
    RowBox[{"ZeemanKetBraOperatorBasis", "[", "]"}]}], ",", 
   RowBox[{"Basis", "\[RuleDelayed]", 
    RowBox[{"ZeemanBasis", "[", "]"}]}], ",", 
   RowBox[{"NormalizationFactor", "\[Rule]", "None"}], ",", 
   RowBox[{"UseMatrixExpWhenPossible", "\[Rule]", "True"}], ",", 
   RowBox[{"UseHilbertSpaceWhenPossible", "\[Rule]", "True"}], ",", 
   RowBox[{"UseDiagonalizationWhenPossible", "\[Rule]", "False"}], ",", 
   RowBox[{"InitialTimePoint", "\[Rule]", "0"}], ",", 
   RowBox[{"FinalTimePoint", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"BackgroundGenerator", "\[Rule]", "None"}], ",", 
   RowBox[{"EnsembleAverage", "\[Rule]", "False"}], ",", 
   RowBox[{"InterpolationPoints", "\[Rule]", "1000"}], ",", 
   RowBox[{"AccuracyGoal", "\[Rule]", "10"}], ",", 
   RowBox[{"PrecisionGoal", "\[Rule]", "10"}], ",", 
   RowBox[{"MaxSteps", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"MaxStepSize", "\[Rule]", "Automatic"}], ",", 
   RowBox[{
   "Simulations`Simulations`Private`InterpolationStepSize", "\[Rule]", 
    "1.`*^-6"}], ",", 
   RowBox[{"Chronology", "\[RuleDelayed]", "$Chronology"}], ",", 
   RowBox[{"Parallel", "\[Rule]", "True"}], ",", 
   RowBox[{"MaxBatchSize", "\[Rule]", "128"}], ",", 
   RowBox[{"MinimumRecommendedUserLevel", "\[Rule]", "2"}]}], "}"}]], "Output",
 CellChangeTimes->{3.718534287643494*^9, 3.728129956162904*^9, 
  3.728131267965408*^9, 3.728209818144788*^9, 3.728392268648757*^9, 
