Cell[CellGroupData[{

Cell["NormalizationFactor", "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 3.5445543033258867`*^9}, {
  3.575597754474698*^9, 
  3.575597758383108*^9}},ExpressionUUID->"d921b779-d2fa-45c9-8ee8-\
bfbdc7eee98f"],

Cell[TextData[{
 "The option ",
 StyleBox["NormalizationFactor\[Rule]",
  FontWeight->"Bold"],
 StyleBox["normfac",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "may be used to divide the output of ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " by ",
 StyleBox["normfac",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"],
 "The default value is 1. "
}], "Text",
 CellChangeTimes->{{3.575597762439609*^9, 3.575597832357411*^9}, 
   3.575598001071224*^9, 3.575598189064661*^9, 
   3.575598306303976*^9},ExpressionUUID->"a845605c-11fd-4974-896a-\
f3dc37707939"],

Cell[TextData[{
 "The example below shows the result of two calculations, one using the \
default value of ",
 StyleBox["NormalizationFactor",
  FontWeight->"Bold"],
 ", and one with a user-specified value."
}], "Text",
 CellChangeTimes->{{3.575598107295772*^9, 
  3.575598148087007*^9}},ExpressionUUID->"909f6e80-9792-4999-8cf1-\
29a640b7154f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "30", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "10"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "20", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "@", 
  RowBox[{"Re", "@", 
   RowBox[{"FT", "@", 
    RowBox[{"Signal1D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "\[Pi]", " ", "400"}], ",", "200"}], "}"}], "}"}], ",", 
      "H0"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "@", 
  RowBox[{"Re", "@", 
   RowBox[{"FT", "@", 
    RowBox[{"Signal1D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", 
        RowBox[{"1", "/", "200"}]}], "}"}], ",", "H0", ",", 
      RowBox[{"NormalizationFactor", "\[Rule]", 
       RowBox[{"1", "/", "100"}]}]}], "]"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
