  3.575597758383108*^9}},ExpressionUUID->"4a0c5638-d028-4c41-a7ec-\
4f695dba16e5"],

Cell["\<\
The option NormalizationFactor\[Rule]normfac may be used to divide the output \
of TransformationAmplitude by normfac. The default value is 1. \
\>", "Text",
 CellChangeTimes->{{3.575597762439609*^9, 3.575597832357411*^9}, 
   3.575598001071224*^9},ExpressionUUID->"f279fda2-0207-49f5-bc05-\
72456a03a67d"],

Cell["\<\
The example below shows the result of two calculations, one using the default \
value of NormalizationFactor, and one with a user-specified value.\
\>", "Text",
 CellChangeTimes->{{3.575598107295772*^9, 
  3.575598148087007*^9}},ExpressionUUID->"e71329ee-437e-4a90-b48f-\
80a2aa9000fd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TransformationAmplitude", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
   RowBox[{"Pulse", "[", 
    RowBox[{"{", 
     RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"TransformationAmplitude", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", 
   RowBox[{"Pulse", "[", 
    RowBox[{"{", 
     RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", 
