Cell["This inhibits the generation of valid but wild solutions.", "Text",
 CellChangeTimes->{{3.744294993926008*^9, 3.744295053936685*^9}, {
  3.744295209228378*^9, 3.744295234772731*^9}, {3.74429530877512*^9, 
  3.744295324724615*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"006ede28-b576-4cc5-9daa-7a189615e463"],

Cell["\<\
Another way of adding constraints is to use the ConstrainPositive option. \
This allows one to specify that one or more optimization parameters may only \
take positive values, which is commonly the case when, for example, a delay \
is optimized. \
\>", "Text",
 CellChangeTimes->{{3.744295249174073*^9, 3.744295282431486*^9}, {
  3.744295332183479*^9, 3.74429536492052*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"f5663d64-42df-4875-8990-3bf9af7a12ca"],

Cell["\<\
In the following example, a sequence of two pulses, separated by a delay, is \
optimized in order to invert the z-magnetization, under a given resonance \
offset. The flip angles and delay duration must always be positive, while the \
phase of the second pulse is not constrained:\
\>", "Text",
 CellChangeTimes->{{3.744295368371366*^9, 3.7442954526772637`*^9}},
 Background->RGBColor[
  0.94, 0.88, 0.94],ExpressionUUID->"a165459e-f4cb-4893-941d-c6c4b4f081a4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"val", ",", "rules"}], "}"}], "=", 
  RowBox[{"MaximizeTransformationAmplitude", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Delay", "[", "\[Tau]", "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Pulse", "[", 
       RowBox[{"{", 
        RowBox[{"\[Beta]", ",", "\[Phi]"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", 
        RowBox[{"\[Pi]", "/", "10"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0.001"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"BackgroundGenerator", "\[Rule]", 
     RowBox[{"2", "\[Pi]", " ", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"ConstrainPositive", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\[Beta]", ",", "\[Tau]"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
