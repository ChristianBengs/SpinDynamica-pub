Cell[CellGroupData[{

Cell["EnsembleAverage", "Subsubsection",
 CellChangeTimes->{{3.544595756798325*^9, 3.544595769301099*^9}, {
  3.574262905860809*^9, 
  3.574262910963329*^9}},ExpressionUUID->"9a9bec3e-03f6-4917-a731-\
bc8914935a43"],

Cell["\<\
EnsembleAverage may be used together with TransformationAmplitudeTable. The \
following example plots the offset dependence of a composite pulse, including \
also a range in rf amplitudes. The x-coordinates are converted to Hz:\
\>", "Text",
 CellChangeTimes->{{3.544596336436264*^9, 3.544596407049268*^9}, {
   3.544604749592227*^9, 3.5446047701736*^9}, {3.5742629296211143`*^9, 
   3.5742629794992323`*^9}, {3.574263101150847*^9, 3.5742631381616507`*^9}, 
   3.7095479293297544`*^9, {3.7095483664797554`*^9, 3.709548367135496*^9}, {
   3.816862145402826*^9, 3.8168622197967024`*^9}, {3.816862253509678*^9, 
   3.816862254297321*^9}, {3.816862467111912*^9, 
   3.816862477710875*^9}},ExpressionUUID->"b5dd188a-09a8-42ac-8d2d-\
db6672b8e4b2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"TransformationAmplitudeTable", "[", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\n", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"AmplitudeFactor", "\[Rule]", "ampfac"}], ",", 
      RowBox[{"NutationFrequency", "\[Rule]", 
       RowBox[{"2", "\[Pi]", " ", "1", " ", 
        SuperscriptBox["10", "3"]}]}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"\[CapitalOmega]", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Pi]", " ", "2", " ", 
       SuperscriptBox["10", "3"]}], ",", 
      RowBox[{"2", "\[Pi]", " ", "2", " ", 
       SuperscriptBox["10", "3"]}], ",", 
      RowBox[{"{", "51", "}"}]}], "}"}], ",", 
    RowBox[{"EnsembleAverage", "->", 
     RowBox[{"{", 
      RowBox[{"ampfac", ",", 
       RowBox[{"Range", "[", 
        RowBox[{"0.5", ",", "1.5", ",", "0.1"}], "]"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"BackgroundGenerator", "\[Rule]", 
     RowBox[{"\[CapitalOmega]", " ", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"TableCoordinates", "\[Rule]", 
     RowBox[{"\[CapitalOmega]", "/", 
      RowBox[{"(", 
       RowBox[{"2", "\[Pi]"}], ")"}]}]}]}], "\n", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"%", ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<resonance offset / Hz\>\"", ",", "\"\<z\[Rule]z\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.816862183449243*^9, 3.816862183450488*^9}, {
