Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"traj", "=", 
  RowBox[{"Trajectory", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"PulseSequence", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "\[Pi]"}], ",", "\"\<-x\>\""}], "}"}], "]"}], ",", 
        RowBox[{"Pulse", "[", 
         RowBox[{"{", 
          RowBox[{"\[Pi]", ",", "\"\<x\>\""}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"NutationFrequency", "\[Rule]", 
       RowBox[{"2", "\[Pi]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
  3.544550574860662*^9, 3.5445506029714*^9}, {3.5445506338562*^9, 
  3.5445507080017986`*^9}, {3.54455074311629*^9, 3.54455079533016*^9}, {
  3.816858768349782*^9, 3.816858819609671*^9}},
 CellLabel->
  "In[159]:=",ExpressionUUID->"d81a97c1-56fe-4960-85b7-7d4b8240d945"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"TrajectoryFunction", "["}], 
   TagBox[
