Cell[TextData[{
 "A ",
 StyleBox["Signal",
  FontWeight->"Bold"],
 " object may be converted into the frequency domain by applying the complex \
Fourier transform routine ",
 StyleBox["FT ",
  FontWeight->"Bold"],
 "(this is a ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " routine which is an extension of the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " routine ",
 StyleBox["Fourier",
  FontWeight->"Bold"],
 "). "
}], "Text",
 CellChangeTimes->{{3.54460711914415*^9, 
  3.544607191837938*^9}},ExpressionUUID->"49ca71c2-ff69-4253-9c2c-\
b5e088b08d1a"],

