Cell[TextData[{
 "A weak preparation pulse may be defined by using the ",
 StyleBox["Pulse",
  FontWeight->"Bold"],
 " routine, but including a specification for either ",
 StyleBox["PulseDuration",
  FontWeight->"Bold"],
 " or ",
 StyleBox["NutationFrequency",
  FontWeight->"Bold"],
 ". In the example below, the nutation frequency of the pulse is set to 5 Hz, \
leading to a high degree of frequency selectivity:"
}], "Text",
 CellChangeTimes->{{3.544624298172449*^9, 3.544624307283445*^9}, {
   3.544966635797387*^9, 3.544966637683978*^9}, {3.544966692218857*^9, 
   3.54496669643923*^9}, {3.54496673052956*^9, 3.544966738802372*^9}, {
   3.544966814425617*^9, 3.54496683281571*^9}, {3.57426657345147*^9, 
