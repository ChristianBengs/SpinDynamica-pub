  RowBox[{
   RowBox[{
    RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"opI", "[", "\"\<x\>\"", "]"}], ",", 
      RowBox[{"opI", "[", "\"\<y\>\"", "]"}], ",", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], "}"}]}], ",", 
   RowBox[{"Pulse", "[", 
