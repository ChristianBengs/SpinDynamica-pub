Cell[CellGroupData[{

Cell["NormalizationFactor", "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 3.5445543033258867`*^9}, {
  3.575597754474698*^9, 
  3.575597758383108*^9}},ExpressionUUID->"43a2bc69-6f70-44f1-ae75-\
60e8940b78a9"],

Cell[TextData[{
 "The option ",
 StyleBox["NormalizationFactor\[Rule]",
  FontWeight->"Bold"],
 StyleBox["normfac",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "may be used to divide the output of ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " by ",
 StyleBox["normfac",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"],
 "The default value is 1. "
}], "Text",
 CellChangeTimes->{{3.575597762439609*^9, 
  3.575597832357411*^9}},ExpressionUUID->"f8e27ae6-93a5-480e-8bc5-\
506ddffa9ff0"],

Cell[TextData[{
 "The example below shows the result of two calculations, one using the \
default value of ",
 StyleBox["NormalizationFactor",
  FontWeight->"Bold"],
 ", and one with a user-specified value."
}], "Text",
 CellChangeTimes->{{3.575598107295772*^9, 
  3.575598148087007*^9}},ExpressionUUID->"1c17aa2f-e64c-4d84-b916-\
93977d500233"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"traj1", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", "1"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"traj2", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], ",", "1"}], "}"}], ",", 
     RowBox[{"NormalizationFactor", "\[Rule]", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"traj1", "[", "t", "]"}], ",", 
     RowBox[{"traj2", "[", "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
  3.575597869524095*^9, 3.575597946793298*^9}},
 CellLabel->
  "In[198]:=",ExpressionUUID->"05b87070-dede-43b1-b39d-f73481a27978"],

