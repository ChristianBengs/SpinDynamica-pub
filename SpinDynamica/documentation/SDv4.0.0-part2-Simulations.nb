Cell["\<\
The magnetization trajectories under this sequence of off-resonance pulses \
may be plotted using ParametricPlot3D, as before:\
\>", "Text",
 CellChangeTimes->{{3.588071838378172*^9, 
  3.588071866442315*^9}},ExpressionUUID->"8c845459-cc45-480a-bf03-\
e61c15fb2ea8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xtraj", ",", "ytraj", ",", "ztraj"}], "}"}], "=", 
   RowBox[{"Trajectory", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"opI", "[", "\"\<x\>\"", "]"}], ",", 
        RowBox[{"opI", "[", "\"\<y\>\"", "]"}], ",", 
        RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PulseSequence", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{"\[Pi]", ",", "\"\<y\>\""}], "}"}], "]"}], ",", 
         RowBox[{"Pulse", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Pi]", "/", "2"}], ",", "\"\<x\>\""}], "}"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"NutationFrequency", "\[Rule]", 
        RowBox[{"2", "\[Pi]"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", 
      RowBox[{"2", "\[Pi]", " ", "0.2", " ", 
       RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"SphereAndAxes", "[", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"ParametricPlot3D", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xtraj", "[", "t", "]"}], ",", 
       RowBox[{"ytraj", "[", "t", "]"}], ",", 
       RowBox[{"ztraj", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"5", "/", "6"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Axes", "\[Rule]", "None"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Boxed", "\[Rule]", "False"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
