Cell[BoxData[{
 RowBox[{
  RowBox[{"ChirpDuration", "=", 
   RowBox[{"200", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ChirpWidth", "=", 
   RowBox[{"2", "\[Pi]", " ", 
    RowBox[{"10", "^", "3"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ChirpAmplitude", "=", 
   RowBox[{"2", "\[Pi]", " ", "100"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ChirpPulse", "=", 
   RowBox[{"ShapedPulse", "[", 
    RowBox[{"ChirpDuration", ",", 
     RowBox[{"{", 
      RowBox[{"tloc", ",", 
       RowBox[{"{", 
        RowBox[{"ChirpAmplitude", ",", "0", ",", 
         RowBox[{"ChirpWidth", " ", 
          RowBox[{"(", 
           RowBox[{"tloc", "/", "ChirpDuration"}], ")"}]}]}], "}"}]}], 
      "}"}]}], "]"}]}], ";"}]}], "Input",
