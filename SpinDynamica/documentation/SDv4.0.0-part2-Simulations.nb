Cell["\<\
The same effect is achieved by adding the offset Hamiltonian to all events. \
However the use of BackgroundGenerator is more compact and convenient, and \
also evaluates faster in many cases. \
\>", "Text",
 CellChangeTimes->{{3.574261405082075*^9, 3.574261427892973*^9}, {
   3.574261478179886*^9, 3.57426149095542*^9}, {3.680340505644738*^9, 
   3.680340514812875*^9}, 
   3.709547927519613*^9},ExpressionUUID->"7e4346e7-b6ad-4389-b736-\
7ac9b66a4807"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ztraj3", "=", 
   RowBox[{"Trajectory", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
      RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", 
           RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], "+", 
          RowBox[{"2", "\[Pi]", " ", "0.1", " ", 
           RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", 
         RowBox[{"1", "/", "4"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", 
           RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], "+", 
          RowBox[{"2", "\[Pi]", " ", "0.1", " ", 
           RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", 
         RowBox[{"1", "/", "2"}]}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", 
           RowBox[{"opI", "[", "\"\<x\>\"", "]"}]}], "+", 
          RowBox[{"2", "\[Pi]", " ", "0.1", " ", 
           RowBox[{"opI", "[", "\"\<z\>\"", "]"}]}]}], ",", 
         RowBox[{"1", "/", "4"}]}], "}"}]}], "}"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"ztraj3", "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "Input",
