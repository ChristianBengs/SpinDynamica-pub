Cell[CellGroupData[{

Cell["SignalCalculationMethod", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
   3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
   3.544606485581957*^9}, {3.544956512738163*^9, 3.54495651862396*^9}, 
   3.544956560062955*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"402dc597-7677-4049-8b9d-4317bb9defb5"],

Cell[TextData[{
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " has a choice of three different computational algorithms, governed by the \
option ",
 StyleBox["SignalCalculationMethod",
  FontWeight->"Bold"],
 ". The default is ",
 StyleBox["SignalCalculationMethod",
  FontWeight->"Bold"],
 "\[Rule]",
 StyleBox["Automatic",
  FontWeight->"Bold"],
 ", in which case the routine tries to determine the most appropriate \
algorithm itself. "
}], "Text",
 CellChangeTimes->{{3.544956521913321*^9, 3.544956608997785*^9}, {
   3.544956940680211*^9, 3.544956977843979*^9}, 3.574270323267505*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"0fbd2ea1-b604-45fb-9ec2-db6bcd23afc9"],

Cell[TextData[{
 StyleBox["SignalCalculationMethod\[Rule]\"Direct\"",
  FontWeight->"Bold"],
 " is the most general method. A ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " calculation is performed, and sampled at the specified set of times. "
}], "Text",
 CellChangeTimes->{{3.54495661598236*^9, 3.544956652824157*^9}, {
  3.54495670874406*^9, 3.544956710480441*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"dca978e9-fb9e-4ac9-8304-b88678885631"],

Cell[TextData[{
 StyleBox["SignalCalculationMethod \[Rule] \"Diagonalization\"",
  FontWeight->"Bold"],
 " is appropriate when a single, time-independent evolution generator spans \
the whole sampling interval.  "
}], "Text",
 CellChangeTimes->{{3.544956661683193*^9, 3.544956698811079*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"7d292b17-1daf-46e5-a77e-9ae2f8180a2f"],

Cell[TextData[{
 StyleBox["SignalCalculationMethod \[Rule] \"COMPUTE\"",
  FontWeight->"Bold"],
 " is appropriate for periodic time-dependent problems.  References: M. Ed\
\[EAcute]n, Y. K. Lee and M. H. Levitt, J. Magn. Reson. A 120, 56 (1996); M. \
H. Levitt and M. Ed\[EAcute]n, Mol. Phys. 95, 879-890 (1998); M. Hohwy, H. \
Bilds\[OSlash]e, H. J. Jakobsen and N. C. Nielsen, J. Magn. Reson. 136, 6-14 \
(1999); M. Helmle et al, J. Magn. Reson. 140, 379-403 (1999). "
}], "Text",
 CellChangeTimes->{{3.544956661683193*^9, 3.544956738325509*^9}, {
   3.544956840710501*^9, 3.544956841755808*^9}, {3.544956882345907*^9, 
   3.544956890611299*^9}, {3.544956997202808*^9, 3.544957038207583*^9}, {
   3.544957400471158*^9, 3.544957438997169*^9}, {3.544957481748661*^9, 
   3.544957483059864*^9}, 3.574270307247539*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"22196f51-0799-4086-9c06-2d4568a3aecd"],

Cell["\<\
The COMPUTE algorithm sometimes requires adjustment of the sampling interval \
to be compatible with the period. The routine reports on this adjustment. \
\>", "Text",
 CellChangeTimes->{{3.544956661683193*^9, 3.544956738325509*^9}, {
  3.544956840710501*^9, 3.544956841755808*^9}, {3.544956882345907*^9, 
  3.544956890611299*^9}, {3.544956997202808*^9, 3.544957038207583*^9}, {
  3.544957400471158*^9, 3.544957438997169*^9}, {3.544957481748661*^9, 
  3.544957485635062*^9}, {3.544957531488533*^9, 3.544957554351224*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"994772b5-f0ba-4b35-abd3-76a88528cd34"],

Cell[TextData[{
 StyleBox["SignalCalculationMethod \[Rule] \[OpenCurlyDoubleQuote]COMPUTE\
\[CloseCurlyDoubleQuote] ",
  FontWeight->"Bold"],
 " may be combined with the option ",
 StyleBox["CarouselAverage\[Rule]True",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544956661683193*^9, 3.544956738325509*^9}, {
   3.544956840710501*^9, 3.544956841755808*^9}, {3.544956882345907*^9, 
   3.544956890611299*^9}, {3.544956997202808*^9, 3.544957038207583*^9}, {
   3.544957400471158*^9, 3.544957438997169*^9}, {3.544957481748661*^9, 
   3.544957516892541*^9}, {3.54496447422443*^9, 3.544964474226037*^9}, 
   3.574843875737013*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"3355a2cb-81aa-4498-aef1-e9c10d0ac2cc"],

Cell[TextData[{
 StyleBox["Signal1D ",
  FontWeight->"Bold"],
 "provides a message indicating which method has been chosen, unless the \
option ",
 StyleBox["ReportSignalCalculationMethod ",
  FontWeight->"Bold"],
 "is set to ",
 StyleBox["False",
  FontWeight->"Bold"],
 ". The message may be disabled for the whole session by executing ",
 StyleBox["SetOptions[Signal1D, ReportSignalCalculationMethod\[Rule]False]",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.5449567420535192`*^9, 3.544956831195508*^9}, 
   3.544956912833502*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"ca84b9f1-9f31-4dfd-8b43-a75f026b5625"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["low-level propagation routines", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.54435984217771*^9}, {
  3.575598482501603*^9, 3.575598484449917*^9}, {3.575598763770335*^9, 
  3.575598779342307*^9}, {3.575599460360424*^9, 3.575599460534473*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellTags->"Signal1D",ExpressionUUID->"a33442aa-5999-442b-8e0d-5c48b9b0789e"],

Cell[TextData[{
 "High-level routines such as ",
 StyleBox["Trajectory, TransformationAmplitude,",
  FontWeight->"Bold"],
 " and ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " use a set of low-level numerical propagation routines, which are \
documented here. "
}], "Text",
 CellChangeTimes->{{3.57559878211159*^9, 3.5755988387659893`*^9}, {
  3.575599468822822*^9, 3.57559949063806*^9}, {3.641654163037114*^9, 
  3.641654164730925*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"e9c2dd9a-8963-4d8c-bd26-d31e8e69f347"],

Cell[CellGroupData[{

Cell["NPropagate", "Subsection",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.54435984217771*^9}, {
  3.575598482501603*^9, 3.575598484449917*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellTags->"Signal1D",ExpressionUUID->"2b795c1d-50c5-4cde-9e29-13e0c9994f98"],

Cell[TextData[{
 StyleBox["NPropagate",
  FontWeight->"Bold"],
 " propagates a spin density operator through a series of events. The event \
specifications, and use of ",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "and other options, are the same as in the routines above. The output of the \
routine is the final value of the spin density operator."
}], "Text",
 CellChangeTimes->{{3.544549694695115*^9, 3.544549774147787*^9}, {
   3.5446063219736023`*^9, 3.54460645985575*^9}, {3.544607424476499*^9, 
   3.544607424905135*^9}, {3.544608243870809*^9, 3.544608267148535*^9}, 
   3.544608333394639*^9, {3.544609007281818*^9, 3.54460903949083*^9}, {
   3.5449821055863333`*^9, 3.5449821145857983`*^9}, {3.5755985018558483`*^9, 
   3.57559854709648*^9}, {3.575598582244341*^9, 3.575598630347045*^9}, 
   3.709547934222259*^9},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"38a3c8f2-f3ea-416a-a912-2c0508cb3c24"],

Cell[TextData[{
 "The general syntax is ",
 StyleBox["NPropagate[events, options][\[Rho]ini]",
  FontWeight->"Bold"],
 " where ",
 StyleBox["\[Rho]ini",
  FontWeight->"Bold"],
 " is the initial density operator."
}], "Text",
 CellChangeTimes->{{3.575598686854257*^9, 3.575598711837219*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"37309f0e-edde-4184-8079-20e4ab4cff4b"],

Cell["\<\
The example below propagates a spin density operator under a series of events:\
\>", "Text",
