Cell[CellGroupData[{

Cell["BackgroundGenerator", "Subsection",
 CellChangeTimes->{{3.544465375144247*^9, 3.544465378279257*^9}, {
  3.709547649547731*^9, 
  3.7095476529137955`*^9}},ExpressionUUID->"ab43910f-5820-4113-b1b3-\
6ff25d41c696"],

Cell[TextData[{
 "An important option for most of the simulation routines is ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 ". This specifies an evolution generator which runs as a \
\[OpenCurlyDoubleQuote]background\[CloseCurlyDoubleQuote] through the entire \
calculation and which is combined automatically with the event \
specifications. "
}], "Text",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
  3.574259904634821*^9, 3.57425990975161*^9}, {3.7095476580634947`*^9, 
  3.709547663300057*^9}},ExpressionUUID->"4ba07aa8-c849-4607-8155-\
2578dd45ccea"],

Cell[TextData[{
 "In most cases, the ",
 StyleBox["BackgroundGenerator",
  FontWeight->"Bold"],
 " parameter is used for the \[OpenCurlyDoubleQuote]internal\
\[CloseCurlyDoubleQuote] Hamiltonian and relaxation superoperator, while the \
sequence of events specifies the interactions with applied magnetic fields. "
}], "Text",
 CellChangeTimes->{{3.544466280020092*^9, 3.544466405961933*^9}, {
   3.544466523924974*^9, 3.544466526698943*^9}, {3.544466722876622*^9, 
   3.544466724274419*^9}, {3.544549002827262*^9, 3.544549005232912*^9}, 
   3.709547668174356*^9},ExpressionUUID->"5f3a14e0-b10e-4214-a640-\
5423635b7e3e"],

Cell[TextData[{
 "Examples of ",
 StyleBox["BackgroundGenerator ",
  FontWeight->"Bold"],
 "are given in the documentation for the individual functions below. "
}], "Text",
 CellChangeTimes->{{3.544548934029782*^9, 3.54454895513953*^9}, 
   3.574260702011462*^9, 
   3.709547670820675*^9},ExpressionUUID->"e5d970ff-fdad-431f-b216-\
7872e3357c75"]
}, Closed]],

Cell[CellGroupData[{

Cell["EnsembleAverage", "Subsection",
 CellChangeTimes->{{3.544465375144247*^9, 3.544465378279257*^9}, {
  3.544466795874485*^9, 3.5444667986553516`*^9}},
 CellTags->
  "EnsembleAverage",ExpressionUUID->"f53fb022-a843-4c0b-99c6-2480aa4acba0"],

Cell[TextData[{
 "An important option for most of the routines is ",
 StyleBox["EnsembleAverage",
  FontWeight->"Bold"],
 ". This allows repetition of the calculations with a variable taking a \
defined set of values, and the results superposed afterwards. "
}], "Text",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 
   3.574260278841069*^9}},ExpressionUUID->"22dd8ed8-02ec-48a0-931b-\
c08aa890e2ac"],

Cell[TextData[{
 "Examples of ",
 StyleBox["EnsembleAverage ",
  FontWeight->"Bold"],
 "are given in the documentation for the individual functions below. "
}], "Text",
 CellChangeTimes->{{3.544548934029782*^9, 
  3.54454895513953*^9}},ExpressionUUID->"589737c5-b960-44b2-a88e-\
9d36cec8cdcd"],

Cell[CellGroupData[{

Cell[TextData[StyleBox["general syntax for EnsembleAverage", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 
   3.574260289512531*^9}},ExpressionUUID->"26c73246-15c3-44c1-9915-\
fa324ca8d368"],

Cell[TextData[{
 "The general syntax for the ",
 StyleBox["EnsembleAverage",
  FontWeight->"Bold"],
 " option is "
}], "Text",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 
   3.5742602926252317`*^9}},ExpressionUUID->"120b8caa-6889-48c5-b44e-\
c19e55c378e3"],

Cell[TextData[StyleBox["EnsembleAverage \[Rule] {var, {{val1, weight1}, \
{val2, weight2}..}}",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.54454823610982*^9, 
  3.544548289107848*^9}},ExpressionUUID->"beaad774-1d39-4d69-b89f-\
1ea1d0bb9481"],

Cell[TextData[{
 "where ",
 StyleBox["var",
  FontWeight->"Bold"],
 " is a symbol, the list ",
 StyleBox["{val1,val2..} ",
  FontWeight->"Bold"],
 "contains a set of values taken by the symbol, and the results of the \
simulations are multiplied by the weights ",
 StyleBox["{weight1,weight2..}",
  FontWeight->"Bold"],
 " and added together. "
}], "Text",
 CellChangeTimes->{{3.544548279329661*^9, 
  3.5445484031190553`*^9}},ExpressionUUID->"d5a8223f-47fd-41d5-a983-\
6c0986414e19"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["abbreviated syntax", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 3.574260306336759*^9}, 
   3.574842780449082*^9},ExpressionUUID->"214c4112-659d-499e-90fc-\
eb48ee8a867e"],

Cell["\<\
If the weights are omitted, they are assumed to be equal, and to add up to 1. \
For example:\
\>", "Text",
 CellChangeTimes->{{3.544548407257786*^9, 
  3.544548425735368*^9}},ExpressionUUID->"c9f3dc8f-6025-40c5-871b-\
1c83145b6673"],

Cell[TextData[StyleBox["EnsembleAverage \[Rule] {var, {val1,val2,val3}}",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.5445484324058223`*^9, 3.544548444685841*^9}, {
  3.544548576502178*^9, 
  3.544548577326025*^9}},ExpressionUUID->"110c935f-36f7-4422-9172-\
4ab6bdbaf573"],

Cell["is equivalent to", "Text",
 CellChangeTimes->{{3.544548449270089*^9, 
  3.5445484547495537`*^9}},ExpressionUUID->"51d41bc8-3724-4d1e-8e5a-\
af132ed998ff"],

Cell[TextData[StyleBox["EnsembleAverage \[Rule] {var, {{val1,1/3},{val2,1/3}, \
{val3,1/3}}}",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.5445484593289967`*^9, 3.544548478541766*^9}, {
  3.544548573312141*^9, 
  3.544548574182294*^9}},ExpressionUUID->"3cf78b62-8f66-47dd-bc9e-\
631ff7838e5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["EnsembleAverage of a multidimensional variable ", \
"Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 3.574260333255394*^9}, {
   3.574260392257372*^9, 3.574260398301755*^9}, {3.5748429637434173`*^9, 
   3.574842967604759*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"d509d2f9-a2f3-4fb8-9665-23dcb7bbe33e"],

Cell[TextData[{
 "Each value of the ensemble variable ",
 StyleBox["{val1,val2,val3} ",
  FontWeight->"Bold"],
 "may be a list of numbers itself. For example,  syntax of the following form \
might be used for simulating an NMR imaging experiment:"
}], "Text",
 CellChangeTimes->{{3.544548495429279*^9, 3.544548530793284*^9}, {
  3.544548633911727*^9, 3.544548668021087*^9}, {3.544548871608823*^9, 
  3.54454887242718*^9}, {3.5742603386322308`*^9, 3.574260375070599*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"2eb0734c-1348-4303-9c0a-4cdec949ea06"],

Cell[TextData[StyleBox["EnsembleAverage \[Rule] {r, {{{x1,y1,z1}, w1}, \
{{x2,y2,z2}, w2}, {{x3,y3,z3}, w3}}}",
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.544548582478689*^9, 3.544548614908313*^9}, {
  3.544548749368485*^9, 3.544548755797852*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"f6d6e4f7-714e-480c-ba31-0397170774da"],

Cell[TextData[{
 "Here the Cartesian position of a volume element is denoted ",
 StyleBox["r",
  FontWeight->"Bold"],
 ", and averaging is conducted over three points with coordinates ",
 StyleBox["{x1,y1,z1}",
  FontWeight->"Bold"],
 ", ",
 StyleBox["{x2,y2,z2}",
  FontWeight->"Bold"],
 " and ",
 StyleBox["{x3,y3,z3}",
  FontWeight->"Bold"],
 ". The weights ",
 StyleBox["{w1,w2,w3}",
  FontWeight->"Bold"],
 " could be used to encode the relative spin density at three points. This \
syntax could readily be extended to any numbers of sampled points. In general \
specifications of this form are best constructed using the very general \
structural operations provided by ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544548624309228*^9, 3.54454862524321*^9}, {
  3.544548672935935*^9, 3.544548721890076*^9}, {3.544548757341964*^9, 
  3.544548832276366*^9}, {3.544548907705555*^9, 3.544548909288373*^9}, {
  3.5446058648027077`*^9, 3.544605871696383*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"8e86d487-078d-4c16-8af7-c0d0fcdb32d8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["CarouselAverage", "Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 3.574260333255394*^9}, {
   3.574260392257372*^9, 3.574260398301755*^9}, {3.5748429637434173`*^9, 
   3.574843002707759*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"8a729144-874a-4b16-8975-039c23736e19"],

Cell[TextData[{
 "If ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " is used to calculate the signal in the presence of a periodic background \
generator, the option ",
 StyleBox["CarouselAverage", "Subsubsection"],
 StyleBox["\[Rule]True",
  FontWeight->"Bold"],
 " may be used to take the average over all phases of the periodic background \
generator, in a computationally efficient way. This option may be used at the \
same time as ",
 StyleBox["EnsembleAverage",
  FontWeight->"Bold"],
 "."
}], "Text",
 CellChangeTimes->{{3.544548495429279*^9, 3.544548530793284*^9}, {
  3.544548633911727*^9, 3.544548668021087*^9}, {3.544548871608823*^9, 
  3.54454887242718*^9}, {3.5742603386322308`*^9, 3.574260375070599*^9}, {
  3.574843006331933*^9, 3.5748431312840233`*^9}, {3.7095477525144997`*^9, 
  3.709547764004388*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"7462d16c-131d-4ecc-9cf4-eec1ba4aba73"],

Cell[TextData[{
 "See ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " for examples."
}], "Text",
 CellChangeTimes->{{3.574843134159107*^9, 3.5748431703805027`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"142ea161-b191-4152-8be6-0c85b1d80904"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["MaxBatchSize", "Subsubsection"]], "Subsubsection",
 CellChangeTimes->{{3.544466208168169*^9, 3.544466263686207*^9}, {
   3.544466802097124*^9, 3.544466946321372*^9}, {3.544548211623917*^9, 
   3.544548232412941*^9}, {3.544548553776027*^9, 3.544548554486961*^9}, 
   3.552278021031759*^9, {3.5742602692227087`*^9, 3.574260289512531*^9}, {
   3.5742604478930683`*^9, 3.574260497930738*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"84cf3a2b-a96d-4652-92ca-ef135fe785d9"],

Cell[TextData[{
 "The computation of an ensemble average is normally performed in batches, in \
order to conserve memory. All members of a single batch are computed and \
combined, before proceeding to the next batch. The option ",
 StyleBox["MaxBatchSize",
  FontWeight->"Bold"],
 " may be used to control the maximum number of members in each batch. "
}], "Text",
 CellChangeTimes->{{3.574260474678107*^9, 3.574260586499652*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"b8f235fa-585b-42aa-a336-3522c11108b1"],

Cell[TextData[{
 "The option setting ",
 StyleBox["MaxBatchSize\[Rule]Infinity",
  FontWeight->"Bold"],
 StyleBox[" ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 "forces computation in a single batch. "
}], "Text",
 CellChangeTimes->{{3.574260595628147*^9, 3.574260636433888*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"fe3107b4-1b3b-4869-bf88-97b16e805c5c"],

Cell[TextData[{
 "The default setting is ",
 StyleBox["MaxBatchSize\[Rule]128",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.574260638885804*^9, 3.574260649587125*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"10f17011-b3e4-43cb-bc5d-ec767c9bb432"],

Cell[TextData[{
 "There should be no need to control ",
 StyleBox["MaxBatchSize",
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSlant->"Italic"],
 "in normal use. "
}], "Text",
 CellChangeTimes->{{3.5742606526018*^9, 3.574260672017449*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"ea91fb95-aa4f-4dad-9f87-dffb62aa90d4"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Parallel", "Subsection",
 CellChangeTimes->{{3.544465375144247*^9, 3.544465378279257*^9}, {
  3.544466795874485*^9, 3.5444667986553516`*^9}, {3.574259956616917*^9, 
  3.5742599638794823`*^9}},
 CellTags->
  "EnsembleAverage",ExpressionUUID->"3cfa0795-523f-46a2-831a-de4fdf0ae022"],

Cell[TextData[{
 "In ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " v2.6.0 and later, ",
 StyleBox["EnsembleAverage",
  FontWeight->"Bold"],
 " is implemented automatically by launching parallel kernels and executing \
simultaneous ",
 StyleBox["SpinDynamica",
  FontSlant->"Italic"],
 " computations. The results of the parallel computations are combined \
automatically when all computations are finished. "
}], "Text",
 CellChangeTimes->{{3.574259968063414*^9, 3.574260045898405*^9}, {
  3.5742607209198513`*^9, 
  3.574260723564498*^9}},ExpressionUUID->"aa83a403-6e53-4111-8ae8-\
3cd565e8159a"],

Cell[CellGroupData[{

Cell["disabling parallel computation", "Subsubsection",
 CellChangeTimes->{{3.5742602043898563`*^9, 
  3.574260208762615*^9}},ExpressionUUID->"1dfed51a-e340-4096-b45d-\
8f3d4e2f3fa0"],

Cell[TextData[{
 "The option ",
 StyleBox["Parallel\[Rule]False",
  FontWeight->"Bold"],
 " may be used to disable parallel computation, leading to sequential \
execution of the computations in ",
 StyleBox["EnsembleAverage",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.574260048607313*^9, 3.574260080498065*^9}, {
  3.5742602338470297`*^9, 3.574260243482583*^9}, {3.574848081872134*^9, 
  3.574848103748654*^9}},ExpressionUUID->"99e0f25f-0cb5-4289-86ee-\
7bd198621ef5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["controlling the number of parallel kernels", "Subsubsection",
 CellChangeTimes->{{3.5742602043898563`*^9, 3.57426022256306*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"ea8565ea-1812-4ac3-939c-63c6ba57c7bc"],

Cell[TextData[{
 "The option ",
 StyleBox["Parallel\[Rule]n",
  FontWeight->"Bold"],
 ", where ",
 StyleBox["n",
  FontWeight->"Bold"],
 " is an integer, executes the code on ",
 StyleBox["n",
  FontWeight->"Bold"],
 " parallel kernels. The default setting ",
 StyleBox["Parallel\[Rule]True",
  FontWeight->"Bold"],
 ", or ",
 StyleBox["Parallel\[Rule]Automatic",
  FontWeight->"Bold"],
 ", uses the maximum number of parallel kernels available on the computation \
platform. "
}], "Text",
 CellChangeTimes->{{3.5742600868124657`*^9, 3.574260184756249*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"95d1765e-f46a-46ed-b801-09d6989f7997"]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Trajectory", "Section",
 CellChangeTimes->{{3.5443597793686047`*^9, 3.544359791519092*^9}},
 CellTags->
  "Trajectory",ExpressionUUID->"26067d88-2dc9-4ae1-9574-f67103788acb"],

Cell[TextData[{
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " tracks the evolution of one or more operator expectation values under a \
sequence of events, starting from any initial value for the spin density \
operator. "
}], "Text",
 CellChangeTimes->{{3.544549694695115*^9, 3.544549774147787*^9}, {
  3.574262489925782*^9, 
  3.5742624906517773`*^9}},ExpressionUUID->"7e8fbe5b-732f-4a42-a80e-\
b3c82bc1a2f2"],

Cell["\<\
The sequence of events may be specified using PulseSequence syntax, or \
explicit syntax, or a mix (see part 1). \
\>", "Text",
 CellChangeTimes->{{3.816856742677157*^9, 
  3.8168567664961977`*^9}},ExpressionUUID->"a25e0601-5577-432c-99b1-\
0779de87f5bc"],

Cell[TextData[{
 "The output of ",
 StyleBox["Trajectory",
  FontWeight->"Bold"],
 " is a ",
 StyleBox["TrajectoryFunction",
  FontWeight->"Bold"],
 ", which may then be evaluated at any time during the computed range."
}], "Text",
 CellChangeTimes->{{3.574262495093223*^9, 
  3.57426253602618*^9}},ExpressionUUID->"819ac6c1-54be-437c-9876-\
620fe7454266"],

Cell[CellGroupData[{

Cell["single event", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
  3.544550277066109*^9, 
  3.544550282913748*^9}},ExpressionUUID->"65e300d8-49a1-474f-86c3-\
c00d2e188efa"],

Cell[TextData[{
 "The following instruction sets the spin system to a single spin-1/2, and \
then calculates the trajectory of the expectation value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["I", "y"], TraditionalForm]],ExpressionUUID->
  "c16034bd-583b-49db-8110-08eed0d4fa97"],
 ", starting with a density operator ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "z"], ","}], TraditionalForm]],ExpressionUUID->
  "ef59cff6-7ef9-471d-ae2e-5b0a3069bf7a"],
 " during a 2\[Pi] pulse acting for 1 second:"
}], "Text",
 CellChangeTimes->{{3.544549895831808*^9, 3.544549944045988*^9}, {
  3.544550115805558*^9, 3.544550218203819*^9}, {3.816858664175553*^9, 
  3.816858665042451*^9}, {3.816858702977825*^9, 
  3.816858733889449*^9}},ExpressionUUID->"196a7de3-2089-4f5f-88b1-\
11850c1f10b6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "1", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"traj", "=", 
  RowBox[{"Trajectory", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"opI", "[", "\"\<z\>\"", "]"}], "\[Rule]", 
     RowBox[{"opI", "[", "\"\<y\>\"", "]"}]}], ",", 
    RowBox[{"Pulse", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "\[Pi]"}], ",", "\"\<x\>\""}], "}"}], ",", 
      RowBox[{"PulseDuration", "\[Rule]", "1"}]}], "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.5445501543137627`*^9, 3.544550243500211*^9}, {
   3.816858670209867*^9, 3.816858685269709*^9}, 3.816858737626729*^9},
 CellLabel->
  "In[152]:=",ExpressionUUID->"dd4045b3-0460-4b31-a1c7-dfa740576fcd"],

