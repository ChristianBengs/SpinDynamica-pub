   3.910152014985689*^9, 3.916897619932973*^9, 3.949039475220126*^9, 
   4.00447454957452*^9},
 CellLabel->
  "Out[148]=",ExpressionUUID->"dab3fd53-ea59-3548-a785-bb3f9253a522"]
}, Open  ]],

Cell[TextData[{
 "The explicit instruction ",
 StyleBox["InitialTimePoint\[Rule]1",
  FontWeight->"Bold"],
 " supersedes the default setting ",
 StyleBox["InitialTimePoint\[Rule]0",
  FontWeight->"Bold"],
 ".",
 StyleBox[" ",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.544549487451745*^9, 3.544549527890307*^9}, {
  3.574263294638973*^9, 
  3.574263296052134*^9}},ExpressionUUID->"5dba30e8-0989-434a-8e49-\
c45403c51e49"],

Cell[TextData[{
 "Options of the type ",
 StyleBox["parameter\[Rule]value",
  FontWeight->"Bold"],
 " may be given in any order. "
}], "Text",
 CellChangeTimes->{{3.574263298443945*^9, 
  3.574263312635584*^9}},ExpressionUUID->"e608d211-c197-4824-a3e0-\
9a8a662ab0fd"],

Cell[CellGroupData[{

Cell["changing default settings", "Subsubsection",
 CellChangeTimes->{{3.574263284901774*^9, 3.5742632894922333`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"1ae6760a-f905-4566-a5f6-599ef08ca74a"],

Cell[TextData[{
 "The default settings of an option may be changed for the entire ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " session by using ",
 StyleBox["SetOptions",
  FontWeight->"Bold"],
 ", for example"
}], "Text",
 CellChangeTimes->{{3.544465981961184*^9, 3.544466041550647*^9}, {
  3.5444661726502733`*^9, 3.544466182271957*^9}, {3.5445494292383137`*^9, 
  3.544549434252825*^9}, {3.54454953932611*^9, 3.544549557961092*^9}, {
  3.574259866211915*^9, 3.5742598679052477`*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"d35b7c22-2601-415f-ba33-0868117eef6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetOptions", "[", 
   RowBox[{"Trajectory", ",", " ", 
    RowBox[{"InterpolationPoints", "\[Rule]", "1000"}]}], "]"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.5444660434656487`*^9, 3.5444660836680117`*^9}, {
  3.552226505552434*^9, 3.5522265061178713`*^9}},
 Background->RGBColor[1, 0.925, 0.925],
 CellLabel->
  "In[149]:=",ExpressionUUID->"490d74da-39e3-4c9c-b8b1-34698c9ac3be"],

Cell["This changes the default setting for the chosen parameter:", "Text",
 CellChangeTimes->{{3.544466087483016*^9, 3.544466142736906*^9}, {
  3.544466191472459*^9, 3.544466194727275*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"2471bdd9-6923-4e09-a2a9-54eb0a627210"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "Trajectory", "]"}]], "Input",
 Background->RGBColor[1, 0.925, 0.925],
 CellLabel->
  "In[150]:=",ExpressionUUID->"3ae77ebd-45eb-4028-9bd5-603f78b01dfe"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"OperatorBasis", "\[RuleDelayed]", 
    RowBox[{"ZeemanKetBraOperatorBasis", "[", "]"}]}], ",", 
   RowBox[{"Basis", "\[RuleDelayed]", 
    RowBox[{"ZeemanBasis", "[", "]"}]}], ",", 
   RowBox[{"NormalizationFactor", "\[Rule]", "None"}], ",", 
   RowBox[{"UseMatrixExpWhenPossible", "\[Rule]", "True"}], ",", 
   RowBox[{"UseHilbertSpaceWhenPossible", "\[Rule]", "True"}], ",", 
   RowBox[{"UseDiagonalizationWhenPossible", "\[Rule]", "False"}], ",", 
   RowBox[{"InitialTimePoint", "\[Rule]", "0"}], ",", 
   RowBox[{"FinalTimePoint", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"BackgroundGenerator", "\[Rule]", "None"}], ",", 
   RowBox[{"EnsembleAverage", "\[Rule]", "False"}], ",", 
   RowBox[{"InterpolationPoints", "\[Rule]", "1000"}], ",", 
   RowBox[{"AccuracyGoal", "\[Rule]", "10"}], ",", 
   RowBox[{"PrecisionGoal", "\[Rule]", "10"}], ",", 
   RowBox[{"MaxSteps", "\[Rule]", "Automatic"}], ",", 
   RowBox[{"MaxStepSize", "\[Rule]", "Automatic"}], ",", 
   RowBox[{
   "Simulations`Simulations`Private`InterpolationStepSize", "\[Rule]", 
    "1.`*^-6"}], ",", 
   RowBox[{"Chronology", "\[RuleDelayed]", "$Chronology"}], ",", 
   RowBox[{"Parallel", "\[Rule]", "True"}], ",", 
   RowBox[{"MaxBatchSize", "\[Rule]", "128"}], ",", 
   RowBox[{"MinimumRecommendedUserLevel", "\[Rule]", "2"}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.7185342878145432`*^9, {3.7281299563523016`*^9, 3.728129961865699*^9}, 
   3.728131268109392*^9, 3.728209818238517*^9, 3.728392268834759*^9, 
   3.728633291616386*^9, 3.758303869362859*^9, 3.789289863186087*^9, 
   3.81652324366704*^9, 3.816680297103539*^9, 3.816856718312146*^9, 
   3.837780694488124*^9, 3.8971550029118185`*^9, 3.910152014994493*^9, 
   3.9168976199417343`*^9, 3.9490394752284527`*^9, 4.004474549591772*^9},
 CellLabel->
  "Out[150]=",ExpressionUUID->"facf455b-8b47-ec42-a692-76f6f109dbef"]
}, Open  ]],

