Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "3", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ispins", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";", 
  RowBox[{"Sspins", "=", 
   RowBox[{"{", "3", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "6", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "40", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
      RowBox[{"opI", "[", 
       RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "40", " ", 
     RowBox[{
      RowBox[{"opI", "[", 
       RowBox[{"2", ",", "\"\<z\>\""}], "]"}], ".", 
      RowBox[{"opI", "[", 
       RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hdec", "=", 
   RowBox[{"2", "\[Pi]", " ", "100", " ", 
    RowBox[{"opI", "[", 
     RowBox[{"Ispins", ",", "\"\<x\>\""}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "@", "\[IndentingNewLine]", 
     RowBox[{"Signal1D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "\[Pi]", " ", "300"}], ",", "\"\<1k\>\""}], "}"}], 
        "}"}], ",", "\[IndentingNewLine]", "Hdec", ",", "\[IndentingNewLine]", 
       RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Observable", "\[Rule]", "Sspins"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
