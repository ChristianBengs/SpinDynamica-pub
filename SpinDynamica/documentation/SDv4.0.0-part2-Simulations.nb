Cell[CellGroupData[{

Cell["TransformationAmplitudeTable with 2 parameters", "Subsubsection",
 CellChangeTimes->{{3.544554296879638*^9, 3.5445543033258867`*^9}, {
  3.575597754474698*^9, 3.575597758383108*^9}, {3.721950927724573*^9, 
