Cell["\<\
In many cases, this is the most convenient syntax for Signal1D.\
\>", "Text",
 CellChangeTimes->{{3.789302902359146*^9, 
  3.789302921260045*^9}},ExpressionUUID->"116e2ef2-ca41-4150-8651-\
6cd06047e780"]
}, Closed]],

Cell[CellGroupData[{

Cell["Observable", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
   3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
   3.544606485581957*^9}, {3.544607568489716*^9, 3.544607607441374*^9}, {
   3.5446076513588247`*^9, 3.5446076541501307`*^9}, 
   3.5446238104708157`*^9},ExpressionUUID->"2772dc28-f238-4aac-b69c-\
3136bdec8d3a"],

Cell[TextData[{
 "The option ",
 StyleBox["Observable",
  FontWeight->"Bold"],
 " may be set to \n\t\[FilledVerySmallSquare] an operator, or \n\t\
\[FilledVerySmallSquare] one or more spin system labels, or\n\t\
\[FilledVerySmallSquare] ",
 StyleBox["All",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.544623820956916*^9, 3.544623864194604*^9}, {
  3.574263789108601*^9, 3.5742637983215218`*^9}, {3.574263835867692*^9, 
  3.5742638499098997`*^9}, {3.574263909447816*^9, 
  3.5742639248454247`*^9}},ExpressionUUID->"8c23856c-e339-4e25-a3af-\
bb7fec2c9f36"],

Cell[TextData[{
 "The default value of ",
 StyleBox["Observable",
  FontWeight->"Bold"],
 " is ",
 StyleBox["All",
  FontWeight->"Bold"],
 ", which implies that all spins give rise to the quadrature NMR signal. "
}], "Text",
 CellChangeTimes->{{3.544623870508128*^9, 
  3.544623904887675*^9}},ExpressionUUID->"20891b3f-b4ff-4523-8a2b-\
e7529828a21b"],

Cell[TextData[{
 "If ",
 StyleBox["Observable",
  FontWeight->"Bold"],
 " is set to a list of spins {j,k..}, then the observable operator for \
quadrature signal detection is set to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      FractionBox["i", "2"], ")"}]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["I", "j", "-"], "+", 
       SubsuperscriptBox["I", "k", "-"], "+"}], ".."}], ")"}]}], 
   TraditionalForm]],ExpressionUUID->"0de3bf9f-a4c8-482d-843f-c50d239d2d91"],
 ". "
}], "Text",
 CellChangeTimes->{{3.544623930536473*^9, 
  3.54462407871543*^9}},ExpressionUUID->"18169694-abb1-46b9-af08-\
f1faac5aa574"],

Cell["\<\
For example, consider a 3 spin system, in which spins #1 and #2 are I-spins, \
while spin #3 is an S-spin. A Hamiltonian is set up for this heteronuclear \
spin system:\
\>", "Text",
 CellChangeTimes->{{3.544624085853735*^9, 3.544624089703988*^9}, {
  3.544624128167091*^9, 3.544624153541571*^9}, {3.544624246470708*^9, 
  3.5446242727442718`*^9}},ExpressionUUID->"1a3c6b85-ee96-417a-8dda-\
900954f93683"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "3", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", " ", "=", " ", 
   RowBox[{
    RowBox[{"2", "\[Pi]", " ", "100", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"(", 
      RowBox[{"-", "120"}], ")"}], " ", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "30", " ", 
     RowBox[{"opI", "[", 
      RowBox[{"3", ",", "\"\<z\>\""}], "]"}]}], "+", "\[IndentingNewLine]", 
    RowBox[{"2", "\[Pi]", " ", "6", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "2", "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "4", " ", 
     RowBox[{
      RowBox[{"opI", "[", "1", "]"}], ".", 
      RowBox[{"opI", "[", "3", "]"}]}]}], "+", 
    RowBox[{"2", "\[Pi]", " ", "5", " ", 
     RowBox[{
      RowBox[{"opI", "[", "2", "]"}], ".", 
      RowBox[{"opI", "[", "3", "]"}]}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ispins", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sspins", "=", 
   RowBox[{"{", "3", "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.54462415546112*^9, 3.544624241137917*^9}, {
  3.544624275297272*^9, 3.544624284490348*^9}, {3.574263963671372*^9, 
  3.5742640175781317`*^9}, {3.574264128482669*^9, 3.574264128729924*^9}},
 CellLabel->
  "In[313]:=",ExpressionUUID->"8ee0ddd5-2cf6-4785-8dde-cae06091dc7c"],

Cell[BoxData[
 TemplateBox[{
  "SetSpinSystem", "set", 
   "\"the spin system has been set to \\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"{\\\", RowBox[{\\\"1\\\", \\\",\\\", \
FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}], \\\",\\\", \
RowBox[{\\\"{\\\", RowBox[{\\\"2\\\", \\\",\\\", FractionBox[\\\"1\\\", \\\"2\
\\\"]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{\\\"3\\\", \
\\\",\\\", FractionBox[\\\"1\\\", \\\"2\\\"]}], \\\"}\\\"}]}], \\\"}\\\"}]\\)\
\"", 2, 313, 129, 33228169006909302228, "Local", "QM`Hilbert`SetSpinSystem"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{
  3.544624285884284*^9, 3.544791773485802*^9, 3.544791911832062*^9, 
   3.5447948698846707`*^9, 3.545058488286049*^9, 3.545061303155697*^9, 
