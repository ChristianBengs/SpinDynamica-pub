Cell[CellGroupData[{

Cell["TableCoordinates", "Subsubsection",
 CellChangeTimes->{{3.544595756798325*^9, 
  3.544595769301099*^9}},ExpressionUUID->"93119033-2c7c-45d2-b03e-\
a9eaadc823c2"],

Cell["\<\
The x-coordinates of TransformationAmplitudeTable may be specified by setting \
the TableCoordinates option to any expression containing the variable \
parameter. The example below varies the amplitude factor for a composite \
pulse but plots it in units of %: \
\>", "Text",
 CellChangeTimes->{{3.544596336436264*^9, 3.544596407049268*^9}, {
  3.544604749592227*^9, 3.5446047701736*^9}, {3.721950477614821*^9, 
  3.72195050469971*^9}, {3.789302152418577*^9, 3.78930217387685*^9}, {
  3.816858047535769*^9, 3.816858061864548*^9}, {3.816861682858602*^9, 
  3.816861714777167*^9}, {3.816861913262875*^9, 
