Cell[CellGroupData[{

Cell["Specifying the sampling using timing parameters", "Subsubsection",
 CellChangeTimes->{{3.544549884360948*^9, 3.544549888991501*^9}, {
  3.544550277066109*^9, 3.544550282913748*^9}, {3.544606482687283*^9, 
  3.544606485581957*^9}, {3.544607568489716*^9, 3.544607572464236*^9}, {
  3.5742650854775743`*^9, 3.574265099019394*^9}, {3.574265327197357*^9, 
  3.57426532759129*^9}, {3.5742656784545918`*^9, 3.574265680642787*^9}, {
  3.626944102199573*^9, 3.6269441378385773`*^9}, {3.626944530917237*^9, 
  3.626944567122734*^9}, {3.626944598741692*^9, 3.626944610306371*^9}, {
  3.6269446639361777`*^9, 
  3.626944666880806*^9}},ExpressionUUID->"b79cd4c7-db50-4563-8b13-\
a73ab230cd65"],

Cell[TextData[{
 "The first argument to ",
 StyleBox["Signal1D",
  FontWeight->"Bold"],
 " may be the form ",
 StyleBox["{tmin, tmax, \[Delta]t}",
  FontWeight->"Bold"],
 " where ",
 StyleBox["tmin",
  FontWeight->"Bold"],
 " is the time coordinate of the first signal sample, ",
 StyleBox["tmax",
  FontWeight->"Bold"],
 " is the time coordinate of the last sample, and ",
 StyleBox["\[Delta]t",
  FontWeight->"Bold"],
 " is the sampling interval (\[OpenCurlyDoubleQuote]dwell time\
\[CloseCurlyDoubleQuote]). "
}], "Text",
 CellChangeTimes->{{3.57426509394692*^9, 3.574265161217547*^9}, {
  3.62694409560419*^9, 
  3.6269440965382967`*^9}},ExpressionUUID->"457d32d8-77ac-468f-b302-\
63abf1ac2064"],

Cell[TextData[{
 "In most cases, ",
 StyleBox["tmin",
  FontWeight->"Bold"],
 " is ",
 StyleBox["0",
  FontWeight->"Bold"],
 ". "
}], "Text",
 CellChangeTimes->{{3.574265203442564*^9, 
  3.5742652104012337`*^9}},ExpressionUUID->"7ecd8142-e265-4ddc-b49f-\
d5202ba45bd0"],

Cell[TextData[{
 "The inverse of ",
 StyleBox["\[Delta]t",
  FontWeight->"Bold"],
 " is the bandwidth of the spectrum after the Fourier transform, in Hz."
}], "Text",
 CellChangeTimes->{{3.5742652134979467`*^9, 
  3.574265286677738*^9}},ExpressionUUID->"40d5a270-4000-4a2b-811d-\
459fb3819561"],

Cell[TextData[{
 "The inverse of ",
 StyleBox["tmax-tmin",
  FontWeight->"Bold"],
 " is the digital resolution of the spectrum after the Fourier transform, in \
Hz."
}], "Text",
 CellChangeTimes->{{3.5742652567583857`*^9, 
  3.5742652979693193`*^9}},ExpressionUUID->"9c694730-af35-4bd7-8026-\
b0b26de45159"],

Cell["\<\
These parameters should be adjusted to bring the desired spectrum into the \
spectral bandwidth, without folding.\
\>", "Text",
 CellChangeTimes->{{3.57426533213529*^9, 
  3.574265371892769*^9}},ExpressionUUID->"adddf67c-c90a-4833-9153-\
bca5844aae30"],

Cell["\<\
As an example, the settings below give a spectrum of bandwidth 200\
\[NonBreakingSpace]Hz, and digital resolution of 1\[NonBreakingSpace]Hz:\
\>", "Text",
 CellChangeTimes->{{3.574265440322687*^9, 3.574265469250931*^9}, {
  3.626945624197804*^9, 
  3.6269456248108244`*^9}},ExpressionUUID->"1434e50d-b40f-4b23-ac0f-\
8b1b771e601f"],

