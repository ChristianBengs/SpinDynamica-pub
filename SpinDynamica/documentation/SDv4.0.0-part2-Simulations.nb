Cell[TextData[{
 "Syntax of this form may be used to simulate decoupling sequences. The \
following instructions simulate the effect of repetitive ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["90", "x"], TraditionalForm]],ExpressionUUID->
  "4b154781-8268-4994-824c-06a7067eb799"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["180", "y"], TraditionalForm]],ExpressionUUID->
  "63d49d5e-98a3-41ee-9e3f-c3877116a7ee"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["90", "x"], TraditionalForm]],ExpressionUUID->
  "86a51112-673f-4f3d-9b9c-a5df47ab7f82"],
 " composite pulses applied to the I-spins while the S-spins are detected:"
}], "Text",
 CellChangeTimes->{{3.544965949395599*^9, 3.5449659597788277`*^9}, {
  3.5449659929919786`*^9, 3.544966067769403*^9}},
 Background->RGBColor[
  1, 0.925, 0.925],ExpressionUUID->"42fbdff2-55b1-4e79-9280-4aa0afb97d85"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"SetSpinSystem", "[", "2", "]"}], ";", " ", 
  RowBox[{"Ispins", "=", 
   RowBox[{"{", "1", "}"}]}], ";", " ", 
  RowBox[{"Sspins", "=", 
   RowBox[{"{", "2", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{"2", "\[Pi]", " ", "150", " ", 
    RowBox[{
     RowBox[{"opI", "[", 
      RowBox[{"1", ",", "\"\<z\>\""}], "]"}], ".", 
     RowBox[{"opI", "[", 
      RowBox[{"2", ",", "\"\<z\>\""}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]nutI", "=", 
    RowBox[{"2", "\[Pi]", " ", 
     RowBox[{"10", "^", "3"}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Tau]360I", "=", 
   RowBox[{"2", 
    RowBox[{"\[Pi]", "/", "\[Omega]nutI"}]}]}], ";", " ", 
  RowBox[{"\[Tau]90I", "=", 
   RowBox[{"\[Tau]360I", "/", "4"}]}], ";", " ", 
  RowBox[{"\[Tau]180I", "=", 
   RowBox[{"\[Tau]360I", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signal", "=", "\[IndentingNewLine]", 
   RowBox[{"Signal1D", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0.5", ",", 
       RowBox[{"{", "4096", "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Repeat", "[", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Omega]nutI", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"Ispins", ",", "\"\<x\>\""}], "]"}]}], ",", "\[Tau]90I"}],
          "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Omega]nutI", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"Ispins", ",", "\"\<y\>\""}], "]"}]}], ",", 
          "\[Tau]180I"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Omega]nutI", " ", 
           RowBox[{"opI", "[", 
            RowBox[{"Ispins", ",", "\"\<x\>\""}], "]"}]}], ",", "\[Tau]90I"}],
          "}"}]}], "\[IndentingNewLine]", "}"}], "\[IndentingNewLine]", "]"}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"BackgroundGenerator", "\[Rule]", "H0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Observable", "\[Rule]", "Sspins"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "[", "signal", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time /s\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "[", "signal", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Re", "@", 
    RowBox[{"FT", "[", "signal", "]"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "0.001"}], ",", "0.002"}], "}"}]}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency /Hz\>\"", ",", "\"\<amplitude\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
